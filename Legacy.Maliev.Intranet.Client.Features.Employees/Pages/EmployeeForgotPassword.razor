@page "/Employees/ForgotPassword"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject IStringLocalizer<EmployeeForgotPassword> Text
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="employee-recovery">
    <section class="employee-recovery__card" aria-labelledby="employee-forgot-password-heading">
        <h1 id="employee-forgot-password-heading">@Text["Heading"]</h1>
        <p class="employee-recovery__introduction">@Text["Introduction"]</p>

        @if (!string.IsNullOrWhiteSpace(notice))
        {
            <ShadcnAlert Variant="@noticeVariant" AlertRole="@NoticeRole"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert>
        }

        @if (submitting)
        {
            <div class="employee-recovery__progress" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Processing"]" Size="1.25rem" /><span>@Text["Processing"]</span></div>
        }

        <EditForm Model="@formModel" OnSubmit="SubmitAsync" Class="employee-recovery__form">
            <ShadcnFormField Id="employee-recovery-email" Label="@Text["Email"]" Error="@emailError" Required="true" Disabled="@submitting">
                <Control><ShadcnInput TValue="string" id="employee-recovery-email" Type="email" @bind-Value="formModel.Email" autocomplete="email" Required="true" Disabled="@submitting" /></Control>
            </ShadcnFormField>
            <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting" Class="employee-recovery__primary">
                @Text["Submit"]
            </ShadcnButton>
        </EditForm>
        <LegacyLink Href="/Login" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["BackToLogin"]" Class="employee-recovery__link">@Text["BackToLogin"]</LegacyLink>
    </section>
</main>

@code {
    private readonly RecoveryEmailForm formModel = new();
    private bool submitting;
    private string? emailError;
    private string? notice;
    private ShadcnAlertVariant noticeVariant = ShadcnAlertVariant.Default;
    private ShadcnAlertRole NoticeRole => noticeVariant == ShadcnAlertVariant.Destructive ? ShadcnAlertRole.Alert : ShadcnAlertRole.Status;

    private async Task SubmitAsync()
    {
        if (submitting) return;
        emailError = string.IsNullOrWhiteSpace(formModel.Email) ? Text["EmailRequired"].Value : null;
        if (emailError is not null) return;

        submitting = true;
        notice = null;
        try
        {
            var csrf = await GetCsrfAsync();
            if (csrf is null) { ShowError(Text["Unavailable"]); return; }
            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/employee-recovery/password-reset/request")
            {
                Content = JsonContent.Create(new EmployeeRecoveryEmailRequest(formModel.Email.Trim())),
            };
            request.Headers.Add("X-CSRF-TOKEN", csrf);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Accepted)
            {
                noticeVariant = ShadcnAlertVariant.Default;
                notice = Text["Accepted"];
                return;
            }

            ShowError(response.StatusCode == HttpStatusCode.TooManyRequests
                ? Text["RateLimited"]
                : Text["Unavailable"]);
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            ShowError(Text["Unavailable"]);
        }
        finally { submitting = false; }
    }

    private async Task<string?> GetCsrfAsync()
    {
        using var response = await Http.GetForPresentationAsync("/bff/session");
        if (!response.IsSuccessStatusCode) return null;
        return (await response.Content.ReadFromJsonAsync<EmployeeSessionSummary>())?.CsrfToken;
    }

    private void ShowError(string message)
    {
        noticeVariant = ShadcnAlertVariant.Destructive;
        notice = message;
    }

    private sealed class RecoveryEmailForm
    {
        public string Email { get; set; } = string.Empty;
    }
}
