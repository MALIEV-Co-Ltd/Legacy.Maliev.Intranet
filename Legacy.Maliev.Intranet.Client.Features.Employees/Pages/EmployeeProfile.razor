@page "/hr/profile"
@attribute [Authorize]
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using Legacy.Maliev.Intranet.Contracts
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<EmployeeProfile> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="employee-profile-page">
    <header class="operations-page-header">
        <div>
            <h1>@Text["Heading"]</h1>
            <p>@Text["Description"]</p>
        </div>
        <ShadcnButton Variant="ShadcnButtonVariant.Outline" OnClick="LoadAsync" Disabled="@(loading || submitting)">
            @Text["Refresh"]
        </ShadcnButton>
    </header>

    @if (loading)
    {
        <div class="employee-profile__loading" role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (profile is null)
    {
        <ShadcnAlert Variant="@(string.IsNullOrWhiteSpace(error) ? ShadcnAlertVariant.Default : ShadcnAlertVariant.Destructive)" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@(string.IsNullOrWhiteSpace(error) ? Text["NotFound"] : error)</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        }
        @if (!string.IsNullOrWhiteSpace(notice))
        {
            <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert>
        }

        <section class="employee-profile__card" aria-labelledby="profile-editable-heading">
            <h2 id="profile-editable-heading">@Text["EditableDetails"]</h2>
            <p class="employee-profile__help">@Text["EditableDetailsHelp"]</p>
            <EditForm EditContext="@editContext" aria-labelledby="profile-editable-heading">
                <DataAnnotationsValidator />
                <div class="employee-profile__grid">
                    <ShadcnFormField Id="employee-profile-first-name" Label="@Text["FirstName"]" Error="@ValidationFor(() => model.FirstName)" Required="true" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-profile-first-name" @bind-Value="model.FirstName" Required="true" maxlength="256" Disabled="@submitting" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="employee-profile-last-name" Label="@Text["LastName"]" Error="@ValidationFor(() => model.LastName)" Required="true" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-profile-last-name" @bind-Value="model.LastName" Required="true" maxlength="256" Disabled="@submitting" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="employee-profile-phone" Label="@Text["Phone"]" Error="@ValidationFor(() => model.PhoneNumber)" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-profile-phone" Type="tel" @bind-Value="model.PhoneNumber" maxlength="256" Disabled="@submitting" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="employee-profile-date-of-birth" Label="@Text["DateOfBirth"]" Disabled="@submitting"><Control><ShadcnDatePicker id="employee-profile-date-of-birth" @bind-Value="DateOfBirth" Clearable="true" CalendarLabel="@Text["DateOfBirth"]" Disabled="@submitting" data-date-format="@CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern" /></Control></ShadcnFormField>
                </div>
                <div class="employee-profile__actions">
                    <ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="SaveAsync" Disabled="@submitting">
                        @(submitting ? Text["Saving"] : Text["SaveChanges"])
                    </ShadcnButton>
                    <ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Ghost" OnClick="ResetEditableFields" Disabled="@submitting">
                        @Text["Reset"]
                    </ShadcnButton>
                </div>
            </EditForm>
        </section>

        <section class="employee-profile__card" aria-labelledby="profile-managed-heading">
            <h2 id="profile-managed-heading">@Text["ManagedDetails"]</h2>
            <p class="employee-profile__help">@Text["ManagedDetailsHelp"]</p>
            <dl class="employee-profile__managed-grid">
                <div><dt>@Text["EmployeeNumber"]</dt><dd>@profile.Id</dd></div>
                <div><dt>@Text["Email"]</dt><dd>@profile.Email</dd></div>
                <div><dt>@Text["Role"]</dt><dd>@Display(profile.Role?.Name)</dd></div>
                <div class="employee-profile__wide"><dt>@Text["HomeAddress"]</dt><dd>@Display(AddressLine(profile.HomeAddress))</dd></div>
            </dl>
        </section>
    }
</main>

@code {
    private readonly EditableProfileModel model = new();
    private EmployeeDetail? profile;
    private EditContext editContext = null!;
    private bool loading;
    private bool submitting;
    private string? error;
    private string? notice;

    protected override Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        return LoadAsync();
    }

    private Task LoadAsync() => LoadAsync(clearNotice: true);

    private async Task LoadAsync(bool clearNotice)
    {
        loading = true;
        error = null;
        if (clearNotice)
        {
            notice = null;
        }

        try
        {
            using var response = await Http.GetForPresentationAsync("/bff/profile");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                profile = null;
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                profile = null;
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                profile = null;
                error = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loaded = await response.Content.ReadFromJsonAsync<EmployeeDetail>();
            if (loaded is null || loaded.Id <= 0)
            {
                profile = null;
                error = Text["InvalidResponse"];
                return;
            }

            profile = loaded;
            ResetEditableFields();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (profile is null || submitting)
        {
            return;
        }

        if (!editContext.Validate())
        {
            error = Text["ValidationFailed"];
            notice = null;
            return;
        }

        submitting = true;
        error = null;
        notice = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToLogin();
                return;
            }

            if (!sessionResponse.IsSuccessStatusCode)
            {
                error = Text["SessionUnavailable"];
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                error = Text["SessionUnavailable"];
                return;
            }

            var update = new EmployeeSelfProfileUpdateRequest(
                model.FirstName.Trim(),
                model.LastName.Trim(),
                string.IsNullOrWhiteSpace(model.PhoneNumber) ? null : model.PhoneNumber.Trim(),
                model.DateOfBirth);
            using var request = new HttpRequestMessage(HttpMethod.Put, "/bff/profile")
            {
                Content = JsonContent.Create(update),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["ForbiddenUpdate"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                error = Text["ValidationFailed"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                profile = null;
                error = Text["NotFound"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["SaveFailed"];
                return;
            }

            await LoadAsync(clearNotice: false);
            if (profile is not null && string.IsNullOrWhiteSpace(error))
            {
                notice = Text["Saved"];
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private void ResetEditableFields()
    {
        if (profile is null)
        {
            return;
        }

        model.FirstName = profile.FirstName;
        model.LastName = profile.LastName;
        model.PhoneNumber = profile.PhoneNumber;
        model.DateOfBirth = profile.DateOfBirth;
        editContext = new EditContext(model);
        error = null;
    }

    private void RedirectToLogin() => Navigation.NavigateTo(
        $"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");

    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotProvided"] : value;

    private DateOnly? DateOfBirth
    {
        get => model.DateOfBirth is DateTime date ? DateOnly.FromDateTime(date) : null;
        set => model.DateOfBirth = value?.ToDateTime(TimeOnly.MinValue);
    }

    private string? ValidationFor<TValue>(System.Linq.Expressions.Expression<Func<TValue>> expression) =>
        editContext.GetValidationMessages(FieldIdentifier.Create(expression)).FirstOrDefault();

    private static string? AddressLine(EmployeeAddressDetail? address)
    {
        if (address is null)
        {
            return null;
        }

        var parts = new[] { address.Building, address.AddressLine1, address.AddressLine2, address.City, address.State, address.PostalCode }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        return string.Join(", ", parts);
    }

    private sealed class EditableProfileModel
    {
        [Required, StringLength(256)]
        public string FirstName { get; set; } = string.Empty;

        [Required, StringLength(256)]
        public string LastName { get; set; } = string.Empty;

        [Phone, StringLength(256)]
        public string? PhoneNumber { get; set; }

        public DateTime? DateOfBirth { get; set; }
    }
}
