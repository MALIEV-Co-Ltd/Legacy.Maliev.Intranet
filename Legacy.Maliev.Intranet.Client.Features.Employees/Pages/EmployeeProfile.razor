@page "/hr/profile"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using System.Net
@using System.Net.Http.Json
@using Legacy.Maliev.Intranet.Contracts
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<EmployeeProfile> Text
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="employee-profile-page">
    <header class="operations-page-header">
        <div>
            <h1>@Text["Heading"]</h1>
            <p>@Text["Description"]</p>
        </div>
        <ShadcnButton Variant="ShadcnButtonVariant.Outline" OnClick="LoadAsync" Disabled="@(loading || submitting)">
            @Text["Refresh"]
        </ShadcnButton>
    </header>

    @if (loading)
    {
        <div class="employee-profile__loading" role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (profile is null)
    {
        <ShadcnAlert Variant="@(string.IsNullOrWhiteSpace(error) ? ShadcnAlertVariant.Default : ShadcnAlertVariant.Destructive)" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@(string.IsNullOrWhiteSpace(error) ? Text["NotFound"] : error)</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        }
        @if (!string.IsNullOrWhiteSpace(notice))
        {
            <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert>
        }

        <section class="employee-profile__card" aria-labelledby="profile-editable-heading">
            <h2 id="profile-editable-heading">@Text["EditableDetails"]</h2>
            <p class="employee-profile__help">@Text["EditableDetailsHelp"]</p>
            <EditForm EditContext="@editContext" aria-labelledby="profile-editable-heading">
                <DataAnnotationsValidator />
                <div class="employee-profile__grid">
                    <ShadcnFormField Id="employee-profile-first-name" Label="@Text["FirstName"]" Error="@ValidationFor(() => model.FirstName)" Required="true" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-profile-first-name" @bind-Value="model.FirstName" Required="true" maxlength="256" Disabled="@submitting" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="employee-profile-last-name" Label="@Text["LastName"]" Error="@ValidationFor(() => model.LastName)" Required="true" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-profile-last-name" @bind-Value="model.LastName" Required="true" maxlength="256" Disabled="@submitting" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="employee-profile-phone" Label="@Text["Phone"]" Error="@ValidationFor(() => model.PhoneNumber)" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-profile-phone" Type="tel" @bind-Value="model.PhoneNumber" maxlength="256" Disabled="@submitting" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="employee-profile-date-of-birth" Label="@Text["DateOfBirth"]" Disabled="@submitting"><Control><ShadcnDatePicker id="employee-profile-date-of-birth" @bind-Value="DateOfBirth" Clearable="true" CalendarLabel="@Text["DateOfBirth"]" Disabled="@submitting" data-date-format="@CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern" /></Control></ShadcnFormField>
                </div>
                <div class="employee-profile__actions">
                    <ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="SaveAsync" Disabled="@submitting">
                        @(submitting ? Text["Saving"] : Text["SaveChanges"])
                    </ShadcnButton>
                    <ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Ghost" OnClick="ResetEditableFields" Disabled="@submitting">
                        @Text["Reset"]
                    </ShadcnButton>
                </div>
            </EditForm>
        </section>

        <section class="employee-profile__card" aria-labelledby="profile-managed-heading">
            <h2 id="profile-managed-heading">@Text["ManagedDetails"]</h2>
            <p class="employee-profile__help">@Text["ManagedDetailsHelp"]</p>
            <dl class="employee-profile__managed-grid">
                <div><dt>@Text["EmployeeNumber"]</dt><dd>@profile.Id</dd></div>
                <div><dt>@Text["Email"]</dt><dd>@profile.Email</dd></div>
                <div><dt>@Text["Role"]</dt><dd>@Display(profile.Role?.Name)</dd></div>
                <div class="employee-profile__wide"><dt>@Text["HomeAddress"]</dt><dd>@Display(AddressLine(profile.HomeAddress))</dd></div>
            </dl>
        </section>
    }
</main>

@code {
    private readonly EditableProfileModel model = new();
    private EmployeeDetail? profile;
    private EditContext editContext = null!;
    private bool loading;
    private bool submitting;
    private string? error;
    private string? notice;
    private readonly object authenticationStateLock = new();
    private Task<AuthenticationState>? latestAuthenticationState;
    private long authenticationRevision;
    private long profileAuthenticationRevision = -1;
    private string? profileEmployeeIdentity;
    private bool disposed;

    protected override Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        editContext = new EditContext(model);
        return LoadAsync();
    }

    private Task LoadAsync() => LoadAsync(clearNotice: true);

    private async Task LoadAsync(bool clearNotice)
    {
        var revision = Volatile.Read(ref authenticationRevision);
        loading = true;
        error = null;
        if (clearNotice)
        {
            notice = null;
        }

        try
        {
            (AuthenticationState State, long Revision) current;
            try { current = await GetLatestAuthenticationStateAsync(); }
            catch (Exception)
            {
                if (!disposed && revision == Volatile.Read(ref authenticationRevision))
                {
                    profile = null;
                    profileEmployeeIdentity = null;
                    profileAuthenticationRevision = -1;
                    error = Text["SessionUnavailable"];
                }
                return;
            }
            if (disposed || current.Revision != revision || revision != Volatile.Read(ref authenticationRevision)) return;
            var employeeIdentity = current.State.User.Identity?.IsAuthenticated == true
                ? current.State.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
            if (string.IsNullOrWhiteSpace(employeeIdentity))
            {
                profile = null;
                profileEmployeeIdentity = null;
                error = Text["SessionUnavailable"];
                return;
            }
            using var response = await Http.GetForPresentationAsync("/bff/profile");
            if (disposed || revision != Volatile.Read(ref authenticationRevision)) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                profile = null;
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                profile = null;
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                profile = null;
                error = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loaded = await response.Content.ReadFromJsonAsync<EmployeeDetail>();
            if (disposed || revision != Volatile.Read(ref authenticationRevision)) return;
            if (loaded is null || loaded.Id <= 0)
            {
                profile = null;
                error = Text["InvalidResponse"];
                return;
            }

            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (disposed || revision != Volatile.Read(ref authenticationRevision)) return;
            var session = sessionResponse.IsSuccessStatusCode
                ? await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>() : null;
            if (disposed || revision != Volatile.Read(ref authenticationRevision)) return;
            if (session?.IsAuthenticated != true
                || !string.Equals(session.EmployeeId, employeeIdentity, StringComparison.Ordinal)
                || session.LegacyDatabaseId != loaded.Id)
            {
                profile = null;
                profileEmployeeIdentity = null;
                profileAuthenticationRevision = -1;
                error = Text["SessionUnavailable"];
                return;
            }

            profile = loaded;
            profileAuthenticationRevision = revision;
            profileEmployeeIdentity = employeeIdentity;
            ResetEditableFields();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (!disposed && revision == Volatile.Read(ref authenticationRevision)) error = Text["Unavailable"];
        }
        finally
        {
            if (!disposed && revision == Volatile.Read(ref authenticationRevision)) loading = false;
        }
    }

    private async Task SaveAsync()
    {
        var currentProfile = profile;
        var revision = Volatile.Read(ref authenticationRevision);
        var employeeIdentity = profileEmployeeIdentity;
        if (currentProfile is null || string.IsNullOrWhiteSpace(employeeIdentity)
            || loading || submitting || disposed || profileAuthenticationRevision != revision)
        {
            return;
        }

        var validatedContext = editContext;
        var fields = (model.FirstName, model.LastName, model.PhoneNumber, model.DateOfBirth);
        bool StillCurrent() => !disposed && revision == Volatile.Read(ref authenticationRevision)
            && profileAuthenticationRevision == revision && ReferenceEquals(profile, currentProfile)
            && string.Equals(profileEmployeeIdentity, employeeIdentity, StringComparison.Ordinal)
            && ReferenceEquals(editContext, validatedContext)
            && fields == (model.FirstName, model.LastName, model.PhoneNumber, model.DateOfBirth);
        void RequireReload()
        {
            if (disposed || revision != Volatile.Read(ref authenticationRevision) || !ReferenceEquals(profile, currentProfile)) return;
            profile = null;
            profileAuthenticationRevision = -1;
            profileEmployeeIdentity = null;
            error = Text["SaveOutcomeUnknown"];
            notice = null;
        }
        submitting = true;
        var sent = false;
        try
        {
            var valid = await validatedContext.ValidateAsync();
            if (!StillCurrent()) return;
            if (!valid)
            {
                error = Text["ValidationFailed"];
                notice = null;
                return;
            }
            error = null;
            notice = null;
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (!StillCurrent()) return;
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToLogin();
                return;
            }

            if (!sessionResponse.IsSuccessStatusCode)
            {
                error = Text["SessionUnavailable"];
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (!StillCurrent()) return;
            if (session?.IsAuthenticated != true || !string.Equals(session.EmployeeId, employeeIdentity, StringComparison.Ordinal)
                || session.LegacyDatabaseId != currentProfile.Id
                || string.IsNullOrWhiteSpace(session.CsrfToken))
            {
                error = Text["SessionUnavailable"];
                return;
            }

            var update = new EmployeeSelfProfileUpdateRequest(
                fields.FirstName.Trim(),
                fields.LastName.Trim(),
                string.IsNullOrWhiteSpace(fields.PhoneNumber) ? null : fields.PhoneNumber.Trim(),
                fields.DateOfBirth);
            using var request = new HttpRequestMessage(HttpMethod.Put, "/bff/profile")
            {
                Content = JsonContent.Create(update),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            if (!StillCurrent()) return;
            sent = true;
            using var response = await Http.SendAsync(request);
            if (!StillCurrent())
            {
                RequireReload();
                return;
            }
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                RedirectToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["ForbiddenUpdate"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                error = Text["ValidationFailed"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                profile = null;
                error = Text["NotFound"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if ((int)response.StatusCode >= 500 || (response.IsSuccessStatusCode && response.StatusCode != HttpStatusCode.NoContent))
            {
                RequireReload();
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["SaveFailed"];
                return;
            }

            await LoadAsync(clearNotice: false);
            if (!disposed && revision == Volatile.Read(ref authenticationRevision)
                && profileAuthenticationRevision == revision && profile?.Id == currentProfile.Id
                && string.IsNullOrWhiteSpace(error))
            {
                notice = Text["Saved"];
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (sent) RequireReload();
            else if (StillCurrent()) error = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task<(AuthenticationState State, long Revision)> GetLatestAuthenticationStateAsync()
    {
        while (true)
        {
            Task<AuthenticationState>? pending;
            long revision;
            lock (authenticationStateLock) { pending = latestAuthenticationState; revision = authenticationRevision; }
            if (pending is null)
            {
                var initial = AuthenticationStateProvider.GetAuthenticationStateAsync();
                lock (authenticationStateLock)
                {
                    pending = latestAuthenticationState ??= initial;
                    revision = authenticationRevision;
                }
            }
            AuthenticationState state;
            try { state = await pending; }
            catch (Exception) when (!IsCurrentAuthenticationState(pending, revision)) { continue; }
            if (IsCurrentAuthenticationState(pending, revision)) return (state, revision);
        }
    }

    private bool IsCurrentAuthenticationState(Task<AuthenticationState> state, long revision)
    {
        lock (authenticationStateLock)
            return ReferenceEquals(state, latestAuthenticationState) && revision == authenticationRevision;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        long revision;
        lock (authenticationStateLock)
        {
            revision = ++authenticationRevision;
            latestAuthenticationState = state;
        }
        _ = InvokeAsync(() =>
        {
            if (disposed || revision != Volatile.Read(ref authenticationRevision)
                || profileAuthenticationRevision == revision) return;
            profile = null;
            profileAuthenticationRevision = -1;
            profileEmployeeIdentity = null;
            loading = false;
            error = Text["SessionUnavailable"];
            notice = null;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        disposed = true;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private void ResetEditableFields()
    {
        if (profile is null)
        {
            return;
        }

        model.FirstName = profile.FirstName;
        model.LastName = profile.LastName;
        model.PhoneNumber = profile.PhoneNumber;
        model.DateOfBirth = profile.DateOfBirth;
        editContext = new EditContext(model);
        error = null;
    }

    private void RedirectToLogin() => Navigation.NavigateTo(
        $"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");

    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotProvided"] : value;

    private DateOnly? DateOfBirth
    {
        get => model.DateOfBirth is DateTime date ? DateOnly.FromDateTime(date) : null;
        set => model.DateOfBirth = value?.ToDateTime(TimeOnly.MinValue);
    }

    private string? ValidationFor<TValue>(System.Linq.Expressions.Expression<Func<TValue>> expression) =>
        editContext.GetValidationMessages(FieldIdentifier.Create(expression)).FirstOrDefault();

    private static string? AddressLine(EmployeeAddressDetail? address)
    {
        if (address is null)
        {
            return null;
        }

        var parts = new[] { address.Building, address.AddressLine1, address.AddressLine2, address.City, address.State, address.PostalCode }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        return string.Join(", ", parts);
    }

    private sealed class EditableProfileModel
    {
        [Required, StringLength(256)]
        public string FirstName { get; set; } = string.Empty;

        [Required, StringLength(256)]
        public string LastName { get; set; } = string.Empty;

        [Phone, StringLength(256)]
        public string? PhoneNumber { get; set; }

        public DateTime? DateOfBirth { get; set; }
    }
}
