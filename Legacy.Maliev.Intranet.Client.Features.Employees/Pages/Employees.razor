@page "/Employees/Index"
@using System.Globalization
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Employees> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="mlv-module-shell employees-page">
    <div class="mlv-page-body">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header">
        <div><h1>@Text["Employees"]</h1><p>@Text["Profiles"]</p></div>
        <ShadcnButton Href="/Employees/Create">
            @Text["CreateEmployee"]
        </ShadcnButton>
    </header>

    <section class="employee-table-region" aria-label="@Text["EmployeesTable"]">
        <OperationalDataTable TItem="EmployeeListItem"
                              Items="@(page?.Items ?? [])"
                              Columns="@Columns"
                              RowKey="@(employee => employee.Id.ToString(CultureInfo.InvariantCulture))"
                              State="@dataTableState"
                              StateChanged="HandleDataTableStateChangedAsync"
                              RequestChanged="HandleDataTableRequestAsync"
                              TotalCount="@(page?.TotalRecords ?? 0)"
                              Loading="@loading"
                              Error="@error"
                              FilterPlaceholder="@Text["Search"]"
                              EmptyText="@Text["Empty"]"
                              LoadingText="@Text["Loading"]"
                              ActionsLabel="@Text["Actions"]"
                              PageSizeOptions="@PageSizeOptions"
                              DetailHref="@(employee => $"/Employees/View?id={employee.Id}")"
                              DetailAriaLabel="@(employee => Text["ViewEmployee", employee.Id])"
                              DetailsAriaLabel="@(employee => Text["ExpandEmployee", employee.Id])">
            <QuickViewContent Context="context">
                <dl class="employee-quick-view">
                    <div><dt>@Text["Name"]</dt><dd>@context.FullName</dd></div>
                    <div><dt>@Text["Role"]</dt><dd>@ValueOrFallback(context.Role?.Name)</dd></div>
                    <div><dt>@Text["Email"]</dt><dd>@context.Email</dd></div>
                </dl>
            </QuickViewContent>
        </OperationalDataTable>
    </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private EmployeeListPage? page;
    private string? error;
    private bool loading;
    private EmployeeListSort currentSort = EmployeeListSort.EmployeeId_Descending;
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 25 };
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 250];
    private IReadOnlyList<ShadcnDataTableColumn<EmployeeListItem>> Columns =>
    [
        new("id", Text["Id"], employee => employee.Id) { Sortable = true, Filterable = true, Hideable = false },
        new("name", Text["Name"], employee => employee.FullName) { Filterable = true, MinWidth = "12rem" },
        new("role", Text["Role"], employee => ValueOrFallback(employee.Role?.Name)) { Filterable = true, MinWidth = "12rem" },
        new("email", Text["Email"], employee => employee.Email) { Sortable = true, Filterable = true, MinWidth = "14rem" },
    ];
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Employees"]),
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        currentSort = Enum.TryParse<EmployeeListSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : EmployeeListSort.EmployeeId_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<EmployeeListSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? new ListToolbarState<EmployeeListSort>(Search, currentSort, Size)).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/employees?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<EmployeeListPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, EmployeeListSort sort, int size, bool replace = false)
    {
        var uri = $"/Employees/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}";
        Navigation.NavigateTo(uri, replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, Index - 1),
        PageSize = Size,
        Sorts = [currentSort switch
        {
            EmployeeListSort.EmployeeId_Ascending => new("id", ShadcnSortDirection.Ascending),
            EmployeeListSort.EmployeeEmail_Ascending => new("email", ShadcnSortDirection.Ascending),
            EmployeeListSort.EmployeeEmail_Descending => new("email", ShadcnSortDirection.Descending),
            _ => new("id", ShadcnSortDirection.Descending),
        }],
    };

    private EmployeeListSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => EmployeeListSort.EmployeeId_Ascending,
        { ColumnKey: "email", Direction: ShadcnSortDirection.Ascending } => EmployeeListSort.EmployeeEmail_Ascending,
        { ColumnKey: "email", Direction: ShadcnSortDirection.Descending } => EmployeeListSort.EmployeeEmail_Descending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => EmployeeListSort.EmployeeId_Descending,
        _ => currentSort,
    };

    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
