@page "/Employees/Index"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Employees> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="mlv-module-shell employees-page">
    <div class="mlv-page-body">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header">
        <div><MudText Typo="Typo.h4" HtmlTag="h1">@Text["Employees"]</MudText><MudText Typo="Typo.body2">@Text["Profiles"]</MudText></div>
        <MudButton Href="/Employees/Create" Variant="Variant.Filled" Color="Color.Primary">
            @Text["CreateEmployee"]
        </MudButton>
    </header>

    <ListToolbar TSort="EmployeeListSort"
                 Value="@ToolbarState"
                 Defaults="@DefaultToolbarState"
                 SortOptions="@SortOptions"
                 PageSizeOptions="@PageSizeOptions"
                 SearchLabel="@Text["Search"]"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite"><MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" /><span class="visually-hidden">@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Text["Empty"]</MudAlert>
    }
    else
    {
        <section class="employee-table-region" aria-label="@Text["EmployeesTable"]">
        <OperationalTable TItem="EmployeeListItem"
                          TKey="int"
                          Items="@(page.Items)"
                          KeySelector="@(context => context.Id)"
                          TableLabel="@Text["EmployeesTable"]"
                          ColumnCount="5"
                          State="@tableState"
                          DetailHref="@(context => $"/Employees/View?id={context.Id}")"
                          DetailAriaLabel="@(context => Text["ViewEmployee", context.Id])"
                          ExpandAriaLabel="@(context => Text["ExpandEmployee", context.Id])"
                          CollapseAriaLabel="@(context => Text["CollapseEmployee", context.Id])">
            <HeaderContent>
                <tr>
                    <th class="operational-table__identity employee-id" data-priority="essential">@Text["Id"]</th>
                    <th class="employee-name" data-priority="essential">@Text["Name"]</th>
                    <th class="employee-role" data-priority="essential">@Text["Role"]</th>
                    <th class="employee-email" data-priority="supporting">@Text["Email"]</th>
                    <th class="operational-table__actions-heading"><span class="visually-hidden">@Text["Actions"]</span></th>
                </tr>
            </HeaderContent>
            <RowContent Context="context">
                <td class="operational-table__identity employee-id mlv-mono" data-priority="essential">@context.Id</td>
                <td class="employee-name" data-priority="essential" title="@context.FullName">@context.FullName</td>
                <td class="employee-role" data-priority="essential" title="@context.Role?.Name">@ValueOrFallback(context.Role?.Name)</td>
                <td class="employee-email" data-priority="supporting" title="@context.Email">@context.Email</td>
            </RowContent>
            <QuickViewContent Context="context">
                <dl class="employee-quick-view">
                    <div><dt>@Text["Email"]</dt><dd>@context.Email</dd></div>
                </dl>
            </QuickViewContent>
        </OperationalTable>
        </section>
        <nav class="d-flex flex-wrap align-center justify-space-between gap-3 mt-4" aria-label="@Text["EmployeePages"]">
            <MudButton Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</MudButton>
            <MudText aria-live="polite">@Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords]</MudText>
            <MudButton Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</MudButton>
        </nav>
    }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private EmployeeListPage? page;
    private string? error;
    private bool loading;
    private EmployeeListSort currentSort = EmployeeListSort.EmployeeId_Descending;
    private readonly LatestRequestGate requestGate = new();
    private readonly OperationalTableState<int> tableState = new();
    private static readonly ListToolbarState<EmployeeListSort> DefaultToolbarState =
        new(null, EmployeeListSort.EmployeeId_Descending, 25);
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 250];
    private ListToolbarState<EmployeeListSort> ToolbarState => new(Search, currentSort, Size);
    private IReadOnlyList<ListToolbarOption<EmployeeListSort>> SortOptions =>
        Enum.GetValues<EmployeeListSort>()
            .Select(option => new ListToolbarOption<EmployeeListSort>(option, Text[option.ToString()]))
            .ToArray();
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Employees"]),
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        currentSort = Enum.TryParse<EmployeeListSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : EmployeeListSort.EmployeeId_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<EmployeeListSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? ToolbarState).Normalize();
        tableState.Clear();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/employees?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<EmployeeListPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private Task HandleToolbarRequestAsync(ListToolbarRequest<EmployeeListSort> request)
    {
        var state = request.State.Normalize();
        if (request.Reason == ListToolbarChangeReason.Refreshed && state == ToolbarState.Normalize())
        {
            return LoadAsync();
        }

        return NavigateAsync(1, state.Search, state.Sort, state.PageSize, replace: true);
    }

    private Task NavigateAsync(int index, string? search, EmployeeListSort sort, int size, bool replace = false)
    {
        tableState.Clear();
        var uri = $"/Employees/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}";
        Navigation.NavigateTo(uri, replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
