@page "/Employees/View"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<EmployeeView> Text

<PageTitle>@(detail is null ? Text["PageTitle"] : Text["EmployeePageTitle", detail.FullName])</PageTitle>

<main class="employee-detail">
    @if (loading)
    {
        <div class="employee-detail__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="@(notFound ? ShadcnAlertVariant.Default : ShadcnAlertVariant.Destructive)" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        <div class="employee-detail__actions">
            @if (!notFound)
            {
                <ShadcnButton OnClick="LoadAsync">@Text["Retry"]</ShadcnButton>
            }
            <LegacyLink Href="/Employees/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["BackToEmployees"]">@Text["BackToEmployees"]</LegacyLink>
        </div>
    }
    else if (detail is not null)
    {
        <header class="operations-page-header"><div><h1>@detail.FullName</h1><p>@Text["EmployeeNumber", detail.Id]</p></div></header>
        <section class="employee-detail__card" aria-label="@Text["EmployeePageTitle", detail.FullName]">
            <dl class="details">
                <dt>@Text["Email"]</dt>
                <dd>@detail.Email</dd>
                <dt>@Text["PhoneNumber"]</dt>
                <dd>@ValueOrFallback(detail.PhoneNumber)</dd>
                <dt>@Text["DateOfBirth"]</dt>
                <dd>@FormatDate(detail.DateOfBirth)</dd>
                <dt>@Text["Role"]</dt>
                <dd>@ValueOrFallback(detail.Role?.Name)</dd>
                <dt>@Text["Address"]</dt>
                <dd>@ValueOrFallback(detail.HomeAddress?.AddressLine1)</dd>
            </dl>
        </section>
        <LegacyLink Href="/Employees/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["BackToEmployees"]" Class="employee-detail__back">@Text["BackToEmployees"]</LegacyLink>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int Id { get; set; }

    private EmployeeDetail? detail;
    private string? error;
    private bool loading;
    private bool notFound;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        detail = null;
        error = null;
        notFound = false;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/employees/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                notFound = true;
                error = Text["NotFound"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                error = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            detail = await response.Content.ReadFromJsonAsync<EmployeeDetail>();
            if (detail is null || detail.Id != Id)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotProvided"] : value;

    private string FormatDate(DateTime? value) =>
        LegacyPresentation.FormatCalendarDate(value, System.Globalization.CultureInfo.CurrentCulture, Text["NotProvided"]);
}
