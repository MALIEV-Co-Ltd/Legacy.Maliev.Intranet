@page "/Employees/ResetPassword"
@attribute [AllowAnonymous]
@inject HttpClient Http
@inject IStringLocalizer<EmployeeResetPassword> Text
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="employee-recovery">
    <section class="employee-recovery__card" aria-labelledby="employee-reset-password-heading">
        <h1 id="employee-reset-password-heading">@Text["Heading"]</h1>
        <p class="employee-recovery__introduction">@Text["Introduction"]</p>

        @if (!HasValidAction)
        {
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@Text["InvalidLink"]</ShadcnAlertDescription></ShadcnAlert>
            <LegacyLink Href="/Employees/ForgotPassword" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["RequestNewLink"]" Class="employee-recovery__link">@Text["RequestNewLink"]</LegacyLink>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(notice))
            {
                <ShadcnAlert Variant="@noticeVariant" AlertRole="@NoticeRole"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert>
            }
            @if (submitting)
            {
                <div class="employee-recovery__progress" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Processing"]" Size="1.25rem" /><span>@Text["Processing"]</span></div>
            }
            <EditForm Model="@formModel" OnSubmit="SubmitAsync" Class="employee-recovery__form">
                <ShadcnFormField Id="employee-reset-password" Label="@Text["Password"]" Error="@passwordError" Required="true" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-reset-password" Type="password" @bind-Value="formModel.Password" autocomplete="new-password" Required="true" Disabled="@submitting" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-reset-confirm-password" Label="@Text["ConfirmPassword"]" Error="@confirmPasswordError" Required="true" Disabled="@submitting"><Control><ShadcnInput TValue="string" id="employee-reset-confirm-password" Type="password" @bind-Value="formModel.ConfirmPassword" autocomplete="new-password" Required="true" Disabled="@submitting" /></Control></ShadcnFormField>
                <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting" Class="employee-recovery__primary">@Text["Submit"]</ShadcnButton>
            </EditForm>
            @if (completed)
            {
                <LegacyLink Href="/Login" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["SignIn"]" Class="employee-recovery__link">@Text["SignIn"]</LegacyLink>
            }
        }
    </section>
</main>

@code {
    private readonly ResetPasswordForm formModel = new();
    private bool submitting;
    private bool completed;
    private string? passwordError;
    private string? confirmPasswordError;
    private string? notice;
    private ShadcnAlertVariant noticeVariant = ShadcnAlertVariant.Default;
    private ShadcnAlertRole NoticeRole => noticeVariant == ShadcnAlertVariant.Destructive ? ShadcnAlertRole.Alert : ShadcnAlertRole.Status;

    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private bool HasValidAction => !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);

    private async Task SubmitAsync()
    {
        if (submitting || completed || !HasValidAction) return;
        passwordError = string.IsNullOrWhiteSpace(formModel.Password) ? Text["PasswordRequired"].Value : null;
        confirmPasswordError = string.IsNullOrWhiteSpace(formModel.ConfirmPassword) ? Text["ConfirmPasswordRequired"].Value : null;
        if (passwordError is not null || confirmPasswordError is not null) return;
        if (!string.Equals(formModel.Password, formModel.ConfirmPassword, StringComparison.Ordinal))
        {
            confirmPasswordError = Text["Mismatch"];
            return;
        }

        submitting = true;
        notice = null;
        var submittedPassword = formModel.Password;
        formModel.Password = string.Empty;
        formModel.ConfirmPassword = string.Empty;
        try
        {
            var csrf = await GetCsrfAsync();
            if (csrf is null) { ShowError(Text["Unavailable"]); return; }
            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/employee-recovery/password-reset/complete")
            {
                Content = JsonContent.Create(new EmployeePasswordResetRequest(Email!, Token!, submittedPassword, submittedPassword)),
            };
            request.Headers.Add("X-CSRF-TOKEN", csrf);
            using var response = await Http.SendAsync(request);
            submittedPassword = string.Empty;
            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                completed = true;
                noticeVariant = ShadcnAlertVariant.Default;
                notice = Text["Completed"];
                return;
            }

            ShowError(response.StatusCode switch
            {
                HttpStatusCode.BadRequest => Text["InvalidLink"],
                HttpStatusCode.TooManyRequests => Text["RateLimited"],
                _ => Text["Unavailable"],
            });
        }
        catch (Exception exception) when (
            exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            ShowError(Text["Unavailable"]);
        }
        finally
        {
            submittedPassword = string.Empty;
            submitting = false;
        }
    }

    private async Task<string?> GetCsrfAsync()
    {
        using var response = await Http.GetForPresentationAsync("/bff/session");
        if (!response.IsSuccessStatusCode) return null;
        return (await response.Content.ReadFromJsonAsync<EmployeeSessionSummary>())?.CsrfToken;
    }

    private void ShowError(string message)
    {
        noticeVariant = ShadcnAlertVariant.Destructive;
        notice = message;
    }

    private sealed class ResetPasswordForm
    {
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
