@page "/Employees/Create"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<EmployeeCreate> Text
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="employee-create">
    <header class="operations-page-header"><div><h1>@Text["CreateEmployee"]</h1><p>@Text["ProfileAndAccount"]</p></div></header>
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert" Class="employee-create__alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="HandleInvalidSubmit" Class="employee-create__form">
        <DataAnnotationsValidator />
        <section class="employee-create__section" aria-labelledby="employee-account-heading">
            <h2 id="employee-account-heading">@Text["AccountDetails"]</h2>
            <div class="employee-create__grid">
                <ShadcnFormField Id="employee-create-first-name" Label="@Text["FirstName"]" Error="@ValidationFor(() => model.FirstName)" Required="true"><Control><ShadcnInput TValue="string" id="employee-create-first-name" @bind-Value="model.FirstName" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-create-last-name" Label="@Text["LastName"]" Error="@ValidationFor(() => model.LastName)" Required="true"><Control><ShadcnInput TValue="string" id="employee-create-last-name" @bind-Value="model.LastName" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-create-email" Label="@Text["Email"]" Error="@ValidationFor(() => model.Email)" Required="true" Class="employee-create__span"><Control><ShadcnInput TValue="string" id="employee-create-email" Type="email" @bind-Value="model.Email" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-create-password" Label="@Text["Password"]" Error="@ValidationFor(() => model.Password)" Required="true"><Control><ShadcnInput TValue="string" id="employee-create-password" Type="password" autocomplete="new-password" @bind-Value="model.Password" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-create-confirm-password" Label="@Text["ConfirmPassword"]" Error="@ValidationFor(() => model.ConfirmPassword)" Required="true"><Control><ShadcnInput TValue="string" id="employee-create-confirm-password" Type="password" autocomplete="new-password" @bind-Value="model.ConfirmPassword" Required="true" /></Control></ShadcnFormField>
                <p class="employee-create__privacy employee-create__span">@Text["PasswordPrivacy"]</p>
            </div>
        </section>
        <section class="employee-create__section" aria-labelledby="employee-work-heading">
            <h2 id="employee-work-heading">@Text["EmploymentDetails"]</h2>
            <div class="employee-create__grid">
                <ShadcnFormField Id="employee-create-phone" Label="@Text["PhoneNumber"]" Error="@ValidationFor(() => model.PhoneNumber)" Class="employee-create__span"><Control><ShadcnInput TValue="string" id="employee-create-phone" Type="tel" @bind-Value="model.PhoneNumber" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-create-role" Label="@Text["RoleId"]" Error="@ValidationFor(() => model.RoleId)"><Control><ShadcnInput TValue="int?" id="employee-create-role" Type="number" min="1" @bind-Value="model.RoleId" /></Control></ShadcnFormField>
                <ShadcnFormField Id="employee-create-date-of-birth" Label="@Text["DateOfBirth"]"><Control><ShadcnDatePicker id="employee-create-date-of-birth" @bind-Value="DateOfBirth" Clearable="true" CalendarLabel="@Text["DateOfBirth"]" /></Control></ShadcnFormField>
            </div>
        </section>
        <div class="employee-create__actions">
            <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">
                @(submitting ? Text["Submitting"] : Text["CreateEmployee"])
            </ShadcnButton>
            <LegacyLink Href="/Employees/Index" Role="LegacyLinkRole.Navigation" Disabled="@submitting" AriaLabel="@Text["Cancel"]">@Text["Cancel"]</LegacyLink>
        </div>
    </EditForm>
</main>

@code {
    private readonly CreateEmployeeAccountRequest model = new();
    private EditContext editContext = null!;
    private bool submitting;
    private string? error;

    protected override void OnInitialized() => editContext = new EditContext(model);

    private DateOnly? DateOfBirth
    {
        get => model.DateOfBirth is DateTime date ? DateOnly.FromDateTime(date) : null;
        set => model.DateOfBirth = value?.ToDateTime(TimeOnly.MinValue);
    }

    private string? ValidationFor<TValue>(Expression<Func<TValue>> expression) =>
        editContext.GetValidationMessages(FieldIdentifier.Create(expression)).FirstOrDefault();

    private void HandleInvalidSubmit(EditContext _) => error = Text["ValidationFailed"];

    private async Task SubmitAsync()
    {
        if (submitting) return;

        submitting = true;
        error = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { error = Text["CreateFailed"]; return; }

            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/employees") { Content = JsonContent.Create(model) };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { error = Text["Forbidden"]; return; }
            if (response.StatusCode == HttpStatusCode.BadRequest) { error = Text["ValidationFailed"]; return; }
            if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { error = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { error = Text["CreateFailed"]; return; }

            var created = await response.Content.ReadFromJsonAsync<CreatedEmployeeAccount>();
            if (created is null || created.Id <= 0) { error = Text["InvalidResponse"]; return; }
            Navigation.NavigateTo($"/Employees/View?id={created.Id}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["CreateFailed"];
        }
        finally { submitting = false; }
    }

    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
