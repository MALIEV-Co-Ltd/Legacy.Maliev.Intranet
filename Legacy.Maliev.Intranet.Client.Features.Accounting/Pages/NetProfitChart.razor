@page "/Finances/NetProfitChart"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<NetProfitChart> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <div class="operations-page-header d-flex flex-wrap align-center justify-space-between gap-3 mb-4">
        <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Title", Year]</MudText>
        <MudButton Href="/Finances/Index" Variant="Variant.Outlined">@Text["Back"]</MudButton>
    </div>

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" />
            <span class="visually-hidden">@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (chartData is null || chartData.Labels.Length == 0)
    {
        <MudAlert Severity="Severity.Info" aria-live="polite">@Text["NoData", Year]</MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12">
                <section aria-labelledby="cumulative-income-heading">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText id="cumulative-income-heading" Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["Cumulative"]</MudText>
                        <div aria-hidden="true">
                            <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@cumulativeSeries" ChartLabels="@chartData.Labels" Width="100%" Height="360px" />
                        </div>
                    </MudPaper>
                </section>
            </MudItem>
            <MudItem xs="12">
                <section aria-labelledby="daily-income-heading">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText id="daily-income-heading" Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["Daily"]</MudText>
                        <div aria-hidden="true">
                            <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@dailySeries" ChartLabels="@chartData.Labels" Width="100%" Height="360px" />
                        </div>
                    </MudPaper>
                </section>
            </MudItem>
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["TableHeading", Year]</MudText>
                    <MudTable Items="IncomeRows" Breakpoint="Breakpoint.Sm" Elevation="0" aria-label="@Text["TableLabel", Year]">
                        <HeaderContent>
                            <MudTh>@Text["Date"]</MudTh>
                            <MudTh>@Text["DailyThb"]</MudTh>
                            <MudTh>@Text["CumulativeThb"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@Text["Date"]">@context.Date</MudTd>
                            <MudTd DataLabel="@Text["DailyThb"]">@FormatThb(context.Daily)</MudTd>
                            <MudTd DataLabel="@Text["CumulativeThb"]">@FormatThb(context.Cumulative)</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "year")] public int? RequestedYear { get; set; }

    private int Year { get; set; }
    private FinanceNetIncomeChartData? chartData;
    private List<ChartSeries<double>> cumulativeSeries = [];
    private List<ChartSeries<double>> dailySeries = [];
    private bool loading;
    private string? error;

    private static int BangkokYear => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "Asia/Bangkok").Year;
    private IReadOnlyList<IncomeRow> IncomeRows => chartData is null
        ? []
        : chartData.Labels.Select((date, index) => new IncomeRow(
            date,
            chartData.DailyAmounts[index],
            chartData.CumulativeAmounts[index])).ToArray();

    private static string FormatThb(double value) => $"{value:N2} THB";

    protected override async Task OnParametersSetAsync()
    {
        Year = Math.Clamp(RequestedYear ?? BangkokYear, 1900, BangkokYear + 1);
        loading = true;
        error = null;
        try
        {
            var trend = await FinanceChartDataClient.LoadAsync(Http, Year, includeExpense: false);
            chartData = FinanceChartSeries.BuildNetIncome(trend.Income);
            cumulativeSeries = [new ChartSeries<double> { Name = Text["NetIncome"], Data = chartData.CumulativeAmounts }];
            dailySeries = [new ChartSeries<double> { Name = Text["Amount"], Data = chartData.DailyAmounts }];
        }
        catch (FinanceChartDataException exception)
        {
            HandleFailure(exception.StatusCode);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private void HandleFailure(HttpStatusCode? statusCode)
    {
        if (statusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
            return;
        }

        error = statusCode switch
        {
            HttpStatusCode.Forbidden => Text["Forbidden"],
            HttpStatusCode.TooManyRequests => Text["RateLimited"],
            HttpStatusCode.BadGateway => Text["InvalidResponse"],
            _ => Text["Unavailable"],
        };
    }

    private sealed record IncomeRow(string Date, double Daily, double Cumulative);
}
