@page "/Finances/NetProfitChart"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<NetProfitChart> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="finance-chart-page">
    <div class="operations-page-header">
        <h1>@Text["Title", Year]</h1>
        <LegacyLink Href="/Finances/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
    </div>

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else if (chartData is null || chartData.Labels.Length == 0)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["NoData", Year]</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        <div class="finance-chart-grid">
            <section class="finance-chart-card">
                <ShadcnChart Id="cumulative-income" Type="ShadcnChartType.Line" Title="@Text["Cumulative"]" CategoryLabel="@Text["Date"]" Config="@cumulativeConfig" Categories="@chartData.Labels" Series="@cumulativeSeries" ShowGrid="true" ShowMajorGrid="true" ShowLegend="true" InitialWidth="960" InitialHeight="360" ValueFormatter="@FormatThb" />
            </section>
            <section class="finance-chart-card">
                <ShadcnChart Id="daily-income" Type="ShadcnChartType.Bar" Title="@Text["Daily"]" CategoryLabel="@Text["Date"]" Config="@dailyConfig" Categories="@chartData.Labels" Series="@dailySeries" ShowGrid="true" ShowMajorGrid="true" ShowLegend="true" InitialWidth="960" InitialHeight="360" ValueFormatter="@FormatThb" />
            </section>
            <section class="finance-chart-card finance-chart-table" aria-labelledby="income-table-heading">
                <h2 id="income-table-heading">@Text["TableHeading", Year]</h2>
                <ShadcnTable ExpectedColumnCount="3" aria-label="@Text["TableLabel", Year]">
                    <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Date"]</ShadcnTableHead><ShadcnTableHead>@Text["DailyThb"]</ShadcnTableHead><ShadcnTableHead>@Text["CumulativeThb"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                    <ShadcnTableBody>
                        @foreach (var row in IncomeRows)
                        {
                            <ShadcnTableRow><ShadcnTableCell data-label="@Text["Date"]">@row.Date</ShadcnTableCell><ShadcnTableCell data-label="@Text["DailyThb"]">@FormatThb(row.Daily)</ShadcnTableCell><ShadcnTableCell data-label="@Text["CumulativeThb"]">@FormatThb(row.Cumulative)</ShadcnTableCell></ShadcnTableRow>
                        }
                    </ShadcnTableBody>
                </ShadcnTable>
            </section>
        </div>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "year")] public int? RequestedYear { get; set; }

    private int Year { get; set; }
    private FinanceNetIncomeChartData? chartData;
    private IReadOnlyList<ShadcnChartSeries> cumulativeSeries = [];
    private IReadOnlyList<ShadcnChartSeries> dailySeries = [];
    private ShadcnChartConfig cumulativeConfig => new() { ["net-income"] = new(Text["NetIncome"]) { Color = "var(--shadcn-chart-2)" } };
    private ShadcnChartConfig dailyConfig => new() { ["amount"] = new(Text["Amount"]) { Color = "var(--shadcn-chart-1)" } };
    private bool loading;
    private string? error;

    private static int BangkokYear => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "Asia/Bangkok").Year;
    private IReadOnlyList<IncomeRow> IncomeRows => chartData is null
        ? []
        : chartData.Labels.Select((date, index) => new IncomeRow(
            date,
            chartData.DailyAmounts[index],
            chartData.CumulativeAmounts[index])).ToArray();

    private static string FormatThb(double value) => $"{value:N2} THB";

    protected override async Task OnParametersSetAsync()
    {
        Year = Math.Clamp(RequestedYear ?? BangkokYear, 1900, BangkokYear + 1);
        loading = true;
        error = null;
        try
        {
            var trend = await FinanceChartDataClient.LoadAsync(Http, Year, includeExpense: false);
            chartData = FinanceChartSeries.BuildNetIncome(trend.Income);
            cumulativeSeries = [new ShadcnChartSeries("net-income", NullableValues(chartData.CumulativeAmounts))];
            dailySeries = [new ShadcnChartSeries("amount", NullableValues(chartData.DailyAmounts))];
        }
        catch (FinanceChartDataException exception)
        {
            HandleFailure(exception.StatusCode);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private static double?[] NullableValues(IEnumerable<double> values) => values.Select(value => (double?)value).ToArray();

    private void HandleFailure(HttpStatusCode? statusCode)
    {
        if (statusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
            return;
        }

        error = statusCode switch
        {
            HttpStatusCode.Forbidden => Text["Forbidden"],
            HttpStatusCode.TooManyRequests => Text["RateLimited"],
            HttpStatusCode.BadGateway => Text["InvalidResponse"],
            _ => Text["Unavailable"],
        };
    }

    private sealed record IncomeRow(string Date, double Daily, double Cumulative);
}
