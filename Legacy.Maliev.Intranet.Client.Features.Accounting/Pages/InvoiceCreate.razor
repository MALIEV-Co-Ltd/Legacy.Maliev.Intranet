@page "/Invoices/Create"
@page "/accounting/new"
@using System.ComponentModel.DataAnnotations
@using Microsoft.JSInterop
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<InvoiceCreate> Text
@inject IJSRuntime JS

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="invoice-editor">
    <div class="operations-page-header"><h1>@Text["Heading"]</h1>@if (pendingRequest is null || reloadBlocked) { <LegacyLink Href="/Invoices/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink> } else { <span aria-disabled="true">@Text["Back"]</span> }</div>
    @if (!string.IsNullOrWhiteSpace(error)) { <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert> }
    @if (pendingRequest is not null && !ReceiptLocked) { <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["PendingRetry"]</ShadcnAlertDescription></ShadcnAlert> }
    @if (ReceiptLocked)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@receiptNotice</ShadcnAlertDescription></ShadcnAlert>
    }
    @if (knownInvoiceId is not null)
    {
        <LegacyLink Href="@($"/Invoices/View?id={knownInvoiceId}")" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["OpenExistingInvoice"]">@Text["OpenExistingInvoice"]</LegacyLink>
    }
    @if (reloadBlocked) { <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@Text["ReloadReconciliationRequired"]</ShadcnAlertDescription></ShadcnAlert> }

    <section class="invoice-editor__section" aria-labelledby="quotation-heading">
        <h2 id="quotation-heading">@Text["Quotation"]</h2>
        <div class="invoice-editor__lookup">
            <AccountingInputField TValue="int" Id="invoice-quotation" Label="@Text["QuotationId"]" Type="number" InputMode="numeric" Min="1" Value="@quotationId" ValueChanged="@(value => quotationId = value)" Disabled="@(loading || IntentLocked)" />
            <ShadcnButton OnClick="LoadPreviewAsync" Disabled="@(loading || IntentLocked || quotationId <= 0)">@(loading ? Text["Loading"] : Text["LoadQuotation"])</ShadcnButton>
        </div>
        @if (loading) { <div role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div> }
    </section>

    @if (preview is not null)
    {
        <EditForm EditContext="@editContext" OnValidSubmit="CreateAsync" class="invoice-editor__form">
            <DataAnnotationsValidator />
            <section class="invoice-editor__section" aria-labelledby="invoice-data-heading">
                <h2 id="invoice-data-heading">@Text["InvoiceData"]</h2>
                <div class="invoice-editor__grid invoice-editor__grid--three">
                    <AccountingInputField TValue="string" Id="invoice-number" Label="@Text["InvoiceNumber"]" @bind-Value="model.InvoiceNumber" Required="true" MaxLength="100" Disabled="@IntentLocked" />
                    <div class="invoice-editor__readout"><span>@Text["CustomerId"]</span><strong>@preview.CustomerId</strong></div>
                    <div class="invoice-editor__readout"><span>@Text["SalesPerson"]</span><strong>@preview.SalesPerson</strong></div>
                    <AccountingInputField TValue="string" Id="invoice-purchase-order" Label="@Text["PurchaseOrderNumber"]" @bind-Value="model.PurchaseOrderNumber" MaxLength="250" Disabled="@IntentLocked" />
                    <AccountingInputField TValue="string" Id="invoice-requisitioner" Label="@Text["Requisitioner"]" @bind-Value="model.Requisitioner" MaxLength="250" Disabled="@IntentLocked" />
                    <AccountingInputField TValue="string" Id="invoice-shipped-via" Label="@Text["ShippedVia"]" @bind-Value="model.ShippedVia" MaxLength="250" Disabled="@IntentLocked" />
                    <AccountingInputField TValue="string" Id="invoice-fob" Label="@Text["Fob"]" @bind-Value="model.Fob" MaxLength="250" Disabled="@IntentLocked" />
                    <AccountingInputField TValue="string" Id="invoice-terms" Label="@Text["Terms"]" @bind-Value="model.Terms" MaxLength="250" Disabled="@IntentLocked" />
                    <div class="invoice-editor__readout"><span>@Text["Currency"]</span><strong>@preview.Currency</strong></div>
                    <AccountingInputField TValue="string" Id="invoice-tax-id" Label="@Text["TaxIdentification"]" @bind-Value="model.TaxIdentification" MaxLength="250" Disabled="@IntentLocked" />
                    <AccountingInputField TValue="string" Id="invoice-registration" Label="@Text["CommercialRegistration"]" @bind-Value="model.CommercialRegistration" MaxLength="250" Disabled="@IntentLocked" />
                </div>
            </section>
            <div class="invoice-editor__addresses">@AddressSection("billing", Text["Billing"], model.BillingAddress, false)@AddressSection("shipping", Text["Shipping"], model.ShippingAddress, true)</div>
            <section class="invoice-editor__section" aria-labelledby="order-items-heading">
                <h2 id="order-items-heading">@Text["OrderItems"]</h2>
                <ShadcnTable ExpectedColumnCount="4" aria-label="@Text["OrderItemsTable"]">
                    <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Description"]</ShadcnTableHead><ShadcnTableHead>@Text["UnitPrice"]</ShadcnTableHead><ShadcnTableHead>@Text["Quantity"]</ShadcnTableHead><ShadcnTableHead>@Text["Subtotal"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                    <ShadcnTableBody>@foreach (var item in preview.OrderItems) { <ShadcnTableRow><ShadcnTableCell data-label="@Text["Description"]">@item.Description</ShadcnTableCell><ShadcnTableCell data-label="@Text["UnitPrice"]">@Money(item.UnitPrice)</ShadcnTableCell><ShadcnTableCell data-label="@Text["Quantity"]">@item.Quantity</ShadcnTableCell><ShadcnTableCell data-label="@Text["Subtotal"]">@Money(item.Subtotal)</ShadcnTableCell></ShadcnTableRow> }</ShadcnTableBody>
                </ShadcnTable>
            </section>
            <section class="invoice-editor__section invoice-editor__summary">
                <div><ShadcnFormField Id="invoice-comment" Label="@Text["Comment"]"><Control><ShadcnTextarea TValue="string" id="invoice-comment" @bind-Value="model.Comment" maxlength="2000" rows="7" Disabled="@IntentLocked" /></Control></ShadcnFormField></div>
                <div>
                    <dl class="invoice-editor__totals"><div><dt>@Text["Subtotal"]</dt><dd>@Money(preview.Subtotal)</dd></div><div><dt>@Text["Vat"]</dt><dd>@Money(preview.Vat)</dd></div><div><dt>@Text["Total"]</dt><dd>@Money(preview.Total)</dd></div><div><dt>@Text["WithholdingTax"]</dt><dd>@Money(model.DeductWithholdingTax ? preview.AvailableWithholdingTax : 0m)</dd></div><div><dt>@Text["Outstanding"]</dt><dd>@Money(Outstanding)</dd></div></dl>
                    <div class="invoice-editor__checks"><AccountingCheckboxField Id="invoice-withholding" Label="@Text["DeductWithholdingTax"]" @bind-Value="model.DeductWithholdingTax" Disabled="@IntentLocked" /><AccountingCheckboxField Id="invoice-email" Label="@Text["SendEmail"]" @bind-Value="model.SendEmail" Disabled="@IntentLocked" /></div>
                </div>
            </section>
            <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@(submitting || !storageChecked || reloadBlocked || ReceiptLocked)" Class="invoice-editor__submit">@(submitting ? Text["Creating"] : pendingRequest is not null && !ReceiptLocked ? Text["RetryOriginal"] : Text["Create"])</ShadcnButton>
        </EditForm>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "quotationId")] public int? QuotationIdInput { get; set; }
    private EmployeeSessionSummary? session;
    private InvoiceCreationPreview? preview;
    private CreateModel model = new();
    private EditContext editContext = null!;
    private int quotationId;
    private bool loading;
    private bool submitting;
    private bool storageChecked;
    private bool reloadBlocked;
    private string? error;
    private int? knownInvoiceId;
    private string? receiptNotice;
    private bool ambiguousInvoiceReference;
    private bool ReceiptLocked => knownInvoiceId is not null || ambiguousInvoiceReference;
    private const string UnresolvedStorageKey = "maliev-invoice-create-unresolved";
    private const string ProviderAcceptedStorageKey = "maliev-invoice-create-provider-accepted";
    private Guid operationId;
    private CreateInvoiceFromQuotationRequest? pendingRequest;
    private decimal Outstanding => preview is null ? 0m : preview.Total - (model.DeductWithholdingTax ? preview.AvailableWithholdingTax : 0m);
    private bool IntentLocked => submitting || pendingRequest is not null || !storageChecked || reloadBlocked || ReceiptLocked;

    protected override async Task OnInitializedAsync()
    {
        try { session = await Http.GetFromJsonForPresentationAsync<EmployeeSessionSummary>("/bff/session"); }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        if (QuotationIdInput is > 0) { quotationId = QuotationIdInput.Value; await LoadPreviewAsync(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            reloadBlocked = await JS.InvokeAsync<string?>("sessionStorage.getItem", UnresolvedStorageKey) is not null;
            var savedReceipt = await JS.InvokeAsync<string?>("sessionStorage.getItem", ProviderAcceptedStorageKey);
            if (savedReceipt is not null) reloadBlocked = !RestoreProviderAcceptedReceipt(savedReceipt);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException) { reloadBlocked = true; }
        storageChecked = true;
        StateHasChanged();
    }

    private async Task LoadPreviewAsync()
    {
        if (quotationId <= 0 || submitting || pendingRequest is not null || ReceiptLocked) return;
        loading = true; error = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/invoices/from-quotation/{quotationId}/preview");
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); preview = null; return; }
            preview = await response.Content.ReadFromJsonAsync<InvoiceCreationPreview>();
            if (preview is null) { error = Text["InvalidResponse"]; return; }
            model = CreateModel.From(preview);
            editContext = new EditContext(model);
            operationId = Guid.Empty;
            pendingRequest = null;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }

    private async Task CreateAsync()
    {
        if (session?.CsrfToken is null || preview is null || submitting || !storageChecked || reloadBlocked || ReceiptLocked) return;
        var retryingOriginal = pendingRequest is not null;
        submitting = true; error = null;
        try
        {
            pendingRequest ??= model.ToRequest();
            if (operationId == Guid.Empty) operationId = Guid.NewGuid();
            try { await JS.InvokeVoidAsync("sessionStorage.setItem", UnresolvedStorageKey, "1"); }
            catch (Exception exception) when (exception is JSException or InvalidOperationException)
            {
                reloadBlocked = true;
                return;
            }
            using var request = new HttpRequestMessage(HttpMethod.Post, $"/bff/invoices/from-quotation/{preview.QuotationId}") { Content = JsonContent.Create(pendingRequest) };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            request.Headers.Add("Idempotency-Key", operationId.ToString("D"));
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode)
            {
                var uncertain = (int)response.StatusCode >= 500 || response.StatusCode is HttpStatusCode.RequestTimeout;
                error = uncertain || retryingOriginal ? Text["RetrySafe"] : ErrorFor(response.StatusCode);
                if (!uncertain && !retryingOriginal)
                {
                    if (!await ClearUnresolvedAsync()) return;
                    pendingRequest = null; operationId = Guid.Empty;
                }
                return;
            }
            using var receipt = await System.Text.Json.JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            if (ReceiptPropertyCount(receipt.RootElement, "invoiceId") > 1)
            {
                ambiguousInvoiceReference = true;
                receiptNotice = Text["AmbiguousInvoiceReceipt"];
                return;
            }
            if (!TryReceiptNumber(receipt.RootElement, "invoiceId", out var invoiceId) || invoiceId <= 0) { error = Text["InvalidResponse"]; return; }
            knownInvoiceId = invoiceId;
            receiptNotice = Text["UnconfirmedReceipt"];
            if (!TryReceiptNumber(receipt.RootElement, "state", out var state) || state is not (0 or 1)
                || !TryReceiptNumber(receipt.RootElement, "emailState", out var emailState) || emailState is not (0 or 1 or 2 or 3))
            {
                receiptNotice = Text["UnconfirmedReceipt"];
                return;
            }
            if (emailState == 2)
            {
                receiptNotice = Text["EmailReconciliationRequired"];
                return;
            }
            if (emailState == 3)
            {
                receiptNotice = Text["ProviderAcceptedReceipt"];
                try
                {
                    await JS.InvokeVoidAsync("sessionStorage.setItem", ProviderAcceptedStorageKey,
                        System.Text.Json.JsonSerializer.Serialize(new { invoiceId, quotationId = preview.QuotationId }));
                }
                catch (Exception exception) when (exception is JSException or InvalidOperationException) { reloadBlocked = true; }
                return;
            }
            if (!await ClearUnresolvedAsync()) return;
            Navigation.NavigateTo($"/Invoices/View?id={invoiceId}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["RetrySafe"]; }
        finally { submitting = false; }
    }

    private static bool TryReceiptNumber(System.Text.Json.JsonElement receipt, string name, out int value)
    {
        value = 0;
        return receipt.ValueKind == System.Text.Json.JsonValueKind.Object
            && ReceiptPropertyCount(receipt, name) == 1
            && receipt.TryGetProperty(name, out var property)
            && property.ValueKind == System.Text.Json.JsonValueKind.Number
            && property.TryGetInt32(out value);
    }

    private bool RestoreProviderAcceptedReceipt(string savedReceipt)
    {
        // This bounded tab history prevents another create; it is not server-status authentication.
        if (savedReceipt.Length > 128) return false;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(savedReceipt);
            var receipt = document.RootElement;
            if (receipt.ValueKind != System.Text.Json.JsonValueKind.Object || receipt.EnumerateObject().Count() != 2
                || !TryReceiptNumber(receipt, "invoiceId", out var invoiceId) || invoiceId <= 0
                || !TryReceiptNumber(receipt, "quotationId", out var savedQuotationId) || savedQuotationId <= 0 || savedQuotationId != quotationId)
            {
                return false;
            }
            knownInvoiceId = invoiceId;
            receiptNotice = Text["ProviderAcceptedReceipt"];
            return true;
        }
        catch (System.Text.Json.JsonException) { return false; }
    }

    private static int ReceiptPropertyCount(System.Text.Json.JsonElement receipt, string name) => receipt.ValueKind == System.Text.Json.JsonValueKind.Object
        ? receipt.EnumerateObject().Count(property => property.NameEquals(name)) : 0;

    private async Task<bool> ClearUnresolvedAsync()
    {
        try { await JS.InvokeVoidAsync("sessionStorage.removeItem", UnresolvedStorageKey); return true; }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            reloadBlocked = true;
            return false;
        }
    }

    private RenderFragment AddressSection(string id, string heading, AddressModel address, bool telephone) => @<section class="invoice-editor__section"><h2>@heading</h2><div class="invoice-editor__grid"><AccountingInputField TValue="string" Id="@($"{id}-recipient")" Label="@Text["Recipient"]" @bind-Value="address.Recipient" MaxLength="250" Disabled="@IntentLocked" />@if (telephone) { <AccountingInputField TValue="string" Id="@($"{id}-telephone")" Label="@Text["Telephone"]" @bind-Value="address.Telephone" MaxLength="250" Disabled="@IntentLocked" /> }<AccountingInputField TValue="string" Id="@($"{id}-company")" Label="@Text["Company"]" @bind-Value="address.Company" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-building")" Label="@Text["Building"]" @bind-Value="address.Building" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-line1")" Label="@Text["Line1"]" @bind-Value="address.Line1" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-line2")" Label="@Text["Line2"]" @bind-Value="address.Line2" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-city")" Label="@Text["City"]" @bind-Value="address.City" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-state")" Label="@Text["State"]" @bind-Value="address.State" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-postal")" Label="@Text["PostalCode"]" @bind-Value="address.PostalCode" MaxLength="250" Disabled="@IntentLocked" /><AccountingInputField TValue="string" Id="@($"{id}-country")" Label="@Text["Country"]" @bind-Value="address.Country" MaxLength="250" Disabled="@IntentLocked" /></div></section>;

    private string Money(decimal? value) => value is null ? "-" : $"{value:N2} {preview?.Currency}";
    private string ErrorFor(HttpStatusCode status) => status switch { HttpStatusCode.BadRequest => Text["InvalidRequest"], HttpStatusCode.Forbidden => Text["Forbidden"], HttpStatusCode.NotFound => Text["NotFound"], HttpStatusCode.Conflict => Text["Conflict"], HttpStatusCode.TooManyRequests => Text["RateLimited"], _ => Text["Unavailable"] };

    private sealed class CreateModel
    {
        [Required, MaxLength(100)] public string InvoiceNumber { get; set; } = string.Empty; public string? Comment { get; set; } public string? PurchaseOrderNumber { get; set; }
        public string? Requisitioner { get; set; } public string? ShippedVia { get; set; } public string? Fob { get; set; } public string? Terms { get; set; }
        public AddressModel BillingAddress { get; set; } = new(); public AddressModel ShippingAddress { get; set; } = new();
        public string? TaxIdentification { get; set; } public string? CommercialRegistration { get; set; } public bool DeductWithholdingTax { get; set; } = true; public bool SendEmail { get; set; } = true;
        public static CreateModel From(InvoiceCreationPreview value) => new() { InvoiceNumber = value.InvoiceNumber, Comment = value.Comment, ShippedVia = value.ShippedVia, Fob = value.Fob, Terms = value.Terms, BillingAddress = AddressModel.From(value.BillingAddress), ShippingAddress = AddressModel.From(value.ShippingAddress), TaxIdentification = value.TaxIdentification, CommercialRegistration = value.CommercialRegistration, DeductWithholdingTax = value.AvailableWithholdingTax > 0m };
        public CreateInvoiceFromQuotationRequest ToRequest() => new(InvoiceNumber, Comment, PurchaseOrderNumber, Requisitioner, ShippedVia, Fob, Terms, BillingAddress.ToContract(), ShippingAddress.ToContract(), TaxIdentification, CommercialRegistration, DeductWithholdingTax, SendEmail);
    }
    private sealed class AddressModel
    {
        public string? Recipient { get; set; } public string? Company { get; set; } public string? Building { get; set; } public string? Line1 { get; set; } public string? Line2 { get; set; }
        public string? City { get; set; } public string? State { get; set; } public string? PostalCode { get; set; } public string? Country { get; set; } public string? Telephone { get; set; }
        public static AddressModel From(InvoiceCreationAddress value) => new() { Recipient = value.Recipient, Company = value.Company, Building = value.Building, Line1 = value.Line1, Line2 = value.Line2, City = value.City, State = value.State, PostalCode = value.PostalCode, Country = value.Country, Telephone = value.Telephone };
        public InvoiceCreationAddress ToContract() => new(Recipient, Company, Building, Line1, Line2, City, State, PostalCode, Country, Telephone);
    }
}
