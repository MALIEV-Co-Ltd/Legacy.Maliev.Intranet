@page "/Finances/Index"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Finances> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="finance-index-page">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <div class="operations-page-header">
        <h1>@Text["Finance"]</h1>
        <div class="finance-actions" role="group" aria-label="@Text["FinanceActions"]">
            <ShadcnButton Href="/Finances/Create">@Text["Create"]</ShadcnButton>
            <ShadcnButton Href="/Finances/YearlyActivityChart" Variant="ShadcnButtonVariant.Outline">@Text["YearlyActivity"]</ShadcnButton>
            <ShadcnButton Href="@($"/Finances/NetProfitChart?year={BangkokYear}")" Variant="ShadcnButtonVariant.Outline">@Text["NetProfit"]</ShadcnButton>
        </div>
    </div>

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        <div class="finance-summary-grid">
            @foreach (var summary in SummaryCards)
            {
                <section class="finance-summary-card">
                        <h2>@summary.Title</h2>
                        @if (summary.Value.Details.Count == 0)
                        {
                            <p class="finance-muted">@Text["NoData"]</p>
                        }
                        else
                        {
                            @foreach (var detail in summary.Value.Details.Where(value => value.CurrentAmount != 0m))
                            {
                                <div class="finance-summary-detail">
                                    <span>@FormatAmount(detail.CurrentAmount, detail.CurrencyId)</span>
                                    <span class="@DeltaClass(detail.DeltaAmount)">@FormatDelta(detail)</span>
                                </div>
                            }
                        }
                </section>
            }
        </div>

        @if (TrendRows.Count > 0)
        {
            <section class="finance-trend" role="region" aria-labelledby="yearly-trend-heading">
                <h2 id="yearly-trend-heading">@Text["YearlyTrend"]</h2>
                @* OperationalTable exception: AnalyticalMonthlySummary. Comparison-oriented aggregate, not a record list. *@
                <ShadcnTable ExpectedColumnCount="4" aria-label="@Text["YearlyTrendTable"]">
                    <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Month"]</ShadcnTableHead><ShadcnTableHead>@Text["Income"]</ShadcnTableHead><ShadcnTableHead>@Text["Expense"]</ShadcnTableHead><ShadcnTableHead>@Text["Net"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                    <ShadcnTableBody>
                        @foreach (var row in TrendRows)
                        {
                            <ShadcnTableRow><ShadcnTableCell data-label="@Text["Month"]">@row.Month.ToString("Y", CultureInfo.CurrentCulture)</ShadcnTableCell><ShadcnTableCell data-label="@Text["Income"]">@FormatAmount(row.Income, thbCurrencyId?.ToString(CultureInfo.InvariantCulture))</ShadcnTableCell><ShadcnTableCell data-label="@Text["Expense"]">@FormatAmount(row.Expense, thbCurrencyId?.ToString(CultureInfo.InvariantCulture))</ShadcnTableCell><ShadcnTableCell data-label="@Text["Net"]">@FormatAmount(row.Income - row.Expense, thbCurrencyId?.ToString(CultureInfo.InvariantCulture))</ShadcnTableCell></ShadcnTableRow>
                        }
                    </ShadcnTableBody>
                </ShadcnTable>
            </section>
        }

        @if (Page is null)
        {
            <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["NoPayments"]</ShadcnAlertDescription></ShadcnAlert>
        }
        else
        {
            <OperationalDataTable TItem="FinancePaymentItem"
                              Items="@(Page.Items)"
                              Columns="@Columns"
                              RowKey="@(payment => payment.Id.ToString(CultureInfo.InvariantCulture))"
                              State="@dataTableState"
                              StateChanged="HandleDataTableStateChangedAsync"
                              RequestChanged="HandleDataTableRequestAsync"
                              TotalCount="@(Page.TotalRecords)"
                              FilterPlaceholder="@Text["Search"]"
                              EmptyText="@Text["NoPayments"]"
                              LoadingText="@Text["Loading"]"
                              ActionsLabel="@Text["Actions"]"
                              PageSizeOptions="@FinancePageSizes"
                              DetailHref="@(payment => $"/Finances/View?id={payment.Id}")"
                              DetailAriaLabel="@(payment => Text["ViewFinance", payment.Id])"
                              DetailsAriaLabel="@(payment => Text["ExpandFinance", payment.Id])">
                <QuickViewContent Context="payment"><dl class="operational-quick-view">
                    <div><dt>@Text["Description"]</dt><dd>@ValueOrFallback(payment.Description)</dd></div>
                    <div><dt>@Text["Method"]</dt><dd>@payment.PaymentMethodId</dd></div>
                    <div><dt>@Text["Recipient"]</dt><dd>@ValueOrFallback(payment.Recipient)</dd></div>
                    <div><dt>@Text["TransactionNumber"]</dt><dd class="mlv-mono">@ValueOrFallback(payment.TransactionNumber)</dd></div>
                </dl></QuickViewContent>
            </OperationalDataTable>
        }
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private FinancePaymentPage? Page { get; set; }
    private static readonly int[] FinancePageSizes = [10, 25, 50, 100];
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 25 };
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Accounting"], "/accounting"),
        new(Text["Finance"]),
    ];
    private FinanceSummary Weekly { get; set; } = new([]);
    private FinanceSummary Monthly { get; set; } = new([]);
    private FinanceSummary MonthlyJobIncome { get; set; } = new([]);
    private FinanceSummary Yearly { get; set; } = new([]);
    private IReadOnlyDictionary<int, string> currencies = new Dictionary<int, string>();
    private IReadOnlyDictionary<DateTime, decimal> yearlyIncome = new Dictionary<DateTime, decimal>();
    private IReadOnlyDictionary<DateTime, decimal> yearlyExpense = new Dictionary<DateTime, decimal>();
    private int? thbCurrencyId;
    private string? error;
    private bool loading;
    private FinancePaymentSort currentSort = FinancePaymentSort.PaymentCreatedDate_Descending;
    private static int BangkokYear => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "Asia/Bangkok").Year;
    private IReadOnlyList<ShadcnDataTableColumn<FinancePaymentItem>> Columns =>
    [
        new("id", Text["Id"], payment => payment.Id) { Sortable = true, Filterable = true, Hideable = false },
        new("direction", Text["Direction"], payment => payment.PaymentDirectionId) { Sortable = true, Filterable = true },
        new("type", Text["Type"], payment => payment.PaymentTypeId) { Sortable = true, Filterable = true },
        new("amount", Text["Amount"], payment => payment.Amount) { Alignment = ShadcnTableAlignment.End, CellTemplate = payment => builder => builder.AddContent(0, FormatAmount(payment.Amount, payment.CurrencyId?.ToString(CultureInfo.InvariantCulture))) },
        new("payment-date", Text["PaymentDate"], payment => payment.PaymentDate) { Sortable = true, CellTemplate = payment => builder => builder.AddContent(0, FormatDate(payment.PaymentDate)) },
        new("description", Text["Description"], payment => ValueOrFallback(payment.Description)) { Filterable = true, MinWidth = "14rem" },
        new("method", Text["Method"], payment => payment.PaymentMethodId) { Sortable = true, Filterable = true },
        new("recipient", Text["Recipient"], payment => ValueOrFallback(payment.Recipient)) { Sortable = true, Filterable = true },
        new("transaction", Text["TransactionNumber"], payment => ValueOrFallback(payment.TransactionNumber)) { Filterable = true },
        new("created", Text["PaymentCreatedDate_Descending"], payment => payment.CreatedDate) { Sortable = true },
    ];

    private IReadOnlyList<(string Title, FinanceSummary Value)> SummaryCards =>
    [
        (Text["ThisWeek"], Weekly),
        (Text["ThisMonth"], Monthly),
        (Text["ThisYear"], Yearly),
        (Text["JobEarning"], MonthlyJobIncome),
    ];

    private IReadOnlyList<FinanceTrendRow> TrendRows => yearlyIncome.Keys
        .Concat(yearlyExpense.Keys)
        .Distinct()
        .OrderByDescending(value => value)
        .Take(12)
        .Select(month => new FinanceTrendRow(
            month,
            yearlyIncome.GetValueOrDefault(month),
            yearlyExpense.GetValueOrDefault(month)))
        .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 100);
        currentSort = Enum.TryParse<FinancePaymentSort>(SortQuery, true, out var parsed)
            ? parsed
            : FinancePaymentSort.PaymentCreatedDate_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = requestGate.Begin();
        loading = true;
        error = null;
        HttpResponseMessage[]? responses = null;
        try
        {
            responses = await Task.WhenAll(
                Http.GetForPresentationAsync($"/bff/finances?sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={Index}&size={Size}", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/finances/summaries/weekly", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/finances/summaries/monthly", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/finances/summaries/monthly-job-income", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/finances/summaries/yearly", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/catalog/currencies", lease.CancellationToken));
            if (!lease.IsCurrent)
            {
                return;
            }
            if (HandleFailure(responses))
            {
                return;
            }

            var loadedPage = await responses[0].Content.ReadFromJsonAsync<FinancePaymentPage>(lease.CancellationToken);
            var loadedWeekly = await responses[1].Content.ReadFromJsonAsync<FinanceSummary>(lease.CancellationToken) ?? new([]);
            var loadedMonthly = await responses[2].Content.ReadFromJsonAsync<FinanceSummary>(lease.CancellationToken) ?? new([]);
            var loadedMonthlyJobIncome = await responses[3].Content.ReadFromJsonAsync<FinanceSummary>(lease.CancellationToken) ?? new([]);
            var loadedYearly = await responses[4].Content.ReadFromJsonAsync<FinanceSummary>(lease.CancellationToken) ?? new([]);
            var currencyItems = await responses[5].Content.ReadFromJsonAsync<List<CatalogCurrency>>(lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (loadedPage?.Items is null || currencyItems is null)
            {
                error = Text["InvalidResponse"];
                return;
            }

            var loadedCurrencies = currencyItems.ToDictionary(item => item.Id, item => item.ShortName);
            var loadedThbCurrencyId = currencyItems.FirstOrDefault(item => string.Equals(item.ShortName, "THB", StringComparison.OrdinalIgnoreCase))?.Id;
            var currencyQuery = loadedThbCurrencyId is int currencyId
                ? $"&currencyId={currencyId.ToString(CultureInfo.InvariantCulture)}"
                : string.Empty;
            using var incomeResponse = await Http.GetForPresentationAsync($"/bff/finances/trends/yearly-income?year={BangkokYear}{currencyQuery}", lease.CancellationToken);
            using var expenseResponse = await Http.GetForPresentationAsync($"/bff/finances/trends/yearly-expense?{currencyQuery.TrimStart('&')}", lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (HandleFailure([incomeResponse, expenseResponse]))
            {
                return;
            }

            var loadedYearlyIncome = await incomeResponse.Content.ReadFromJsonAsync<Dictionary<DateTime, decimal>>(lease.CancellationToken) ?? new();
            var loadedYearlyExpense = await expenseResponse.Content.ReadFromJsonAsync<Dictionary<DateTime, decimal>>(lease.CancellationToken) ?? new();
            if (!lease.IsCurrent)
            {
                return;
            }

            Page = loadedPage;
            Weekly = loadedWeekly;
            Monthly = loadedMonthly;
            MonthlyJobIncome = loadedMonthlyJobIncome;
            Yearly = loadedYearly;
            currencies = loadedCurrencies;
            thbCurrencyId = loadedThbCurrencyId;
            yearlyIncome = loadedYearlyIncome;
            yearlyExpense = loadedYearlyExpense;
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            if (responses is not null)
            {
                foreach (var response in responses)
                {
                    response.Dispose();
                }
            }

            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private bool HandleFailure(IEnumerable<HttpResponseMessage> responses)
    {
        var failed = responses.FirstOrDefault(response => !response.IsSuccessStatusCode);
        if (failed is null)
        {
            return false;
        }

        if (failed.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        }
        else
        {
            error = failed.StatusCode switch
            {
                HttpStatusCode.Forbidden => Text["Forbidden"],
                HttpStatusCode.TooManyRequests => Text["RateLimited"],
                HttpStatusCode.BadGateway => Text["InvalidResponse"],
                _ => Text["Unavailable"],
            };
        }

        return true;
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, FinancePaymentSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/Finances/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 100)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, Index - 1),
        PageSize = Size,
        HiddenColumnKeys = new HashSet<string>(["created"], StringComparer.Ordinal),
        Sorts = currentSort switch
        {
            FinancePaymentSort.PaymentId_Ascending => [new("id", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.PaymentId_Descending => [new("id", ShadcnSortDirection.Descending)],
            FinancePaymentSort.PaymentCreatedDate_Ascending => [new("created", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.PaymentCreatedDate_Descending => [new("created", ShadcnSortDirection.Descending)],
            FinancePaymentSort.PaymentDate_Ascending => [new("payment-date", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.PaymentDate_Descending => [new("payment-date", ShadcnSortDirection.Descending)],
            FinancePaymentSort.PaymentDirection_Ascending => [new("direction", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.PaymentDirection_Descending => [new("direction", ShadcnSortDirection.Descending)],
            FinancePaymentSort.PaymentType_Ascending => [new("type", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.PaymentType_Descending => [new("type", ShadcnSortDirection.Descending)],
            FinancePaymentSort.PaymentMethod_Ascending => [new("method", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.PaymentMethod_Descending => [new("method", ShadcnSortDirection.Descending)],
            FinancePaymentSort.Recipient_Ascending => [new("recipient", ShadcnSortDirection.Ascending)],
            FinancePaymentSort.Recipient_Descending => [new("recipient", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private FinancePaymentSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.PaymentId_Ascending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.PaymentId_Descending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.PaymentCreatedDate_Ascending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.PaymentCreatedDate_Descending,
        { ColumnKey: "payment-date", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.PaymentDate_Ascending,
        { ColumnKey: "payment-date", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.PaymentDate_Descending,
        { ColumnKey: "direction", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.PaymentDirection_Ascending,
        { ColumnKey: "direction", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.PaymentDirection_Descending,
        { ColumnKey: "type", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.PaymentType_Ascending,
        { ColumnKey: "type", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.PaymentType_Descending,
        { ColumnKey: "method", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.PaymentMethod_Ascending,
        { ColumnKey: "method", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.PaymentMethod_Descending,
        { ColumnKey: "recipient", Direction: ShadcnSortDirection.Ascending } => FinancePaymentSort.Recipient_Ascending,
        { ColumnKey: "recipient", Direction: ShadcnSortDirection.Descending } => FinancePaymentSort.Recipient_Descending,
        _ => currentSort,
    };

    private string CurrencyName(string? id) => int.TryParse(id, CultureInfo.InvariantCulture, out var value) && currencies.TryGetValue(value, out var name) ? name : "-";
    private string FormatAmount(decimal amount, string? currencyId) => $"{amount:N2} {CurrencyName(currencyId)}";
    private static string FormatDate(DateTime? value) => LegacyPresentation.FormatCalendarDate(value, CultureInfo.CurrentCulture, "-");
    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string DeltaClass(decimal value) => value > 0 ? "finance-delta--positive" : value < 0 ? "finance-delta--negative" : "finance-muted";
    private static string FormatDelta(FinanceSummaryDetail detail) => $"{detail.DeltaAmount:+#,##0.00;-#,##0.00;0.00} ({detail.DeltaPercent:N2}%)";
    private sealed record FinanceTrendRow(DateTime Month, decimal Income, decimal Expense);
}
