@page "/Finances/YearlyActivityChart"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<YearlyActivityChart> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="finance-chart-page">
    <div class="operations-page-header">
        <h1>@Text["Title", BangkokYear]</h1>
        <LegacyLink Href="/Finances/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
    </div>

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else if (chartData is null || chartData.Labels.Length == 0)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["NoData"]</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        <section class="finance-chart-card">
            <ShadcnChart Id="yearly-activity" Type="ShadcnChartType.Bar" Title="@Text["ChartHeading", BangkokYear]" CategoryLabel="@Text["Date"]" Config="@chartConfig" Categories="@chartLabels" Series="@series" ShowGrid="true" ShowMajorGrid="true" ShowLegend="true" LegendInteractive="true" InitialWidth="1200" InitialHeight="520" ValueFormatter="@FormatThb" />
        </section>
        <section class="finance-chart-card finance-chart-table" aria-labelledby="activity-table-heading">
            <h2 id="activity-table-heading">@Text["ChartHeading", BangkokYear]</h2>
            <ShadcnTable ExpectedColumnCount="3" aria-label="@Text["TableLabel", BangkokYear]">
                <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Date"]</ShadcnTableHead><ShadcnTableHead>@Text["IncomeThb"]</ShadcnTableHead><ShadcnTableHead>@Text["ExpenseThb"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                <ShadcnTableBody>
                    @foreach (var row in ActivityRows)
                    {
                        <ShadcnTableRow><ShadcnTableCell data-label="@Text["Date"]">@row.Date</ShadcnTableCell><ShadcnTableCell data-label="@Text["IncomeThb"]">@FormatThb(row.Income)</ShadcnTableCell><ShadcnTableCell data-label="@Text["ExpenseThb"]">@FormatThb(row.Expense)</ShadcnTableCell></ShadcnTableRow>
                    }
                </ShadcnTableBody>
            </ShadcnTable>
        </section>
    }
</main>

@code {
    private FinanceActivityChartData? chartData;
    private IReadOnlyList<ShadcnChartSeries> series = [];
    private ShadcnChartConfig chartConfig => new()
    {
        ["income"] = new(Text["Income"]) { Color = "var(--shadcn-chart-2)" },
        ["expense"] = new(Text["Expense"]) { Color = "var(--shadcn-chart-5)" },
    };
    private bool loading;
    private string? error;

    private static int BangkokYear => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "Asia/Bangkok").Year;
    private IReadOnlyList<ActivityRow> ActivityRows => chartData is null
        ? []
        : chartData.Labels.Select((date, index) => new ActivityRow(
            date,
            chartData.Income[index],
            Math.Abs(chartData.Expense[index]))).ToArray();

    // Keep the full dd/MM values in the table while using compact d/M labels
    // in the chart to avoid collisions at narrow responsive widths while
    // preserving the same date index for every bar and tooltip.
    private string[] chartLabels => chartData is null
        ? []
        : chartData.Labels.Select(ShortChartLabel).ToArray();

    private static string ShortChartLabel(string label) => label.TrimStart('0').Replace("/0", "/", StringComparison.Ordinal);

    private static string FormatThb(double value) => $"{value:N2} THB";

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            // The activity report is scoped to the current Bangkok calendar
            // year. Passing an empty year query makes the migrated Accounting
            // endpoint reject the request, leaving the chart in a permanent
            // "temporarily unavailable" state.
            var trend = await FinanceChartDataClient.LoadAsync(Http, BangkokYear, includeExpense: true);
            chartData = FinanceChartSeries.BuildActivity(trend.Income, trend.Expense);
            series =
            [
                new ShadcnChartSeries("income", NullableValues(chartData.Income)),
                new ShadcnChartSeries("expense", NullableValues(chartData.Expense)),
            ];
        }
        catch (FinanceChartDataException exception)
        {
            HandleFailure(exception.StatusCode);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private static double?[] NullableValues(IEnumerable<double> values) => values.Select(value => (double?)value).ToArray();

    private void HandleFailure(HttpStatusCode? statusCode)
    {
        if (statusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
            return;
        }

        error = statusCode switch
        {
            HttpStatusCode.Forbidden => Text["Forbidden"],
            HttpStatusCode.TooManyRequests => Text["RateLimited"],
            HttpStatusCode.BadGateway => Text["InvalidResponse"],
            _ => Text["Unavailable"],
        };
    }

    private sealed record ActivityRow(string Date, double Income, double Expense);
}
