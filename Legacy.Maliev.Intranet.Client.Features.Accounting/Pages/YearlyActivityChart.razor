@page "/Finances/YearlyActivityChart"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<YearlyActivityChart> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <div class="operations-page-header d-flex flex-wrap align-center justify-space-between gap-3 mb-4">
        <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Title", BangkokYear]</MudText>
        <MudButton Href="/Finances/Index" Variant="Variant.Outlined">@Text["Back"]</MudButton>
    </div>

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" />
            <span class="visually-hidden">@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (chartData is null || chartData.Labels.Length == 0)
    {
        <MudAlert Severity="Severity.Info" aria-live="polite">@Text["NoData"]</MudAlert>
    }
    else
    {
        <section aria-labelledby="yearly-activity-heading">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText id="yearly-activity-heading" Typo="Typo.h5" HtmlTag="h2">@Text["ChartHeading", BangkokYear]</MudText>
                <div aria-hidden="true">
                    <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@series" ChartLabels="@chartLabels" Width="100%" Height="520px" />
                </div>
                <MudTable Items="ActivityRows" Breakpoint="Breakpoint.Sm" Elevation="0" aria-label="@Text["TableLabel", BangkokYear]">
                    <HeaderContent>
                        <MudTh>@Text["Date"]</MudTh>
                        <MudTh>@Text["IncomeThb"]</MudTh>
                        <MudTh>@Text["ExpenseThb"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@Text["Date"]">@context.Date</MudTd>
                        <MudTd DataLabel="@Text["IncomeThb"]">@FormatThb(context.Income)</MudTd>
                        <MudTd DataLabel="@Text["ExpenseThb"]">@FormatThb(context.Expense)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </section>
    }
</MudContainer>

@code {
    private FinanceActivityChartData? chartData;
    private List<ChartSeries<double>> series = [];
    private bool loading;
    private string? error;

    private static int BangkokYear => TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "Asia/Bangkok").Year;
    private IReadOnlyList<ActivityRow> ActivityRows => chartData is null
        ? []
        : chartData.Labels.Select((date, index) => new ActivityRow(
            date,
            chartData.Income[index],
            Math.Abs(chartData.Expense[index]))).ToArray();

    // Keep the full dd/MM values in the table while using compact d/M labels
    // for the chart.  MudChart does not rotate labels consistently at every
    // responsive width, so shortening the axis labels avoids collisions while
    // preserving the same date index for every bar and tooltip.
    private string[] chartLabels => chartData is null
        ? []
        : chartData.Labels.Select(ShortChartLabel).ToArray();

    private static string ShortChartLabel(string label) => label.TrimStart('0').Replace("/0", "/", StringComparison.Ordinal);

    private static string FormatThb(double value) => $"{value:N2} THB";

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            // The activity report is scoped to the current Bangkok calendar
            // year. Passing an empty year query makes the migrated Accounting
            // endpoint reject the request, leaving the MudChart family in a
            // permanent "temporarily unavailable" state.
            var trend = await FinanceChartDataClient.LoadAsync(Http, BangkokYear, includeExpense: true);
            chartData = FinanceChartSeries.BuildActivity(trend.Income, trend.Expense);
            series =
            [
                new ChartSeries<double> { Name = Text["Income"], Data = chartData.Income },
                new ChartSeries<double> { Name = Text["Expense"], Data = chartData.Expense },
            ];
        }
        catch (FinanceChartDataException exception)
        {
            HandleFailure(exception.StatusCode);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private void HandleFailure(HttpStatusCode? statusCode)
    {
        if (statusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
            return;
        }

        error = statusCode switch
        {
            HttpStatusCode.Forbidden => Text["Forbidden"],
            HttpStatusCode.TooManyRequests => Text["RateLimited"],
            HttpStatusCode.BadGateway => Text["InvalidResponse"],
            _ => Text["Unavailable"],
        };
    }

    private sealed record ActivityRow(string Date, double Income, double Expense);
}
