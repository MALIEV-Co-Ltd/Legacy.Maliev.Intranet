@page "/Invoices/View"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<InvoiceView> Text

<PageTitle>@Text["PageTitle", Id ?? 0]</PageTitle>

<main class="invoice-detail">
    @if (loading)
    {
        <div role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        <div class="invoice-detail__actions"><ShadcnButton OnClick="LoadAsync">@Text["Retry"]</ShadcnButton><LegacyLink Href="/Invoices/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink></div>
    }
    else if (detailPage is not null)
    {
        <div class="operations-page-header"><h1>@Text["Heading", detailPage.Invoice.Number]</h1><LegacyLink Href="/Invoices/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink></div>
        @if (!string.IsNullOrWhiteSpace(notice)) { <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert> }

        <section class="invoice-detail__section">
            <dl class="invoice-detail__facts">
                <div><dt>@Text["InvoiceId"]</dt><dd>@detailPage.Invoice.Id</dd></div>
                <div><dt>@Text["CustomerId"]</dt><dd><LegacyLink Href="@($"/Customers/View?id={detailPage.Invoice.CustomerId}")" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["CustomerId"]} {detailPage.Invoice.CustomerId}")">@detailPage.Invoice.CustomerId</LegacyLink></dd></div>
                <div><dt>@Text["CreatedDate"]</dt><dd>@FormatDate(detailPage.Invoice.CreatedDate)</dd></div>
                <div><dt>@Text["SalesPerson"]</dt><dd>@Value(detailPage.Invoice.SalesPerson)</dd></div>
                <div><dt>@Text["PurchaseOrder"]</dt><dd>@Value(detailPage.Invoice.PurchaseOrderNumber)</dd></div>
                <div><dt>@Text["Terms"]</dt><dd>@Value(detailPage.Invoice.Terms)</dd></div>
                <div><dt>@Text["PaymentStatus"]</dt><dd><ShadcnBadge Variant="@(detailPage.Invoice.IsPaid ? ShadcnBadgeVariant.Default : ShadcnBadgeVariant.Secondary)">@(detailPage.Invoice.IsPaid ? Text["PaidStatus"] : Text["UnpaidStatus"])</ShadcnBadge></dd></div>
            </dl>
            <div class="invoice-detail__addresses"><section><h2>@Text["Billing"]</h2><p>@Address(detailPage.Invoice, false)</p></section><section><h2>@Text["Shipping"]</h2><p>@Address(detailPage.Invoice, true)</p></section></div>
        </section>

        <section class="invoice-detail__section" aria-labelledby="items-heading">
            <h2 id="items-heading">@Text["Items"]</h2>
            @if (detailPage.OrderItems.Count == 0) { <p>@Text["NoItems"]</p> }
            else
            {
                <ShadcnTable ExpectedColumnCount="4" aria-label="@Text["OrderItemsTable"]"><ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Description"]</ShadcnTableHead><ShadcnTableHead>@Text["UnitPrice"]</ShadcnTableHead><ShadcnTableHead>@Text["Quantity"]</ShadcnTableHead><ShadcnTableHead>@Text["Subtotal"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader><ShadcnTableBody>@foreach (var item in detailPage.OrderItems) { <ShadcnTableRow><ShadcnTableCell data-label="@Text["Description"]">@Value(item.Description)</ShadcnTableCell><ShadcnTableCell data-label="@Text["UnitPrice"]">@Money(item.UnitPrice)</ShadcnTableCell><ShadcnTableCell data-label="@Text["Quantity"]">@item.Quantity</ShadcnTableCell><ShadcnTableCell data-label="@Text["Subtotal"]">@Money(item.Subtotal)</ShadcnTableCell></ShadcnTableRow> }</ShadcnTableBody></ShadcnTable>
            }
        </section>

        <section class="invoice-detail__section" aria-labelledby="receipt-actions-heading">
            <h2 id="receipt-actions-heading">@Text["ReceiptActions"]</h2>
            <div class="invoice-detail__actions" role="group" aria-label="@Text["ReceiptActionGroup"]">
                @if (detailPage.Invoice.ReceiptId is null)
                {
                    <ShadcnButton OnClick="CreateReceiptAsync" Disabled="@(submitting || !detailPage.Invoice.IsPaid)">@Text["CreateReceipt"]</ShadcnButton>
                }
                else
                {
                    <ShadcnButton OnClick="ArmEmailReceipt" Disabled="@submitting" Variant="ShadcnButtonVariant.Outline" aria-expanded="@emailReceiptArmed">@Text["EmailReceipt"]</ShadcnButton>
                    @if (emailReceiptArmed) { <div class="invoice-detail__actions" role="group" aria-label="@Text["EmailReceiptConfirmation"]"><ShadcnButton OnClick="EmailReceiptAsync" Disabled="@submitting">@Text["ConfirmEmailReceipt"]</ShadcnButton><ShadcnButton OnClick="CancelEmailReceipt" Disabled="@submitting" Variant="ShadcnButtonVariant.Ghost">@Text["Cancel"]</ShadcnButton></div> }
                    <ShadcnButton OnClick="ArmRemoveReceipt" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive" aria-expanded="@receiptRemoveArmed">@Text["RemoveReceipt"]</ShadcnButton>
                    @if (receiptRemoveArmed) { <div class="invoice-detail__actions" role="group" aria-label="@Text["RemoveReceiptConfirmation"]"><ShadcnButton OnClick="RemoveReceiptAsync" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive">@Text["ConfirmRemoveReceipt"]</ShadcnButton><ShadcnButton OnClick="CancelRemoveReceipt" Disabled="@submitting" Variant="ShadcnButtonVariant.Ghost">@Text["Cancel"]</ShadcnButton></div> }
                }
            </div>
            @if (!detailPage.Invoice.IsPaid && detailPage.Invoice.ReceiptId is null) { <p class="invoice-detail__muted">@Text["ReceiptRequiresPayment"]</p> }
        </section>

        <section class="invoice-detail__section" aria-labelledby="documents-heading">
            <h2 id="documents-heading">@Text["Documents"]</h2>
            @if (detailPage.InvoiceFiles.Count + detailPage.ReceiptFiles.Count == 0) { <p>@Text["NoDocuments"]</p> }
            else { <ul class="invoice-detail__documents">@foreach (var file in detailPage.InvoiceFiles.Concat(detailPage.ReceiptFiles)) { <li><LegacyLink Href="@file.Uri?.ToString()" Role="LegacyLinkRole.External" Target="_blank" Rel="noopener">@file.ObjectName</LegacyLink></li> }</ul> }
        </section>

        <section class="invoice-detail__section">
            <dl class="invoice-detail__totals"><div><dt>@Text["Subtotal"]</dt><dd>@Money(detailPage.Invoice.Subtotal)</dd></div><div><dt>@Text["Vat"]</dt><dd>@Money(detailPage.Invoice.Vat)</dd></div><div><dt>@Text["Total"]</dt><dd>@Money(detailPage.Invoice.Total)</dd></div><div><dt>@Text["WithholdingTax"]</dt><dd>@Money(detailPage.Invoice.WithholdingTax)</dd></div><div><dt>@Text["Outstanding"]</dt><dd>@Money(detailPage.Invoice.Outstanding)</dd></div></dl>
            <EditForm EditContext="@editContext" OnValidSubmit="SaveAsync" class="invoice-detail__form"><DataAnnotationsValidator /><div class="invoice-detail__form-grid"><AccountingCheckboxField Id="invoice-paid" Label="@Text["Paid"]" @bind-Value="edit.IsPaid" Disabled="@submitting" /><AccountingInputField TValue="DateTime?" Id="invoice-payment-date" Label="@Text["PaymentDate"]" Type="date" @bind-Value="edit.PaymentDate" Disabled="@submitting" /><div class="invoice-detail__wide"><ShadcnFormField Id="invoice-internal-comment" Label="@Text["InternalComment"]"><Control><ShadcnTextarea TValue="string" id="invoice-internal-comment" @bind-Value="edit.InternalComment" rows="5" maxlength="1000" Disabled="@submitting" /></Control></ShadcnFormField></div><div class="invoice-detail__wide invoice-detail__actions" role="group" aria-label="@Text["InvoiceActionGroup"]"><ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@Text["Save"]</ShadcnButton><ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="ArmDelete" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive" aria-expanded="@deleteArmed">@Text["Delete"]</ShadcnButton>@if (deleteArmed) { <div class="invoice-detail__actions" role="group" aria-label="@Text["DeleteConfirmation"]"><ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="DeleteAsync" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive">@Text["ConfirmDelete"]</ShadcnButton><ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="CancelDelete" Disabled="@submitting" Variant="ShadcnButtonVariant.Ghost">@Text["Cancel"]</ShadcnButton></div> }</div></div></EditForm>
        </section>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }
    private InvoiceDetailPage? detailPage;
    private EmployeeSessionSummary? session;
    private InvoiceEditModel edit = new();
    private EditContext editContext = null!;
    private bool loading = true;
    private bool submitting;
    private bool deleteArmed;
    private bool receiptRemoveArmed;
    private bool emailReceiptArmed;
    private Guid? createReceiptOperationId;
    private Guid? removeReceiptOperationId;
    private Guid? emailReceiptOperationId;
    private string? error;
    private string? notice;

    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync()
    {
        loading = true; error = null;
        if (Id is not > 0) { error = Text["InvalidId"]; loading = false; return; }
        try
        {
            session = await Http.GetFromJsonForPresentationAsync<EmployeeSessionSummary>("/bff/session");
            using var response = await Http.GetForPresentationAsync($"/bff/invoices/{Id.Value}");
            if (response.StatusCode == HttpStatusCode.Unauthorized) { Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}"); return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { error = Text["NotFound"]; return; }
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            detailPage = await response.Content.ReadFromJsonAsync<InvoiceDetailPage>();
            if (detailPage is null) { error = Text["InvalidResponse"]; return; }
            edit = InvoiceEditModel.From(detailPage.Invoice);
            editContext = new EditContext(edit);
        }
        catch (InvalidDataException) { error = Text["InvalidResponse"]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }
    private async Task SaveAsync()
    {
        if (detailPage is null || submitting) return;
        using var request = WriteRequest(HttpMethod.Put, $"/bff/invoices/{detailPage.Invoice.Id}");
        request.Content = JsonContent.Create(edit.ToRequest());
        await SendAsync(request, Text["Saved"]);
    }
    private async Task DeleteAsync()
    {
        if (detailPage is null) return;
        using var request = WriteRequest(HttpMethod.Delete, $"/bff/invoices/{detailPage.Invoice.Id}");
        submitting = true; error = null;
        try { using var response = await Http.SendAsync(request); if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; } Navigation.NavigateTo("/Invoices/Index"); }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { submitting = false; }
    }
    private async Task CreateReceiptAsync()
    {
        if (detailPage is null) return;
        createReceiptOperationId ??= Guid.NewGuid();
        using var request = ReceiptRequest(HttpMethod.Post, $"/bff/invoices/{detailPage.Invoice.Id}/receipt", createReceiptOperationId.Value);
        request.Content = JsonContent.Create(new CreateInvoiceReceiptRequest(detailPage.Invoice.InternalComment, false));
        await SendReceiptAsync(request, Text["ReceiptCreated"], () => createReceiptOperationId = null);
    }
    private async Task EmailReceiptAsync()
    {
        if (detailPage is null) return;
        emailReceiptOperationId ??= Guid.NewGuid();
        using var request = ReceiptRequest(HttpMethod.Post, $"/bff/invoices/{detailPage.Invoice.Id}/receipt/email", emailReceiptOperationId.Value);
        await SendReceiptAsync(request, Text["ReceiptEmailed"], () => { emailReceiptOperationId = null; emailReceiptArmed = false; });
    }
    private async Task RemoveReceiptAsync()
    {
        if (detailPage is null) return;
        removeReceiptOperationId ??= Guid.NewGuid();
        using var request = ReceiptRequest(HttpMethod.Delete, $"/bff/invoices/{detailPage.Invoice.Id}/receipt", removeReceiptOperationId.Value);
        await SendReceiptAsync(request, Text["ReceiptRemoved"], () => { removeReceiptOperationId = null; receiptRemoveArmed = false; });
    }
    private HttpRequestMessage ReceiptRequest(HttpMethod method, string path, Guid operationId) { var request = WriteRequest(method, path); request.Headers.Add("Idempotency-Key", operationId.ToString("D")); return request; }
    private async Task SendReceiptAsync(HttpRequestMessage request, string success, Action completed)
    {
        submitting = true; error = null; notice = null;
        try { using var response = await Http.SendAsync(request); if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; } completed(); notice = success; await LoadAsync(); }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException) { error = Text["Unavailable"]; }
        finally { submitting = false; }
    }
    private HttpRequestMessage WriteRequest(HttpMethod method, string path) { var request = new HttpRequestMessage(method, path); if (!string.IsNullOrWhiteSpace(session?.CsrfToken)) request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken); return request; }
    private async Task SendAsync(HttpRequestMessage request, string success)
    {
        submitting = true; error = null; notice = null;
        try { using var response = await Http.SendAsync(request); if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; } if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; } notice = success; await LoadAsync(); }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { submitting = false; }
    }
    private void ArmDelete() => deleteArmed = true;
    private void CancelDelete() => deleteArmed = false;
    private void ArmRemoveReceipt() => receiptRemoveArmed = true;
    private void CancelRemoveReceipt() => receiptRemoveArmed = false;
    private void ArmEmailReceipt() => emailReceiptArmed = true;
    private void CancelEmailReceipt() => emailReceiptArmed = false;
    private string ErrorFor(HttpStatusCode status) => status switch { HttpStatusCode.Forbidden => Text["Forbidden"], HttpStatusCode.TooManyRequests => Text["RateLimited"], HttpStatusCode.BadGateway => Text["InvalidResponse"], _ => Text["Unavailable"] };
    private string Money(decimal? value) => value is null ? "-" : $"{value:N2} {detailPage?.Invoice.Currency}";
    private static string FormatDate(DateTime? value) => LegacyPresentation.FormatUtcDateTime(value, CultureInfo.CurrentCulture, "-");
    private static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Address(InvoiceDetail value, bool shipping) => string.Join(Environment.NewLine, (shipping ? new[] { value.ShippingAddressRecipient, value.ShippingAddressCompany, value.ShippingAddressBuilding, value.ShippingAddressLine1, value.ShippingAddressLine2, value.ShippingAddressCity, value.ShippingAddressState, value.ShippingAddressPostalCode, value.ShippingAddressCountry } : new[] { value.BillingAddressRecipient, value.BillingAddressCompany, value.BillingAddressBuilding, value.BillingAddressLine1, value.BillingAddressLine2, value.BillingAddressCity, value.BillingAddressState, value.BillingAddressPostalCode, value.BillingAddressCountry }).Where(item => !string.IsNullOrWhiteSpace(item)));
    private sealed class InvoiceEditModel
    {
        public bool IsPaid { get; set; }
        public DateTime? PaymentDate { get; set; }
        public string? InternalComment { get; set; }
        public DateTime ModifiedDate { get; set; }
        public static InvoiceEditModel From(InvoiceDetail value) => new() { IsPaid = value.IsPaid, PaymentDate = value.PaymentDate, InternalComment = value.InternalComment, ModifiedDate = value.ModifiedDate ?? throw new InvalidDataException("Invoice has no concurrency timestamp.") };
        public InvoiceUpdateRequest ToRequest() => new(IsPaid, PaymentDate, InternalComment, ModifiedDate);
    }
}
