@page "/Finances/View"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<FinanceView> Text

<PageTitle>@Text["PageTitle", Id ?? 0]</PageTitle>

<main class="finance-editor">
    @if (loading)
    {
        <div role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        <div class="finance-editor__actions">
            <ShadcnButton OnClick="LoadAsync">@Text["Retry"]</ShadcnButton>
            <LegacyLink Href="/Finances/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
        </div>
    }
    else if (page is not null)
    {
        <div class="operations-page-header">
            <h1>@Text["Heading", page.Payment.Id]</h1>
            <LegacyLink Href="/Finances/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
        </div>
        @if (!string.IsNullOrWhiteSpace(notice))
        {
            <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert>
        }

        <EditForm EditContext="@editContext" OnValidSubmit="SaveAsync" class="finance-editor__form">
            <DataAnnotationsValidator />
            <div class="finance-editor__grid">
                <AccountingSelectField TValue="int?" Id="finance-employee" Label="@Text["Employee"]" @bind-Value="edit.EmployeeId" Options="@EmployeeOptions" Placeholder="@Text["Employee"]" Clearable="true" Disabled="@submitting" />
                <AccountingSelectField TValue="int" Id="finance-direction" Label="@Text["Direction"]" @bind-Value="edit.PaymentDirectionId" Options="@DirectionOptions" Placeholder="@Text["Direction"]" Required="true" Disabled="@submitting" />
                <AccountingSelectField TValue="int" Id="finance-type" Label="@Text["Type"]" @bind-Value="edit.PaymentTypeId" Options="@TypeOptions" Placeholder="@Text["Type"]" Required="true" Disabled="@submitting" />
                <AccountingSelectField TValue="int" Id="finance-method" Label="@Text["Method"]" @bind-Value="edit.PaymentMethodId" Options="@MethodOptions" Placeholder="@Text["Method"]" Required="true" Disabled="@submitting" />
                <AccountingInputField TValue="decimal" Id="finance-amount" Label="@AmountLabel" Type="number" InputMode="decimal" Min="0" @bind-Value="edit.Amount" Required="true" Disabled="@submitting" />
                <AccountingSelectField TValue="int?" Id="finance-currency" Label="@Text["Currency"]" @bind-Value="edit.CurrencyId" Options="@CurrencyOptions" Placeholder="@Text["Currency"]" Clearable="true" Disabled="@submitting" />
                <AccountingInputField TValue="string" Id="finance-recipient" Label="@Text["Recipient"]" @bind-Value="edit.Recipient" Disabled="@submitting" />
                <AccountingInputField TValue="string" Id="finance-transaction" Label="@Text["TransactionNumber"]" @bind-Value="edit.TransactionNumber" Disabled="@submitting" />
                <AccountingInputField TValue="DateTime?" Id="finance-payment-date" Label="@Text["PaymentDate"]" Type="date" @bind-Value="edit.PaymentDate" Disabled="@submitting" />
                <div class="finance-editor__wide"><ShadcnFormField Id="finance-description" Label="@Text["Description"]"><Control><ShadcnTextarea TValue="string" id="finance-description" @bind-Value="edit.Description" rows="4" Disabled="@submitting" /></Control></ShadcnFormField></div>
                <div class="finance-editor__wide finance-editor__actions" role="group" aria-label="@Text["PaymentActions"]">
                        <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@Text["Save"]</ShadcnButton>
                        <ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="ArmDelete" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive" aria-expanded="@deleteArmed">@Text["Delete"]</ShadcnButton>
                        @if (deleteArmed)
                        {
                            <span class="finance-editor__confirmation" role="group" aria-label="@Text["DeleteConfirmation"]">
                                <ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="DeleteAsync" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive">@Text["ConfirmDelete"]</ShadcnButton>
                                <ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="CancelDelete" Disabled="@submitting" Variant="ShadcnButtonVariant.Ghost">@Text["Cancel"]</ShadcnButton>
                            </span>
                        }
                </div>
            </div>
        </EditForm>

        <section class="finance-files" aria-labelledby="finance-files-heading">
            <h2 id="finance-files-heading">@Text["Files"]</h2>
            <div class="finance-files__upload"><InputFile OnChange="SelectFiles" multiple disabled="@submitting" /><ShadcnButton OnClick="UploadAsync" Disabled="@(submitting || uploads.Count == 0)">@Text["Upload"]</ShadcnButton></div>
            @if (page.Files.Count == 0)
            {
                <p>@Text["NoFiles"]</p>
            }
            else
            {
                <ul class="finance-files__list">
                    @foreach (var file in page.Files)
                    {
                        <li>
                            <LegacyLink Href="@file.Uri?.ToString()" Role="LegacyLinkRole.External" Target="_blank" Rel="noopener">@file.ObjectName</LegacyLink>
                            <div class="finance-editor__actions" role="group" aria-label="@Text["FileActions", file.ObjectName]">
                                <ShadcnButton OnClick="() => ArmFileRemove(file.Id)" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive" Size="ShadcnButtonSize.Small" aria-label="@Text["RemoveFile", file.ObjectName]" aria-expanded="@(fileRemoveArmedId == file.Id)">@Text["RemoveFile", file.ObjectName]</ShadcnButton>
                                @if (fileRemoveArmedId == file.Id)
                                {
                                    <div class="finance-editor__confirmation" role="group" aria-label="@Text["RemoveFileConfirmation", file.ObjectName]">
                                        <ShadcnButton OnClick="() => RemoveFileAsync(file.Id)" Disabled="@submitting" Variant="ShadcnButtonVariant.Destructive" Size="ShadcnButtonSize.Small">@Text["ConfirmRemoveFile"]</ShadcnButton>
                                        <ShadcnButton OnClick="CancelFileRemove" Disabled="@submitting" Variant="ShadcnButtonVariant.Ghost" Size="ShadcnButtonSize.Small">@Text["Cancel"]</ShadcnButton>
                                    </div>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }
    private FinanceDetailPage? page;
    private EmployeeSessionSummary? session;
    private FinanceEditModel edit = new();
    private EditContext editContext = null!;
    private readonly List<IBrowserFile> uploads = [];
    private Guid? uploadAttemptId;
    private bool loading = true;
    private bool submitting;
    private bool deleteArmed;
    private int? fileRemoveArmedId;
    private string? error;
    private string? notice;
    private IReadOnlyList<ShadcnSelectOption<int?>> EmployeeOptions => page?.Employees.Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray() ?? [];
    private IReadOnlyList<ShadcnSelectOption<int>> DirectionOptions => page?.Directions.Select(item => new ShadcnSelectOption<int>(item.Id, item.Name)).ToArray() ?? [];
    private IReadOnlyList<ShadcnSelectOption<int>> TypeOptions => page?.Types.Select(item => new ShadcnSelectOption<int>(item.Id, item.Name)).ToArray() ?? [];
    private IReadOnlyList<ShadcnSelectOption<int>> MethodOptions => page?.Methods.Select(item => new ShadcnSelectOption<int>(item.Id, item.Name)).ToArray() ?? [];
    private IReadOnlyList<ShadcnSelectOption<int?>> CurrencyOptions => page?.Currencies.Select(item => new ShadcnSelectOption<int?>(item.Id, item.ShortName)).ToArray() ?? [];
    private string AmountLabel => $"{Text["AmountThbOrCurrency"]} ({CurrencyName(edit.CurrencyId)})";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; error = null;
        if (Id is not > 0) { error = Text["InvalidId"]; loading = false; return; }
        try
        {
            session = await Http.GetFromJsonForPresentationAsync<EmployeeSessionSummary>("/bff/session");
            using var response = await Http.GetForPresentationAsync($"/bff/finances/{Id.Value}");
            if (response.StatusCode == HttpStatusCode.Unauthorized) { Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}"); return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { error = Text["NotFound"]; return; }
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            page = await response.Content.ReadFromJsonAsync<FinanceDetailPage>();
            if (page is null) { error = Text["InvalidResponse"]; return; }
            edit = FinanceEditModel.From(page.Payment);
            editContext = new EditContext(edit);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (page is null || submitting) return;
        using var request = WriteRequest(HttpMethod.Put, $"/bff/finances/{page.Payment.Id}");
        request.Content = JsonContent.Create(edit.ToRequest());
        await SendAsync(request, Text["Saved"]);
    }

    private void SelectFiles(InputFileChangeEventArgs args) { uploads.Clear(); uploads.AddRange(args.GetMultipleFiles()); uploadAttemptId = Guid.NewGuid(); }
    private async Task UploadAsync()
    {
        if (page is null || uploads.Count == 0) return;
        using var content = new MultipartFormDataContent("----maliev-finance-upload");
        foreach (var upload in uploads)
        {
            var file = new StreamContent(upload.OpenReadStream(200 * 1024 * 1024));
            file.Headers.ContentType = new(upload.ContentType);
            content.Add(file, "files", upload.Name);
        }
        using var request = WriteRequest(HttpMethod.Post, $"/bff/finances/{page.Payment.Id}/files");
        request.Headers.Add("Idempotency-Key", (uploadAttemptId ??= Guid.NewGuid()).ToString("D"));
        request.Content = content;
        await SendAsync(request, Text["Uploaded"]);
    }

    private async Task RemoveFileAsync(int fileId)
    {
        if (page is null) return;
        using var request = WriteRequest(HttpMethod.Delete, $"/bff/finances/{page.Payment.Id}/files/{fileId}");
        await SendAsync(request, Text["FileRemoved"]);
        if (string.IsNullOrWhiteSpace(error)) fileRemoveArmedId = null;
    }

    private async Task DeleteAsync()
    {
        if (page is null) return;
        using var request = WriteRequest(HttpMethod.Delete, $"/bff/finances/{page.Payment.Id}");
        submitting = true; error = null;
        try
        {
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            Navigation.NavigateTo("/Finances/Index");
        }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { submitting = false; }
    }

    private void ArmDelete() => deleteArmed = true;
    private void CancelDelete() => deleteArmed = false;
    private void ArmFileRemove(int fileId) => fileRemoveArmedId = fileId;
    private void CancelFileRemove() => fileRemoveArmedId = null;

    private HttpRequestMessage WriteRequest(HttpMethod method, string path)
    {
        var request = new HttpRequestMessage(method, path);
        if (!string.IsNullOrWhiteSpace(session?.CsrfToken)) request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
        return request;
    }

    private async Task SendAsync(HttpRequestMessage request, string success)
    {
        submitting = true; error = null; notice = null;
        try
        {
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; }
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            notice = success; uploads.Clear(); uploadAttemptId = null; await LoadAsync();
        }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { submitting = false; }
    }

    private string ErrorFor(HttpStatusCode status) => status switch { HttpStatusCode.Forbidden => Text["Forbidden"], HttpStatusCode.TooManyRequests => Text["RateLimited"], HttpStatusCode.BadGateway => Text["InvalidResponse"], _ => Text["Unavailable"] };
    private string CurrencyName(int? id) => page?.Currencies.FirstOrDefault(item => item.Id == id)?.ShortName ?? Text["CurrencyUnknown"];

    private sealed class FinanceEditModel
    {
        public int? EmployeeId { get; set; }
        [Range(1, int.MaxValue)] public int PaymentDirectionId { get; set; }
        [Range(1, int.MaxValue)] public int PaymentTypeId { get; set; }
        public string? Description { get; set; }
        [Range(1, int.MaxValue)] public int PaymentMethodId { get; set; }
        [Range(typeof(decimal), "0.01", "79228162514264337593543950335")] public decimal Amount { get; set; }
        public int? CurrencyId { get; set; }
        public string? Recipient { get; set; }
        public string? TransactionNumber { get; set; }
        public DateTime? PaymentDate { get; set; }
        public DateTime? ModifiedDate { get; set; }
        public static FinanceEditModel From(FinancePaymentItem value) => new() { EmployeeId = value.EmployeeId, PaymentDirectionId = value.PaymentDirectionId, PaymentTypeId = value.PaymentTypeId, Description = value.Description, PaymentMethodId = value.PaymentMethodId, Amount = value.Amount, CurrencyId = value.CurrencyId, Recipient = value.Recipient, TransactionNumber = value.TransactionNumber, PaymentDate = value.PaymentDate, ModifiedDate = value.ModifiedDate };
        public FinancePaymentUpdateRequest ToRequest() => new(EmployeeId, PaymentDirectionId, PaymentTypeId, Description, PaymentMethodId, Amount, CurrencyId, Recipient, TransactionNumber, PaymentDate, ModifiedDate);
    }
}
