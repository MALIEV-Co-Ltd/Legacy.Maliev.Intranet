@page "/Invoices/Index"
@page "/accounting"
@page "/finance/invoices"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Invoices> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="invoice-index-page">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <div class="operations-page-header">
        <h1>@Text["Invoices"]</h1>
        <ShadcnButton Href="/Invoices/Create">@Text["Create"]</ShadcnButton>
    </div>

    <ListToolbar TSort="InvoiceListSort"
                 Value="@ToolbarValue"
                 Defaults="@ToolbarDefaults"
                 SortOptions="@ToolbarSortOptions"
                 PageSizeOptions="@InvoicePageSizes"
                 SearchLabel="@Text["Search"]"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        @foreach (var section in Sections)
        {
            <section class="invoice-section">
                <h2>@section.Title</h2>
                <p class="invoice-section__summary">
                    @Text["RecordsSummary", section.Page.TotalRecords, section.Page.TotalPages]
                    @if (!section.Paid)
                    {
                        <span> · @Text["OutstandingSummary", FormatMoney(section.Page.Items.Sum(invoice => invoice.Outstanding), section.Page.Items.FirstOrDefault()?.Currency)]</span>
                    }
                </p>
                @if (section.Page.Items.Count == 0)
                {
                    <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@section.EmptyMessage</ShadcnAlertDescription></ShadcnAlert>
                }
                else
                {
                    <OperationalTable TItem="InvoiceListItem" TKey="int" Items="@section.Page.Items"
                                      KeySelector="@(invoice => invoice.Id)" TableLabel="@Text["InvoiceTableLabel", section.Title]"
                                      ColumnCount="14" State="@tableState"
                                      DetailHref="@(invoice => $"/Invoices/View?id={invoice.Id}")"
                                      DetailAriaLabel="@(invoice => Text["ViewInvoice", invoice.Id])"
                                      ExpandAriaLabel="@(invoice => Text["ExpandInvoice", invoice.Id])"
                                      CollapseAriaLabel="@(invoice => Text["CollapseInvoice", invoice.Id])">
                        <HeaderContent>
                            <tr><th class="operational-table__identity" data-priority="essential">@Text["Id"]</th>
                                <th data-priority="essential">@Text["Number"]</th><th data-priority="essential">@Text["CustomerId"]</th>
                                <th data-priority="essential">@Text["Paid"]</th><th data-priority="essential">@Text["Outstanding"]</th>
                                <th data-priority="essential">@Text["Total"]</th><th data-priority="supporting">@Text["ReceiptId"]</th>
                                <th data-priority="supporting">@Text["PurchaseOrder"]</th><th data-priority="supporting">@Text["Subtotal"]</th>
                                <th data-priority="supporting">@Text["Vat"]</th><th data-priority="supporting">@Text["WithholdingTax"]</th>
                                <th data-priority="supporting">@Text["PaymentDate"]</th><th data-priority="supporting">@Text["CreatedDate"]</th>
                                <th class="operational-table__actions-heading"><span class="visually-hidden">@Text["Actions"]</span></th></tr>
                        </HeaderContent>
                        <RowContent Context="invoice">
                            <td class="operational-table__identity mlv-mono" data-priority="essential">@invoice.Id</td>
                            <td class="mlv-mono" data-priority="essential">@invoice.Number</td>
                            <td class="mlv-mono" data-priority="essential"><LegacyLink Href="@($"/Customers/View?id={invoice.CustomerId}")" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["CustomerId"]} {invoice.CustomerId}")">@invoice.CustomerId</LegacyLink></td>
                            <td data-priority="essential">
                                <ShadcnBadge Variant="ShadcnBadgeVariant.Outline" Class="@(invoice.IsPaid ? "invoice-status--paid" : "invoice-status--unpaid")">
                                    @(invoice.IsPaid ? Text["PaidStatus"] : Text["UnpaidStatus"])
                                </ShadcnBadge>
                            </td>
                            <td class="mlv-mono" data-priority="essential"><strong>@FormatMoney(invoice.Outstanding, invoice.Currency)</strong></td>
                            <td class="mlv-mono" data-priority="essential">@FormatMoney(invoice.Total, invoice.Currency)</td>
                            <td class="mlv-mono" data-priority="supporting">@(invoice.ReceiptId?.ToString(CultureInfo.InvariantCulture) ?? "-")</td>
                            <td class="mlv-mono" data-priority="supporting">@ValueOrFallback(invoice.PurchaseOrderNumber)</td>
                            <td class="mlv-mono" data-priority="supporting">@FormatMoney(invoice.Subtotal, invoice.Currency)</td>
                            <td class="mlv-mono" data-priority="supporting">@FormatMoney(invoice.Vat, invoice.Currency)</td>
                            <td class="mlv-mono" data-priority="supporting">@FormatMoney(invoice.WithholdingTax, invoice.Currency, negate: true)</td>
                            <td class="mlv-mono" data-priority="supporting">@FormatCalendarDate(invoice.PaymentDate)</td>
                            <td class="mlv-mono" data-priority="supporting">@FormatTimestamp(invoice.CreatedDate)</td>
                        </RowContent>
                        <QuickViewContent Context="invoice"><dl class="operational-quick-view">
                            <div><dt>@Text["ReceiptId"]</dt><dd class="mlv-mono">@(invoice.ReceiptId?.ToString(CultureInfo.InvariantCulture) ?? "-")</dd></div>
                            <div><dt>@Text["PurchaseOrder"]</dt><dd class="mlv-mono">@ValueOrFallback(invoice.PurchaseOrderNumber)</dd></div>
                            <div><dt>@Text["Subtotal"]</dt><dd class="mlv-mono">@FormatMoney(invoice.Subtotal, invoice.Currency)</dd></div>
                            <div><dt>@Text["Vat"]</dt><dd class="mlv-mono">@FormatMoney(invoice.Vat, invoice.Currency)</dd></div>
                            <div><dt>@Text["WithholdingTax"]</dt><dd class="mlv-mono">@FormatMoney(invoice.WithholdingTax, invoice.Currency, negate: true)</dd></div>
                            <div><dt>@Text["PaymentDate"]</dt><dd class="mlv-mono">@FormatCalendarDate(invoice.PaymentDate)</dd></div>
                            <div><dt>@Text["CreatedDate"]</dt><dd class="mlv-mono">@FormatTimestamp(invoice.CreatedDate)</dd></div>
                        </dl></QuickViewContent>
                    </OperationalTable>
                }
            </section>
        }

        <nav class="invoice-pager" aria-label="@Text["InvoicePages"]">
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="@(!HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</ShadcnButton>
            <span aria-live="polite">@Text["PageSummary", Index, TotalPages, TotalRecords]</span>
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="@(!HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</ShadcnButton>
        </nav>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private static readonly InvoiceListPage EmptyPage = new([], 1, 0, 0, false, false);
    private static readonly int[] InvoicePageSizes = [10, 25, 50, 100, 150];
    private readonly LatestRequestGate requestGate = new();
    private readonly OperationalTableState<int> tableState = new();
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Invoices"]),
    ];
    private InvoiceListPage paidInvoices = EmptyPage;
    private InvoiceListPage unpaidInvoices = EmptyPage;
    private InvoiceListSort currentSort = InvoiceListSort.InvoiceCreatedDate_Descending;
    private bool loading;
    private string? error;
    private ListToolbarState<InvoiceListSort> ToolbarValue => new(Search, currentSort, Size);
    private static ListToolbarState<InvoiceListSort> ToolbarDefaults =>
        new(null, InvoiceListSort.InvoiceCreatedDate_Descending, 10);
    private IReadOnlyList<ListToolbarOption<InvoiceListSort>> ToolbarSortOptions =>
        Enum.GetValues<InvoiceListSort>().Select(option => new ListToolbarOption<InvoiceListSort>(option, Text[option.ToString()])).ToArray();

    private IReadOnlyList<(string Title, string EmptyMessage, bool Paid, InvoiceListPage Page)> Sections =>
    [
        (Text["UnpaidInvoices"], Text["NoUnpaidInvoices"], false, unpaidInvoices),
        (Text["PaidInvoices"], Text["NoPaidInvoices"], true, paidInvoices),
    ];
    private int TotalPages => Math.Max(paidInvoices.TotalPages, unpaidInvoices.TotalPages);
    private int TotalRecords => paidInvoices.TotalRecords + unpaidInvoices.TotalRecords;
    private bool HasPreviousPage => paidInvoices.HasPreviousPage || unpaidInvoices.HasPreviousPage;
    private bool HasNextPage => paidInvoices.HasNextPage || unpaidInvoices.HasNextPage;

    protected override async Task OnParametersSetAsync()
    {
        Index = Math.Max(1, Index);
        Size = Size is 10 or 25 or 50 or 100 or 150 ? Size : 10;
        currentSort = Enum.TryParse<InvoiceListSort>(SortQuery, true, out var parsed)
            ? parsed
            : InvoiceListSort.InvoiceCreatedDate_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = requestGate.Begin();
        tableState.Clear();
        loading = true;
        error = null;
        HttpResponseMessage[]? responses = null;
        try
        {
            var query = $"sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={Index}&size={Size}";
            responses = await Task.WhenAll(
                Http.GetForPresentationAsync($"/bff/invoices?{query}&paid=true", lease.CancellationToken),
                Http.GetForPresentationAsync($"/bff/invoices?{query}&paid=false", lease.CancellationToken));
            if (!lease.IsCurrent)
            {
                return;
            }
            if (HandleFailure(responses))
            {
                return;
            }

            var paid = await responses[0].Content.ReadFromJsonAsync<InvoiceListPage>(lease.CancellationToken) ?? EmptyPage;
            var unpaid = await responses[1].Content.ReadFromJsonAsync<InvoiceListPage>(lease.CancellationToken) ?? EmptyPage;
            if (!lease.IsCurrent)
            {
                return;
            }

            paidInvoices = paid;
            unpaidInvoices = unpaid;
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            if (responses is not null)
            {
                foreach (var response in responses)
                {
                    response.Dispose();
                }
            }

            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private bool HandleFailure(IEnumerable<HttpResponseMessage> responses)
    {
        var failed = responses.FirstOrDefault(response => !response.IsSuccessStatusCode);
        if (failed is null)
        {
            return false;
        }

        if (failed.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        }
        else
        {
            error = failed.StatusCode switch
            {
                HttpStatusCode.Forbidden => Text["Forbidden"],
                HttpStatusCode.TooManyRequests => Text["RateLimited"],
                HttpStatusCode.BadGateway => Text["InvalidResponse"],
                _ => Text["Unavailable"],
            };
        }

        return true;
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private Task HandleToolbarRequestAsync(ListToolbarRequest<InvoiceListSort> request) =>
        request.Reason == ListToolbarChangeReason.Refreshed && request.State.Normalize() == ToolbarValue.Normalize()
            ? LoadAsync()
            : NavigateAsync(1, request.State.Search, request.State.Sort, request.State.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, InvoiceListSort sort, int size, bool replace = false)
    {
        tableState.Clear();
        Navigation.NavigateTo($"/Invoices/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={size}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private static string FormatMoney(decimal? value, string? currency, bool negate = false) =>
        value is null ? "-" : $"{(negate ? -value.Value : value.Value):N2} {ValueOrFallback(currency)}";
    private static string FormatTimestamp(DateTime? value) =>
        LegacyPresentation.FormatUtcDateTime(value, CultureInfo.CurrentCulture, "-");
    private static string FormatCalendarDate(DateTime? value) =>
        LegacyPresentation.FormatCalendarDate(value, CultureInfo.CurrentCulture, "-");
    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
