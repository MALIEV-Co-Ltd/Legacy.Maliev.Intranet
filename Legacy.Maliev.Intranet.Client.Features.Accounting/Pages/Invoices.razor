@page "/Invoices/Index"
@page "/accounting"
@page "/finance/invoices"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Invoices> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="invoice-index-page">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <div class="operations-page-header">
        <h1>@Text["Invoices"]</h1>
        <ShadcnButton Href="/Invoices/Create">@Text["Create"]</ShadcnButton>
    </div>

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" />
            <span>@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        @foreach (var section in Sections)
        {
            <section class="invoice-section">
                <h2>@section.Title</h2>
                @if (!section.Paid && section.Page.Items.Count > 0)
                {
                    <p class="invoice-section__summary">@Text["OutstandingSummary", FormatMoney(section.Page.Items.Sum(invoice => invoice.Outstanding), section.Page.Items.FirstOrDefault()?.Currency)]</p>
                }
                <OperationalDataTable TItem="InvoiceListItem"
                                      Items="@(section.Page.Items)"
                                      Columns="@Columns"
                                      RowKey="@(invoice => invoice.Id.ToString(CultureInfo.InvariantCulture))"
                                      State="@dataTableState"
                                      StateChanged="HandleDataTableStateChangedAsync"
                                      RequestChanged="HandleDataTableRequestAsync"
                                      TotalCount="@(section.Page.TotalRecords)"
                                      FilterPlaceholder="@Text["Search"]"
                                      EmptyText="@section.EmptyMessage"
                                      LoadingText="@Text["Loading"]"
                                      ActionsLabel="@Text["Actions"]"
                                      PageSizeOptions="@InvoicePageSizes"
                                      DetailHref="@(invoice => $"/Invoices/View?id={invoice.Id}")"
                                      DetailAriaLabel="@(invoice => Text["ViewInvoice", invoice.Id])"
                                      DetailsAriaLabel="@(invoice => Text["ExpandInvoice", invoice.Id])">
                        <QuickViewContent Context="invoice"><dl class="operational-quick-view">
                            <div><dt>@Text["ReceiptId"]</dt><dd class="mlv-mono">@(invoice.ReceiptId?.ToString(CultureInfo.InvariantCulture) ?? "-")</dd></div>
                            <div><dt>@Text["PurchaseOrder"]</dt><dd class="mlv-mono">@ValueOrFallback(invoice.PurchaseOrderNumber)</dd></div>
                            <div><dt>@Text["Subtotal"]</dt><dd class="mlv-mono">@FormatMoney(invoice.Subtotal, invoice.Currency)</dd></div>
                            <div><dt>@Text["Vat"]</dt><dd class="mlv-mono">@FormatMoney(invoice.Vat, invoice.Currency)</dd></div>
                            <div><dt>@Text["WithholdingTax"]</dt><dd class="mlv-mono">@FormatMoney(invoice.WithholdingTax, invoice.Currency, negate: true)</dd></div>
                            <div><dt>@Text["PaymentDate"]</dt><dd class="mlv-mono">@FormatCalendarDate(invoice.PaymentDate)</dd></div>
                            <div><dt>@Text["CreatedDate"]</dt><dd class="mlv-mono">@FormatTimestamp(invoice.CreatedDate)</dd></div>
                        </dl></QuickViewContent>
                    </OperationalDataTable>
            </section>
        }
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private static readonly InvoiceListPage EmptyPage = new([], 1, 0, 0, false, false);
    private static readonly int[] InvoicePageSizes = [10, 25, 50, 100, 150];
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 10 };
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Invoices"]),
    ];
    private InvoiceListPage paidInvoices = EmptyPage;
    private InvoiceListPage unpaidInvoices = EmptyPage;
    private InvoiceListSort currentSort = InvoiceListSort.InvoiceCreatedDate_Descending;
    private bool loading;
    private string? error;
    private IReadOnlyList<ShadcnDataTableColumn<InvoiceListItem>> Columns =>
    [
        new("id", Text["Id"], invoice => invoice.Id) { Sortable = true, Hideable = false },
        new("number", Text["Number"], invoice => invoice.Number),
        new("customer", Text["CustomerId"], invoice => invoice.CustomerId) { CellTemplate = invoice => CustomerLink(invoice.CustomerId) },
        new("paid", Text["Paid"], invoice => invoice.IsPaid ? Text["PaidStatus"] : Text["UnpaidStatus"]),
        new("outstanding", Text["Outstanding"], invoice => invoice.Outstanding) { Alignment = ShadcnTableAlignment.End, CellTemplate = invoice => builder => builder.AddContent(0, FormatMoney(invoice.Outstanding, invoice.Currency)) },
        new("total", Text["Total"], invoice => invoice.Total) { Alignment = ShadcnTableAlignment.End, CellTemplate = invoice => builder => builder.AddContent(0, FormatMoney(invoice.Total, invoice.Currency)) },
        new("receipt", Text["ReceiptId"], invoice => invoice.ReceiptId),
        new("purchase-order", Text["PurchaseOrder"], invoice => ValueOrFallback(invoice.PurchaseOrderNumber)),
        new("subtotal", Text["Subtotal"], invoice => invoice.Subtotal) { Alignment = ShadcnTableAlignment.End, CellTemplate = invoice => builder => builder.AddContent(0, FormatMoney(invoice.Subtotal, invoice.Currency)) },
        new("vat", Text["Vat"], invoice => invoice.Vat) { Alignment = ShadcnTableAlignment.End, CellTemplate = invoice => builder => builder.AddContent(0, FormatMoney(invoice.Vat, invoice.Currency)) },
        new("withholding", Text["WithholdingTax"], invoice => invoice.WithholdingTax) { Alignment = ShadcnTableAlignment.End, CellTemplate = invoice => builder => builder.AddContent(0, FormatMoney(invoice.WithholdingTax, invoice.Currency, negate: true)) },
        new("payment-date", Text["PaymentDate"], invoice => invoice.PaymentDate) { Sortable = true, CellTemplate = invoice => builder => builder.AddContent(0, FormatCalendarDate(invoice.PaymentDate)) },
        new("created", Text["CreatedDate"], invoice => invoice.CreatedDate) { Sortable = true, CellTemplate = invoice => builder => builder.AddContent(0, FormatTimestamp(invoice.CreatedDate)) },
    ];

    private IReadOnlyList<(string Title, string EmptyMessage, bool Paid, InvoiceListPage Page)> Sections =>
    [
        (Text["UnpaidInvoices"], Text["NoUnpaidInvoices"], false, unpaidInvoices),
        (Text["PaidInvoices"], Text["NoPaidInvoices"], true, paidInvoices),
    ];
    protected override async Task OnParametersSetAsync()
    {
        Index = Math.Max(1, Index);
        Size = Size is 10 or 25 or 50 or 100 or 150 ? Size : 10;
        currentSort = Enum.TryParse<InvoiceListSort>(SortQuery, true, out var parsed)
            ? parsed
            : InvoiceListSort.InvoiceCreatedDate_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = requestGate.Begin();
        loading = true;
        error = null;
        HttpResponseMessage[]? responses = null;
        try
        {
            var query = $"sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={Index}&size={Size}";
            responses = await Task.WhenAll(
                Http.GetForPresentationAsync($"/bff/invoices?{query}&paid=true", lease.CancellationToken),
                Http.GetForPresentationAsync($"/bff/invoices?{query}&paid=false", lease.CancellationToken));
            if (!lease.IsCurrent)
            {
                return;
            }
            if (HandleFailure(responses))
            {
                return;
            }

            var paid = await responses[0].Content.ReadFromJsonAsync<InvoiceListPage>(lease.CancellationToken) ?? EmptyPage;
            var unpaid = await responses[1].Content.ReadFromJsonAsync<InvoiceListPage>(lease.CancellationToken) ?? EmptyPage;
            if (!lease.IsCurrent)
            {
                return;
            }

            paidInvoices = paid;
            unpaidInvoices = unpaid;
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            if (responses is not null)
            {
                foreach (var response in responses)
                {
                    response.Dispose();
                }
            }

            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private bool HandleFailure(IEnumerable<HttpResponseMessage> responses)
    {
        var failed = responses.FirstOrDefault(response => !response.IsSuccessStatusCode);
        if (failed is null)
        {
            return false;
        }

        if (failed.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        }
        else
        {
            error = failed.StatusCode switch
            {
                HttpStatusCode.Forbidden => Text["Forbidden"],
                HttpStatusCode.TooManyRequests => Text["RateLimited"],
                HttpStatusCode.BadGateway => Text["InvalidResponse"],
                _ => Text["Unavailable"],
            };
        }

        return true;
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, InvoiceListSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/Invoices/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={size}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, Index - 1),
        PageSize = Size,
        Sorts = currentSort switch
        {
            InvoiceListSort.InvoiceId_Ascending => [new("id", ShadcnSortDirection.Ascending)],
            InvoiceListSort.InvoiceId_Descending => [new("id", ShadcnSortDirection.Descending)],
            InvoiceListSort.InvoiceCreatedDate_Ascending => [new("created", ShadcnSortDirection.Ascending)],
            InvoiceListSort.InvoiceCreatedDate_Descending => [new("created", ShadcnSortDirection.Descending)],
            InvoiceListSort.InvoicePaymentDate_Ascending => [new("payment-date", ShadcnSortDirection.Ascending)],
            InvoiceListSort.InvoicePaymentDate_Descending => [new("payment-date", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private InvoiceListSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => InvoiceListSort.InvoiceId_Ascending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => InvoiceListSort.InvoiceId_Descending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Ascending } => InvoiceListSort.InvoiceCreatedDate_Ascending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Descending } => InvoiceListSort.InvoiceCreatedDate_Descending,
        { ColumnKey: "payment-date", Direction: ShadcnSortDirection.Ascending } => InvoiceListSort.InvoicePaymentDate_Ascending,
        { ColumnKey: "payment-date", Direction: ShadcnSortDirection.Descending } => InvoiceListSort.InvoicePaymentDate_Descending,
        _ => currentSort,
    };

    private RenderFragment CustomerLink(int customerId) => builder =>
    {
        builder.OpenComponent<LegacyLink>(0);
        builder.AddAttribute(1, nameof(LegacyLink.Href), $"/Customers/View?id={customerId}");
        builder.AddAttribute(2, nameof(LegacyLink.Role), LegacyLinkRole.Record);
        builder.AddAttribute(3, nameof(LegacyLink.AriaLabel), $"{Text["CustomerId"]} {customerId}");
        builder.AddAttribute(4, nameof(LegacyLink.ChildContent), (RenderFragment)(content => content.AddContent(0, customerId)));
        builder.CloseComponent();
    };

    private static string FormatMoney(decimal? value, string? currency, bool negate = false) =>
        value is null ? "-" : $"{(negate ? -value.Value : value.Value):N2} {ValueOrFallback(currency)}";
    private static string FormatTimestamp(DateTime? value) =>
        LegacyPresentation.FormatUtcDateTime(value, CultureInfo.CurrentCulture, "-");
    private static string FormatCalendarDate(DateTime? value) =>
        LegacyPresentation.FormatCalendarDate(value, CultureInfo.CurrentCulture, "-");
    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
