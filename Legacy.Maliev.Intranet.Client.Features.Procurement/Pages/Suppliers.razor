@page "/Suppliers/Index"
@page "/purchasing/suppliers"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Suppliers> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="procurement-list-page supplier-list">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header">
        <div><h1>@Text["Suppliers"]</h1><p>@Text["Procurement"]</p></div>
        <ShadcnButton OnClick="OpenCreate">@Text["CreateSupplier"]</ShadcnButton>
    </header>

    <ListToolbar TSort="SupplierListSort"
                 Value="@ToolbarValue"
                 Defaults="@ToolbarDefaults"
                 SortOptions="@ToolbarSortOptions"
                 PageSizeOptions="@ToolbarPageSizes"
                 SearchLabel="@Text["Search"]"
                 ResultsId="suppliers-results"
                 ResultsStatus="@ToolbarResultsStatus"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div class="procurement-list-page__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["Empty"]</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        <div id="suppliers-results" aria-busy="false">
        <OperationalTable TItem="SupplierListItem" TKey="int" Items="@(page.Items)"
                          KeySelector="@(supplier => supplier.Id)" TableLabel="@Text["SuppliersTable"]"
                          ColumnCount="5" State="@tableState"
                          DetailHref="@(supplier => $"/Suppliers/View?id={supplier.Id}")"
                          DetailAriaLabel="@(supplier => Text["ViewSupplier", supplier.Id])"
                          ExpandAriaLabel="@(supplier => Text["ExpandSupplier", supplier.Id])"
                          CollapseAriaLabel="@(supplier => Text["CollapseSupplier", supplier.Id])">
            <HeaderContent>
                <tr><th class="operational-table__identity" data-priority="essential">@Text["Id"]</th>
                    <th data-priority="essential">@Text["Name"]</th><th data-priority="essential">@Text["Email"]</th>
                    <th data-priority="supporting">@Text["Telephone"]</th>
                    <th class="operational-table__actions-heading"><span class="visually-hidden">@Text["Actions"]</span></th></tr>
            </HeaderContent>
            <RowContent Context="supplier">
                <td class="operational-table__identity mlv-mono" data-priority="essential">@supplier.Id</td>
                <td data-priority="essential">@ValueOrFallback(supplier.Name)</td>
                <td data-priority="essential">@ValueOrFallback(supplier.Email)</td>
                <td data-priority="supporting">@ValueOrFallback(supplier.Telephone)</td>
            </RowContent>
            <QuickViewContent Context="supplier"><dl class="operational-quick-view">
                <div><dt>@Text["Telephone"]</dt><dd>@ValueOrFallback(supplier.Telephone)</dd></div>
                <div><dt>@Text["Email"]</dt><dd>@ValueOrFallback(supplier.Email)</dd></div>
            </dl></QuickViewContent>
        </OperationalTable>
        </div>
        <nav class="procurement-pager" aria-label="@Text["SupplierPages"]">
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</ShadcnButton>
            <span aria-live="polite">@Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords]</span>
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</ShadcnButton>
        </nav>
    }
</main>

@code {
    private static readonly int[] ToolbarPageSizes = [10, 25, 50, 100, 250];

    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private SupplierListPage? page;
    private string? error;
    private bool loading;
    private SupplierListSort currentSort = SupplierListSort.SupplierId_Descending;
    private readonly LatestRequestGate loadGate = new();
    private readonly OperationalTableState<int> tableState = new();
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Procurement"], "/purchasing"),
        new(Text["Suppliers"]),
    ];

    private ListToolbarState<SupplierListSort> ToolbarValue => new(Search, currentSort, Size);
    private static ListToolbarState<SupplierListSort> ToolbarDefaults =>
        new(null, SupplierListSort.SupplierId_Descending, 25);
    private IReadOnlyList<ListToolbarOption<SupplierListSort>> ToolbarSortOptions =>
        Enum.GetValues<SupplierListSort>()
            .Select(value => new ListToolbarOption<SupplierListSort>(value, Text[value.ToString()].Value))
            .ToArray();
    private string? ToolbarResultsStatus => page is null
        ? null
        : Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords].Value;

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        currentSort = Enum.TryParse<SupplierListSort>(SortQuery, ignoreCase: true, out var parsedSort) && Enum.IsDefined(parsedSort)
            ? parsedSort
            : SupplierListSort.SupplierId_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = loadGate.Begin();
        tableState.Clear();
        if (lease.IsCurrent)
        {
            loading = true;
            error = null;
            page = null;
        }
        try
        {
            var uri = $"/bff/suppliers?sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={Index}&size={Size}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                error = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var nextPage = await response.Content.ReadFromJsonAsync<SupplierListPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (nextPage?.Items is null)
            {
                error = Text["InvalidResponse"];
                return;
            }
            page = nextPage;
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task HandleToolbarRequestAsync(ListToolbarRequest<SupplierListSort> request)
    {
        if (request.Reason == ListToolbarChangeReason.Refreshed && request.State == ToolbarValue)
        {
            return LoadAsync();
        }

        return NavigateAsync(1, request.State.Search, request.State.Sort, request.State.PageSize, replace: true);
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private void OpenCreate() => Navigation.NavigateTo("/Suppliers/Create");

    private Task NavigateAsync(int index, string? search, SupplierListSort sort, int size, bool replace = false)
    {
        tableState.Clear();
        Navigation.NavigateTo($"/Suppliers/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => loadGate.Dispose();

    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
