@page "/Suppliers/Create"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SupplierCreate> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="supplier-editor-page">
    <header class="operations-page-header"><div><h1>@Text["CreateSupplier"]</h1><p>@Text["Procurement"]</p></div></header>
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="HandleInvalidSubmit" class="supplier-editor-form">
        <DataAnnotationsValidator />
        <section class="supplier-editor-section" aria-labelledby="supplier-details-heading">
            <h2 id="supplier-details-heading">@Text["Supplier"]</h2>
            <div class="supplier-editor-grid">
                <ProcurementInputField TValue="string" Id="supplier-name" Label="@Text["Name"]" @bind-Value="model.Name" Required="true" MaxLength="256" />
                <ProcurementInputField TValue="string" Id="supplier-website" Label="@Text["Website"]" Type="url" @bind-Value="model.Website" />
                <ProcurementInputField TValue="string" Id="supplier-tax-number" Label="@Text["TaxNumber"]" @bind-Value="model.TaxNumber" />
                <ProcurementInputField TValue="string" Id="supplier-email" Label="@Text["Email"]" Type="email" @bind-Value="model.Email" />
                <ProcurementInputField TValue="string" Id="supplier-telephone" Label="@Text["Telephone"]" Type="tel" @bind-Value="model.Telephone" />
                <ProcurementInputField TValue="string" Id="supplier-mobile" Label="@Text["Mobile"]" Type="tel" @bind-Value="model.Mobile" />
                <ProcurementInputField TValue="string" Id="supplier-fax" Label="@Text["Fax"]" @bind-Value="model.Fax" />
                <ShadcnFormField Id="supplier-note" Label="@Text["Note"]" Class="supplier-editor-wide"><Control><ShadcnTextarea TValue="string" id="supplier-note" @bind-Value="model.Note" /></Control></ShadcnFormField>
            </div>
        </section>

        <section class="supplier-editor-section" aria-labelledby="supplier-address-heading">
            <h2 id="supplier-address-heading">@Text["Address"]</h2>
            <div class="supplier-editor-grid">
                <ProcurementInputField TValue="string" Id="supplier-building" Label="@Text["Building"]" @bind-Value="model.Building" />
                <ProcurementInputField TValue="string" Id="supplier-address-1" Label="@Text["Address1"]" @bind-Value="model.Address1" Required="true" />
                <ProcurementInputField TValue="string" Id="supplier-address-2" Label="@Text["Address2"]" @bind-Value="model.Address2" />
                <ProcurementInputField TValue="string" Id="supplier-city" Label="@Text["City"]" @bind-Value="model.City" />
                <ProcurementInputField TValue="string" Id="supplier-state" Label="@Text["State"]" @bind-Value="model.State" />
                <ProcurementInputField TValue="string" Id="supplier-postal-code" Label="@Text["PostalCode"]" @bind-Value="model.PostalCode" />
                <ProcurementInputField TValue="int" Id="supplier-country-id" Label="@Text["CountryId"]" Type="number" Min="1" @bind-Value="model.CountryId" Required="true" />
            </div>
        </section>

        <div class="supplier-editor-actions">
            <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@(submitting ? Text["Submitting"] : Text["CreateSupplier"])</ShadcnButton>
            <LegacyLink Href="/Suppliers/Index" Role="LegacyLinkRole.Navigation" Disabled="@submitting" AriaLabel="@Text["Cancel"]">@Text["Cancel"]</LegacyLink>
        </div>
    </EditForm>
</main>

@code {
    private readonly SupplierCreateRequest model = new();
    private EditContext editContext = null!;
    private bool submitting;
    private string? error;

    protected override void OnInitialized() => editContext = new EditContext(model);
    private void HandleInvalidSubmit(EditContext _) => error = Text["ValidationFailed"];

    private async Task SubmitAsync()
    {
        if (submitting) return;
        submitting = true;
        error = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { error = Text["CreateFailed"]; return; }

            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/suppliers") { Content = JsonContent.Create(model) };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { error = Text["Forbidden"]; return; }
            if (response.StatusCode == HttpStatusCode.BadRequest) { error = Text["ValidationFailed"]; return; }
            if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { error = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { error = Text["CreateFailed"]; return; }

            var created = await response.Content.ReadFromJsonAsync<CreatedSupplier>();
            if (created is null || created.Id <= 0) { error = Text["InvalidResponse"]; return; }
            Navigation.NavigateTo($"/Suppliers/View?id={created.Id}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["CreateFailed"];
        }
        finally { submitting = false; }
    }

    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
