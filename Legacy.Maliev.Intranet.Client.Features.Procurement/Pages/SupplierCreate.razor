@page "/Suppliers/Create"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<SupplierCreate> Text
@inject ILogger<SupplierCreate> Logger
@using Microsoft.Extensions.Logging

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="supplier-editor-page">
    <header class="operations-page-header"><div><h1>@Text["CreateSupplier"]</h1><p>@Text["Procurement"]</p></div></header>
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="HandleInvalidSubmit" class="supplier-editor-form">
        <DataAnnotationsValidator />
        <section class="supplier-editor-section" aria-labelledby="supplier-details-heading">
            <h2 id="supplier-details-heading">@Text["Supplier"]</h2>
                <LookupCompanyAssist Id="supplier-company-lookup" Selected="ApplyCompanySuggestion" Disabled="@submitting" />
            <div class="supplier-editor-grid">
                <ProcurementInputField TValue="string" Id="supplier-name" Label="@Text["Name"]" @bind-Value="model.Name" Required="true" MaxLength="256" />
                <ProcurementInputField TValue="string" Id="supplier-website" Label="@Text["Website"]" Type="url" @bind-Value="model.Website" />
                <ProcurementInputField TValue="string" Id="supplier-tax-number" Label="@Text["TaxNumber"]" @bind-Value="model.TaxNumber" />
                <ProcurementInputField TValue="string" Id="supplier-email" Label="@Text["Email"]" Type="email" @bind-Value="model.Email" />
                <ProcurementInputField TValue="string" Id="supplier-telephone" Label="@Text["Telephone"]" Type="tel" @bind-Value="model.Telephone" />
                <ProcurementInputField TValue="string" Id="supplier-mobile" Label="@Text["Mobile"]" Type="tel" @bind-Value="model.Mobile" />
                <ProcurementInputField TValue="string" Id="supplier-fax" Label="@Text["Fax"]" @bind-Value="model.Fax" />
                <ShadcnFormField Id="supplier-note" Label="@Text["Note"]" Class="supplier-editor-wide"><Control><ShadcnTextarea TValue="string" id="supplier-note" @bind-Value="model.Note" /></Control></ShadcnFormField>
            </div>
        </section>

        <section class="supplier-editor-section" aria-labelledby="supplier-address-heading">
            <h2 id="supplier-address-heading">@Text["Address"]</h2>
            <p>@Text["AddressOptionalHint"]</p>
                <LookupAddressAssist Id="supplier-address-lookup" SelectionChanged="ApplyAddressSuggestion" DetailConfirmed="ApplyAddressDetail" CountryKey="@(model.CountryId.ToString(CultureInfo.InvariantCulture))" Disabled="@submitting" />
            <div class="supplier-editor-grid">
                <ProcurementInputField TValue="string" Id="supplier-building" Label="@Text["Building"]" @bind-Value="model.Building" />
                <ProcurementInputField TValue="string" Id="supplier-address-1" Label="@Text["Address1"]" @bind-Value="model.Address1" Required="@model.HasAnyAddress()" />
                <ProcurementInputField TValue="string" Id="supplier-address-2" Label="@Text["Address2"]" @bind-Value="model.Address2" />
                <ProcurementInputField TValue="string" Id="supplier-city" Label="@Text["City"]" @bind-Value="model.City" />
                <ProcurementInputField TValue="string" Id="supplier-state" Label="@Text["State"]" @bind-Value="model.State" />
                <ProcurementInputField TValue="string" Id="supplier-postal-code" Label="@Text["PostalCode"]" @bind-Value="model.PostalCode" />
                <ProcurementSelectField TValue="int" Id="supplier-country-id" Label="@Text["CountryId"]" @bind-Value="model.CountryId" Options="@CountryOptions" Placeholder="@Text["SelectCountry"]" Required="@model.HasAnyAddress()" Disabled="@(submitting || countriesLoading || countries.Count == 0)" />
                @if (countryError is not null) { <div role="alert">@countryError <ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Outline" OnClick="LoadCountriesAsync" Disabled="@(submitting || countriesLoading)">@Text["RetryCountries"]</ShadcnButton></div> }
            </div>
        </section>

        <div class="supplier-editor-actions">
            <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@(submitting || outcomeUnknown)">@(submitting ? Text["Submitting"] : Text["CreateSupplier"])</ShadcnButton>
            <LegacyLink Href="/Suppliers/Index" Role="LegacyLinkRole.Navigation" Disabled="@submitting" AriaLabel="@Text["Cancel"]">@Text["Cancel"]</LegacyLink>
        </div>
    </EditForm>
</main>

@code {
    private void ApplyCompanySuggestion(LookupCompany value)
    {
        if (submitting) return;
        LookupSupplierSuggestions.ApplyCompany(model, value, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th");
        editContext.NotifyFieldChanged(new FieldIdentifier(model, nameof(model.Name)));
        editContext.NotifyFieldChanged(new FieldIdentifier(model, nameof(model.TaxNumber)));
    }
    private void ApplyAddressSuggestion(LookupAddressSelection value)
    {
        if (submitting) return;
        LookupSupplierSuggestions.ApplyAddress(model, value);
        foreach (var field in new[] { nameof(model.City), nameof(model.State), nameof(model.PostalCode) })
            editContext.NotifyFieldChanged(new FieldIdentifier(model, field));
    }
    private void ApplyAddressDetail(string value)
    {
        if (submitting) return;
        model.Address1 = value;
        editContext.NotifyFieldChanged(new FieldIdentifier(model, nameof(model.Address1)));
    }
    private readonly SupplierCreateRequest model = new() { AllowMissingAddress = true };
    private EditContext editContext = null!;
    private bool submitting;
    private bool disposed;
    private bool outcomeUnknown;
    private string? error;
    private IReadOnlyList<EmployeeAdministrationCountry> countries = [];
    private bool countriesLoading;
    private string? countryError;
    private IReadOnlyList<ShadcnSelectOption<int>> CountryOptions => countries.Select(country => new ShadcnSelectOption<int>(country.Id, country.Name)).ToArray();

    protected override void OnInitialized() => editContext = new EditContext(model);
    protected override Task OnInitializedAsync() => LoadCountriesAsync();

    private async Task LoadCountriesAsync()
    {
        if (disposed || countriesLoading) return;
        countriesLoading = true;
        countryError = null;
        try
        {
            using var response = await Http.GetForPresentationAsync("/bff/suppliers/create-countries");
            if (disposed) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (!response.IsSuccessStatusCode) { countryError = Text["CountriesUnavailable"]; return; }
            var values = await response.Content.ReadFromJsonAsync<EmployeeAdministrationCountry[]>();
            if (disposed) return;
            if (values is not { Length: > 0 } || values.Any(value => value is null || value.Id <= 0 || string.IsNullOrWhiteSpace(value.Name)) || values.Select(value => value.Id).Distinct().Count() != values.Length)
            { countryError = Text["CountriesUnavailable"]; return; }
            countries = values;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        { if (!disposed) countryError = Text["CountriesUnavailable"]; }
        finally { if (!disposed) countriesLoading = false; }
    }
    private void HandleInvalidSubmit(EditContext _) => error = Text["ValidationFailed"];

    private async Task SubmitAsync()
    {
        if (submitting || disposed || outcomeUnknown) return;
        submitting = true;
        error = null;
        var snapshot = System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(model, System.Text.Json.JsonSerializerOptions.Web);
        bool Unchanged() => snapshot.AsSpan().SequenceEqual(System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(model, System.Text.Json.JsonSerializerOptions.Web));
        var dispatched = false;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (disposed || !Unchanged()) return;
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (disposed || !Unchanged()) return;
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { error = Text["CreateFailed"]; return; }

            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/suppliers") { Content = new ByteArrayContent(snapshot) };
            request.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/json") { CharSet = "utf-8" };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            dispatched = true;
            using var response = await Http.SendAsync(request);
            if (disposed) return;
            if (!response.IsSuccessStatusCode)
            {
                outcomeUnknown = true;
                var statusMessage = Text["CreateResponseStatus", (int)response.StatusCode].Value;
                var detail = response.StatusCode switch
                {
                    HttpStatusCode.Forbidden => "Forbidden",
                    HttpStatusCode.Conflict => "Conflict",
                    HttpStatusCode.TooManyRequests => "RateLimited",
                    _ => null,
                };
                if (detail is not null) statusMessage += $" {Text[detail]}";
                error = $"{statusMessage} {Text["CreateOutcomeUnknown"]}";
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CreatedSupplier>();
            if (disposed) return;
            if (created is null || created.Id <= 0) { outcomeUnknown = true; error = Text["CreateOutcomeUnknown"]; return; }
            Navigation.NavigateTo($"/Suppliers/View?id={created.Id}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (!disposed) { outcomeUnknown = dispatched; error = Text[dispatched ? "CreateOutcomeUnknown" : "CreateFailed"]; }
        }
        catch (Exception exception) when (dispatched && exception is not OutOfMemoryException)
        {
            Logger.LogWarning("Supplier creation ended unexpectedly after dispatch.");
            if (!disposed) { outcomeUnknown = true; error = Text["CreateOutcomeUnknown"]; }
        }
        finally { if (!disposed) submitting = false; }
    }

    public void Dispose() => disposed = true;

    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
