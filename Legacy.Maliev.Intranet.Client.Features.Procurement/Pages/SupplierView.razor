@page "/Suppliers/View"
@attribute [Authorize]
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@inject IStringLocalizer<SupplierView> Text
@inject IStringLocalizer<SupplierCreate> Fields

<PageTitle>@Text["PageTitle", Id]</PageTitle>
<main class="supplier-editor-page">
    <header class="operations-page-header"><div><h1>@(detail?.Name ?? Text["Supplier"])</h1><p>@Text["SupplierNumber", Id]</p></div></header>
    @if (loading)
    {
        <div class="supplier-editor-loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error) && detail is null)
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    @if (detail is not null)
    {
        @if (!string.IsNullOrWhiteSpace(error)) { <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert> }
        @if (!string.IsNullOrWhiteSpace(notification)) { <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notification</ShadcnAlertDescription></ShadcnAlert> }
        <EditForm EditContext="@editContext" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit" class="supplier-editor-form">
            <DataAnnotationsValidator />
            <section class="supplier-editor-section" aria-labelledby="supplier-edit-heading">
                <h2 id="supplier-edit-heading">@Fields["Supplier"]</h2>
                <div class="supplier-editor-grid">
                    <ProcurementInputField TValue="string" Id="supplier-edit-name" Label="@Fields["Name"]" @bind-Value="model.Name" Required="true" MaxLength="256" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-website" Label="@Fields["Website"]" Type="url" @bind-Value="model.Website" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-tax-number" Label="@Fields["TaxNumber"]" @bind-Value="model.TaxNumber" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-email" Label="@Fields["Email"]" Type="email" @bind-Value="model.Email" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-telephone" Label="@Fields["Telephone"]" Type="tel" @bind-Value="model.Telephone" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-mobile" Label="@Fields["Mobile"]" Type="tel" @bind-Value="model.Mobile" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-fax" Label="@Fields["Fax"]" @bind-Value="model.Fax" Disabled="@submitting" />
                    <ShadcnFormField Id="supplier-edit-note" Label="@Fields["Note"]" Class="supplier-editor-wide"><Control><ShadcnTextarea TValue="string" id="supplier-edit-note" @bind-Value="model.Note" Disabled="@submitting" /></Control></ShadcnFormField>
                </div>
            </section>

            <section class="supplier-editor-section" aria-labelledby="supplier-edit-address-heading">
                <h2 id="supplier-edit-address-heading">@Fields["Address"]</h2>
                <div class="supplier-editor-grid">
                    <ProcurementInputField TValue="string" Id="supplier-edit-building" Label="@Fields["Building"]" @bind-Value="model.Building" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-address-1" Label="@Fields["Address1"]" @bind-Value="model.Address1" Required="true" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-address-2" Label="@Fields["Address2"]" @bind-Value="model.Address2" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-city" Label="@Fields["City"]" @bind-Value="model.City" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-state" Label="@Fields["State"]" @bind-Value="model.State" Disabled="@submitting" />
                    <ProcurementInputField TValue="string" Id="supplier-edit-postal-code" Label="@Fields["PostalCode"]" @bind-Value="model.PostalCode" Disabled="@submitting" />
                    <ProcurementInputField TValue="int" Id="supplier-edit-country-id" Label="@Fields["CountryId"]" Type="number" Min="1" @bind-Value="model.CountryId" Required="true" Disabled="@submitting" />
                </div>
            </section>
            <div class="supplier-editor-actions">
                <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@Text["Save"]</ShadcnButton>
                <LegacyLink Href="/Suppliers/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
            </div>
        </EditForm>

        <section class="supplier-danger-zone" aria-labelledby="supplier-danger-heading">
            <h2 id="supplier-danger-heading">@Text["ConfirmDeleteTitle"]</h2>
            <ShadcnAlertDialog Open="@deleteDialogOpen" OpenChanged="HandleDeleteDialogChangedAsync">
                <ShadcnAlertDialogTrigger id="supplier-delete-trigger" Disabled="@submitting">@Text["Delete"]</ShadcnAlertDialogTrigger>
                <ShadcnAlertDialogContent>
                    <ShadcnAlertDialogHeader>
                        <ShadcnAlertDialogTitle>@Text["ConfirmDeleteTitle"]</ShadcnAlertDialogTitle>
                        <ShadcnAlertDialogDescription>@Text["ConfirmDeleteBody"]</ShadcnAlertDialogDescription>
                    </ShadcnAlertDialogHeader>
                    <ShadcnAlertDialogFooter>
                        <ShadcnAlertDialogCancel Disabled="@submitting">@Text["Cancel"]</ShadcnAlertDialogCancel>
                        <ShadcnAlertDialogAction Disabled="@submitting" OnClick="@(_ => DeleteAsync())">@Text["Delete"]</ShadcnAlertDialogAction>
                    </ShadcnAlertDialogFooter>
                </ShadcnAlertDialogContent>
            </ShadcnAlertDialog>
        </section>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }
    private readonly SupplierCreateRequest model = new();
    private SupplierDetail? detail;
    private EditContext editContext = null!;
    private bool loading, submitting;
    private bool deleteDialogOpen, restoreDeleteTriggerFocus;
    private string? error, notification;

    protected override void OnInitialized() => editContext = new EditContext(model);
    protected override async Task OnParametersSetAsync() => await LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoreDeleteTriggerFocus)
        {
            return;
        }

        restoreDeleteTriggerFocus = false;
        try
        {
            await JavaScript.InvokeVoidAsync("malievFocus.byId", "supplier-delete-trigger");
        }
        catch (JSException)
        {
            // The browser can tear down the page between the close render and
            // this best-effort focus restoration. The dialog is already closed.
        }
        catch (TaskCanceledException)
        {
            // Navigation or browser shutdown cancelled the render callback.
        }
    }

    private Task HandleDeleteDialogChangedAsync(bool open)
    {
        deleteDialogOpen = open;
        restoreDeleteTriggerFocus = !open;
        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        if (Id <= 0) { error = Text["NotFound"]; detail = null; return; }
        loading = true; error = null; notification = null; detail = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/suppliers/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized) { Login(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { error = Text["Forbidden"]; return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { error = Text["NotFound"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { error = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { error = Text["Unavailable"]; return; }
            detail = await response.Content.ReadFromJsonAsync<SupplierDetail>();
            if (detail is null || detail.Id != Id) { detail = null; error = Text["InvalidResponse"]; return; }
            Copy(detail);
            editContext = new EditContext(model);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }

    private void HandleInvalidSubmit(EditContext _) => error = Text["ValidationFailed"];

    private async Task SaveAsync()
    {
        if (submitting) return;
        using var response = await SendWriteAsync(HttpMethod.Put);
        if (response is null || !HandleWrite(response)) return;
        notification = Text["Saved"];
    }

    private async Task DeleteAsync()
    {
        if (submitting) return;
        using var response = await SendWriteAsync(HttpMethod.Delete);
        if (response is null || !HandleWrite(response)) return;
        Navigation.NavigateTo("/Suppliers/Index");
    }

    private async Task<HttpResponseMessage?> SendWriteAsync(HttpMethod method)
    {
        submitting = true; error = null; notification = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            var session = sessionResponse.IsSuccessStatusCode ? await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>() : null;
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { error = Text["Unavailable"]; return null; }
            using var request = new HttpRequestMessage(method, $"/bff/suppliers/{Id}");
            if (method == HttpMethod.Put) request.Content = JsonContent.Create(model);
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            return await Http.SendAsync(request);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; return null; }
        finally { submitting = false; }
    }

    private bool HandleWrite(HttpResponseMessage response)
    {
        if (response.StatusCode == HttpStatusCode.Unauthorized) { Login(); return false; }
        if (response.StatusCode == HttpStatusCode.Forbidden) error = Text["Forbidden"];
        else if (response.StatusCode == HttpStatusCode.NotFound) error = Text["NotFound"];
        else if (response.StatusCode == HttpStatusCode.BadRequest) error = Text["ValidationFailed"];
        else if (response.StatusCode == HttpStatusCode.Conflict) error = Text["Conflict"];
        else if (response.StatusCode == HttpStatusCode.TooManyRequests) error = Text["RateLimited"];
        else if (!response.IsSuccessStatusCode) error = Text["Unavailable"];
        return response.IsSuccessStatusCode;
    }

    private void Copy(SupplierDetail value) { model.Name=value.Name; model.Website=value.Website; model.TaxNumber=value.TaxNumber; model.Email=value.Email; model.Note=value.Note; model.Telephone=value.Telephone; model.Mobile=value.Mobile; model.Fax=value.Fax; model.Building=value.Building; model.Address1=value.Address1; model.Address2=value.Address2; model.City=value.City; model.State=value.State; model.PostalCode=value.PostalCode; model.CountryId=value.CountryId; }
    private void Login() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
