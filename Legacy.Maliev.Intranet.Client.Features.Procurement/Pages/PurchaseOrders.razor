@page "/PurchaseOrders/Index"
@page "/purchasing"
@page "/mfg/procurement"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<PurchaseOrders> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="procurement-list-page">
    <header class="operations-page-header">
        <div><MudText Typo="Typo.h4" HtmlTag="h1">@Text["PurchaseOrders"]</MudText><MudText Typo="Typo.body2">@Text["Procurement"]</MudText></div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">@Text["CreatePurchaseOrder"]</MudButton>
    </header>

    <ListToolbar TSort="PurchaseOrderListSort"
                 Value="@ToolbarValue"
                 Defaults="@ToolbarDefaults"
                 SortOptions="@ToolbarSortOptions"
                 PageSizeOptions="@ToolbarPageSizes"
                 SearchLabel="@Text["Search"]"
                 ResultsId="purchase-orders-results"
                 ResultsStatus="@ToolbarResultsStatus"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite"><MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" /><span class="visually-hidden">@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Text["Empty"]</MudAlert>
    }
    else
    {
        <div id="purchase-orders-results" aria-busy="false">
        <MudTable Items="page.Items" Hover="true" Breakpoint="Breakpoint.Md" Elevation="1" Class="procurement-responsive-table" aria-label="@Text["PurchaseOrdersTable"]">
            <HeaderContent>
                <MudTh>@Text["Id"]</MudTh>
                <MudTh>@Text["Employee"]</MudTh>
                <MudTh>@Text["Fob"]</MudTh>
                <MudTh>@Text["Terms"]</MudTh>
                <MudTh>@Text["Shipping"]</MudTh>
                <MudTh>@Text["Created"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Text["Id"]">
                    <a href="@($"/PurchaseOrders/View?id={context.Id}")"
                       @onclick="@(() => OpenPurchaseOrder(context.Id))"
                       @onclick:preventDefault="true">@context.Id</a>
                </MudTd>
                <MudTd DataLabel="@Text["Employee"]">@EmployeeName(context.EmployeeId)</MudTd>
                <MudTd DataLabel="@Text["Fob"]">@ValueOrFallback(context.Fob)</MudTd>
                <MudTd DataLabel="@Text["Terms"]">@ValueOrFallback(context.Terms)</MudTd>
                <MudTd DataLabel="@Text["Shipping"]">@ValueOrFallback(context.ShippingMethod)</MudTd>
                <MudTd DataLabel="@Text["Created"]">@FormatDate(context.CreatedDate)</MudTd>
            </RowTemplate>
        </MudTable>
        </div>
        <nav class="procurement-pager" aria-label="@Text["PurchaseOrderPages"]">
            <MudButton Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</MudButton>
            <MudText aria-live="polite">@Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords]</MudText>
            <MudButton Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</MudButton>
        </nav>
    }
</MudContainer>

@code {
    private static readonly int[] ToolbarPageSizes = [10, 25, 50, 100, 250];

    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private PurchaseOrderListPage? page;
    private IReadOnlyDictionary<int, string> employeeNames = new Dictionary<int, string>();
    private string? error;
    private bool loading;
    private PurchaseOrderListSort currentSort = PurchaseOrderListSort.PurchaseOrderId_Descending;
    private readonly LatestRequestGate loadGate = new();

    private ListToolbarState<PurchaseOrderListSort> ToolbarValue => new(Search, currentSort, Size);
    private static ListToolbarState<PurchaseOrderListSort> ToolbarDefaults =>
        new(null, PurchaseOrderListSort.PurchaseOrderId_Descending, 25);
    private IReadOnlyList<ListToolbarOption<PurchaseOrderListSort>> ToolbarSortOptions =>
        Enum.GetValues<PurchaseOrderListSort>()
            .Select(value => new ListToolbarOption<PurchaseOrderListSort>(value, Text[value.ToString()].Value))
            .ToArray();
    private string? ToolbarResultsStatus => page is null
        ? null
        : Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords].Value;

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        currentSort = Enum.TryParse<PurchaseOrderListSort>(SortQuery, ignoreCase: true, out var parsedSort) && Enum.IsDefined(parsedSort)
            ? parsedSort
            : PurchaseOrderListSort.PurchaseOrderId_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = loadGate.Begin();
        if (lease.IsCurrent)
        {
            loading = true;
            error = null;
            page = null;
            employeeNames = new Dictionary<int, string>();
        }
        HttpResponseMessage[]? responses = null;
        try
        {
            var ordersTask = Http.GetForPresentationAsync($"/bff/purchase-orders?sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={Index}&size={Size}", lease.CancellationToken);
            var employeesTask = Http.GetForPresentationAsync("/bff/employees?sort=EmployeeId_Ascending&search=&index=1&size=250", lease.CancellationToken);
            responses = await Task.WhenAll(ordersTask, employeesTask);
            if (!lease.IsCurrent || HandleFailure(responses))
            {
                return;
            }

            var nextPage = await responses[0].Content.ReadFromJsonAsync<PurchaseOrderListPage>(cancellationToken: lease.CancellationToken);
            var employees = await responses[1].Content.ReadFromJsonAsync<EmployeeListPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (nextPage?.Items is null || employees?.Items is null)
            {
                error = Text["InvalidResponse"];
                return;
            }

            page = nextPage;
            employeeNames = employees.Items.ToDictionary(value => value.Id, value => value.FullName);
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (responses is not null)
            {
                foreach (var response in responses)
                {
                    response.Dispose();
                }
            }

            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private bool HandleFailure(IEnumerable<HttpResponseMessage> responses)
    {
        var failed = responses.FirstOrDefault(response => !response.IsSuccessStatusCode);
        if (failed is null)
        {
            return false;
        }

        if (failed.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        }
        else if (failed.StatusCode == HttpStatusCode.Forbidden)
        {
            error = Text["Forbidden"];
        }
        else if (failed.StatusCode == HttpStatusCode.TooManyRequests)
        {
            error = Text["RateLimited"];
        }
        else if (failed.StatusCode == HttpStatusCode.BadGateway)
        {
            error = Text["InvalidResponse"];
        }
        else
        {
            error = Text["Unavailable"];
        }

        return true;
    }

    private Task HandleToolbarRequestAsync(ListToolbarRequest<PurchaseOrderListSort> request)
    {
        if (request.Reason == ListToolbarChangeReason.Refreshed && request.State == ToolbarValue)
        {
            return LoadAsync();
        }

        return NavigateAsync(1, request.State.Search, request.State.Sort, request.State.PageSize, replace: true);
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);
    private void OpenCreate() => Navigation.NavigateTo("/PurchaseOrders/Create");
    private void OpenPurchaseOrder(int id) => Navigation.NavigateTo($"/PurchaseOrders/View?id={id}");

    private Task NavigateAsync(int index, string? search, PurchaseOrderListSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/PurchaseOrders/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => loadGate.Dispose();

    private string EmployeeName(int? id) => id is int value && employeeNames.TryGetValue(value, out var name) ? name : "-";
    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) =>
        LegacyPresentation.FormatUtcDateTime(value, CultureInfo.CurrentCulture, "-");
}
