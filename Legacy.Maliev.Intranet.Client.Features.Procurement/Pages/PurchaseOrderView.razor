@page "/PurchaseOrders/View"
@attribute [Authorize]
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JavaScript
@inject IStringLocalizer<PurchaseOrderView> Text

<PageTitle>@(detail is null ? Text["PageTitle"] : Text["PageTitleWithId", detail.Id])</PageTitle>

<main class="purchase-order-view-page">
    @if (loading)
    {
        <div class="purchase-order-view-loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error) && detail is null)
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        <div class="purchase-order-view-actions">
            @if (!forbidden) { <ShadcnButton OnClick="LoadAsync">@Text["Retry"]</ShadcnButton> }
            <LegacyLink Href="/PurchaseOrders/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
        </div>
    }
    else if (notFound)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["NotFound"]</ShadcnAlertDescription></ShadcnAlert>
        <LegacyLink Href="/PurchaseOrders/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]" Class="purchase-order-view-back">@Text["Back"]</LegacyLink>
    }
    else if (detail is not null)
    {
        <header class="operations-page-header">
            <div><h1>@Text["PurchaseOrder", detail.Id]</h1><p>@Text["Procurement"]</p></div>
            <div class="purchase-order-downloads">
                @foreach (var download in detail.Downloads)
                {
                    <ShadcnButton Href="@download.Url.AbsoluteUri" Target="_blank" Rel="noopener" Variant="ShadcnButtonVariant.Outline">@Text["DownloadPdf"]</ShadcnButton>
                }
            </div>
        </header>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        }
        <section class="purchase-order-summary" aria-label="@Text["PurchaseOrder", detail.Id]">
            <dl>
                <div><dt>@Text["Supplier"]</dt><dd>@Value(detail.SupplierName)</dd></div>
                <div><dt>@Text["SupplierContact"]</dt><dd>@Value(detail.SupplierContactPerson)</dd></div>
                <div><dt>@Text["OrderedBy"]</dt><dd>@Value(detail.OrderedBy)</dd></div>
                <div><dt>@Text["ShippingMethod"]</dt><dd>@Value(detail.ShippingMethod)</dd></div>
                <div><dt>@Text["Fob"]</dt><dd>@Value(detail.Fob)</dd></div>
                <div><dt>@Text["Terms"]</dt><dd>@Value(detail.Terms)</dd></div>
                <div><dt>@Text["Created"]</dt><dd>@FormatDate(detail.CreatedDate)</dd></div>
                <div class="purchase-order-summary-wide"><dt>@Text["Notes"]</dt><dd>@Value(detail.Notes)</dd></div>
            </dl>
        </section>

        <ShadcnTable Class="purchase-order-lines" ExpectedColumnCount="5">
            <ShadcnTableCaption Class="sr-only">@Text["LineItemsTable"]</ShadcnTableCaption>
            <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["PartNumber"]</ShadcnTableHead><ShadcnTableHead>@Text["Description"]</ShadcnTableHead><ShadcnTableHead>@Text["UnitPrice"]</ShadcnTableHead><ShadcnTableHead>@Text["Quantity"]</ShadcnTableHead><ShadcnTableHead>@Text["Subtotal"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
            <ShadcnTableBody>
                @foreach (var item in detail.Items)
                {
                    <ShadcnTableRow>
                        <ShadcnTableCell data-label="@Text["PartNumber"]">@Value(item.PartNumber)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Text["Description"]">@Value(item.Description)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Text["UnitPrice"]" class="purchase-order-money">@Money(item.UnitPrice)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Text["Quantity"]" class="purchase-order-number">@item.Quantity</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Text["Subtotal"]" class="purchase-order-money">@Money(item.Subtotal)</ShadcnTableCell>
                    </ShadcnTableRow>
                }
            </ShadcnTableBody>
        </ShadcnTable>

        <section class="purchase-order-danger-zone" aria-labelledby="purchase-order-danger-heading">
            <h2 id="purchase-order-danger-heading">@Text["ConfirmDeleteTitle"]</h2>
            <ShadcnAlertDialog Open="@deleteDialogOpen" OpenChanged="HandleDeleteDialogChangedAsync">
                <ShadcnAlertDialogTrigger id="purchase-order-delete-trigger" Disabled="@deleting">@Text["Delete"]</ShadcnAlertDialogTrigger>
                <ShadcnAlertDialogContent>
                    <ShadcnAlertDialogHeader>
                        <ShadcnAlertDialogTitle>@Text["ConfirmDeleteTitle"]</ShadcnAlertDialogTitle>
                        <ShadcnAlertDialogDescription>@Text["ConfirmDeleteBody"]</ShadcnAlertDialogDescription>
                    </ShadcnAlertDialogHeader>
                    <ShadcnAlertDialogFooter>
                        <ShadcnAlertDialogCancel Disabled="@deleting">@Text["Cancel"]</ShadcnAlertDialogCancel>
                        <ShadcnAlertDialogAction Disabled="@deleting" OnClick="@(_ => DeleteAsync())">@Text["Delete"]</ShadcnAlertDialogAction>
                    </ShadcnAlertDialogFooter>
                </ShadcnAlertDialogContent>
            </ShadcnAlertDialog>
        </section>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }
    private PurchaseOrderDetail? detail;
    private bool loading = true;
    private bool deleteDialogOpen, restoreDeleteTriggerFocus;
    private bool notFound;
    private bool deleting;
    private bool forbidden;
    private string? error;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; notFound = false; forbidden = false; error = null; detail = null;
        if (Id <= 0) { notFound = true; loading = false; return; }
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/purchase-orders/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { forbidden = true; error = Text["Forbidden"]; return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { notFound = true; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { error = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { error = Text["Unavailable"]; return; }
            detail = await response.Content.ReadFromJsonAsync<PurchaseOrderDetail>();
            if (detail is null || detail.Id != Id) error = Text["InvalidResponse"];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }

    private async Task DeleteAsync()
    {
        if (deleting) return;
        deleting = true; error = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { error = Text["DeleteFailed"]; return; }
            using var request = new HttpRequestMessage(HttpMethod.Delete, $"/bff/purchase-orders/{Id}");
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { error = Text["ForbiddenDelete"]; return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { Navigation.NavigateTo("/PurchaseOrders/Index"); return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { error = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { error = Text["DeleteFailed"]; return; }
            Navigation.NavigateTo("/PurchaseOrders/Index");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["DeleteFailed"]; }
        finally { deleting = false; }
    }

    private string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Money(decimal value) => $"{value:N2} THB";
    private static string FormatDate(DateTime? value) => LegacyPresentation.FormatUtcDateTime(value, CultureInfo.CurrentCulture, "-");
    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!restoreDeleteTriggerFocus)
        {
            return;
        }

        restoreDeleteTriggerFocus = false;
        try
        {
            await JavaScript.InvokeVoidAsync("malievFocus.byId", "purchase-order-delete-trigger");
        }
        catch (JSException)
        {
            // The browser can tear down the page between the close render and
            // this best-effort focus restoration. The dialog is already closed.
        }
        catch (TaskCanceledException)
        {
            // Navigation or browser shutdown cancelled the render callback.
        }
    }

    private Task HandleDeleteDialogChangedAsync(bool open)
    {
        deleteDialogOpen = open;
        restoreDeleteTriggerFocus = !open;
        return Task.CompletedTask;
    }
}
