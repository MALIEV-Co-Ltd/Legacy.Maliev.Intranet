@using Microsoft.Extensions.Options
@inject IOptions<ShadcnOptions> ConfiguredOptions

<MudThemeProvider Theme="@_theme" IsDarkMode="@EffectiveDarkMode" />
<div @attributes="AdditionalAttributes"
     class="@RootClass"
     style="@RootStyle"
     data-shadcn-scope
     data-shadcn-theme="@(EffectiveDarkMode ? "dark" : "light")"
     dir="@(EffectiveDirection == ShadcnDirection.RightToLeft ? "rtl" : "ltr")">
    <MudRTLProvider RightToLeft="@(EffectiveDirection == ShadcnDirection.RightToLeft)">
        <MudPopoverProvider />
        <MudDialogProvider BackgroundClass="@ShadcnCss.OverlayScopeClass" />
        <MudSnackbarProvider />
        <CascadingValue Value="@Context">
            @ChildContent
        </CascadingValue>
    </MudRTLProvider>
</div>

@code {
    private MudTheme _theme = null!;
    private ShadcnOptions _options = null!;

    [Parameter] public bool? IsDarkMode { get; set; }
    [Parameter] public ShadcnDirection? Direction { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool EffectiveDarkMode => IsDarkMode ?? _options.DefaultDarkMode;
    private ShadcnDirection EffectiveDirection => Direction ?? _options.DefaultDirection;
    private ShadcnContext Context => new(EffectiveDarkMode, EffectiveDirection);
    private string RootClass => JoinValues(ShadcnCss.ScopeClass, Class, GetAdditionalAttribute("class"));
    private string RootStyle => JoinStyles(Style, GetAdditionalAttribute("style"),
        $"--shadcn-font-sans: {_options.FontFamily}");

    protected override void OnInitialized()
    {
        _options = ConfiguredOptions.Value;
        _theme = ShadcnThemeFactory.Create(_options);
    }

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(EffectiveDirection))
            throw new ArgumentOutOfRangeException(nameof(Direction), EffectiveDirection,
                "Shadcn direction must be LeftToRight or RightToLeft.");
    }

    private string? GetAdditionalAttribute(string name) => AdditionalAttributes?
        .FirstOrDefault(attribute => string.Equals(attribute.Key, name, StringComparison.OrdinalIgnoreCase))
        .Value?.ToString();

    private static string JoinValues(params string?[] values) => string.Join(" ", values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim()));

    private static string JoinStyles(params string?[] values) => string.Join("; ", values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim().TrimEnd(';')));
}
