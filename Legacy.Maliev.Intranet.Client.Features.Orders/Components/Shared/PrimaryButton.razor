@if (!string.IsNullOrWhiteSpace(Href))
{
    <ShadcnButton Class="@CssClass" Href="@Href" Variant="ShadcnButtonVariant.Default">
        @IconMarkup
        @ChildContent
    </ShadcnButton>
}
else
{
    <ShadcnButton Class="@CssClass" ButtonType="@ResolvedButtonType"
                  Disabled="@(Disabled || Busy)" aria-busy="@Busy" OnClick="OnClick"
                  Variant="ShadcnButtonVariant.Default">
        @if (Busy)
        {
            <ShadcnSpinner Class="mlv-button-spinner" Label="@BusyLabel" Size="1rem" />
        }
        else
        {
            @IconMarkup
        }
        @if (Busy && !string.IsNullOrWhiteSpace(BusyLabel))
        {
            <span>@BusyLabel</span>
        }
        else
        {
            <span>@ChildContent</span>
        }
    </ShadcnButton>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? BusyLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }

    private string CssClass => $"mlv-button primary {Class}".Trim();
    private ShadcnButtonType ResolvedButtonType => string.Equals(Type, "submit", StringComparison.OrdinalIgnoreCase)
        ? ShadcnButtonType.Submit
        : ShadcnButtonType.Button;
    private RenderFragment? IconMarkup => string.IsNullOrWhiteSpace(Icon) ? null : builder =>
    {
        var icon = new ShadcnIconData("material-path", "legacy", "0 0 24 24", $"<path d=\"{System.Security.SecurityElement.Escape(Icon)}\" />");
        builder.OpenComponent<ShadcnIcon>(0);
        builder.AddAttribute(1, nameof(ShadcnIcon.Icon), icon);
        builder.AddAttribute(2, nameof(ShadcnIcon.Size), 18d);
        builder.CloseComponent();
    };
}
