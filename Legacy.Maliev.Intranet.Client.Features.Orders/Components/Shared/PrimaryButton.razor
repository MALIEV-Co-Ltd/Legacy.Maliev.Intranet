@if (!string.IsNullOrWhiteSpace(Href))
{
    <MudButton Class="@($"mlv-button primary {Class}")" Href="@Href" StartIcon="@Icon"
               Variant="Variant.Filled" Color="Color.Primary">
        @ChildContent
    </MudButton>
}
else
{
    <MudButton Class="@($"mlv-button primary {Class}")" ButtonType="@ResolvedButtonType"
               Disabled="@(Disabled || Busy)" aria-busy="@Busy" OnClick="OnClick"
               StartIcon="@(Busy ? null : Icon)" Variant="Variant.Filled" Color="Color.Primary">
        @if (Busy)
        {
            <MudProgressCircular Class="mlv-button-spinner" Size="Size.Small" Indeterminate="true" />
        }
        @if (Busy && !string.IsNullOrWhiteSpace(BusyLabel))
        {
            <span>@BusyLabel</span>
        }
        else
        {
            <span>@ChildContent</span>
        }
    </MudButton>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? BusyLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }

    private ButtonType ResolvedButtonType => string.Equals(Type, "submit", StringComparison.OrdinalIgnoreCase)
        ? ButtonType.Submit
        : ButtonType.Button;
}
