@page "/Orders/View"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<OrderDetail> Text

<PageTitle>@Text["PageTitle", Id ?? 0]</PageTitle>

<main class="order-detail">
@if (loading)
{
    <div class="order-detail__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
}
else if (page is not null)
{
    <header class="operations-page-header order-detail-header">
        <div><h1>@Text["OrderHeading", page.Order.Id]</h1><p>@Text["OrderDetails"]</p></div>
        <div class="order-header-actions">
            <LegacyLink Href="/Orders/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["BackToOrders"]">@Text["BackToOrders"]</LegacyLink>
            <ShadcnButton Href="@($"/bff/orders/{page.Order.Id}/label")" Target="_blank" Rel="noopener" Variant="ShadcnButtonVariant.Outline">@Text["OrderLabel"]</ShadcnButton>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notice</ShadcnAlertDescription></ShadcnAlert>
    }

    <EditForm Model="@edit" OnSubmit="SaveAsync" class="order-edit-form">
        <ShadcnAccordion Values="@openSections" ValuesChanged="@(values => openSections = values)" Multiple="true" Label="@Text["OrderDetails"]" Class="order-edit-sections">
            <ShadcnAccordionItem Value="details"><ShadcnAccordionTrigger>@Text["OrderDetails"]</ShadcnAccordionTrigger><ShadcnAccordionContent>
                <div class="order-edit-grid">
                    <ShadcnFormField Id="order-customer" Label="@Text["CustomerId"]"><Control><ShadcnInput TValue="string" id="order-customer" Value="@(page.Order.CustomerId?.ToString(CultureInfo.CurrentCulture) ?? "-")" ReadOnly="true" /></Control></ShadcnFormField>
                    @if (page.Order.CustomerId is int customerId) { <div class="order-customer-link"><ShadcnButton Href="@($"/Customers/View?id={customerId}")" Variant="ShadcnButtonVariant.Outline">@Text["CustomerInfo"]</ShadcnButton></div> }
                <ShadcnFormField Id="order-employee" Label="@Text["Employee"]"><Control><ShadcnSelect TValue="int?" id="order-employee" @bind-Value="edit.EmployeeId" Options="@EmployeeOptions" Placeholder="@Text["Employee"]" Clearable="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-name" Label="@Text["Name"]"><Control><ShadcnInput TValue="string" id="order-name" Type="text" Required="true" @bind-Value="edit.Name" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-quantity" Label="@Text["Quantity"]"><Control><ShadcnInput TValue="int" id="order-quantity" Type="number" min="1" Required="true" @bind-Value="edit.Quantity" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-manufactured" Label="@Text["Manufactured"]"><Control><ShadcnInput TValue="int" id="order-manufactured" Type="number" min="0" Required="true" @bind-Value="edit.Manufactured" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="order-remaining" Label="@Text["Remaining"]"><Control><ShadcnInput TValue="string" id="order-remaining" Value="@(page.Order.Remaining?.ToString(CultureInfo.CurrentCulture) ?? "-")" ReadOnly="true" /></Control></ShadcnFormField>
                </div>
            </ShadcnAccordionContent></ShadcnAccordionItem>

            <ShadcnAccordionItem Value="process"><ShadcnAccordionTrigger>@Text["Process"]</ShadcnAccordionTrigger><ShadcnAccordionContent><div class="order-edit-grid">
                <ShadcnFormField Id="order-process" Label="@Text["Process"]"><Control><ShadcnSelect TValue="int" id="order-process" @bind-Value="edit.ProcessId" Options="@ProcessOptions" Placeholder="@Text["Process"]" Clearable="false" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-material" Label="@Text["Material"]"><Control><ShadcnSelect TValue="int?" id="order-material" @bind-Value="edit.MaterialId" Options="@MaterialOptions" Placeholder="@Text["Material"]" Clearable="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-color" Label="@Text["Color"]"><Control><ShadcnSelect TValue="int?" id="order-color" @bind-Value="edit.ColorId" Options="@ColorOptions" Placeholder="@Text["Color"]" Clearable="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-finish" Label="@Text["SurfaceFinish"]"><Control><ShadcnSelect TValue="int?" id="order-finish" @bind-Value="edit.SurfaceFinishId" Options="@SurfaceFinishOptions" Placeholder="@Text["SurfaceFinish"]" Clearable="true" /></Control></ShadcnFormField>
            </div></ShadcnAccordionContent></ShadcnAccordionItem>

            <ShadcnAccordionItem Value="price"><ShadcnAccordionTrigger>@Text["UnitPrice"]</ShadcnAccordionTrigger><ShadcnAccordionContent><div class="order-edit-grid">
                <ShadcnFormField Id="order-unit-price" Label="@Text["UnitPrice"]"><Control><ShadcnInput TValue="decimal?" id="order-unit-price" Type="number" InputMode="decimal" min="0" @bind-Value="edit.UnitPrice" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-discount" Label="@Text["Discount"]"><Control><ShadcnInput TValue="decimal?" id="order-discount" Type="number" InputMode="decimal" min="0" max="100" @bind-Value="edit.DiscountPercent" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-currency" Label="@Text["Currency"]"><Control><ShadcnSelect TValue="int?" id="order-currency" @bind-Value="edit.CurrencyId" Options="@CurrencyOptions" Placeholder="@Text["Currency"]" Clearable="true" /></Control></ShadcnFormField>
            </div></ShadcnAccordionContent></ShadcnAccordionItem>

            <ShadcnAccordionItem Value="schedule"><ShadcnAccordionTrigger>@Text["PromisedDate"]</ShadcnAccordionTrigger><ShadcnAccordionContent><div class="order-edit-grid">
                <ShadcnFormField Id="order-lead-time" Label="@Text["LeadTime"]"><Control><ShadcnInput TValue="int?" id="order-lead-time" Type="number" min="0" @bind-Value="edit.LeadTime" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-promised-date" Label="@Text["PromisedDate"]"><Control><ShadcnDatePicker id="order-promised-date" @bind-Value="PromisedDate" Clearable="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-finished-date" Label="@Text["FinishedDate"]"><Control><ShadcnDatePicker id="order-finished-date" @bind-Value="FinishedDate" Clearable="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-tracking" Label="@Text["TrackingNumber"]"><Control><ShadcnInput TValue="string" id="order-tracking" Type="text" @bind-Value="edit.TrackingNumber" /></Control></ShadcnFormField>
            </div></ShadcnAccordionContent></ShadcnAccordionItem>

            <ShadcnAccordionItem Value="requirements"><ShadcnAccordionTrigger>@Text["Requirements"]</ShadcnAccordionTrigger><ShadcnAccordionContent>
                <div class="order-edit-grid">
                    <ShadcnFormField Id="order-description" Label="@Text["Requirements"]" Class="order-edit-wide"><Control><ShadcnTextarea TValue="string" id="order-description" @bind-Value="edit.Description" /></Control></ShadcnFormField>
                    <ShadcnFormField Id="order-comment" Label="@Text["Comment"]" Class="order-edit-wide"><Control><ShadcnTextarea TValue="string" id="order-comment" @bind-Value="edit.Comment" /></Control></ShadcnFormField>
                    <div class="order-edit-checks order-edit-wide">
                        <ShadcnField Orientation="ShadcnFieldOrientation.Horizontal"><ShadcnCheckbox id="order-social" Value="@edit.AllowSocialMedia" ValueChanged="@(value => edit.AllowSocialMedia = value.GetValueOrDefault())" /><ShadcnFieldLabel For="order-social">@Text["AllowSocialMedia"]</ShadcnFieldLabel></ShadcnField>
                        <ShadcnField Orientation="ShadcnFieldOrientation.Horizontal"><ShadcnCheckbox id="order-cancellation" Value="@edit.AllowCancellation" ValueChanged="@(value => edit.AllowCancellation = value.GetValueOrDefault())" /><ShadcnFieldLabel For="order-cancellation">@Text["AllowCancellation"]</ShadcnFieldLabel></ShadcnField>
                        <ShadcnField Orientation="ShadcnFieldOrientation.Horizontal"><ShadcnCheckbox id="order-payment" Value="@edit.AllowPayment" ValueChanged="@(value => edit.AllowPayment = value.GetValueOrDefault())" /><ShadcnFieldLabel For="order-payment">@Text["AllowPayment"]</ShadcnFieldLabel></ShadcnField>
                    </div>
                </div>
            </ShadcnAccordionContent></ShadcnAccordionItem>
        </ShadcnAccordion>
        <div class="order-save-bar"><ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@Text["Save"]</ShadcnButton></div>
    </EditForm>

    <section class="order-workflow-panel">
        <h2>@Text["Status"]</h2>
        <p>@Text["CurrentStatus"]: <span class="operations-status-pill">@StatusLabel(page.CurrentStatus?.Name)</span></p>
        <div class="order-status-actions">
            <ShadcnFormField Id="order-next-status" Label="@Text["NextStatus"]"><Control><ShadcnSelect TValue="int?" id="order-next-status" @bind-Value="selectedStatus" Options="@StatusOptions" Placeholder="@Text["NextStatus"]" Clearable="true" /></Control></ShadcnFormField>
            <ShadcnButton OnClick="TransitionAsync" Disabled="@(submitting || selectedStatus is null)">@Text["ApplyStatus"]</ShadcnButton>
        </div>
        <div class="order-history" tabindex="0"><ShadcnItemGroup>
            @foreach (var item in page.History.OrderByDescending(value => value.CreatedDate))
            {
                <ShadcnItem Size="ShadcnItemSize.Small"><ShadcnItemContent><ShadcnItemTitle>@StatusLabel(item.Name)</ShadcnItemTitle><ShadcnItemDescription>@LegacyPresentation.FormatUtcDateTime(item.CreatedDate, CultureInfo.CurrentCulture, "-")</ShadcnItemDescription></ShadcnItemContent></ShadcnItem>
            }
        </ShadcnItemGroup></div>
    </section>

    <section class="order-files-panel">
        <h2>@Text["Files"]</h2>
        <div class="order-upload-actions"><InputFile OnChange="SelectFiles" multiple /><ShadcnButton OnClick="UploadAsync" Disabled="@(submitting || uploads.Count == 0)">@Text["Upload"]</ShadcnButton></div>
        <ShadcnItemGroup>
            @foreach (var file in page.Files)
            {
                <ShadcnItem><ShadcnItemContent><ShadcnItemTitle><LegacyLink Href="@file.Uri?.ToString()" Role="LegacyLinkRole.External" Target="_blank" Rel="noopener">@file.ObjectName</LegacyLink></ShadcnItemTitle></ShadcnItemContent><ShadcnItemActions><ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Destructive" Size="ShadcnButtonSize.Icon" OnClick="() => RemoveFileAsync(file.Id)" Disabled="@submitting" aria-label="@Text["RemoveFile", file.ObjectName]"><ShadcnIcon Icon="@DeleteIcon" Size="18" /></ShadcnButton></ShadcnItemActions></ShadcnItem>
            }
        </ShadcnItemGroup>
    </section>
}
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }
    private OrderDetailPage? page;
    private OrderEditModel edit = new();
    private EmployeeSessionSummary? session;
    private readonly List<IBrowserFile> uploads = [];
    private int? selectedStatus;
    private bool loading = true;
    private bool submitting;
    private string? error;
    private string? notice;
    private IReadOnlyCollection<string> openSections = ["details", "process"];
    private static readonly ShadcnIconData DeleteIcon = LucideIconCatalog.Instance.Get(LucideIconNames.Trash2);

    private IReadOnlyList<ShadcnSelectOption<int?>> EmployeeOptions => (page?.Employees ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int>> ProcessOptions => (page?.Processes ?? []).Select(item => new ShadcnSelectOption<int>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> MaterialOptions => (page?.Materials ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> ColorOptions => (page?.Colors ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> SurfaceFinishOptions => (page?.SurfaceFinishes ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> CurrencyOptions => (page?.Currencies ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, item.ShortName)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> StatusOptions => (page?.AvailableStatuses ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, StatusLabel(item.Name))).ToArray();
    private DateOnly? PromisedDate { get => edit.PromisedDate is DateTime date ? DateOnly.FromDateTime(date) : null; set => edit.PromisedDate = value?.ToDateTime(TimeOnly.MinValue); }
    private DateOnly? FinishedDate { get => edit.FinishedDate is DateTime date ? DateOnly.FromDateTime(date) : null; set => edit.FinishedDate = value?.ToDateTime(TimeOnly.MinValue); }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true; error = null;
        if (Id is not > 0) { error = Text["InvalidId"]; loading = false; return; }
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            session = sessionResponse.IsSuccessStatusCode
                ? await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>()
                : null;
            using var response = await Http.GetForPresentationAsync($"/bff/orders/{Id.Value}");
            if (response.StatusCode == HttpStatusCode.Unauthorized) { Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}"); return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { error = Text["NotFound"]; return; }
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            page = await response.Content.ReadFromJsonAsync<OrderDetailPage>();
            if (page is null) { error = Text["InvalidResponse"]; return; }
            edit = OrderEditModel.From(page.Order);
            selectedStatus = null;
        }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }

    private async Task SaveAsync()
    {
        if (page is null || session?.CsrfToken is null) return;
        if (edit.ProcessId <= 0 || edit.Quantity <= 0 || edit.Manufactured < 0 || string.IsNullOrWhiteSpace(edit.Name)) { error = Text["InvalidRequest"]; return; }
        await SendWriteAsync(HttpMethod.Put, $"/bff/orders/{page.Order.Id}", JsonContent.Create(edit.ToRequest()), Text["OrderSaved"]);
    }

    private async Task TransitionAsync()
    {
        if (page is null || selectedStatus is null) return;
        using var request = WriteRequest(HttpMethod.Post, $"/bff/orders/{page.Order.Id}/status/{selectedStatus.Value}");
        request.Headers.Add("Idempotency-Key", Guid.NewGuid().ToString("D"));
        await SendAsync(request, Text["StatusSaved"]);
    }

    private void SelectFiles(InputFileChangeEventArgs args) { uploads.Clear(); uploads.AddRange(args.GetMultipleFiles()); }

    private async Task UploadAsync()
    {
        if (page is null || session?.CsrfToken is null || uploads.Count == 0) return;
        using var content = new MultipartFormDataContent("----maliev-order-upload");
        foreach (var upload in uploads)
        {
            var file = new StreamContent(upload.OpenReadStream(200 * 1024 * 1024));
            file.Headers.ContentType = new(upload.ContentType);
            content.Add(file, "files", upload.Name);
        }
        using var request = WriteRequest(HttpMethod.Post, $"/bff/orders/{page.Order.Id}/files");
        request.Content = content; // multipart/form-data
        await SendAsync(request, Text["FilesUploaded"]);
    }

    private async Task RemoveFileAsync(int fileId)
    {
        if (page is null) return;
        using var request = WriteRequest(HttpMethod.Delete, $"/bff/orders/{page.Order.Id}/files/{fileId}");
        await SendAsync(request, Text["FileRemoved"]);
    }

    private async Task SendWriteAsync(HttpMethod method, string path, HttpContent content, string success)
    {
        using var request = WriteRequest(method, path); request.Content = content; await SendAsync(request, success);
    }

    private HttpRequestMessage WriteRequest(HttpMethod method, string path)
    {
        var request = new HttpRequestMessage(method, path);
        if (!string.IsNullOrWhiteSpace(session?.CsrfToken)) request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
        return request;
    }

    private async Task SendAsync(HttpRequestMessage request, string success)
    {
        submitting = true; error = null; notice = null;
        try
        {
            // The BFF key ring may rotate while this long-lived WASM page is open (for
            // example, after an Aspire restart). Refresh the browser-safe session projection
            // immediately before every write so the request token matches the current cookie.
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            session = sessionResponse.IsSuccessStatusCode
                ? await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>()
                : null;
            request.Headers.Remove("X-CSRF-TOKEN");
            if (!string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            }

            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; }
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            notice = success; uploads.Clear(); await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally { submitting = false; }
    }

    private string ErrorFor(HttpStatusCode status) => status switch { HttpStatusCode.Forbidden => Text["Forbidden"], HttpStatusCode.TooManyRequests => Text["RateLimited"], HttpStatusCode.BadGateway => Text["InvalidResponse"], _ => Text["Unavailable"] };

    private string StatusLabel(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "new" => Text["StatusNew"],
        "reviewing" => Text["StatusReviewing"],
        "reviewed" => Text["StatusReviewed"],
        "quoted" => Text["StatusQuoted"],
        "accepted" => Text["StatusAccepted"],
        "paid" => Text["StatusPaid"],
        "in progress" or "inprogress" => Text["StatusInProgress"],
        "completed" => Text["StatusCompleted"],
        "cancelled" or "canceled" => Text["StatusCancelled"],
        "shipped" => Text["StatusShipped"],
        "delivered" => Text["StatusDelivered"],
        null or "" => "-",
        _ => status,
    };

    private sealed class OrderEditModel
    {
        public int? EmployeeId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int ProcessId { get; set; }
        public int? MaterialId { get; set; }
        public int? SurfaceFinishId { get; set; }
        public int? ColorId { get; set; }
        public int Quantity { get; set; }
        public int Manufactured { get; set; }
        public decimal? UnitPrice { get; set; }
        public decimal? DiscountPercent { get; set; }
        public int? CurrencyId { get; set; }
        public int? LeadTime { get; set; }
        public DateTime? PromisedDate { get; set; }
        public DateTime? FinishedDate { get; set; }
        public string? Comment { get; set; }
        public bool AllowSocialMedia { get; set; }
        public bool AllowCancellation { get; set; }
        public bool AllowPayment { get; set; }
        public string? TrackingNumber { get; set; }
        public DateTime? ModifiedDate { get; set; }
        public static OrderEditModel From(OrderDetailItem value) => new() { EmployeeId = value.EmployeeId, Name = value.Name ?? string.Empty, Description = value.Description, ProcessId = value.ProcessId, MaterialId = value.MaterialId, SurfaceFinishId = value.SurfaceFinishId, ColorId = value.ColorId, Quantity = value.Quantity, Manufactured = value.Manufactured, UnitPrice = value.UnitPrice, DiscountPercent = value.DiscountPercent, CurrencyId = value.CurrencyId, LeadTime = value.LeadTime, PromisedDate = value.PromisedDate, FinishedDate = value.FinishedDate, Comment = value.Comment, AllowSocialMedia = value.AllowSocialMedia, AllowCancellation = value.AllowCancellation, AllowPayment = value.AllowPayment, TrackingNumber = value.TrackingNumber, ModifiedDate = value.ModifiedDate };
        public OrderUpdateRequest ToRequest() => new(EmployeeId, Name, Description, ProcessId, MaterialId, SurfaceFinishId, ColorId, Quantity, Manufactured, UnitPrice, DiscountPercent, CurrencyId, LeadTime, PromisedDate, FinishedDate, Comment, AllowSocialMedia, AllowCancellation, AllowPayment, TrackingNumber, ModifiedDate);
    }
}
