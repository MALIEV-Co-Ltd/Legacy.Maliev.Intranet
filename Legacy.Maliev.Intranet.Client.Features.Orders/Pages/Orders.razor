@page "/Orders/Index"
@page "/sales/orders"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Orders> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="mlv-module-shell orders-module-shell">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <ModuleHeader Title="@Text["Orders"]" Subtitle="@Text["PageSubtitle"]">
        <PrimaryButton IconData="@AddIcon" Href="/Orders/Create">
            @Text["CreateOrder"]
        </PrimaryButton>
    </ModuleHeader>

    <PageBody Class="mlv-data-page-body">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="mlv-error" role="alert" aria-live="assertive">@error</div>
        }

        <PanelCard Title="@Text["Orders"]" Class="orders-results-panel">
            <ListToolbar TSort="OrderListSort"
                         Value="@ToolbarValue"
                         Defaults="@ToolbarDefaults"
                         SortOptions="@ToolbarSortOptions"
                         PageSizeOptions="@ToolbarPageSizes"
                         SearchLabel="@Text["Search"]"
                         ResultsId="orders-results"
                         ResultsStatus="@ToolbarResultsStatus"
                         IsBusy="@loading"
                         OnRequest="HandleToolbarRequestAsync" />

            @if (loading)
            {
                <ProgressiveSkeleton Layout="table" Rows="8" Columns="10" ShowFilters="false" Label="@Text["Loading"]" />
            }
            else
            {
                <div id="orders-results" class="orders-sections" aria-busy="false">
                    @foreach (var section in Sections)
                    {
                        <section class="orders-section" aria-labelledby="@SectionId(section.Title)">
                            <div class="orders-section-heading">
                                <h2 id="@SectionId(section.Title)">@section.Title</h2>
                                @if (section.ShowCount)
                                {
                                    <span class="orders-section-count">@Text["OrderCount", section.Items.Count]</span>
                                }
                            </div>

                            @if (section.Items.Count == 0)
                            {
                                <div class="mlv-empty">@Text["Empty"]</div>
                            }
                            else
                            {
                                <div class="@(section.ShowCount ? "orders-working-set" : null)">
                                    <OperationalTable TItem="OrderListItem"
                                                      TKey="int"
                                                      Items="@section.Items"
                                                      KeySelector="@(order => TableKey(section.Kind, order.Id))"
                                                      TableLabel="@section.Title"
                                                      ColumnCount="11"
                                                      State="@tableState"
                                                      DetailHref="@(order => $"/Orders/View?id={order.Id}")"
                                                      DetailAriaLabel="@(order => Text["ViewOrder", order.Id])"
                                                      ExpandAriaLabel="@(order => Text["ExpandOrder", order.Id])"
                                                      CollapseAriaLabel="@(order => Text["CollapseOrder", order.Id])">
                                        <HeaderContent>
                                            <tr>
                                                <th class="operational-table__identity" data-priority="essential">@Text["Id"]</th>
                                                <th data-priority="essential">@Text["Customer"]</th>
                                                <th data-priority="essential">@Text["Name"]</th>
                                                <th data-priority="essential">@Text["Remaining"]</th>
                                                <th data-priority="essential">@Text["Promised"]</th>
                                                <th data-priority="supporting">@Text["Process"]</th>
                                                <th data-priority="supporting">@Text["Quantity"]</th>
                                                <th data-priority="supporting">@Text["Manufactured"]</th>
                                                <th data-priority="supporting">@Text["Employee"]</th>
                                                <th data-priority="supporting">@Text["Subtotal"]</th>
                                                <th class="operational-table__actions-heading"><span class="visually-hidden">@Text["Actions"]</span></th>
                                            </tr>
                                        </HeaderContent>
                                        <RowContent Context="order">
                                            <td class="operational-table__identity orders-id mlv-mono" data-priority="essential">@order.Id</td>
                                            <td class="orders-id" data-priority="essential">@ValueOrFallback(order.CustomerId)</td>
                                            <td class="orders-name" data-priority="essential" title="@ValueOrFallback(order.Name)">
                                                <span>@ValueOrFallback(order.Name)</span>
                                                @if (!order.AllowSocialMedia)
                                                {
                                                    <span class="orders-confidential">@Text["Confidential"]</span>
                                                }
                                            </td>
                                            <td class="orders-quantity" data-priority="essential">@ValueOrFallback(order.Remaining)</td>
                                            <td class="orders-date" data-priority="essential">@FormatDate(order.PromisedDate)</td>
                                            <td data-priority="supporting">@ProcessName(order.ProcessId)</td>
                                            <td class="orders-quantity" data-priority="supporting">@order.Quantity</td>
                                            <td class="orders-quantity" data-priority="supporting">@order.Manufactured</td>
                                            <td data-priority="supporting">@EmployeeName(order.EmployeeId)</td>
                                            <td class="orders-money mlv-mono" data-priority="supporting">@FormatAmount(order.Subtotal)</td>
                                        </RowContent>
                                        <QuickViewContent Context="order">
                                            <dl class="orders-quick-view">
                                                <div><dt>@Text["Name"]</dt><dd>@ValueOrFallback(order.Name)</dd></div>
                                                <div><dt>@Text["Process"]</dt><dd>@ProcessName(order.ProcessId)</dd></div>
                                                <div><dt>@Text["Quantity"]</dt><dd class="orders-quantity">@order.Quantity</dd></div>
                                                <div><dt>@Text["Manufactured"]</dt><dd class="orders-quantity">@order.Manufactured</dd></div>
                                                <div><dt>@Text["Employee"]</dt><dd>@EmployeeName(order.EmployeeId)</dd></div>
                                                <div><dt>@Text["Subtotal"]</dt><dd class="orders-money mlv-mono">@FormatAmount(order.Subtotal)</dd></div>
                                                <div><dt>@Text["SocialMedia"]</dt><dd>@(order.AllowSocialMedia ? Text["SocialMediaAllowed"] : Text["Confidential"])</dd></div>
                                                <div><dt>@Text["Created"]</dt><dd class="orders-date">@FormatDate(order.CreatedDate)</dd></div>
                                                <div><dt>@Text["Modified"]</dt><dd class="orders-date">@FormatDate(order.ModifiedDate)</dd></div>
                                            </dl>
                                        </QuickViewContent>
                                    </OperationalTable>
                                </div>
                            }
                        </section>
                    }
                </div>

                @if (Page is not null)
                {
                    <nav class="orders-pager" aria-label="@Text["OrderPages"]">
                        <SecondaryButton Disabled="@(!Page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</SecondaryButton>
                        <span aria-live="polite">@Text["PageSummary", Page.PageIndex, Page.TotalPages, Page.TotalRecords]</span>
                        <SecondaryButton Disabled="@(!Page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</SecondaryButton>
                    </nav>
                }
            }
        </PanelCard>
    </PageBody>
</div>

@code {
    private static readonly ShadcnIconData AddIcon = LucideIconCatalog.Instance.Get(LucideIconNames.Plus);
    private const int PendingWorkingSetSize = 1000;
    private static readonly int[] ToolbarPageSizes = [10, 25, 50, 100, 250];

    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private OrderListPage? Page { get; set; }
    private IReadOnlyList<OrderListItem> AssignedOrders { get; set; } = [];
    private IReadOnlyList<OrderListItem> UnassignedOrders { get; set; } = [];
    private IReadOnlyDictionary<int, string> employeeNames = new Dictionary<int, string>();
    private IReadOnlyDictionary<int, string> processNames = new Dictionary<int, string>();
    private string? error;
    private bool loading;
    private OrderListSort currentSort = OrderListSort.OrderCreatedDate_Descending;
    private readonly LatestRequestGate loadGate = new();
    private readonly OperationalTableState<int> tableState = new();
    private readonly Dictionary<(OrderSectionKind Section, int OrderId), int> tableKeys = [];
    private int nextTableKey;

    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Orders"]),
    ];

    private ListToolbarState<OrderListSort> ToolbarValue => new(Search, currentSort, Size);
    private static ListToolbarState<OrderListSort> ToolbarDefaults =>
        new(null, OrderListSort.OrderCreatedDate_Descending, 10);
    private IReadOnlyList<ListToolbarOption<OrderListSort>> ToolbarSortOptions =>
        Enum.GetValues<OrderListSort>()
            .Select(value => new ListToolbarOption<OrderListSort>(value, Text[value.ToString()].Value))
            .ToArray();
    private string? ToolbarResultsStatus => Page is null
        ? null
        : Text["PageSummary", Page.PageIndex, Page.TotalPages, Page.TotalRecords].Value;

    private IReadOnlyList<OrderSection> Sections =>
    [
        new(OrderSectionKind.Assigned, Text["AssignedToMe"], AssignedOrders, true),
        new(OrderSectionKind.AwaitingAssignment, Text["AwaitingAssignment"], UnassignedOrders, true),
        new(OrderSectionKind.All, Text["AllOrders"], Page?.Items ?? [], false),
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 10, maximum: 250);
        currentSort = Enum.TryParse<OrderListSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : OrderListSort.OrderCreatedDate_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = loadGate.Begin();
        if (lease.IsCurrent)
        {
            tableState.Clear();
            tableKeys.Clear();
            nextTableKey = 0;
            loading = true;
            error = null;
            Page = null;
            AssignedOrders = [];
            UnassignedOrders = [];
        }
        HttpResponseMessage[]? responses = null;
        try
        {
            var pageTask = Http.GetForPresentationAsync($"/bff/orders?sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={Index}&size={Size}", lease.CancellationToken);
            var pendingTask = Http.GetForPresentationAsync($"/bff/orders/pending?size={PendingWorkingSetSize}", lease.CancellationToken);
            var processesTask = Http.GetForPresentationAsync("/bff/order-processes", lease.CancellationToken);
            var employeesTask = Http.GetForPresentationAsync("/bff/employees?sort=EmployeeId_Ascending&search=&index=1&size=250", lease.CancellationToken);
            var sessionTask = Http.GetForPresentationAsync("/bff/session", lease.CancellationToken);
            responses = await Task.WhenAll(pageTask, pendingTask, processesTask, employeesTask, sessionTask);

            if (!lease.IsCurrent || HandleFailure(responses))
            {
                return;
            }

            var nextPage = await responses[0].Content.ReadFromJsonAsync<OrderListPage>(cancellationToken: lease.CancellationToken);
            var pending = await responses[1].Content.ReadFromJsonAsync<OrderListPage>(cancellationToken: lease.CancellationToken);
            var processes = await responses[2].Content.ReadFromJsonAsync<List<OrderProcessItem>>(cancellationToken: lease.CancellationToken);
            var employees = await responses[3].Content.ReadFromJsonAsync<EmployeeListPage>(cancellationToken: lease.CancellationToken);
            var session = await responses[4].Content.ReadFromJsonAsync<EmployeeSessionSummary>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (nextPage?.Items is null || pending?.Items is null || processes is null || employees?.Items is null || session is null)
            {
                error = Text["InvalidResponse"];
                return;
            }

            Page = nextPage;
            employeeNames = employees.Items.ToDictionary(value => value.Id, value => value.FullName);
            processNames = processes.ToDictionary(value => value.Id, value => value.Name);
            AssignedOrders = session.LegacyDatabaseId is not int employeeId
                ? []
                : pending.Items.Where(value => value.EmployeeId == employeeId).ToArray();
            UnassignedOrders = pending.Items.Where(value => value.EmployeeId is null).ToArray();
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (responses is not null)
            {
                foreach (var response in responses)
                {
                    response.Dispose();
                }
            }

            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private bool HandleFailure(IEnumerable<HttpResponseMessage> responses)
    {
        var failed = responses.FirstOrDefault(response => !response.IsSuccessStatusCode);
        if (failed is null)
        {
            return false;
        }

        if (failed.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        }
        else if (failed.StatusCode == HttpStatusCode.Forbidden)
        {
            error = Text["Forbidden"];
        }
        else if (failed.StatusCode == HttpStatusCode.TooManyRequests)
        {
            error = Text["RateLimited"];
        }
        else if (failed.StatusCode == HttpStatusCode.BadGateway)
        {
            error = Text["InvalidResponse"];
        }
        else
        {
            error = Text["Unavailable"];
        }

        return true;
    }

    private Task HandleToolbarRequestAsync(ListToolbarRequest<OrderListSort> request)
    {
        if (request.Reason == ListToolbarChangeReason.Refreshed && request.State == ToolbarValue)
        {
            return LoadAsync();
        }

        return NavigateAsync(1, request.State.Search, request.State.Sort, request.State.PageSize, replace: true);
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private Task NavigateAsync(int index, string? search, OrderListSort sort, int size, bool replace = false)
    {
        tableState.Clear();
        Navigation.NavigateTo($"/Orders/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => loadGate.Dispose();

    private string ProcessName(int id) => processNames.TryGetValue(id, out var name) ? name : id.ToString(CultureInfo.InvariantCulture);
    private string EmployeeName(int? id) => id is int value && employeeNames.TryGetValue(value, out var name) ? name : "-";
    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string ValueOrFallback(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? "-";
    private static string FormatAmount(decimal? value) => value?.ToString("N2", CultureInfo.CurrentCulture) ?? "-";
    private static string FormatDate(DateTime? value) =>
        LegacyPresentation.FormatCalendarDate(value, CultureInfo.CurrentCulture, "-");
    private static string SectionId(string title) => $"orders-{title.Replace(' ', '-').ToLowerInvariant()}";

    private int TableKey(OrderSectionKind section, int orderId)
    {
        var identity = (section, orderId);
        if (tableKeys.TryGetValue(identity, out var key))
        {
            return key;
        }

        key = nextTableKey++;
        tableKeys.Add(identity, key);
        return key;
    }

    private enum OrderSectionKind
    {
        Assigned,
        AwaitingAssignment,
        All,
    }

    private sealed record OrderSection(
        OrderSectionKind Kind,
        string Title,
        IReadOnlyList<OrderListItem> Items,
        bool ShowCount);
}
