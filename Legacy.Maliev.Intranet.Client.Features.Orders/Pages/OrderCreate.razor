@page "/Orders/Create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<OrderCreate> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="order-create">
@if (loading)
{
    <div class="order-create__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
}
else
{
    <header class="operations-page-header">
        <div><h1>@Text["Heading"]</h1><p>@Text["OrderDetails"]</p></div>
        <LegacyLink Href="/Orders/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["BackToOrders"]">@Text["BackToOrders"]</LegacyLink>
    </header>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notice @if (createdOrderId is int orderId) { <LegacyLink Href="@($"/Orders/View?id={orderId}")" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["ViewOrder"]} {orderId}")">@Text["ViewOrder"]</LegacyLink> }</ShadcnAlertDescription></ShadcnAlert>
    }

    <EditForm Model="@model" OnSubmit="CreateAsync" class="order-create__form">
        <section class="order-create__section" aria-labelledby="order-create-details-heading">
            <h2 id="order-create-details-heading">@Text["OrderDetails"]</h2>
            <div class="order-create__grid">
                <ShadcnFormField Id="order-create-customer" Label="@Text["CustomerId"]" Required="true"><Control><ShadcnInput TValue="int" id="order-create-customer" Type="number" min="1" @bind-Value="model.CustomerId" Required="true" /></Control></ShadcnFormField>
                <div class="order-create__lookup">
                    <ShadcnButton ButtonType="ShadcnButtonType.Button" OnClick="LookupCustomerAsync" Disabled="@submitting" Variant="ShadcnButtonVariant.Outline">@Text["FindCustomer"]</ShadcnButton>
                    @if (createPage?.Customer is not null) { <span>@createPage.Customer.FullName · @createPage.Customer.Email</span> }
                    else if (customerLookupAttempted) { <span class="order-create__error">@Text["CustomerNotFound"]</span> }
                </div>
                <ShadcnFormField Id="order-create-name" Label="@Text["Name"]" Required="true" Class="order-create__wide"><Control><ShadcnInput TValue="string" id="order-create-name" @bind-Value="model.Name" Required="true" maxlength="256" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-create-process" Label="@Text["Process"]" Required="true"><Control><ShadcnSelect TValue="int" id="order-create-process" @bind-Value="model.ProcessId" Options="@ProcessOptions" Placeholder="@Text["Process"]" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-create-material" Label="@Text["Material"]"><Control><ShadcnSelect TValue="int?" id="order-create-material" Value="@model.MaterialId" ValueChanged="OnMaterialChangedAsync" ValueExpression="@(() => model.MaterialId)" Options="@MaterialOptions" Placeholder="@Text["Material"]" Clearable="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-create-color" Label="@Text["Color"]" Disabled="@(model.MaterialId is null)"><Control><ShadcnSelect TValue="int?" id="order-create-color" @bind-Value="model.ColorId" Options="@ColorOptions" Placeholder="@Text["Color"]" Clearable="true" Disabled="@(model.MaterialId is null)" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-create-finish" Label="@Text["SurfaceFinish"]" Disabled="@(model.MaterialId is null)"><Control><ShadcnSelect TValue="int?" id="order-create-finish" @bind-Value="model.SurfaceFinishId" Options="@SurfaceFinishOptions" Placeholder="@Text["SurfaceFinish"]" Clearable="true" Disabled="@(model.MaterialId is null)" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-create-quantity" Label="@Text["Quantity"]" Required="true"><Control><ShadcnInput TValue="int" id="order-create-quantity" Type="number" min="1" @bind-Value="model.Quantity" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="order-create-description" Label="@Text["Requirements"]" Class="order-create__wide"><Control><ShadcnTextarea TValue="string" id="order-create-description" @bind-Value="model.Description" maxlength="500" /></Control></ShadcnFormField>
                <div class="order-create__checks order-create__wide">
                    <ShadcnField Orientation="ShadcnFieldOrientation.Horizontal"><ShadcnCheckbox id="order-create-confirmation" Value="@model.SendConfirmationEmail" ValueChanged="@(value => model.SendConfirmationEmail = value.GetValueOrDefault())" /><ShadcnFieldLabel For="order-create-confirmation">@Text["SendConfirmationEmail"]</ShadcnFieldLabel></ShadcnField>
                    <ShadcnField Orientation="ShadcnFieldOrientation.Horizontal"><ShadcnCheckbox id="order-create-social" Value="@model.AllowSocialMedia" ValueChanged="@(value => model.AllowSocialMedia = value.GetValueOrDefault())" /><ShadcnFieldLabel For="order-create-social">@Text["AllowSocialMedia"]</ShadcnFieldLabel></ShadcnField>
                </div>
                <section class="order-create__files order-create__wide" aria-labelledby="order-create-files-heading">
                    <h3 id="order-create-files-heading">@Text["Files"]</h3>
                    <InputFile OnChange="SelectFiles" multiple />
                    @if (uploads.Count > 0) { <p>@Text["SelectedFiles", uploads.Count]</p> }
                </section>
            </div>
        </section>
        <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@(submitting ? Text["Creating"] : Text["Create"])</ShadcnButton>
    </EditForm>
}
</main>

@code {
    [SupplyParameterFromQuery(Name = "customerId")] public int? CustomerId { get; set; }

    private const long MaxUploadBytes = 200L * 1024 * 1024;
    private readonly Guid createAttemptId = Guid.NewGuid();
    private readonly List<IBrowserFile> uploads = [];
    private OrderCreatePage? createPage;
    private OrderMaterialOptions materialOptions = new([], []);
    private EmployeeSessionSummary? session;
    private CreateModel model = new();
    private bool loading = true;
    private bool submitting;
    private bool customerLookupAttempted;
    private int? createdOrderId;
    private string? error;
    private string? notice;

    private IReadOnlyList<ShadcnSelectOption<int>> ProcessOptions => (createPage?.Processes ?? []).Select(item => new ShadcnSelectOption<int>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> MaterialOptions => (createPage?.Materials ?? []).Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> ColorOptions => materialOptions.Colors.Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> SurfaceFinishOptions => materialOptions.SurfaceFinishes.Select(item => new ShadcnSelectOption<int?>(item.Id, item.Name)).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (CustomerId is > 0) model.CustomerId = CustomerId.Value;
        await LoadAsync(CustomerId);
    }

    private async Task LoadAsync(int? customerId)
    {
        loading = true;
        error = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            session = sessionResponse.IsSuccessStatusCode
                ? await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>()
                : null;
            var path = customerId is > 0 ? $"/bff/orders/create?customerId={customerId.Value}" : "/bff/orders/create";
            using var response = await Http.GetForPresentationAsync(path);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            createPage = await response.Content.ReadFromJsonAsync<OrderCreatePage>();
            if (createPage is null) { error = Text["InvalidResponse"]; return; }
            customerLookupAttempted = customerId is > 0;
            if (createPage.Customer is not null) model.CustomerId = createPage.Customer.Id;
            if (model.ProcessId == 0 && createPage.Processes.Count > 0) model.ProcessId = createPage.Processes[0].Id;
        }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }

    private Task LookupCustomerAsync() => LoadAsync(model.CustomerId > 0 ? model.CustomerId : null);

    private async Task OnMaterialChangedAsync(int? value)
    {
        model.MaterialId = value;
        await LoadMaterialOptionsAsync();
    }

    private async Task LoadMaterialOptionsAsync()
    {
        model.ColorId = null;
        model.SurfaceFinishId = null;
        materialOptions = new([], []);
        if (model.MaterialId is not int materialId) return;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/orders/create/materials/{materialId}");
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            materialOptions = await response.Content.ReadFromJsonAsync<OrderMaterialOptions>() ?? new([], []);
        }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
    }

    private void SelectFiles(InputFileChangeEventArgs args)
    {
        uploads.Clear();
        uploads.AddRange(args.GetMultipleFiles());
    }

    private async Task CreateAsync()
    {
        if (session?.CsrfToken is null) return;
        if (model.CustomerId <= 0 || model.ProcessId <= 0 || model.Quantity <= 0 || string.IsNullOrWhiteSpace(model.Name)) { error = Text["InvalidRequest"]; return; }
        if (createPage?.Customer?.Id != model.CustomerId) { error = Text["ValidateCustomer"]; return; }
        if (uploads.Sum(file => file.Size) > MaxUploadBytes) { error = Text["FilesTooLarge"]; return; }

        submitting = true;
        error = null;
        notice = null;
        try
        {
            using var content = new MultipartFormDataContent("----maliev-order-create");
            content.Add(JsonContent.Create(model.ToRequest()), "request");
            foreach (var upload in uploads)
            {
                var file = new StreamContent(upload.OpenReadStream(MaxUploadBytes));
                file.Headers.ContentType = new(upload.ContentType);
                content.Add(file, "files", upload.Name);
            }
            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/orders") { Content = content };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            request.Headers.Add("Idempotency-Key", createAttemptId.ToString("D"));
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode) { error = ErrorFor(response.StatusCode); return; }
            var result = await response.Content.ReadFromJsonAsync<OrderCreatedResult>();
            if (result is null) { error = Text["InvalidResponse"]; return; }
            if (string.IsNullOrWhiteSpace(result.Warning))
            {
                Navigation.NavigateTo($"/Orders/View?id={result.Id}");
                return;
            }
            createdOrderId = result.Id;
            notice = Text["NotificationWarning"];
        }
        catch (HttpRequestException) { error = Text["Unavailable"]; }
        finally { submitting = false; }
    }

    private string ErrorFor(HttpStatusCode status) => status switch
    {
        HttpStatusCode.BadRequest => Text["InvalidRequest"],
        HttpStatusCode.Forbidden => Text["Forbidden"],
        HttpStatusCode.NotFound => Text["CustomerNotFound"],
        HttpStatusCode.TooManyRequests => Text["RateLimited"],
        _ => Text["Unavailable"],
    };

    private sealed class CreateModel
    {
        public int CustomerId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int ProcessId { get; set; }
        public int? MaterialId { get; set; }
        public int? SurfaceFinishId { get; set; }
        public int? ColorId { get; set; }
        public int Quantity { get; set; } = 1;
        public bool SendConfirmationEmail { get; set; } = true;
        public bool AllowSocialMedia { get; set; }

        public OrderCreateRequest ToRequest() => new(
            CustomerId, Name, Description, ProcessId, MaterialId, SurfaceFinishId, ColorId,
            Quantity, SendConfirmationEmail, AllowSocialMedia);
    }
}
