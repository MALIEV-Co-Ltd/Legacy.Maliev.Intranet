@typeparam TSort where TSort : struct, Enum
@using System.Globalization
@implements IAsyncDisposable
@inject IStringLocalizer<ListToolbarResources> Text

<section class="list-toolbar" role="search" aria-label="@Text["FilterLabel"]" aria-busy="@IsBusy.ToString().ToLowerInvariant()">
    <div class="list-toolbar__grid">
        <div class="list-toolbar__field list-toolbar__search-field">
            <label for="list-toolbar-search">@(SearchLabel ?? Text["Search"])</label>
            <span class="list-toolbar__input-wrap">
                <ShadcnIcon Icon="SearchIcon" Size="18" />
                <ShadcnInput TValue="string" id="list-toolbar-search" Type="search"
                             Value="@controller!.Current.Search" ValueChanged="ChangeSearchAsync"
                             aria-controls="@ResultsId" />
            </span>
        </div>
        <div class="list-toolbar__field">
            <label for="list-toolbar-sort">@Text["Sort"]</label>
            <ShadcnSelect TValue="TSort" id="list-toolbar-sort"
                          Value="@controller.Current.Sort" ValueChanged="ChangeSortAsync"
                          Options="@SelectSortOptions" Placeholder="@Text["Sort"]"
                          aria-controls="@ResultsId" />
        </div>
        <div class="list-toolbar__field">
            <label for="list-toolbar-page-size">@Text["PerPage"]</label>
            <ShadcnSelect TValue="int" id="list-toolbar-page-size"
                          Value="@controller.Current.PageSize" ValueChanged="ChangePageSizeAsync"
                          Options="@SelectPageSizeOptions" Placeholder="@Text["PerPage"]"
                          aria-controls="@ResultsId" />
        </div>
        <div class="list-toolbar__actions">
            @if (controller.CanClear)
            {
                <ShadcnButton Variant="ShadcnButtonVariant.Ghost" OnClick="ClearAsync">
                    <ShadcnIcon Icon="ClearIcon" Size="18" />
                    @Text["Clear"]
                </ShadcnButton>
            }
            <ShadcnButton Class="list-toolbar__refresh" Variant="ShadcnButtonVariant.Ghost" Size="ShadcnButtonSize.Icon"
                          Disabled="@IsBusy" aria-label="@Text["Refresh"]" title="@Text["Refresh"]"
                          OnClick="RefreshAsync">
                <ShadcnIcon Icon="RefreshIcon" Size="20" />
            </ShadcnButton>
        </div>
    </div>
    <span class="visually-hidden" role="status" aria-live="polite">
        @(IsBusy ? Text["Filtering"] : ResultsStatus)
    </span>
</section>

@code {
    [Parameter, EditorRequired] public ListToolbarState<TSort> Value { get; set; }
    [Parameter, EditorRequired] public ListToolbarState<TSort> Defaults { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ListToolbarOption<TSort>> SortOptions { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<int> PageSizeOptions { get; set; } = [];
    [Parameter, EditorRequired] public EventCallback<ListToolbarRequest<TSort>> OnRequest { get; set; }
    [Parameter] public string? SearchLabel { get; set; }
    [Parameter] public string? ResultsId { get; set; }
    [Parameter] public string? ResultsStatus { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public int DebounceMilliseconds { get; set; } = 350;

    private DebouncedListToolbarController<TSort>? controller;
    private ListToolbarState<TSort>? observedValue;
    private ListToolbarState<TSort>? observedDefaults;
    private static readonly ShadcnIconData SearchIcon = LucideIconCatalog.Instance.Get(LucideIconNames.Search);
    private static readonly ShadcnIconData ClearIcon = LucideIconCatalog.Instance.Get(LucideIconNames.ListFilterPlus);
    private static readonly ShadcnIconData RefreshIcon = LucideIconCatalog.Instance.Get(LucideIconNames.RefreshCw);
    private IReadOnlyList<ShadcnSelectOption<TSort>> SelectSortOptions =>
        SortOptions.Select(option => new ShadcnSelectOption<TSort>(option.Value, option.Label)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int>> SelectPageSizeOptions =>
        PageSizeOptions.Select(pageSize => new ShadcnSelectOption<int>(pageSize, pageSize.ToString(CultureInfo.CurrentCulture))).ToArray();

    protected override void OnParametersSet()
    {
        if (controller is null)
        {
            controller = new(Value, Defaults, debounceDelay: TimeSpan.FromMilliseconds(DebounceMilliseconds));
        }
        else if (observedValue != Value || observedDefaults != Defaults)
        {
            controller.Hydrate(Value, Defaults);
        }

        observedValue = Value;
        observedDefaults = Defaults;
    }

    private Task ChangeSearchAsync(string? value) => controller!.ChangeSearchAsync(value, EmitAsync);
    private Task ChangeSortAsync(TSort value) => controller!.ChangeSortAsync(value, EmitAsync);
    private Task ChangePageSizeAsync(int value) => controller!.ChangePageSizeAsync(value, EmitAsync);
    private Task ClearAsync() => controller!.ClearAsync(EmitAsync);
    private Task RefreshAsync() => controller!.RefreshAsync(EmitAsync);
    private Task EmitAsync(ListToolbarRequest<TSort> request, CancellationToken _) => OnRequest.InvokeAsync(request);

    public async ValueTask DisposeAsync()
    {
        if (controller is not null)
        {
            await controller.DisposeAsync();
        }
    }
}
