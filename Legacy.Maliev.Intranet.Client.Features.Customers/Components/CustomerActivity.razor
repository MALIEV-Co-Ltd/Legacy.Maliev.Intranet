@namespace Legacy.Maliev.Intranet.Client.Features.Customers.Components

<section class="customer-activity" aria-labelledby="customer-activity-heading">
    <h2 id="customer-activity-heading" class="customer-activity__heading">
        @Localize("Activity")
    </h2>

    @if (Loading)
    {
        <div class="customer-activity__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Localize("ActivityLoading")" Size="1.25rem" /><span>@Localize("ActivityLoading")</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@Error</ShadcnAlertDescription></ShadcnAlert>
        <ShadcnButton OnClick="Retry">@Localize("Retry")</ShadcnButton>
    }
    else if (Page is not null)
    {
        <div class="customer-activity__warnings" aria-label="@Localize("ActivitySourceWarnings")">
            @if (ShouldWarn(Page.Orders))
            {
                <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@SourceWarning("Orders", Page.Orders)</ShadcnAlertDescription></ShadcnAlert>
            }
            @if (ShouldWarn(Page.Quotations))
            {
                <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@SourceWarning("Quotations", Page.Quotations)</ShadcnAlertDescription></ShadcnAlert>
            }
            @if (ShouldWarn(Page.Invoices))
            {
                <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@SourceWarning("Invoices", Page.Invoices)</ShadcnAlertDescription></ShadcnAlert>
            }
        </div>

        @if (Page.Items.Count == 0)
        {
            <p class="customer-activity__empty">@Localize("ActivityEmpty")</p>
        }
        else
        {
            <ol class="customer-activity__timeline">
                @foreach (var item in Page.Items)
                {
                    <li class="customer-activity__item">
                        <div class="customer-activity__record">
                            <LegacyLink Href="@RecordHref(item)"
                                        Role="LegacyLinkRole.Record"
                                        AriaLabel="@ActivityTitle(item)">
                                @RecordLabel(item)
                            </LegacyLink>
                            <span class="customer-activity__status">@StatusText(item)</span>
                        </div>
                        @if (item.Kind == CustomerHistoryKind.Order && item.CompletedUnits is not null && item.TotalUnits is not null)
                        {
                            <span class="customer-activity__detail">@LocalizeFormat("OrderProgress", new object?[] { item.CompletedUnits, item.TotalUnits })</span>
                        }
                        @if (item.Amount is decimal amount && !string.IsNullOrWhiteSpace(item.Currency))
                        {
                            <span class="customer-activity__amount">@FormatMoney(amount, item.Currency)</span>
                        }
                        <time datetime="@item.Timestamp.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" class="customer-activity__time">
                            @FormatTimestamp(item.Timestamp)
                        </time>
                    </li>
                }
            </ol>
        }
    }
    else
    {
        <p class="customer-activity__empty">@Localize("ActivityEmpty")</p>
    }
</section>

@code {
    [Parameter] public CustomerActivityPage? Page { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, object?[], string> LocalizeFormat { get; set; } = null!;
    [Parameter, EditorRequired] public Func<DateTime, string> FormatTimestamp { get; set; } = null!;
    [Parameter, EditorRequired] public Func<decimal, string, string> FormatMoney { get; set; } = null!;

    private string RecordHref(CustomerActivityItem item) => item.Kind switch
    {
        CustomerHistoryKind.Order => $"/Orders/View?id={item.Id}",
        CustomerHistoryKind.Quotation => $"/Quotations/View?id={item.Id}",
        CustomerHistoryKind.Invoice => $"/Invoices/View?id={item.Id}",
        _ => throw new InvalidOperationException($"Unsupported customer history kind '{item.Kind}'."),
    };

    private string ActivityTitle(CustomerActivityItem item) => item.Kind switch
    {
        CustomerHistoryKind.Order => LocalizeFormat("ViewOrderAccessible", new object?[] { item.Id }),
        CustomerHistoryKind.Quotation => LocalizeFormat("ViewQuotationAccessible", new object?[] { item.Id }),
        CustomerHistoryKind.Invoice => LocalizeFormat("ViewInvoiceAccessible", new object?[] { item.Label ?? item.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) }),
        _ => throw new InvalidOperationException($"Unsupported customer history kind '{item.Kind}'."),
    };

    private string RecordLabel(CustomerActivityItem item) => item.Kind switch
    {
        CustomerHistoryKind.Order => LocalizeFormat("OrderNumber", new object?[] { item.Id }),
        CustomerHistoryKind.Quotation => LocalizeFormat("QuotationNumber", new object?[] { item.Id }),
        CustomerHistoryKind.Invoice => item.Label ?? LocalizeFormat("InvoiceNumber", new object?[] { item.Id }),
        _ => throw new InvalidOperationException($"Unsupported customer history kind '{item.Kind}'."),
    };

    private string StatusText(CustomerActivityItem item) => Localize(item.Status switch
    {
        CustomerActivityStatus.InProgress => "StatusInProgress",
        CustomerActivityStatus.Complete => "StatusComplete",
        CustomerActivityStatus.Open => "StatusOpen",
        CustomerActivityStatus.Accepted => "StatusAccepted",
        CustomerActivityStatus.Declined => "StatusDeclined",
        CustomerActivityStatus.Paid => "StatusPaid",
        CustomerActivityStatus.Outstanding => "StatusOutstanding",
        _ => throw new InvalidOperationException($"Unsupported customer activity status '{item.Status}'."),
    });

    private string SourceWarning(string sourceKey, CustomerHistorySourceSummary source) =>
        LocalizeFormat(
            "ActivitySourceWarning",
            new object?[] { Localize(sourceKey), Localize($"SourceState{source.State}") });

    private static bool ShouldWarn(CustomerHistorySourceSummary source) =>
        source.State is not CustomerHistorySourceState.Available and not CustomerHistorySourceState.Forbidden;
}
