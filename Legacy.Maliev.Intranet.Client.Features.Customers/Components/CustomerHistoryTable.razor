@namespace Legacy.Maliev.Intranet.Client.Features.Customers.Components

<section class="customer-history" aria-labelledby="@HeadingId">
    <div class="customer-history__header">
        <h2 id="@HeadingId" class="customer-history__heading">@Localize(HeadingKey)</h2>
        @if (!Loading && string.IsNullOrWhiteSpace(Error) && CurrentTotalRecords is int totalRecords)
        {
            <span class="customer-history__count">@LocalizeFormat("HistoryResultCount", new object?[] { totalRecords })</span>
        }
    </div>

    @if (Loading)
    {
        <div class="customer-history__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Localize("HistoryLoading")" Size="1.25rem" /><span>@Localize("HistoryLoading")</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@Error</ShadcnAlertDescription></ShadcnAlert>
        <ShadcnButton OnClick="Retry">@Localize("Retry")</ShadcnButton>
    }
    else if (Items.Count == 0)
    {
        <p class="customer-history__empty">@Localize(EmptyKey)</p>
    }
    else
    {
        @switch (Kind)
        {
            case CustomerHistoryKind.Order:
                <div class="customer-history__table-scroll">
                <ShadcnTable Class="customer-history__table" ExpectedColumnCount="6" data-projection="history-orders">
                    <ShadcnTableHeader><ShadcnTableRow>
                        <ShadcnTableHead>@Localize("Record")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Name")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Status")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("PromisedDate")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("References")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("FinancialAndDates")</ShadcnTableHead>
                    </ShadcnTableRow></ShadcnTableHeader>
                    <ShadcnTableBody>
                    @foreach (var order in Orders!.Items)
                    {
                        <ShadcnTableRow>
                        <ShadcnTableCell data-label="@Localize("Record")" class="mlv-mono" data-field="Id">
                            <LegacyLink Href="@($"/Orders/View?id={order.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@RecordActivityTitle(CustomerHistoryKind.Order, order.Id)">
                                @LocalizeFormat("OrderNumber", new object?[] { order.Id })
                            </LegacyLink>
                        </ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Name")" class="history-primary" data-field="Name">@DisplayValue(order.Name)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Status")" class="history-status mlv-mono" data-field="Quantity Manufactured Remaining">@OrderStatus(order) · @DisplayNumber(order.Remaining)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("PromisedDate")" class="mlv-mono" data-field="PromisedDate">@FormatDate(order.PromisedDate)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("References")" class="history-meta mlv-mono" data-field="CustomerId EmployeeId ProcessId">@DisplayReference("C", order.CustomerId) · @DisplayReference("E", order.EmployeeId) · @DisplayReference("P", order.ProcessId)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("FinancialAndDates")" class="history-meta mlv-mono" data-field="Subtotal AllowSocialMedia CreatedDate ModifiedDate">@DisplayMoney(order.Subtotal) · @DisplayBoolean(order.AllowSocialMedia) · @FormatDate(order.CreatedDate) · @FormatDate(order.ModifiedDate)</ShadcnTableCell>
                        </ShadcnTableRow>
                    }
                    </ShadcnTableBody>
                </ShadcnTable>
                </div>
                break;
            case CustomerHistoryKind.Quotation:
                <div class="customer-history__table-scroll">
                <ShadcnTable Class="customer-history__table" ExpectedColumnCount="7" data-projection="history-quotations">
                    <ShadcnTableHeader><ShadcnTableRow>
                        <ShadcnTableHead>@Localize("Record")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Status")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("ExpirationDate")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Period")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("References")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Amounts")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("TermsAndDates")</ShadcnTableHead>
                    </ShadcnTableRow></ShadcnTableHeader>
                    <ShadcnTableBody>
                    @foreach (var quotation in Quotations!.Items)
                    {
                        <ShadcnTableRow>
                        <ShadcnTableCell data-label="@Localize("Record")" class="mlv-mono" data-field="Id">
                            <LegacyLink Href="@($"/Quotations/View?id={quotation.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@RecordActivityTitle(CustomerHistoryKind.Quotation, quotation.Id)">
                                @LocalizeFormat("QuotationNumber", new object?[] { quotation.Id })
                            </LegacyLink>
                        </ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Status")" class="history-status mlv-mono" data-field="Accepted">@QuotationStatus(quotation)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("ExpirationDate")" class="mlv-mono" data-field="ExpirationDate">@FormatDate(quotation.ExpirationDate)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Period")" class="mlv-mono" data-field="Period">@LocalizeFormat("PeriodDays", new object?[] { quotation.Period })</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("References")" class="history-meta mlv-mono" data-field="CustomerId EmployeeId InvoiceId CurrencyId">@DisplayReference("C", quotation.CustomerId) · @DisplayReference("E", quotation.EmployeeId) · @DisplayReference("I", quotation.InvoiceId) · @DisplayReference("¤", quotation.CurrencyId)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Amounts")" class="history-meta mlv-mono" data-field="Subtotal Vat Total WithholdingTax QuotedAmount">@DisplayMoney(quotation.Subtotal) · @DisplayMoney(quotation.Vat) · @DisplayMoney(quotation.Total) · @DisplayMoney(quotation.WithholdingTax) · @DisplayMoney(quotation.QuotedAmount)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("TermsAndDates")" class="history-meta" data-field="Comment Fob ShippedVia Terms CreatedDate ModifiedDate">@DisplayValue(quotation.Comment) · @DisplayValue(quotation.Fob) · @DisplayValue(quotation.ShippedVia) · @DisplayValue(quotation.Terms) · @FormatDate(quotation.CreatedDate) · @FormatDate(quotation.ModifiedDate)</ShadcnTableCell>
                        </ShadcnTableRow>
                    }
                    </ShadcnTableBody>
                </ShadcnTable>
                </div>
                break;
            case CustomerHistoryKind.Invoice:
                <div class="customer-history__table-scroll">
                <ShadcnTable Class="customer-history__table" ExpectedColumnCount="7" data-projection="history-invoices">
                    <ShadcnTableHeader><ShadcnTableRow>
                        <ShadcnTableHead>@Localize("Record")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Status")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Total")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("CreatedDate")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("References")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Amounts")</ShadcnTableHead>
                        <ShadcnTableHead>@Localize("Payment")</ShadcnTableHead>
                    </ShadcnTableRow></ShadcnTableHeader>
                    <ShadcnTableBody>
                    @foreach (var invoice in Invoices!.Items)
                    {
                        <ShadcnTableRow>
                        <ShadcnTableCell data-label="@Localize("Record")" class="mlv-mono" data-field="Id Number">
                            <LegacyLink Href="@($"/Invoices/View?id={invoice.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@RecordActivityTitle(CustomerHistoryKind.Invoice, invoice.Id, invoice.Number)">
                                @invoice.Number
                            </LegacyLink>
                        </ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Status")" class="history-status mlv-mono" data-field="IsPaid">@(invoice.IsPaid ? Localize("StatusPaid") : Localize("StatusOutstanding"))</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Total")" class="mlv-mono" data-field="Total Currency">@FormatInvoiceMoney(invoice.Total, invoice.Currency)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("CreatedDate")" class="mlv-mono" data-field="CreatedDate">@FormatDate(invoice.CreatedDate)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("References")" class="history-meta mlv-mono" data-field="CustomerId PurchaseOrderNumber ReceiptId">@DisplayReference("C", invoice.CustomerId) · @DisplayValue(invoice.PurchaseOrderNumber) · @DisplayReference("R", invoice.ReceiptId)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Amounts")" class="history-meta mlv-mono" data-field="Subtotal Vat WithholdingTax Outstanding">@DisplayMoney(invoice.Subtotal) · @DisplayMoney(invoice.Vat) · @DisplayMoney(invoice.WithholdingTax) · @DisplayMoney(invoice.Outstanding)</ShadcnTableCell>
                        <ShadcnTableCell data-label="@Localize("Payment")" class="history-meta mlv-mono" data-field="PaymentDate">@FormatDate(invoice.PaymentDate)</ShadcnTableCell>
                        </ShadcnTableRow>
                    }
                    </ShadcnTableBody>
                </ShadcnTable>
                </div>
                break;
        }

        <nav class="customer-history__pager" aria-label="@LocalizeFormat("HistoryPagination", new object?[] { Localize(HeadingKey) })">
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="@(Loading || CurrentPageIndex <= 1)" OnClick="PreviousPageAsync" aria-label="@Localize("PreviousPage")">
                @Localize("PreviousPage")
            </ShadcnButton>
            <span>@LocalizeFormat("PageOf", new object?[] { CurrentPageIndex, Math.Max(CurrentTotalPages, 1) })</span>
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Disabled="@(Loading || CurrentPageIndex >= CurrentTotalPages)" OnClick="NextPageAsync" aria-label="@Localize("NextPage")">
                @Localize("NextPage")
            </ShadcnButton>
        </nav>
    }
</section>

@code {
    [Parameter, EditorRequired] public CustomerHistoryKind Kind { get; set; }
    [Parameter] public OrderListPage? Orders { get; set; }
    [Parameter] public QuotationListPage? Quotations { get; set; }
    [Parameter] public InvoiceListPage? Invoices { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, object?[], string> LocalizeFormat { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string?, string> DisplayValue { get; set; } = null!;
    [Parameter, EditorRequired] public Func<DateTime?, string> FormatDate { get; set; } = null!;
    [Parameter, EditorRequired] public Func<decimal?, string, string> FormatMoney { get; set; } = null!;

    protected override void OnParametersSet() => ValidatePageContract();

    private IReadOnlyList<object> Items => Kind switch
    {
        CustomerHistoryKind.Order => Orders?.Items.Cast<object>().ToArray() ?? [],
        CustomerHistoryKind.Quotation => Quotations?.Items.Cast<object>().ToArray() ?? [],
        CustomerHistoryKind.Invoice => Invoices?.Items.Cast<object>().ToArray() ?? [],
        _ => [],
    };

    private string HeadingId => $"customer-{Kind.ToString().ToLowerInvariant()}-heading";
    private string HeadingKey => Kind.ToString() + "s";
    private string EmptyKey => Kind.ToString() + "sEmpty";

    private int CurrentPageIndex => Kind switch
    {
        CustomerHistoryKind.Order => Orders?.PageIndex ?? 1,
        CustomerHistoryKind.Quotation => Quotations?.PageIndex ?? 1,
        CustomerHistoryKind.Invoice => Invoices?.PageIndex ?? 1,
        _ => 1,
    };

    private int CurrentTotalPages => Kind switch
    {
        CustomerHistoryKind.Order => Orders?.TotalPages ?? 0,
        CustomerHistoryKind.Quotation => Quotations?.TotalPages ?? 0,
        CustomerHistoryKind.Invoice => Invoices?.TotalPages ?? 0,
        _ => 0,
    };

    private int? CurrentTotalRecords => Kind switch
    {
        CustomerHistoryKind.Order => Orders?.TotalRecords,
        CustomerHistoryKind.Quotation => Quotations?.TotalRecords,
        CustomerHistoryKind.Invoice => Invoices?.TotalRecords,
        _ => null,
    };

    private void ValidatePageContract()
    {
        var providedPages = (Orders is null ? 0 : 1) + (Quotations is null ? 0 : 1) + (Invoices is null ? 0 : 1);
        var matchingPageProvided = Kind switch
        {
            CustomerHistoryKind.Order => Orders is not null,
            CustomerHistoryKind.Quotation => Quotations is not null,
            CustomerHistoryKind.Invoice => Invoices is not null,
            _ => false,
        };

        if (providedPages != 1 || !matchingPageProvided)
        {
            throw new InvalidOperationException($"Customer history kind '{Kind}' requires exactly one matching page contract.");
        }
    }

    private Task PreviousPageAsync() => RequestPageAsync(CurrentPageIndex - 1);
    private Task NextPageAsync() => RequestPageAsync(CurrentPageIndex + 1);

    private Task RequestPageAsync(int requestedPage)
    {
        var lastPage = Math.Max(CurrentTotalPages, 1);
        var boundedPage = Math.Clamp(requestedPage, 1, lastPage);
        return boundedPage == CurrentPageIndex
            ? Task.CompletedTask
            : PageChanged.InvokeAsync(boundedPage);
    }

    private string OrderStatus(OrderListItem order) => order.Manufactured >= order.Quantity
        ? Localize("StatusComplete")
        : LocalizeFormat("OrderProgress", new object?[] { order.Manufactured, order.Quantity });

    private string QuotationStatus(QuotationListItem quotation) => quotation.Accepted switch
    {
        true => Localize("StatusAccepted"),
        false => Localize("StatusDeclined"),
        null => Localize("StatusOpen"),
    };

    private string RecordActivityTitle(CustomerHistoryKind kind, int id, string? label = null) => kind switch
    {
        CustomerHistoryKind.Order => LocalizeFormat("ViewOrderAccessible", new object?[] { id }),
        CustomerHistoryKind.Quotation => LocalizeFormat("ViewQuotationAccessible", new object?[] { id }),
        CustomerHistoryKind.Invoice => LocalizeFormat("ViewInvoiceAccessible", new object?[] { label ?? id.ToString(System.Globalization.CultureInfo.InvariantCulture) }),
        _ => throw new InvalidOperationException($"Unsupported customer history kind '{kind}'."),
    };

    private string FormatInvoiceMoney(decimal? amount, string currency) =>
        string.IsNullOrWhiteSpace(currency) ? DisplayValue(null) : FormatMoney(amount, currency);

    private string DisplayReference(string prefix, int? value) => value is null
        ? DisplayValue(null)
        : $"{prefix}{value.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private string DisplayNumber(int? value) => value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? DisplayValue(null);
    private string DisplayMoney(decimal? value) => value?.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) ?? DisplayValue(null);
    private string DisplayBoolean(bool value) => value ? Localize("Yes") : Localize("No");
}
