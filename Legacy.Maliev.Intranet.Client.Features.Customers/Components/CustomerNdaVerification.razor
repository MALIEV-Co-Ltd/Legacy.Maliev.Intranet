@namespace Legacy.Maliev.Intranet.Client.Features.Customers.Components
@inject HttpClient Http
@inject IStringLocalizer<CustomerNdaVerification> Text

<ShadcnCollapsible><ShadcnCollapsibleTrigger>@Text["Verify externally signed NDA"]</ShadcnCollapsibleTrigger><ShadcnCollapsibleContent>
    <p>@Text["Expiry does not release confidentiality."]</p>
    @if (agreement is not null) {
        <dl><dt>@Text["Agreement calendar"]</dt><dd>@Text[agreement.AgreementStatus]</dd><dt>@Text["Confidentiality obligation"]</dt><dd>@Text[agreement.ObligationStatus]</dd><dt>@Text["Expiry date (UTC)"]</dt><dd>@(agreement.ExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm 'UTC'") ?? Text["Unknown"].Value)</dd><dt>@Text["Confidentiality survival"]</dt><dd>@Text[agreement.SurvivalKind]</dd></dl>
    }
    @if (!string.IsNullOrEmpty(message)) { <p role="status" aria-live="polite">@Text[message]</p> }
    <label for="@Id("party-one")">@Text["First party"]</label><ShadcnInput TValue="string" id="@Id("party-one")" @bind-Value="partyOne" Required="true" maxlength="250" />
    <label for="@Id("party-two")">@Text["Second party"]</label><ShadcnInput TValue="string" id="@Id("party-two")" @bind-Value="partyTwo" Required="true" maxlength="250" />
    <label for="@Id("effective")">@Text["Effective date (UTC)"]</label><ShadcnInput TValue="string" id="@Id("effective")" Type="date" Value="@DateValue(effective)" ValueChanged="@(value => effective = ParseDate(value) ?? default)" />
    <label for="@Id("expiry")">@Text["Expiry date (UTC)"]</label><ShadcnInput TValue="string" id="@Id("expiry")" Type="date" Value="@DateValue(expiry)" ValueChanged="@(value => expiry = ParseDate(value))" />
    <label for="@Id("renewal")">@Text["Renewal date (UTC)"]</label><ShadcnInput TValue="string" id="@Id("renewal")" Type="date" Value="@DateValue(renewal)" ValueChanged="@(value => renewal = ParseDate(value))" />
    <label for="@Id("survival")">@Text["Confidentiality survival"]</label><ShadcnSelect TValue="string" id="@Id("survival")" @bind-Value="survival" Options="@SurvivalOptions" />
    @if (survival == "Finite") { <label for="@Id("survival-end")">@Text["Survival end date (UTC)"]</label><ShadcnInput TValue="string" id="@Id("survival-end")" Type="date" Value="@DateValue(survivalEnd)" ValueChanged="@(value => survivalEnd = ParseDate(value))" /> }
    <label for="@Id("coverage")">@Text["Explicit coverage"]</label><ShadcnSelect TValue="string" id="@Id("coverage")" @bind-Value="coverageKind" Options="@CoverageOptions" />
    @if (coverageKind != "Customer") { <label for="@Id("resource")">@Text["Canonical resource ID"]</label><ShadcnInput TValue="int" id="@Id("resource")" Type="number" min="1" @bind-Value="resourceId" /> }
    <label for="@Id("responsible")">@Text["Responsible employee subject"]</label><ShadcnInput TValue="string" id="@Id("responsible")" @bind-Value="responsible" Required="true" maxlength="250" />
    <label for="@Id("reason")">@Text["Verification reason"]</label><ShadcnTextarea TValue="string" id="@Id("reason")" @bind-Value="reason" maxlength="1000" Required="true" />
    <p>@Text["Unknown survival remains protected and requires review."]</p>
    <ShadcnButton id="@Id("verify")" OnClick="VerifyAsync" Disabled="@busy" OperationFeedback="false">@Text["Verify exact signed version"]</ShadcnButton>
    @if (agreementStatus == "Expired" && obligationStatus != "Released") { <p role="alert">@Text["Expired but protected"]</p> }
</ShadcnCollapsibleContent></ShadcnCollapsible>

@code {
    private IReadOnlyList<ShadcnSelectOption<string>> SurvivalOptions => new[] { "Unknown", "Indefinite", "Finite" }.Select(value => new ShadcnSelectOption<string>(value, Text[value])).ToArray();
    private IReadOnlyList<ShadcnSelectOption<string>> CoverageOptions => new[] { new ShadcnSelectOption<string>("", Text["Select coverage"]), new ShadcnSelectOption<string>("Customer", Text["Customer-wide coverage"]) }.Concat(coverageKinds.Select(value => new ShadcnSelectOption<string>(value, Text[value]))).ToArray();
    private static string DateValue(DateTime? value) => value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    private static DateTime? ParseDate(string value) => DateTime.TryParseExact(value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date) ? date : null;
    [Parameter] public int CustomerId { get; set; }
    [Parameter] public Guid DocumentId { get; set; }
    [Parameter] public Guid VersionId { get; set; }
    [Parameter] public long ExpectedRevision { get; set; }
    [Parameter] public EventCallback ParentRefresh { get; set; }
    private string partyOne = "", partyTwo = "", responsible = "", reason = "", message = "", agreementStatus = "", obligationStatus = "";
    private DateTime effective = DateTime.UtcNow.Date;
    private DateTime? expiry;
    private DateTime? renewal, survivalEnd;
    private string survival = "Unknown", coverageKind = "";
    private int resourceId;
    private static readonly string[] coverageKinds = ["Order", "Quotation", "Invoice", "Replacement", "Shipment"];
    private bool busy;
    private CustomerNdaAgreementSummary? agreement;
    private string Id(string field) => $"nda-{VersionId:D}-{field}";
    protected override async Task OnParametersSetAsync() {
        agreement = null; agreementStatus = ""; obligationStatus = ""; message = "";
        try {
            using var response = await Http.GetAsync($"/bff/customers/{CustomerId}/documents/{DocumentId:D}/nda?versionId={VersionId:D}");
            if (response.StatusCode == HttpStatusCode.NotFound) return;
            if (!response.IsSuccessStatusCode) { message = "Document service is unavailable. Please retry later."; return; }
            agreement = await response.Content.ReadFromJsonAsync<CustomerNdaAgreementSummary>();
            agreementStatus = agreement?.AgreementStatus ?? ""; obligationStatus = agreement?.ObligationStatus ?? "";
        } catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException) { message = "Document service is unavailable. Please retry later."; }
    }
    private async Task VerifyAsync() {
        if (coverageKind == "" || coverageKind != "Customer" && resourceId <= 0 || survival == "Finite" && survivalEnd is null || string.IsNullOrWhiteSpace(partyOne) || string.IsNullOrWhiteSpace(partyTwo) || string.IsNullOrWhiteSpace(responsible) || string.IsNullOrWhiteSpace(reason)) { message = "Complete agreement details and explicit coverage."; return; }
        var customer = CustomerId; var document = DocumentId;
        var input = new CustomerNdaVerificationRequest(VersionId, ExpectedRevision, partyOne, partyTwo, new DateTimeOffset(DateTime.SpecifyKind(effective, DateTimeKind.Utc)), Utc(expiry), Utc(renewal), survival, survival == "Finite" ? Utc(survivalEnd) : null, responsible, [new(coverageKind, coverageKind == "Customer" ? customer : resourceId)], reason);
        busy = true;
        try {
            var session = await Http.GetFromJsonAsync<EmployeeSessionSummary>("/bff/session");
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { message = "Document access denied."; return; }
            using var request = new HttpRequestMessage(HttpMethod.Post, $"/bff/customers/{customer}/documents/{document:D}/nda/verification") { Content = JsonContent.Create(input) };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (!response.IsSuccessStatusCode) { if (response.StatusCode == HttpStatusCode.Conflict) await ParentRefresh.InvokeAsync(); message = response.StatusCode == HttpStatusCode.Conflict ? "The document changed. Reload before retrying." : "Verification was refused or unavailable."; return; }
            var result = await response.Content.ReadFromJsonAsync<CustomerNdaVerificationReceipt>();
            if (result is null) { message = "Verification was refused or unavailable."; return; }
            await ParentRefresh.InvokeAsync(); await OnParametersSetAsync();
            agreementStatus = result.AgreementStatus; obligationStatus = result.ObligationStatus; message = "Verified exact signed version.";
        } catch (HttpRequestException) { message = "Verification was refused or unavailable."; }
        finally { busy = false; }
    }
    private static DateTimeOffset? Utc(DateTime? value) => value is null ? null : new DateTimeOffset(DateTime.SpecifyKind(value.Value, DateTimeKind.Utc));
}
