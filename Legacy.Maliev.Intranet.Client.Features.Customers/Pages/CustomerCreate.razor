@page "/Customers/Create"
@page "/customers/new"
@page "/sales/customers/new"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<CustomerCreate> Text
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="customer-create">
    <header class="operations-page-header"><div><h1>@Text["CreateCustomer"]</h1><p>@Text["ProfileAndAccount"]</p></div></header>
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert" Class="customer-create__alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    @if (!string.IsNullOrWhiteSpace(onboardingWarning) && createdCustomerId is { } customerId)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status" Class="customer-create__alert">
            <ShadcnAlertDescription>
                @onboardingWarning
                <LegacyLink Href="@($"/Customers/View?id={customerId}")" Role="LegacyLinkRole.Navigation">@Text["ViewCreatedCustomer"]</LegacyLink>
            </ShadcnAlertDescription>
        </ShadcnAlert>
    }
    <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="HandleInvalidSubmit" Class="customer-create__form">
        <DataAnnotationsValidator />
        <section class="customer-create__section" aria-labelledby="customer-identity-heading">
            <h2 id="customer-identity-heading">@Text["IdentityAndAccess"]</h2>
            <div class="customer-create__grid">
                <ShadcnFormField Id="customer-create-first-name" Label="@Text["FirstName"]" Error="@ValidationFor(() => model.FirstName)" Required="true"><Control><ShadcnInput TValue="string" id="customer-create-first-name" @bind-Value="model.FirstName" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="customer-create-last-name" Label="@Text["LastName"]" Error="@ValidationFor(() => model.LastName)" Required="true"><Control><ShadcnInput TValue="string" id="customer-create-last-name" @bind-Value="model.LastName" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="customer-create-email" Label="@Text["Email"]" Error="@ValidationFor(() => model.Email)" Required="true" Class="customer-create__span"><Control><ShadcnInput TValue="string" id="customer-create-email" Type="email" @bind-Value="model.Email" Required="true" /></Control></ShadcnFormField>
                <p class="customer-create__privacy customer-create__span">@Text["AccountNotificationDescription"]</p>
            </div>
        </section>
        <section class="customer-create__section" aria-labelledby="customer-contact-heading">
            <h2 id="customer-contact-heading">@Text["ContactDetails"]</h2>
            <div class="customer-create__grid">
                <ShadcnFormField Id="customer-create-telephone" Label="@Text["Telephone"]" Error="@ValidationFor(() => model.Telephone)" Required="true"><Control><ShadcnInput TValue="string" id="customer-create-telephone" Type="tel" @bind-Value="model.Telephone" Required="true" /></Control></ShadcnFormField>
                <ShadcnFormField Id="customer-create-mobile" Label="@Text["Mobile"]"><Control><ShadcnInput TValue="string" id="customer-create-mobile" Type="tel" @bind-Value="model.Mobile" /></Control></ShadcnFormField>
                <ShadcnFormField Id="customer-create-fax" Label="@Text["Fax"]"><Control><ShadcnInput TValue="string" id="customer-create-fax" @bind-Value="model.Fax" /></Control></ShadcnFormField>
                <ShadcnFormField Id="customer-create-date-of-birth" Label="@Text["DateOfBirth"]"><Control><ShadcnDatePicker id="customer-create-date-of-birth" @bind-Value="DateOfBirth" Clearable="true" CalendarLabel="@Text["DateOfBirth"]" /></Control></ShadcnFormField>
            </div>
        </section>
        <div class="customer-create__actions">
            <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">
                @(submitting ? Text["Submitting"] : Text["CreateCustomer"])
            </ShadcnButton>
            <LegacyLink Href="/Customers/Index" Role="LegacyLinkRole.Navigation" Disabled="@submitting" AriaLabel="@Text["Cancel"]">@Text["Cancel"]</LegacyLink>
        </div>
    </EditForm>
</main>

@code {
    private readonly CreateCustomerAccountRequest model = new();
    private EditContext editContext = null!;
    private bool submitting;
    private string? error;
    private string? onboardingWarning;
    private int? createdCustomerId;

    protected override void OnInitialized() => editContext = new EditContext(model);

    private DateOnly? DateOfBirth
    {
        get => model.DateOfBirth is DateTime date ? DateOnly.FromDateTime(date) : null;
        set => model.DateOfBirth = value?.ToDateTime(TimeOnly.MinValue);
    }

    private string? ValidationFor<TValue>(Expression<Func<TValue>> expression) =>
        editContext.GetValidationMessages(FieldIdentifier.Create(expression)).FirstOrDefault();

    private void HandleInvalidSubmit(EditContext _) => error = Text["ValidationFailed"];

    private async Task SubmitAsync()
    {
        if (submitting)
        {
            return;
        }

        submitting = true;
        error = null;
        onboardingWarning = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                error = Text["CreateFailed"];
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/customers")
            {
                Content = JsonContent.Create(model),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                error = Text["ValidationFailed"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                error = Text["Conflict"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == HttpStatusCode.BadGateway)
                {
                    error = Text["InvalidResponse"];
                    return;
                }

                if (response.StatusCode == HttpStatusCode.ServiceUnavailable)
                {
                    error = Text["ServiceUnavailable"];
                    return;
                }

                error = Text["CreateFailed"];
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CreatedCustomerAccount>();
            if (created is null || created.Id <= 0)
            {
                error = Text["InvalidResponse"];
                return;
            }

            if (!string.Equals(created.OnboardingDelivery, "delivered", StringComparison.Ordinal))
            {
                createdCustomerId = created.Id;
                onboardingWarning = Text["OnboardingDeliveryPending"];
                return;
            }

            Navigation.NavigateTo($"/Customers/View?id={created.Id}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["CreateFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private void NavigateToLogin() => Navigation.NavigateTo(
        $"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
