@page "/Customers/Index"
@page "/customers"
@page "/sales/customers"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Customers> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="customers-page">
<div class="customer-shell">
    <header class="operations-page-header customers-page-header">
        <div><MudText Typo="Typo.h4" HtmlTag="h1">@Text["Customers"]</MudText><MudText Typo="Typo.body2">@Text["Profiles"]</MudText></div>
        <MudButton Href="/Customers/Create" Variant="Variant.Filled" Color="Color.Primary">
            @Text["CreateCustomer"]
        </MudButton>
    </header>

    <ListToolbar TSort="CustomerListSort"
                 Value="@ToolbarState"
                 Defaults="@DefaultToolbarState"
                 SortOptions="@SortOptions"
                 PageSizeOptions="@PageSizeOptions"
                 SearchLabel="@Text["Search"]"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite"><MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" /><span class="visually-hidden">@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Text["Empty"]</MudAlert>
    }
    else
    {
        <div class="customers-results-bar">
            <MudText Class="customers-results-summary" aria-live="polite">
                @Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords]
            </MudText>
            @if (page.TotalPages > 1)
            {
                <nav class="customers-pagination customers-pagination--top" aria-label="@Text["CustomerPagesTop"]">
                    <MudButton Variant="Variant.Text" Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</MudButton>
                </nav>
            }
        </div>
        <div class="customers-table-shell">
        <MudTable Items="page.Items" Hover="true" Breakpoint="Breakpoint.None" Elevation="0" Class="customers-table" aria-label="@Text["CustomersTable"]">
            <HeaderContent>
                <MudTh Class="customer-id-cell" aria-sort="@GetAriaSort(CustomerListSort.CustomerId_Ascending, CustomerListSort.CustomerId_Descending)">
                    <MudButton Class="customer-sort-button" Variant="Variant.Text" OnClick="@(() => SortFromHeaderAsync(CustomerListSort.CustomerId_Ascending, CustomerListSort.CustomerId_Descending))" aria-label="@Text["SortByField", Text["Id"]]">@Text["Id"]</MudButton>
                </MudTh>
                <MudTh Class="customer-name-cell">@Text["Name"]</MudTh>
                <MudTh Class="customer-email-cell" aria-sort="@GetAriaSort(CustomerListSort.CustomerEmail_Ascending, CustomerListSort.CustomerEmail_Descending)">
                    <MudButton Class="customer-sort-button" Variant="Variant.Text" OnClick="@(() => SortFromHeaderAsync(CustomerListSort.CustomerEmail_Ascending, CustomerListSort.CustomerEmail_Descending))" aria-label="@Text["SortByField", Text["Email"]]">@Text["Email"]</MudButton>
                </MudTh>
                <MudTh Class="customer-company-cell" aria-sort="@GetAriaSort(CustomerListSort.CustomerCompany_Ascending, CustomerListSort.CustomerCompany_Descending)">
                    <MudButton Class="customer-sort-button" Variant="Variant.Text" OnClick="@(() => SortFromHeaderAsync(CustomerListSort.CustomerCompany_Ascending, CustomerListSort.CustomerCompany_Descending))" aria-label="@Text["SortByField", Text["Company"]]">@Text["Company"]</MudButton>
                </MudTh>
                <MudTh Class="customer-action-cell"><span class="visually-hidden">@Text["Actions"]</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Text["Id"]" Class="customer-id-cell">@context.Id</MudTd>
                <MudTd DataLabel="@Text["Name"]" Class="customer-name-cell">
                    <MudMenu Label="@context.FullName"
                             AriaLabel="@context.FullName"
                             Variant="Variant.Text"
                             Dense="true"
                             FullWidth="true"
                             Class="customer-value-disclosure customer-name-disclosure">
                        <MudMenuItem Class="customer-full-value" Style="max-width: min(24rem, calc(100vw - 2rem)); white-space: normal; overflow-wrap: anywhere;">@context.FullName</MudMenuItem>
                    </MudMenu>
                </MudTd>
                <MudTd DataLabel="@Text["Email"]" Class="customer-email-cell">
                    <MudMenu Label="@context.Email"
                             AriaLabel="@context.Email"
                             Variant="Variant.Text"
                             Dense="true"
                             FullWidth="true"
                             Class="customer-value-disclosure customer-email-disclosure">
                        <MudMenuItem Class="customer-full-value" Style="max-width: min(24rem, calc(100vw - 2rem)); white-space: normal; overflow-wrap: anywhere;">@context.Email</MudMenuItem>
                    </MudMenu>
                </MudTd>
                <MudTd DataLabel="@Text["Company"]" Class="customer-company-cell">
                    @if (!string.IsNullOrWhiteSpace(context.Company?.Name))
                    {
                        <MudMenu Label="@context.Company.Name"
                                 AriaLabel="@context.Company.Name"
                                 Variant="Variant.Text"
                                 Dense="true"
                                 FullWidth="true"
                                 Class="customer-value-disclosure customer-company-disclosure">
                            <MudMenuItem Class="customer-full-value" Style="max-width: min(24rem, calc(100vw - 2rem)); white-space: normal; overflow-wrap: anywhere;">@context.Company.Name</MudMenuItem>
                        </MudMenu>
                    }
                </MudTd>
                <MudTd DataLabel="@Text["Actions"]" Class="customer-action-cell">
                    <LegacyLink Href="@($"/Customers/View?id={context.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["View"]} {context.Id}")">@Text["View"]</LegacyLink>
                </MudTd>
            </RowTemplate>
        </MudTable>
        </div>
        @if (page.TotalPages > 1)
        {
            <nav class="customers-pagination customers-pagination--bottom" aria-label="@Text["CustomerPagesBottom"]">
                <MudButton Variant="Variant.Text" Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</MudButton>
                <MudButton Variant="Variant.Text" Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</MudButton>
            </nav>
        }
    }
</div>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private CustomerListPage? page;
    private string? error;
    private bool loading;
    private CustomerListSort currentSort = CustomerListSort.CustomerCreatedDate_Descending;
    private readonly LatestRequestGate requestGate = new();
    private static readonly ListToolbarState<CustomerListSort> DefaultToolbarState =
        new(null, CustomerListSort.CustomerCreatedDate_Descending, 25);
    private static readonly int[] PageSizeOptions = [25, 50, 100, 250];
    private ListToolbarState<CustomerListSort> ToolbarState => new(Search, currentSort, Size);
    private IReadOnlyList<ListToolbarOption<CustomerListSort>> SortOptions =>
    [
        new(CustomerListSort.CustomerCreatedDate_Descending, Text[nameof(CustomerListSort.CustomerCreatedDate_Descending)]),
        new(CustomerListSort.CustomerCreatedDate_Ascending, Text[nameof(CustomerListSort.CustomerCreatedDate_Ascending)]),
        new(CustomerListSort.CustomerModifiedDate_Descending, Text[nameof(CustomerListSort.CustomerModifiedDate_Descending)]),
        new(CustomerListSort.CustomerModifiedDate_Ascending, Text[nameof(CustomerListSort.CustomerModifiedDate_Ascending)]),
        new(CustomerListSort.CustomerCompany_Ascending, Text[nameof(CustomerListSort.CustomerCompany_Ascending)]),
        new(CustomerListSort.CustomerCompany_Descending, Text[nameof(CustomerListSort.CustomerCompany_Descending)]),
        new(CustomerListSort.CustomerEmail_Ascending, Text[nameof(CustomerListSort.CustomerEmail_Ascending)]),
        new(CustomerListSort.CustomerEmail_Descending, Text[nameof(CustomerListSort.CustomerEmail_Descending)]),
        new(CustomerListSort.CustomerId_Descending, Text[nameof(CustomerListSort.CustomerId_Descending)]),
        new(CustomerListSort.CustomerId_Ascending, Text[nameof(CustomerListSort.CustomerId_Ascending)])
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        currentSort = Enum.TryParse<CustomerListSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : CustomerListSort.CustomerCreatedDate_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<CustomerListSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? ToolbarState).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/customers?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<CustomerListPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private Task SortFromHeaderAsync(CustomerListSort ascending, CustomerListSort descending) =>
        NavigateAsync(1, Search, currentSort == ascending ? descending : ascending, Size, replace: true);

    private string GetAriaSort(CustomerListSort ascending, CustomerListSort descending) =>
        currentSort == ascending ? "ascending" : currentSort == descending ? "descending" : "none";

    private Task HandleToolbarRequestAsync(ListToolbarRequest<CustomerListSort> request)
    {
        var state = request.State.Normalize();
        if (request.Reason == ListToolbarChangeReason.Refreshed && state == ToolbarState.Normalize())
        {
            return LoadAsync();
        }

        return NavigateAsync(1, state.Search, state.Sort, state.PageSize, replace: true);
    }

    private Task NavigateAsync(int index, string? search, CustomerListSort sort, int size, bool replace = false)
    {
        var uri = $"/Customers/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}";
        Navigation.NavigateTo(uri, replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();
}
