@page "/Customers/Index"
@page "/customers"
@page "/sales/customers"
@using System.Globalization
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Customers> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="mlv-module-shell customers-page">
<div class="customer-shell mlv-page-body">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header customers-page-header">
        <div><h1>@Text["Customers"]</h1><p class="customers-page-subtitle">@Text["Profiles"]</p></div>
        <ShadcnButton Href="/Customers/Create">
            @Text["CreateCustomer"]
        </ShadcnButton>
    </header>

    <section class="customer-table-region" aria-label="@Text["CustomersTable"]">
        <OperationalDataTable TItem="CustomerListItem"
                              Items="@(page?.Items ?? [])"
                              Columns="@Columns"
                              RowKey="@(customer => customer.Id.ToString(CultureInfo.InvariantCulture))"
                              State="@dataTableState"
                              StateChanged="HandleDataTableStateChangedAsync"
                              RequestChanged="HandleDataTableRequestAsync"
                              TotalCount="@(page?.TotalRecords ?? 0)"
                              Loading="@loading"
                              Error="@error"
                              FilterPlaceholder="@Text["Search"]"
                              EmptyText="@Text["Empty"]"
                              LoadingText="@Text["Loading"]"
                              ActionsLabel="@Text["Actions"]"
                              PageSizeOptions="@PageSizeOptions"
                              DetailHref="@(customer => $"/Customers/View?id={customer.Id}")"
                              DetailAriaLabel="@(customer => Text["ViewCustomer", customer.Id])"
                              DetailsAriaLabel="@(customer => Text["ExpandCustomer", customer.Id])">
            <QuickViewContent Context="context">
                <dl class="customer-quick-view">
                    <div><dt>@Text["Name"]</dt><dd>@context.FullName</dd></div>
                    <div><dt>@Text["Email"]</dt><dd>@context.Email</dd></div>
                    <div><dt>@Text["Company"]</dt><dd>@ValueOrFallback(context.Company?.Name)</dd></div>
                </dl>
            </QuickViewContent>
        </OperationalDataTable>
    </section>
</div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 25;

    private CustomerListPage? page;
    private string? error;
    private bool loading;
    private CustomerListSort currentSort = CustomerListSort.CustomerCreatedDate_Descending;
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 25 };
    private static readonly int[] PageSizeOptions = [25, 50, 100, 250];
    private IReadOnlyList<ShadcnDataTableColumn<CustomerListItem>> Columns =>
    [
        new("id", Text["Id"], customer => customer.Id) { Sortable = true, Filterable = true, Hideable = false },
        new("name", Text["Name"], customer => customer.FullName) { Filterable = true, MinWidth = "12rem" },
        new("email", Text["Email"], customer => customer.Email) { Sortable = true, Filterable = true, MinWidth = "14rem" },
        new("company", Text["Company"], customer => ValueOrFallback(customer.Company?.Name)) { Sortable = true, Filterable = true, MinWidth = "14rem" },
    ];
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Customers"]),
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        currentSort = Enum.TryParse<CustomerListSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : CustomerListSort.CustomerCreatedDate_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<CustomerListSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? new ListToolbarState<CustomerListSort>(Search, currentSort, Size)).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/customers?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<CustomerListPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, CustomerListSort sort, int size, bool replace = false)
    {
        var uri = $"/Customers/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}";
        Navigation.NavigateTo(uri, replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, Index - 1),
        PageSize = Size,
        Sorts = currentSort switch
        {
            CustomerListSort.CustomerId_Ascending => [new("id", ShadcnSortDirection.Ascending)],
            CustomerListSort.CustomerId_Descending => [new("id", ShadcnSortDirection.Descending)],
            CustomerListSort.CustomerEmail_Ascending => [new("email", ShadcnSortDirection.Ascending)],
            CustomerListSort.CustomerEmail_Descending => [new("email", ShadcnSortDirection.Descending)],
            CustomerListSort.CustomerCompany_Ascending => [new("company", ShadcnSortDirection.Ascending)],
            CustomerListSort.CustomerCompany_Descending => [new("company", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private CustomerListSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => CustomerListSort.CustomerId_Ascending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => CustomerListSort.CustomerId_Descending,
        { ColumnKey: "email", Direction: ShadcnSortDirection.Ascending } => CustomerListSort.CustomerEmail_Ascending,
        { ColumnKey: "email", Direction: ShadcnSortDirection.Descending } => CustomerListSort.CustomerEmail_Descending,
        { ColumnKey: "company", Direction: ShadcnSortDirection.Ascending } => CustomerListSort.CustomerCompany_Ascending,
        { ColumnKey: "company", Direction: ShadcnSortDirection.Descending } => CustomerListSort.CustomerCompany_Descending,
        _ => currentSort,
    };

    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
