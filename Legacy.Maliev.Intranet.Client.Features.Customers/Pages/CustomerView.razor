@page "/Customers/View"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<CustomerView> Text

<PageTitle>@(customer is null ? Text["PageTitle"] : Text["CustomerPageTitle", customer.FullName])</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="customer-detail">
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-live="polite" aria-label="@Text["Loading"]" />
        }
        else if (!string.IsNullOrWhiteSpace(error))
        {
            <MudAlert Severity="errorSeverity" Class="mb-4" aria-live="assertive">@error</MudAlert>
            <div class="d-flex flex-wrap gap-2">
                @if (!notFound)
                {
                    <MudButton OnClick="LoadAsync" Variant="Variant.Filled" Color="Color.Primary">@Text["Retry"]</MudButton>
                }
                <MudButton Href="/Customers/Index" Variant="Variant.Text">@Text["BackToCustomers"]</MudButton>
            </div>
        }
        else if (customer is not null)
        {
            <header class="customer-detail__header operations-page-header">
                <div class="customer-detail__identity">
                    <MudText Typo="Typo.h4" HtmlTag="h1">@customer.FullName</MudText>
                    <MudText Typo="Typo.body2" Class="customer-detail__number">@Text["CustomerNumber", customer.Id]</MudText>
                </div>
                @if (canEdit)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@submitting" OnClick="BeginEdit" aria-label="@Text["EditCustomer"]">
                        @Text["EditCustomer"]
                    </MudButton>
                }
            </header>

            <div class="customer-detail__layout">
                <section class="customer-detail__section customer-detail__primary" aria-labelledby="customer-contact-heading">
                    <MudText Typo="Typo.h6" HtmlTag="h2" id="customer-contact-heading" Class="customer-detail__section-title">@Text["Contact"]</MudText>
                    @if (editing)
                    {
                        <MudForm @ref="editForm" Model="@editModel" @bind-IsValid="editFormValid">
                            <div class="customer-detail__form-grid">
                                <MudTextField @bind-Value="editModel.FirstName" For="@(() => editModel.FirstName)" Label="@Text["FirstName"]" Required="true" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="editModel.LastName" For="@(() => editModel.LastName)" Label="@Text["LastName"]" Required="true" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="editModel.Email" For="@(() => editModel.Email)" Label="@Text["Email"]" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="editModel.Telephone" For="@(() => editModel.Telephone)" Label="@Text["Telephone"]" InputType="InputType.Telephone" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="editModel.Mobile" For="@(() => editModel.Mobile)" Label="@Text["Mobile"]" InputType="InputType.Telephone" Variant="Variant.Outlined" />
                                <MudTextField @bind-Value="editModel.Fax" For="@(() => editModel.Fax)" Label="@Text["Fax"]" Variant="Variant.Outlined" />
                                <MudDatePicker @bind-Date="editModel.DateOfBirth" For="@(() => editModel.DateOfBirth)" Label="@Text["DateOfBirth"]" Variant="Variant.Outlined" />
                            </div>
                            <div class="customer-detail__form-actions">
                                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary" Disabled="@submitting" OnClick="SaveAsync">
                                    @(submitting ? Text["Saving"] : Text["SaveChanges"])
                                </MudButton>
                                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" Disabled="@submitting" OnClick="CancelEdit">
                                    @Text["Cancel"]
                                </MudButton>
                            </div>
                        </MudForm>
                    }
                    else
                    {
                        <dl class="customer-detail__details details">
                            <div><dt>@Text["Email"]</dt><dd><a href="mailto:@customer.Email">@customer.Email</a></dd></div>
                            <div><dt>@Text["Telephone"]</dt><dd>@Display(customer.Telephone)</dd></div>
                            <div><dt>@Text["Mobile"]</dt><dd>@Display(customer.Mobile)</dd></div>
                            <div><dt>@Text["Fax"]</dt><dd>@Display(customer.Fax)</dd></div>
                            <div><dt>@Text["DateOfBirth"]</dt><dd>@DisplayDate(customer.DateOfBirth)</dd></div>
                        </dl>
                    }
                </section>

                <aside class="customer-detail__secondary" aria-label="@Text["Company"]">
                    <section class="customer-detail__section" aria-labelledby="customer-company-heading">
                        <MudText Typo="Typo.h6" HtmlTag="h2" id="customer-company-heading" Class="customer-detail__section-title">@Text["Company"]</MudText>
                        @if (customer.Company is null)
                        {
                            <MudText Class="customer-detail__empty">@Text["NotAvailable"]</MudText>
                        }
                        else
                        {
                            <dl class="customer-detail__details details">
                                <div><dt>@Text["CompanyName"]</dt><dd>@customer.Company.Name</dd></div>
                                <div><dt>@Text["TaxNumber"]</dt><dd>@Display(customer.Company.TaxNumber)</dd></div>
                                <div><dt>@Text["Registrar"]</dt><dd>@Display(customer.Company.Registrar)</dd></div>
                            </dl>
                        }
                    </section>
                    <section class="customer-detail__section customer-detail__record" aria-labelledby="customer-record-heading">
                        <MudText Typo="Typo.h6" HtmlTag="h2" id="customer-record-heading" Class="customer-detail__section-title">@Text["RecordInformation"]</MudText>
                        <dl class="customer-detail__details details">
                            <div><dt>@Text["CreatedDate"]</dt><dd>@DisplayDateTime(customer.CreatedDate)</dd></div>
                            <div><dt>@Text["ModifiedDate"]</dt><dd>@DisplayDateTime(customer.ModifiedDate)</dd></div>
                        </dl>
                    </section>
                </aside>
            </div>

            <div class="customer-detail__addresses">
                <section class="customer-detail__section" aria-labelledby="customer-billing-heading">
                    <MudText Typo="Typo.h6" HtmlTag="h2" id="customer-billing-heading" Class="customer-detail__section-title">@Text["BillingAddress"]</MudText>
                    <address class="customer-detail__address">@DisplayAddress(customer.BillingAddress)</address>
                </section>
                <section class="customer-detail__section" aria-labelledby="customer-shipping-heading">
                    <MudText Typo="Typo.h6" HtmlTag="h2" id="customer-shipping-heading" Class="customer-detail__section-title">@Text["ShippingAddress"]</MudText>
                    <address class="customer-detail__address">@DisplayAddress(customer.ShippingAddress)</address>
                </section>
            </div>

            <nav class="customer-detail__footer" aria-label="@Text["BackToCustomers"]">
                <MudButton Href="/Customers/Index" Variant="Variant.Text">@Text["BackToCustomers"]</MudButton>
            </nav>
        }
    </div>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }

    private CustomerDetail? customer;
    private readonly CustomerUpdateRequest editModel = new();
    private MudForm? editForm;
    private bool editFormValid;
    private bool canEdit;
    private bool editing;
    private bool submitting;
    private string? error;
    private Severity errorSeverity = Severity.Error;
    private bool loading;
    private bool notFound;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        customer = null;
        error = null;
        errorSeverity = Severity.Error;
        notFound = false;
        editing = false;
        submitting = false;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canEdit = authenticationState.User.Claims.Any(claim =>
            claim.Type == "permissions" &&
            claim.Value == "legacy-customer.customers.update");
        if (Id <= 0)
        {
            error = Text["NotFound"];
            errorSeverity = Severity.Warning;
            notFound = true;
            return;
        }

        loading = true;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/customers/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                error = Text["NotFound"];
                errorSeverity = Severity.Warning;
                notFound = true;
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                error = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            customer = await response.Content.ReadFromJsonAsync<CustomerDetail>();
            if (customer is null || customer.Id != Id)
            {
                customer = null;
                error = Text["InvalidResponse"];
            }
            else
            {
                CopyToEditModel(customer);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private void BeginEdit()
    {
        if (!canEdit || customer is null)
        {
            return;
        }

        CopyToEditModel(customer);
        error = null;
        editing = true;
    }

    private void CancelEdit()
    {
        editing = false;
        error = null;
    }

    private async Task SaveAsync()
    {
        if (!canEdit || !editing || submitting || editForm is null)
        {
            return;
        }

        await editForm.ValidateAsync();
        if (!editFormValid)
        {
            error = Text["ValidationFailed"];
            return;
        }

        submitting = true;
        error = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                error = Text["SaveFailed"];
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/customers/{Id}")
            {
                Content = JsonContent.Create(editModel),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["ForbiddenUpdate"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                error = Text["ValidationFailed"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                error = Text["NotFound"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                error = Text["Conflict"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["SaveFailed"];
                return;
            }

            editing = false;
            await OnParametersSetAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private void CopyToEditModel(CustomerDetail value)
    {
        editModel.FirstName = value.FirstName;
        editModel.LastName = value.LastName;
        editModel.Email = value.Email;
        editModel.Telephone = value.Telephone;
        editModel.Mobile = value.Mobile;
        editModel.Fax = value.Fax;
        editModel.DateOfBirth = value.DateOfBirth;
    }

    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotAvailable"] : value;

    private string DisplayDate(DateTime? value) =>
        LegacyPresentation.FormatCalendarDate(value, System.Globalization.CultureInfo.CurrentCulture, Text["NotAvailable"]);

    private string DisplayDateTime(DateTime? value) =>
        LegacyPresentation.FormatUtcDateTime(value, System.Globalization.CultureInfo.CurrentCulture, Text["NotAvailable"]);

    private string DisplayAddress(CustomerAddressDetail? address)
    {
        if (address is null)
        {
            return Text["NotAvailable"];
        }

        return string.Join(", ", new[]
        {
            address.Building,
            address.AddressLine1,
            address.AddressLine2,
            address.City,
            address.State,
            address.PostalCode,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private void NavigateToLogin() => Navigation.NavigateTo(
        $"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
