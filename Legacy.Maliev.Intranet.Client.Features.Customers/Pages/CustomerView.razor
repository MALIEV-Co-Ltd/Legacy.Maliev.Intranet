    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");

    private long? RelationAuthorizationRevision()
    {
        lock (authenticationStateLock)
        {
            var revision = authenticationRevision;
            return !disposed && canEdit && Volatile.Read(ref appliedAuthenticationRevision) == revision ? revision : null;
        }
    }

    private void ApplyPermissions(System.Security.Claims.ClaimsPrincipal user)
    {
        relationPermissions = user.FindAll("permissions").Select(claim => claim.Value).ToArray();
        canEdit = LegacyNavigationAuthorization.IsEnabled(user, "legacy-customer.customers.update");
        canAdminister = user.Identity?.IsAuthenticated == true && new[] { "legacy-customer.customers.read", "legacy-customer.customers.update",
            "legacy-auth.customer-identities.read", "legacy-auth.customer-identities.update" }
            .All(permission => user.HasClaim("permissions", permission));
        canReadOrders = LegacyNavigationAuthorization.IsEnabled(user, "legacy.orders.read");
        canReadQuotations = LegacyNavigationAuthorization.IsEnabled(user, "legacy.quotations.read");
        canReadInvoices = LegacyNavigationAuthorization.IsEnabled(user, "legacy.accounting.read");
    }

    private async Task<(AuthenticationState State, long Revision)> GetLatestAuthenticationStateAsync()
    {
        while (true)
        {
            Task<AuthenticationState>? pending;
            long revision;
            lock (authenticationStateLock) { pending = latestAuthenticationState; revision = authenticationRevision; }
            if (pending is null)
            {
                var initial = AuthenticationStateProvider.GetAuthenticationStateAsync();
                lock (authenticationStateLock)
                {
                    pending = latestAuthenticationState ??= initial;
                    revision = authenticationRevision;
                }
            }
            AuthenticationState state;
            try { state = await pending; }
            catch (Exception) when (!IsCurrentAuthenticationState(pending, revision)) { continue; }
            if (IsCurrentAuthenticationState(pending, revision)) return (state, revision);
        }
    }

    private bool IsCurrentAuthenticationState(Task<AuthenticationState> state, long revision)
    {
        lock (authenticationStateLock)
            return ReferenceEquals(state, latestAuthenticationState) && revision == authenticationRevision;
    }

    private Task ApplyHistoryAuthenticationAsync(AuthenticationState state, long revision)
    {
        lock (authenticationStateLock)
        {
            if (disposed || revision != authenticationRevision) return Task.CompletedTask;
            ApplyPermissions(state.User);
            Volatile.Write(ref appliedAuthenticationRevision, revision);
            if (!IsTabAllowed(selectedTab))
            {
                selectedTab = "overview";
                activeTabNeedsVisibilitySync = true;
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", "overview"), replace: true);
                return customer is null ? LoadAsync() : Task.CompletedTask;
            }
            return customer is null ? LoadAsync() : LoadSelectedTabAsync(selectedTab);
        }
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        lock (authenticationStateLock)
        {
            Interlocked.Increment(ref authenticationRevision);
            latestAuthenticationState = state;
        }
        _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            ResetHistoryState();
            ApplyPermissions(new System.Security.Claims.ClaimsPrincipal());
            Volatile.Write(ref appliedAuthenticationRevision, -1);
            StateHasChanged();
            try
            {
                var current = await GetLatestAuthenticationStateAsync();
                await ApplyHistoryAuthenticationAsync(current.State, current.Revision);
            }
            catch (Exception) { }
            if (!disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        disposed = true;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        customerLoadGate.Dispose();
        internalRemarkLoadCts?.Cancel();
        internalRemarkLoadCts?.Dispose();
        CancelHistoryLoads();
    }
