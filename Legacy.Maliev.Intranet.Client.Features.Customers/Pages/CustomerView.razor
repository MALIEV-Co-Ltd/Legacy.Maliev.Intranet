@page "/Customers/View"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using Legacy.Maliev.Intranet.Client.Features.Customers.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<CustomerView> Text
@inject IJSRuntime JS
@inject Microsoft.Extensions.Configuration.IConfiguration DocumentFeatureConfiguration

<PageTitle>@(customer is null ? Text["PageTitle"] : Text["CustomerPageTitle", customer.FullName])</PageTitle>

<main class="customer-detail-page">
    <div class="customer-detail">
        @if (loading)
        {
            <div class="customer-detail__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <ShadcnAlert Variant="@(notFound ? ShadcnAlertVariant.Default : ShadcnAlertVariant.Destructive)" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@loadError</ShadcnAlertDescription></ShadcnAlert>
            <div class="customer-detail__recovery">
                @if (!notFound)
                {
                    <ShadcnButton OnClick="LoadAsync">@Text["Retry"]</ShadcnButton>
                }
                <LegacyLink Href="/Customers/Index" Role="LegacyLinkRole.Navigation" StartIconData="ArrowLeftIcon" AriaLabel="@Text["BackToCustomers"]">@Text["BackToCustomers"]</LegacyLink>
            </div>
        }
        else if (customer is not null)
        {
            <PageBreadcrumbs Items="@Breadcrumbs" />
            <header class="customer-detail__header operations-page-header">
                <div class="customer-detail__identity">
                    <h1>@customer.FullName</h1>
                    <p class="customer-detail__number">@Text["CustomerNumber", customer.Id]</p>
                </div>
                @if (canAdminister)
                {
                    <LegacyLink Href="@($"/Customers/Edit?id={Id}")" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["EditCustomer"]">@Text["EditCustomer"]</LegacyLink>
                }
            </header>

            @if (!string.IsNullOrWhiteSpace(operationError))
            {
                <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@operationError</ShadcnAlertDescription></ShadcnAlert>
                @if (operationConflict)
                {
                    <ShadcnButton OnClick="LoadAsync">@Text["ReloadLatest"]</ShadcnButton>
                }
            }

            <div class="customer-detail__tabs" role="region" aria-label="@Text["CustomerWorkspaceTabs"]">
                <ShadcnTabs Value="@selectedTab" ValueChanged="OnActiveTabChangedAsync" Class="customer-detail__tab-list">
                    <ShadcnTabsList aria-label="@Text["CustomerWorkspaceTabs"]">
                        <ShadcnTabsTrigger Value="overview">@Text["Overview"]</ShadcnTabsTrigger>
                        <ShadcnTabsTrigger Value="activity">@Text["Activity"]</ShadcnTabsTrigger>
                        @if (string.Equals(DocumentFeatureConfiguration["CustomerDocuments:Enabled"], "true", StringComparison.OrdinalIgnoreCase)) { <ShadcnTabsTrigger Value="documents">@Text["Documents"]</ShadcnTabsTrigger> }
                        @if (canReadOrders) { <ShadcnTabsTrigger Value="orders">@Text["Orders"]</ShadcnTabsTrigger> }
                        @if (canReadQuotations) { <ShadcnTabsTrigger Value="quotations">@Text["Quotations"]</ShadcnTabsTrigger> }
                        @if (canReadInvoices) { <ShadcnTabsTrigger Value="invoices">@Text["Invoices"]</ShadcnTabsTrigger> }
                    </ShadcnTabsList>
                    <ShadcnTabsContent Value="overview" ForceMount="true">
                        <EditForm EditContext="@editContext">
                            <DataAnnotationsValidator />
                            <CustomerOverview Customer="@customer"
                                              EditModel="@editModel"
                                              CanEdit="@(canEdit && !relationEditing)"
                                              Editing="@editing"
                                              Submitting="@submitting"
                                              BeginEdit="BeginEdit"
                                              Save="SaveAsync"
                                              CancelEdit="CancelEdit"
                                              Localize="Localize"
                                              DisplayValue="Display"
                                              DisplayDate="DisplayDate"
                                              DisplayDateTime="DisplayDateTime"
                                              DisplayAddress="DisplayAddress" />
                        </EditForm>
                        <CustomerInternalRemark Value="@internalRemark"
                                                EditModel="@internalRemarkEditModel"
                                                EditContext="@internalRemarkEditContext"
                                                CanEdit="@(canEdit && !relationEditing && !internalRemarkUnsettled.Contains(Id))"
                                                Editing="@internalRemarkEditing"
                                                Loading="@internalRemarkLoading"
                                                Submitting="@internalRemarkSubmitting"
                                                Saved="@internalRemarkSaved"
                                                Error="@internalRemarkError"
                                                BeginEdit="BeginInternalRemarkEdit"
                                                Save="SaveInternalRemarkAsync"
                                                CancelEdit="CancelInternalRemarkEdit"
                                                Retry="LoadInternalRemarkAsync"
                                                Localize="Localize" />
                        @if (relationSuccess is not null) { <p role="status" aria-live="polite">@relationSuccess</p> }
                        @if (canEdit)
                        {
                            <CustomerRelations @key="customer.Id" Customer="customer" Permissions="relationPermissions" AuthorizationRevision="RelationAuthorizationRevision" Locked="@(editing || submitting || internalRemarkEditing || internalRemarkSubmitting)"
                                               EditingChanged="@(value => relationEditing = value)" Saved="ReloadAfterRelationAsync" Localize="Localize" />
                        }
                    </ShadcnTabsContent>
                    @if (string.Equals(DocumentFeatureConfiguration["CustomerDocuments:Enabled"], "true", StringComparison.OrdinalIgnoreCase)) { <ShadcnTabsContent Value="documents"><CustomerDocuments CustomerId="Id" /></ShadcnTabsContent> }
                    <ShadcnTabsContent Value="activity" ForceMount="true">
                        <CustomerActivity Page="@activityPage"
                                          Loading="@activityLoading"
                                          Error="@activityError"
                                          Retry="LoadActivityAsync"
                                          Localize="Localize"
                                          LocalizeFormat="LocalizeFormat"
                                          FormatTimestamp="FormatTimestamp"
                                          FormatMoney="FormatMoney" />
                    </ShadcnTabsContent>
                    @if (canReadOrders)
                    {
                        <ShadcnTabsContent Value="orders" ForceMount="true">
                            <CustomerHistoryTable Kind="CustomerHistoryKind.Order"
                                                  Orders="@(ordersPage ?? EmptyOrdersPage(ordersPageIndex))"
                                                  Loading="@ordersLoading"
                                                  Error="@ordersError"
                                                  Retry="LoadOrdersAsync"
                                                  PageChanged="LoadOrdersPageAsync"
                                                  Localize="Localize"
                                                  LocalizeFormat="LocalizeFormat"
                                                  DisplayValue="Display"
                                                  FormatDate="DisplayDate"
                                                  FormatMoney="FormatMoney" />
                        </ShadcnTabsContent>
                    }
                    @if (canReadQuotations)
                    {
                        <ShadcnTabsContent Value="quotations" ForceMount="true">
                            <CustomerHistoryTable Kind="CustomerHistoryKind.Quotation"
                                                  Quotations="@(quotationsPage ?? EmptyQuotationsPage(quotationsPageIndex))"
                                                  Loading="@quotationsLoading"
                                                  Error="@quotationsError"
                                                  Retry="LoadQuotationsAsync"
                                                  PageChanged="LoadQuotationsPageAsync"
                                                  Localize="Localize"
                                                  LocalizeFormat="LocalizeFormat"
                                                  DisplayValue="Display"
                                                  FormatDate="DisplayDate"
                                                  FormatMoney="FormatMoney" />
                        </ShadcnTabsContent>
                    }
                    @if (canReadInvoices)
                    {
                        <ShadcnTabsContent Value="invoices" ForceMount="true">
                            <CustomerHistoryTable Kind="CustomerHistoryKind.Invoice"
                                                  Invoices="@(invoicesPage ?? EmptyInvoicesPage(invoicesPageIndex))"
                                                  Loading="@invoicesLoading"
                                                  Error="@invoicesError"
                                                  Retry="LoadInvoicesAsync"
                                                  PageChanged="LoadInvoicesPageAsync"
                                                  Localize="Localize"
                                                  LocalizeFormat="LocalizeFormat"
                                                  DisplayValue="Display"
                                                  FormatDate="DisplayDate"
                                                  FormatMoney="FormatMoney" />
                        </ShadcnTabsContent>
                    }
                </ShadcnTabs>
            </div>

            <nav class="customer-detail__footer" aria-label="@Text["BackToCustomers"]">
                <LegacyLink Href="/Customers/Index" Role="LegacyLinkRole.Navigation" StartIconData="ArrowLeftIcon" AriaLabel="@Text["BackToCustomers"]">@Text["BackToCustomers"]</LegacyLink>
            </nav>
        }
    </div>
</main>

@code {
    private const int HistoryPageSize = 20;
    private static readonly string[] KnownTabs = ["overview", "activity", "orders", "quotations", "invoices"];

    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private CustomerDetail? customer;
    private readonly CustomerUpdateRequest editModel = new();
    private EditContext editContext = null!;
    private readonly CustomerInternalRemarkUpdateRequest internalRemarkEditModel = new();
    private EditContext internalRemarkEditContext = null!;
    private string? internalRemark;
    private string? internalRemarkError;
    private bool internalRemarkEditing;
    private bool internalRemarkLoading;
    private bool internalRemarkSubmitting;
    private readonly HashSet<int> internalRemarkUnsettled = [];
    private bool internalRemarkSaved;
    private CancellationTokenSource? internalRemarkLoadCts;
    private bool canEdit;
    private bool relationEditing;
    private string[] relationPermissions = [];
    private string? relationSuccess;
    private bool canAdminister;
    private bool canReadOrders;
    private bool canReadQuotations;
    private bool canReadInvoices;
    private bool editing;
    private bool submitting;
    private string? loadError;
    private string? operationError;
    private string? customerRevision;
    private bool operationConflict;
    private bool loading;
    private bool notFound;
    private int loadedCustomerId;
    private readonly CustomerLoadGate customerLoadGate = new();
    private string selectedTab = "overview";
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Customers"], "/customers"),
        new(customer!.FullName),
    ];

    private CustomerActivityPage? activityPage;
    private bool activityLoading;
    private string? activityError;
    private CancellationTokenSource? activityLoadCts;

    private OrderListPage? ordersPage;
    private int ordersPageIndex = 1;
    private bool ordersLoading;
    private string? ordersError;
    private CancellationTokenSource? ordersLoadCts;

    private QuotationListPage? quotationsPage;
    private int quotationsPageIndex = 1;
    private bool quotationsLoading;
    private string? quotationsError;
    private CancellationTokenSource? quotationsLoadCts;

    private InvoiceListPage? invoicesPage;
    private int invoicesPageIndex = 1;
    private bool invoicesLoading;
    private string? invoicesError;
    private CancellationTokenSource? invoicesLoadCts;
    private bool activeTabNeedsVisibilitySync;
    private Task<AuthenticationState>? latestAuthenticationState;
    private readonly object authenticationStateLock = new();
    private long authenticationRevision;
    private long appliedAuthenticationRevision = -1;
    private bool disposed;

    private static readonly ShadcnIconData ArrowLeftIcon = LucideIconCatalog.Instance.Get(LucideIconNames.ArrowLeft);

    protected override void OnInitialized()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        editContext = new EditContext(editModel);
        internalRemarkEditContext = new EditContext(internalRemarkEditModel);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCustomerId != Id)
        {
            ResetHistoryState();
            await LoadAsync();
        }

        if (customer is null)
        {
            return;
        }

        string normalized;
        lock (authenticationStateLock)
        {
            if (!IsCurrentAuthenticationRevision()) return;
            normalized = NormalizeTab(Tab);
            if (!IsTabAllowed(normalized)) normalized = "overview";

            if (!string.Equals(selectedTab, normalized, StringComparison.Ordinal))
            {
                selectedTab = normalized;
                activeTabNeedsVisibilitySync = true;
            }
            if (!string.Equals(Tab, normalized, StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", normalized), replace: true);
                return;
            }
        }

        await LoadSelectedTabAsync(normalized);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("malievCustomerWorkspace.preservePanelKeyDefaults"); }
        catch (JSDisconnectedException) { return; }

        if (!activeTabNeedsVisibilitySync)
        {
            return;
        }

        activeTabNeedsVisibilitySync = false;
        try { await JS.InvokeVoidAsync("malievCustomerWorkspace.ensureActiveTabVisible"); }
        catch (JSDisconnectedException) { }
    }

    private async Task LoadAsync()
    {
        var request = customerLoadGate.Begin(Id);
        customer = null;
        loadError = null;
        operationError = null;
        operationConflict = false;
        customerRevision = null;
        notFound = false;
        editing = false;
        relationEditing = false;
        relationSuccess = null;
        submitting = false;
        ResetInternalRemarkState();
        loading = false;
        loadedCustomerId = request.CustomerId;

        var authenticationState = await GetLatestAuthenticationStateAsync();
        lock (authenticationStateLock)
        {
            if (disposed || !customerLoadGate.IsCurrent(request) || authenticationState.Revision != authenticationRevision) return;
            ApplyPermissions(authenticationState.State.User);
            Volatile.Write(ref appliedAuthenticationRevision, authenticationState.Revision);
        }
        bool CurrentCustomerLoad() => customerLoadGate.IsCurrent(request)
            && IsCurrentHistory(request.CustomerId, authenticationState.Revision, request.CancellationToken);
        if (request.CustomerId <= 0)
        {
            loadError = Text["NotFound"];
            notFound = true;
            return;
        }

        loading = true;
        try
        {
            Task<HttpResponseMessage> pending;
            lock (authenticationStateLock)
            {
                if (!CurrentCustomerLoad()) return;
                pending = Http.GetForPresentationAsync($"/bff/customers/{request.CustomerId}/versioned", request.CancellationToken);
            }
            using var response = await pending;
            if (!CurrentCustomerLoad()) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                loadError = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                loadError = Text["NotFound"];
                notFound = true;
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                loadError = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                loadError = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                loadError = Text["Unavailable"];
                return;
            }

            var loadedCustomer = await response.Content.ReadFromJsonAsync<CustomerDetail>(
                cancellationToken: request.CancellationToken);
            if (!CurrentCustomerLoad()) return;
            customer = loadedCustomer;
            var revision = response.Headers.ETag?.ToString();
            if (customer is null || customer.Id != request.CustomerId ||
                string.IsNullOrWhiteSpace(revision) ||
                !System.Text.RegularExpressions.Regex.IsMatch(
                    revision, "^\"[0-9a-f]{8}\"$",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant))
            {
                customer = null;
                loadError = Text["InvalidResponse"];
            }
            else
            {
                customerRevision = revision;
                CopyToEditModel(customer);
                await LoadInternalRemarkAsync();
            }
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (CurrentCustomerLoad()) loadError = Text["Unavailable"];
        }
        finally
        {
            if (CurrentCustomerLoad()) loading = false;
        }
    }

    private Task OnActiveTabChangedAsync(string value)
    {
        lock (authenticationStateLock)
        {
            if (!IsCurrentAuthenticationRevision()) return Task.CompletedTask;
            var tabs = VisibleTabs();
            if (!tabs.Contains(value, StringComparer.Ordinal) || string.Equals(value, selectedTab, StringComparison.Ordinal))
                return Task.CompletedTask;
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", value));
        }
        return Task.CompletedTask;
    }

    private Task LoadSelectedTabAsync(string tab) => tab switch
    {
        "activity" when activityPage is null && !activityLoading => LoadActivityAsync(),
        "orders" when ordersPage is null && !ordersLoading => LoadOrdersAsync(),
        "quotations" when quotationsPage is null && !quotationsLoading => LoadQuotationsAsync(),
        "invoices" when invoicesPage is null && !invoicesLoading => LoadInvoicesAsync(),
        _ => Task.CompletedTask,
    };

    private async Task LoadActivityAsync()
    {
        if (!CanStartHistory("activity")) return;
        activityLoadCts?.Cancel();
        activityLoadCts?.Dispose();
        activityLoadCts = new();
        var token = activityLoadCts.Token;
        var customerId = Id;
        var revision = Volatile.Read(ref authenticationRevision);
        activityLoading = true;
        activityError = null;
        try
        {
            var pending = BeginHistoryRequest(customerId, revision, token, "activity", $"/bff/customers/{customerId}/activity?size={HistoryPageSize}");
            if (pending is null) return;
            using var response = await pending;
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (HandleHistoryStatus(response.StatusCode, "activity", ref activityError)) return;
            var result = await response.Content.ReadFromJsonAsync<CustomerActivityPage>(cancellationToken: token);
            if (!IsCurrentHistory(customerId, revision, token)) return;
            activityPage = result ?? throw new System.Text.Json.JsonException();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { if (IsCurrentHistory(customerId, revision, token)) activityError = Text["HistoryInvalidResponse", Text["Activity"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            if (IsCurrentHistory(customerId, revision, token)) activityError = Text["HistoryUnavailable", Text["Activity"]];
        }
        finally
        {
            if (IsCurrentHistory(customerId, revision, token)) activityLoading = false;
        }
    }

    private Task LoadOrdersAsync() => LoadOrdersPageAsync(ordersPageIndex);

    private async Task LoadOrdersPageAsync(int pageIndex)
    {
        if (!CanStartHistory("orders")) return;
        ordersPageIndex = pageIndex;
        ordersLoadCts?.Cancel();
        ordersLoadCts?.Dispose();
        ordersLoadCts = new();
        var token = ordersLoadCts.Token;
        var customerId = Id;
        var revision = Volatile.Read(ref authenticationRevision);
        ordersLoading = true;
        ordersError = null;
        try
        {
            var pending = BeginHistoryRequest(customerId, revision, token, "orders", $"/bff/customers/{customerId}/orders?index={pageIndex}&size={HistoryPageSize}");
            if (pending is null) return;
            using var response = await pending;
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (HandleHistoryStatus(response.StatusCode, "orders", ref ordersError)) return;
            var result = await response.Content.ReadFromJsonAsync<OrderListPage>(cancellationToken: token);
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (result is null || result.Items.Any(item => item.CustomerId != customerId)) throw new System.Text.Json.JsonException();
            ordersPage = result;
            ordersPageIndex = result.PageIndex;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { if (IsCurrentHistory(customerId, revision, token)) ordersError = Text["HistoryInvalidResponse", Text["Orders"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            if (IsCurrentHistory(customerId, revision, token)) ordersError = Text["HistoryUnavailable", Text["OrderHistorySubject"]];
        }
        finally
        {
            if (IsCurrentHistory(customerId, revision, token)) ordersLoading = false;
        }
    }

    private Task LoadQuotationsAsync() => LoadQuotationsPageAsync(quotationsPageIndex);

    private async Task LoadQuotationsPageAsync(int pageIndex)
    {
        if (!CanStartHistory("quotations")) return;
        quotationsPageIndex = pageIndex;
        quotationsLoadCts?.Cancel();
        quotationsLoadCts?.Dispose();
        quotationsLoadCts = new();
        var token = quotationsLoadCts.Token;
        var customerId = Id;
        var revision = Volatile.Read(ref authenticationRevision);
        quotationsLoading = true;
        quotationsError = null;
        try
        {
            var pending = BeginHistoryRequest(customerId, revision, token, "quotations", $"/bff/customers/{customerId}/quotations?index={pageIndex}&size={HistoryPageSize}");
            if (pending is null) return;
            using var response = await pending;
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (HandleHistoryStatus(response.StatusCode, "quotations", ref quotationsError)) return;
            var result = await response.Content.ReadFromJsonAsync<QuotationListPage>(cancellationToken: token);
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (result is null || result.Items.Any(item => item.CustomerId != customerId)) throw new System.Text.Json.JsonException();
            quotationsPage = result;
            quotationsPageIndex = result.PageIndex;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { if (IsCurrentHistory(customerId, revision, token)) quotationsError = Text["HistoryInvalidResponse", Text["Quotations"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            if (IsCurrentHistory(customerId, revision, token)) quotationsError = Text["HistoryUnavailable", Text["QuotationHistorySubject"]];
        }
        finally
        {
            if (IsCurrentHistory(customerId, revision, token)) quotationsLoading = false;
        }
    }

    private Task LoadInvoicesAsync() => LoadInvoicesPageAsync(invoicesPageIndex);

    private async Task LoadInvoicesPageAsync(int pageIndex)
    {
        if (!CanStartHistory("invoices")) return;
        invoicesPageIndex = pageIndex;
        invoicesLoadCts?.Cancel();
        invoicesLoadCts?.Dispose();
        invoicesLoadCts = new();
        var token = invoicesLoadCts.Token;
        var customerId = Id;
        var revision = Volatile.Read(ref authenticationRevision);
        invoicesLoading = true;
        invoicesError = null;
        try
        {
            var pending = BeginHistoryRequest(customerId, revision, token, "invoices", $"/bff/customers/{customerId}/invoices?index={pageIndex}&size={HistoryPageSize}");
            if (pending is null) return;
            using var response = await pending;
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (HandleHistoryStatus(response.StatusCode, "invoices", ref invoicesError)) return;
            var result = await response.Content.ReadFromJsonAsync<InvoiceListPage>(cancellationToken: token);
            if (!IsCurrentHistory(customerId, revision, token)) return;
            if (result is null || result.Items.Any(item => item.CustomerId != customerId)) throw new System.Text.Json.JsonException();
            invoicesPage = result;
            invoicesPageIndex = result.PageIndex;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { if (IsCurrentHistory(customerId, revision, token)) invoicesError = Text["HistoryInvalidResponse", Text["Invoices"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            if (IsCurrentHistory(customerId, revision, token)) invoicesError = Text["HistoryUnavailable", Text["InvoiceHistorySubject"]];
        }
        finally
        {
            if (IsCurrentHistory(customerId, revision, token)) invoicesLoading = false;
        }
    }

    private bool IsCurrentHistory(int customerId, long revision, CancellationToken token) =>
        !disposed && !token.IsCancellationRequested && Id == customerId &&
        Volatile.Read(ref authenticationRevision) == revision && Volatile.Read(ref appliedAuthenticationRevision) == revision;

    private bool IsCurrentAuthenticationRevision() =>
        !disposed && Volatile.Read(ref appliedAuthenticationRevision) == authenticationRevision;

    private bool CanStartHistory(string family)
    {
        lock (authenticationStateLock) return IsCurrentAuthenticationRevision() && IsTabAllowed(family);
    }

    private Task<HttpResponseMessage>? BeginHistoryRequest(int customerId, long revision, CancellationToken token, string family, string path)
    {
        lock (authenticationStateLock)
        {
            if (!IsCurrentHistory(customerId, revision, token) || !IsTabAllowed(family)) return null;
            return Http.GetForPresentationAsync(path, token);
        }
    }

    private bool HandleHistoryStatus(HttpStatusCode statusCode, string family, ref string? targetError)
    {
        if (statusCode == HttpStatusCode.Unauthorized)
        {
            NavigateToLogin();
            return true;
        }

        if (statusCode == HttpStatusCode.Forbidden)
        {
            SetFamilyPermission(family, false);
            NavigateToOverviewIfSelected(family);
            return true;
        }

        var subject = family switch
        {
            "orders" => Text["OrderHistorySubject"].Value,
            "quotations" => Text["QuotationHistorySubject"].Value,
            "invoices" => Text["InvoiceHistorySubject"].Value,
            _ => Text["Activity"].Value,
        };
        if (statusCode == HttpStatusCode.TooManyRequests)
        {
            targetError = Text["HistoryRateLimited", subject];
            return true;
        }

        if (statusCode == HttpStatusCode.BadGateway)
        {
            targetError = Text["HistoryInvalidResponse", subject];
            return true;
        }

        if (statusCode == HttpStatusCode.ServiceUnavailable || (int)statusCode is < 200 or > 299)
        {
            targetError = Text["HistoryUnavailable", subject];
            return true;
        }

        return false;
    }

    private void SetFamilyPermission(string family, bool value)
    {
        if (family == "orders") canReadOrders = value;
        else if (family == "quotations") canReadQuotations = value;
        else if (family == "invoices") canReadInvoices = value;
    }

    private void NavigateToOverviewIfSelected(string family)
    {
        if (!string.Equals(selectedTab, family, StringComparison.Ordinal)) return;
        selectedTab = "overview";
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", "overview"), replace: true);
    }

    private void BeginEdit()
    {
        if (!canEdit || customer is null) return;
        CopyToEditModel(customer);
        operationError = null;
        operationConflict = false;
        editing = true;
    }

    private void CancelEdit()
    {
        editing = false;
        operationError = null;
        operationConflict = false;
    }

    private async Task LoadInternalRemarkAsync()
    {
        internalRemarkLoadCts?.Cancel();
        internalRemarkLoadCts?.Dispose();
        internalRemarkLoadCts = new();
        var token = internalRemarkLoadCts.Token;
        var customerId = Id;
        internalRemarkLoading = true;
        internalRemarkError = null;
        internalRemarkSaved = false;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/customers/{customerId}/internal-remark", token);
            if (disposed || token.IsCancellationRequested || customerId != Id) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { internalRemarkError = Text["InternalRemarkForbidden"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { internalRemarkError = Text["InternalRemarkRateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { internalRemarkError = Text["InternalRemarkUnavailable"]; return; }

            var loaded = await response.Content.ReadFromJsonAsync<CustomerInternalRemarkResponse>(cancellationToken: token);
            if (token.IsCancellationRequested || customerId != Id) return;
            if (loaded is null || loaded.CustomerId != customerId)
            {
                internalRemarkError = Text["InternalRemarkInvalidResponse"];
                return;
            }

            internalRemark = loaded.InternalRemark;
            internalRemarkEditModel.InternalRemark = internalRemark;
            internalRemarkEditContext = new EditContext(internalRemarkEditModel);
            if (internalRemarkUnsettled.Contains(customerId)) internalRemarkError = Text["InternalRemarkOutcomeUnknown"];
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (!disposed && !token.IsCancellationRequested && customerId == Id) internalRemarkError = Text["InternalRemarkUnavailable"];
        }
        finally
        {
            if (!disposed && !token.IsCancellationRequested && customerId == Id) internalRemarkLoading = false;
        }
    }

    private void BeginInternalRemarkEdit()
    {
        if (!canEdit || internalRemarkUnsettled.Contains(Id) || internalRemarkLoading || !string.IsNullOrWhiteSpace(internalRemarkError)) return;
        internalRemarkEditModel.InternalRemark = internalRemark;
        internalRemarkEditContext = new EditContext(internalRemarkEditModel);
        internalRemarkSaved = false;
        internalRemarkEditing = true;
    }

    private void CancelInternalRemarkEdit()
    {
        internalRemarkEditModel.InternalRemark = internalRemark;
        internalRemarkEditing = false;
        internalRemarkError = internalRemarkUnsettled.Contains(Id) ? Text["InternalRemarkOutcomeUnknown"].Value : null;
    }

    private async Task SaveInternalRemarkAsync()
    {
        if (disposed || !canEdit || !internalRemarkEditing || internalRemarkSubmitting || internalRemarkUnsettled.Contains(Id)) return;
        var validatedContext = internalRemarkEditContext;
        var customerId = Id;
        var revision = customerRevision;
        var remark = internalRemarkEditModel.InternalRemark;
        var authRevision = Volatile.Read(ref authenticationRevision);
        bool Current() => !disposed && ReferenceEquals(validatedContext, internalRemarkEditContext) && Id == customerId
            && string.Equals(customerRevision, revision, StringComparison.Ordinal) && canEdit && internalRemarkEditing
            && string.Equals(internalRemarkEditModel.InternalRemark, remark, StringComparison.Ordinal)
            && Volatile.Read(ref authenticationRevision) == authRevision && Volatile.Read(ref appliedAuthenticationRevision) == authRevision;
        void Warn()
        {
            if (disposed || Id != customerId) return;
            internalRemarkEditing = false;
            internalRemarkError = Text["InternalRemarkOutcomeUnknown"];
        }
        var dispatched = false;
        if (Volatile.Read(ref appliedAuthenticationRevision) != authRevision) return;
        internalRemarkSubmitting = true;
        try
        {
            var valid = await validatedContext.ValidateAsync();
            if (!Current()) return;
            if (!valid)
            {
                internalRemarkError = Text["InternalRemarkValidationFailed"];
                return;
            }
            internalRemarkError = null;
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (!Current()) return;
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (!Current()) return;
            if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { internalRemarkError = Text["InternalRemarkSaveFailed"]; return; }
            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/customers/{customerId}/internal-remark")
            {
                Content = JsonContent.Create(new CustomerInternalRemarkUpdateRequest { InternalRemark = remark }),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            internalRemarkUnsettled.Add(customerId);
            dispatched = true;
            using var response = await Http.SendAsync(request);
            if (!Current()) { Warn(); return; }
            if (!response.IsSuccessStatusCode) { Warn(); return; }
            internalRemarkUnsettled.Remove(customerId);

            internalRemark = string.IsNullOrWhiteSpace(remark)
                ? null
                : remark.Trim();
            internalRemarkEditModel.InternalRemark = internalRemark;
            internalRemarkEditing = false;
            internalRemarkSaved = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (dispatched) Warn();
            else if (Current()) internalRemarkError = Text["InternalRemarkSaveFailed"];
        }
        catch (Exception exception) when (dispatched && exception is not OutOfMemoryException and not StackOverflowException and not AccessViolationException)
        {
            Warn();
        }
        finally
        {
            if (!disposed && Id == customerId && ReferenceEquals(validatedContext, internalRemarkEditContext)) internalRemarkSubmitting = false;
        }
    }

    private async Task ReloadAfterRelationAsync(string kind)
    {
        loadedCustomerId = 0;
        await LoadAsync();
        relationSuccess = Text["RelationSaved_" + kind];
    }

    private async Task SaveAsync()
    {
        if (!canEdit || !editing || submitting) return;
        if (string.IsNullOrWhiteSpace(customerRevision))
        {
            operationError = Text["InvalidResponse"];
            return;
        }

        var validatedContext = editContext;
        var customerId = Id;
        var revision = customerRevision;
        var authRevision = Volatile.Read(ref authenticationRevision);
        if (Volatile.Read(ref appliedAuthenticationRevision) != authRevision) return;
        submitting = true;
        try
        {
            var valid = await validatedContext.ValidateAsync();
            if (disposed || !ReferenceEquals(validatedContext, editContext) || Id != customerId
                || !string.Equals(customerRevision, revision, StringComparison.Ordinal) || !canEdit || !editing
                || Volatile.Read(ref authenticationRevision) != authRevision || Volatile.Read(ref appliedAuthenticationRevision) != authRevision) return;
            if (!valid)
            {
                operationError = Text["ValidationFailed"];
                return;
            }
            operationError = null;
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                operationError = Text["SaveFailed"];
                return;
            }

            if (disposed || !ReferenceEquals(validatedContext, editContext) || Id != customerId
                || !string.Equals(customerRevision, revision, StringComparison.Ordinal) || !canEdit || !editing
                || Volatile.Read(ref authenticationRevision) != authRevision || Volatile.Read(ref appliedAuthenticationRevision) != authRevision) return;

            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/customers/{customerId}/versioned") { Content = JsonContent.Create(editModel) };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            request.Headers.TryAddWithoutValidation("If-Match", revision);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { operationError = Text["ForbiddenUpdate"]; return; }
            if (response.StatusCode == HttpStatusCode.BadRequest) { operationError = Text["ValidationFailed"]; return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { operationError = Text["NotFound"]; return; }
            if (response.StatusCode == HttpStatusCode.PreconditionFailed)
            {
                operationError = Text["ConflictReload"];
                operationConflict = true;
                return;
            }
            if (response.StatusCode == HttpStatusCode.Conflict) { operationError = Text["Conflict"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { operationError = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { operationError = Text["SaveFailed"]; return; }

            editing = false;
            loadedCustomerId = 0;
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            operationError = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private List<string> VisibleTabs()
    {
        var tabs = new List<string> { "overview", "activity" };
        if (canReadOrders) tabs.Add("orders");
        if (canReadQuotations) tabs.Add("quotations");
        if (canReadInvoices) tabs.Add("invoices");
        return tabs;
    }

    private static string NormalizeTab(string? value) =>
        KnownTabs.Contains(value?.Trim() ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            ? value!.Trim().ToLowerInvariant()
            : "overview";

    private bool IsTabAllowed(string value) => value switch
    {
        "overview" or "activity" => true,
        "orders" => canReadOrders,
        "quotations" => canReadQuotations,
        "invoices" => canReadInvoices,
        _ => false,
    };

