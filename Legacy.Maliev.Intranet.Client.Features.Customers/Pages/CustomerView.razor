@page "/Customers/View"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.JSInterop
@using Legacy.Maliev.Intranet.Client.Features.Customers.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<CustomerView> Text
@inject IJSRuntime JS

<PageTitle>@(customer is null ? Text["PageTitle"] : Text["CustomerPageTitle", customer.FullName])</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="customer-detail">
        @if (loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-live="polite" aria-label="@Text["Loading"]" />
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <MudAlert Severity="errorSeverity" Class="mb-4" aria-live="assertive">@loadError</MudAlert>
            <div class="customer-detail__recovery">
                @if (!notFound)
                {
                    <MudButton OnClick="LoadAsync" Variant="Variant.Filled" Color="Color.Primary">@Text["Retry"]</MudButton>
                }
                <LegacyLink Href="/Customers/Index" Role="LegacyLinkRole.Navigation" StartIcon="@Icons.Material.Filled.ArrowBack" AriaLabel="@Text["BackToCustomers"]">@Text["BackToCustomers"]</LegacyLink>
            </div>
        }
        else if (customer is not null)
        {
            <header class="customer-detail__header operations-page-header">
                <div class="customer-detail__identity">
                    <MudText Typo="Typo.h4" HtmlTag="h1">@customer.FullName</MudText>
                    <MudText Typo="Typo.body2" Class="customer-detail__number">@Text["CustomerNumber", customer.Id]</MudText>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(operationError))
            {
                <MudAlert Severity="Severity.Error" aria-live="assertive">@operationError</MudAlert>
            }

            <div class="customer-detail__tabs" role="region" aria-label="@Text["CustomerWorkspaceTabs"]">
                <MudTabs ActivePanelIndex="@ActiveTabIndex"
                         ActivePanelIndexChanged="OnActiveTabChangedAsync"
                         Class="customer-detail__tab-list"
                         MinimumTabWidth="0"
                         ApplyEffectsToContainer="true"
                         Elevation="0"
                         Rounded="false"
                         KeepPanelsAlive="true">
                    <MudTabPanel Text="@Text["Overview"]">
                        <MudForm @ref="editForm" Model="@editModel" @bind-IsValid="editFormValid">
                            <CustomerOverview Customer="@customer"
                                              EditModel="@editModel"
                                              CanEdit="@canEdit"
                                              Editing="@editing"
                                              Submitting="@submitting"
                                              BeginEdit="BeginEdit"
                                              Save="SaveAsync"
                                              CancelEdit="CancelEdit"
                                              Localize="Localize"
                                              DisplayValue="Display"
                                              DisplayDate="DisplayDate"
                                              DisplayDateTime="DisplayDateTime"
                                              DisplayAddress="DisplayAddress" />
                        </MudForm>
                    </MudTabPanel>
                    <MudTabPanel Text="@Text["Activity"]">
                        <CustomerActivity Page="@activityPage"
                                          Loading="@activityLoading"
                                          Error="@activityError"
                                          Retry="LoadActivityAsync"
                                          Localize="Localize"
                                          LocalizeFormat="LocalizeFormat"
                                          FormatTimestamp="FormatTimestamp"
                                          FormatMoney="FormatMoney" />
                    </MudTabPanel>
                    @if (canReadOrders)
                    {
                        <MudTabPanel Text="@Text["Orders"]">
                            <CustomerHistoryTable Kind="CustomerHistoryKind.Order"
                                                  Orders="@(ordersPage ?? EmptyOrdersPage(ordersPageIndex))"
                                                  Loading="@ordersLoading"
                                                  Error="@ordersError"
                                                  Retry="LoadOrdersAsync"
                                                  PageChanged="LoadOrdersPageAsync"
                                                  Localize="Localize"
                                                  LocalizeFormat="LocalizeFormat"
                                                  DisplayValue="Display"
                                                  FormatDate="DisplayDate"
                                                  FormatMoney="FormatMoney" />
                        </MudTabPanel>
                    }
                    @if (canReadQuotations)
                    {
                        <MudTabPanel Text="@Text["Quotations"]">
                            <CustomerHistoryTable Kind="CustomerHistoryKind.Quotation"
                                                  Quotations="@(quotationsPage ?? EmptyQuotationsPage(quotationsPageIndex))"
                                                  Loading="@quotationsLoading"
                                                  Error="@quotationsError"
                                                  Retry="LoadQuotationsAsync"
                                                  PageChanged="LoadQuotationsPageAsync"
                                                  Localize="Localize"
                                                  LocalizeFormat="LocalizeFormat"
                                                  DisplayValue="Display"
                                                  FormatDate="DisplayDate"
                                                  FormatMoney="FormatMoney" />
                        </MudTabPanel>
                    }
                    @if (canReadInvoices)
                    {
                        <MudTabPanel Text="@Text["Invoices"]">
                            <CustomerHistoryTable Kind="CustomerHistoryKind.Invoice"
                                                  Invoices="@(invoicesPage ?? EmptyInvoicesPage(invoicesPageIndex))"
                                                  Loading="@invoicesLoading"
                                                  Error="@invoicesError"
                                                  Retry="LoadInvoicesAsync"
                                                  PageChanged="LoadInvoicesPageAsync"
                                                  Localize="Localize"
                                                  LocalizeFormat="LocalizeFormat"
                                                  DisplayValue="Display"
                                                  FormatDate="DisplayDate"
                                                  FormatMoney="FormatMoney" />
                        </MudTabPanel>
                    }
                </MudTabs>
            </div>

            <nav class="customer-detail__footer" aria-label="@Text["BackToCustomers"]">
                <LegacyLink Href="/Customers/Index" Role="LegacyLinkRole.Navigation" StartIcon="@Icons.Material.Filled.ArrowBack" AriaLabel="@Text["BackToCustomers"]">@Text["BackToCustomers"]</LegacyLink>
            </nav>
        }
    </div>
</MudContainer>

@code {
    private const int HistoryPageSize = 20;
    private static readonly string[] KnownTabs = ["overview", "activity", "orders", "quotations", "invoices"];

    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private CustomerDetail? customer;
    private readonly CustomerUpdateRequest editModel = new();
    private MudForm? editForm;
    private bool editFormValid;
    private bool canEdit;
    private bool canReadOrders;
    private bool canReadQuotations;
    private bool canReadInvoices;
    private bool editing;
    private bool submitting;
    private string? loadError;
    private string? operationError;
    private Severity errorSeverity = Severity.Error;
    private bool loading;
    private bool notFound;
    private int loadedCustomerId;
    private readonly CustomerLoadGate customerLoadGate = new();
    private string selectedTab = "overview";

    private CustomerActivityPage? activityPage;
    private bool activityLoading;
    private string? activityError;
    private CancellationTokenSource? activityLoadCts;

    private OrderListPage? ordersPage;
    private int ordersPageIndex = 1;
    private bool ordersLoading;
    private string? ordersError;
    private CancellationTokenSource? ordersLoadCts;

    private QuotationListPage? quotationsPage;
    private int quotationsPageIndex = 1;
    private bool quotationsLoading;
    private string? quotationsError;
    private CancellationTokenSource? quotationsLoadCts;

    private InvoiceListPage? invoicesPage;
    private int invoicesPageIndex = 1;
    private bool invoicesLoading;
    private string? invoicesError;
    private CancellationTokenSource? invoicesLoadCts;
    private bool activeTabNeedsVisibilitySync;

    private int ActiveTabIndex => VisibleTabs().IndexOf(selectedTab);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedCustomerId != Id)
        {
            ResetHistoryState();
            await LoadAsync();
        }

        if (customer is null)
        {
            return;
        }

        var normalized = NormalizeTab(Tab);
        if (!IsTabAllowed(normalized))
        {
            normalized = "overview";
        }

        if (!string.Equals(selectedTab, normalized, StringComparison.Ordinal))
        {
            selectedTab = normalized;
            activeTabNeedsVisibilitySync = true;
        }
        if (!string.Equals(Tab, normalized, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", normalized), replace: true);
            return;
        }

        await LoadSelectedTabAsync(normalized);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!activeTabNeedsVisibilitySync)
        {
            return;
        }

        activeTabNeedsVisibilitySync = false;
        await JS.InvokeVoidAsync("malievCustomerWorkspace.ensureActiveTabVisible");
    }

    private async Task LoadAsync()
    {
        var request = customerLoadGate.Begin(Id);
        customer = null;
        loadError = null;
        operationError = null;
        errorSeverity = Severity.Error;
        notFound = false;
        editing = false;
        submitting = false;
        loadedCustomerId = request.CustomerId;

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!customerLoadGate.IsCurrent(request)) return;
        var user = authenticationState.User;
        canEdit = LegacyNavigationAuthorization.IsEnabled(user, "legacy-customer.customers.update");
        canReadOrders = LegacyNavigationAuthorization.IsEnabled(user, "legacy.orders.read");
        canReadQuotations = LegacyNavigationAuthorization.IsEnabled(user, "legacy.quotations.read");
        canReadInvoices = LegacyNavigationAuthorization.IsEnabled(user, "legacy.accounting.read");

        if (request.CustomerId <= 0)
        {
            loadError = Text["NotFound"];
            errorSeverity = Severity.Warning;
            notFound = true;
            return;
        }

        loading = true;
        try
        {
            using var response = await Http.GetForPresentationAsync(
                $"/bff/customers/{request.CustomerId}",
                request.CancellationToken);
            if (!customerLoadGate.IsCurrent(request)) return;
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                loadError = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                loadError = Text["NotFound"];
                errorSeverity = Severity.Warning;
                notFound = true;
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                loadError = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                loadError = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                loadError = Text["Unavailable"];
                return;
            }

            var loadedCustomer = await response.Content.ReadFromJsonAsync<CustomerDetail>(
                cancellationToken: request.CancellationToken);
            if (!customerLoadGate.IsCurrent(request)) return;
            customer = loadedCustomer;
            if (customer is null || customer.Id != request.CustomerId)
            {
                customer = null;
                loadError = Text["InvalidResponse"];
            }
            else
            {
                CopyToEditModel(customer);
            }
        }
        catch (OperationCanceledException) when (request.CancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (customerLoadGate.IsCurrent(request)) loadError = Text["Unavailable"];
        }
        finally
        {
            if (customerLoadGate.IsCurrent(request)) loading = false;
        }
    }

    private async Task OnActiveTabChangedAsync(int index)
    {
        var tabs = VisibleTabs();
        if (index < 0 || index >= tabs.Count)
        {
            return;
        }

        var value = tabs[index];
        if (string.Equals(value, selectedTab, StringComparison.Ordinal))
        {
            return;
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", value));
        await Task.CompletedTask;
    }

    private Task LoadSelectedTabAsync(string tab) => tab switch
    {
        "activity" when activityPage is null && !activityLoading => LoadActivityAsync(),
        "orders" when ordersPage is null && !ordersLoading => LoadOrdersAsync(),
        "quotations" when quotationsPage is null && !quotationsLoading => LoadQuotationsAsync(),
        "invoices" when invoicesPage is null && !invoicesLoading => LoadInvoicesAsync(),
        _ => Task.CompletedTask,
    };

    private async Task LoadActivityAsync()
    {
        activityLoadCts?.Cancel();
        activityLoadCts?.Dispose();
        activityLoadCts = new();
        var token = activityLoadCts.Token;
        activityLoading = true;
        activityError = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/customers/{Id}/activity?size={HistoryPageSize}", token);
            if (HandleHistoryStatus(response.StatusCode, "activity", ref activityError)) return;
            var result = await response.Content.ReadFromJsonAsync<CustomerActivityPage>(cancellationToken: token);
            token.ThrowIfCancellationRequested();
            activityPage = result ?? throw new System.Text.Json.JsonException();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { activityError = Text["HistoryInvalidResponse", Text["Activity"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            activityError = Text["HistoryUnavailable", Text["Activity"]];
        }
        finally
        {
            if (!token.IsCancellationRequested) activityLoading = false;
        }
    }

    private Task LoadOrdersAsync() => LoadOrdersPageAsync(ordersPageIndex);

    private async Task LoadOrdersPageAsync(int pageIndex)
    {
        if (!canReadOrders) return;
        ordersPageIndex = pageIndex;
        ordersLoadCts?.Cancel();
        ordersLoadCts?.Dispose();
        ordersLoadCts = new();
        var token = ordersLoadCts.Token;
        ordersLoading = true;
        ordersError = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/customers/{Id}/orders?index={pageIndex}&size={HistoryPageSize}", token);
            if (HandleHistoryStatus(response.StatusCode, "orders", ref ordersError)) return;
            var result = await response.Content.ReadFromJsonAsync<OrderListPage>(cancellationToken: token);
            token.ThrowIfCancellationRequested();
            if (result is null || result.Items.Any(item => item.CustomerId != Id)) throw new System.Text.Json.JsonException();
            ordersPage = result;
            ordersPageIndex = result.PageIndex;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { ordersError = Text["HistoryInvalidResponse", Text["Orders"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            ordersError = Text["HistoryUnavailable", Text["OrderHistorySubject"]];
        }
        finally
        {
            if (!token.IsCancellationRequested) ordersLoading = false;
        }
    }

    private Task LoadQuotationsAsync() => LoadQuotationsPageAsync(quotationsPageIndex);

    private async Task LoadQuotationsPageAsync(int pageIndex)
    {
        if (!canReadQuotations) return;
        quotationsPageIndex = pageIndex;
        quotationsLoadCts?.Cancel();
        quotationsLoadCts?.Dispose();
        quotationsLoadCts = new();
        var token = quotationsLoadCts.Token;
        quotationsLoading = true;
        quotationsError = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/customers/{Id}/quotations?index={pageIndex}&size={HistoryPageSize}", token);
            if (HandleHistoryStatus(response.StatusCode, "quotations", ref quotationsError)) return;
            var result = await response.Content.ReadFromJsonAsync<QuotationListPage>(cancellationToken: token);
            token.ThrowIfCancellationRequested();
            if (result is null || result.Items.Any(item => item.CustomerId != Id)) throw new System.Text.Json.JsonException();
            quotationsPage = result;
            quotationsPageIndex = result.PageIndex;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { quotationsError = Text["HistoryInvalidResponse", Text["Quotations"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            quotationsError = Text["HistoryUnavailable", Text["QuotationHistorySubject"]];
        }
        finally
        {
            if (!token.IsCancellationRequested) quotationsLoading = false;
        }
    }

    private Task LoadInvoicesAsync() => LoadInvoicesPageAsync(invoicesPageIndex);

    private async Task LoadInvoicesPageAsync(int pageIndex)
    {
        if (!canReadInvoices) return;
        invoicesPageIndex = pageIndex;
        invoicesLoadCts?.Cancel();
        invoicesLoadCts?.Dispose();
        invoicesLoadCts = new();
        var token = invoicesLoadCts.Token;
        invoicesLoading = true;
        invoicesError = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/customers/{Id}/invoices?index={pageIndex}&size={HistoryPageSize}", token);
            if (HandleHistoryStatus(response.StatusCode, "invoices", ref invoicesError)) return;
            var result = await response.Content.ReadFromJsonAsync<InvoiceListPage>(cancellationToken: token);
            token.ThrowIfCancellationRequested();
            if (result is null || result.Items.Any(item => item.CustomerId != Id)) throw new System.Text.Json.JsonException();
            invoicesPage = result;
            invoicesPageIndex = result.PageIndex;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (System.Text.Json.JsonException) { invoicesError = Text["HistoryInvalidResponse", Text["Invoices"]]; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            invoicesError = Text["HistoryUnavailable", Text["InvoiceHistorySubject"]];
        }
        finally
        {
            if (!token.IsCancellationRequested) invoicesLoading = false;
        }
    }

    private bool HandleHistoryStatus(HttpStatusCode statusCode, string family, ref string? targetError)
    {
        if (statusCode == HttpStatusCode.Unauthorized)
        {
            NavigateToLogin();
            return true;
        }

        if (statusCode == HttpStatusCode.Forbidden)
        {
            SetFamilyPermission(family, false);
            NavigateToOverviewIfSelected(family);
            return true;
        }

        var subject = family switch
        {
            "orders" => Text["OrderHistorySubject"].Value,
            "quotations" => Text["QuotationHistorySubject"].Value,
            "invoices" => Text["InvoiceHistorySubject"].Value,
            _ => Text["Activity"].Value,
        };
        if (statusCode == HttpStatusCode.TooManyRequests)
        {
            targetError = Text["HistoryRateLimited", subject];
            return true;
        }

        if (statusCode == HttpStatusCode.BadGateway)
        {
            targetError = Text["HistoryInvalidResponse", subject];
            return true;
        }

        if (statusCode == HttpStatusCode.ServiceUnavailable || (int)statusCode is < 200 or > 299)
        {
            targetError = Text["HistoryUnavailable", subject];
            return true;
        }

        return false;
    }

    private void SetFamilyPermission(string family, bool value)
    {
        if (family == "orders") canReadOrders = value;
        else if (family == "quotations") canReadQuotations = value;
        else if (family == "invoices") canReadInvoices = value;
    }

    private void NavigateToOverviewIfSelected(string family)
    {
        if (!string.Equals(selectedTab, family, StringComparison.Ordinal)) return;
        selectedTab = "overview";
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", "overview"), replace: true);
    }

    private void BeginEdit()
    {
        if (!canEdit || customer is null) return;
        CopyToEditModel(customer);
        operationError = null;
        editing = true;
    }

    private void CancelEdit()
    {
        editing = false;
        operationError = null;
    }

    private async Task SaveAsync()
    {
        if (!canEdit || !editing || submitting || editForm is null) return;

        await editForm.ValidateAsync();
        if (!editFormValid)
        {
            operationError = Text["ValidationFailed"];
            return;
        }

        submitting = true;
        operationError = null;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                operationError = Text["SaveFailed"];
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/customers/{Id}") { Content = JsonContent.Create(editModel) };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { operationError = Text["ForbiddenUpdate"]; return; }
            if (response.StatusCode == HttpStatusCode.BadRequest) { operationError = Text["ValidationFailed"]; return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { operationError = Text["NotFound"]; return; }
            if (response.StatusCode == HttpStatusCode.Conflict) { operationError = Text["Conflict"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { operationError = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { operationError = Text["SaveFailed"]; return; }

            editing = false;
            loadedCustomerId = 0;
            await LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            operationError = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private List<string> VisibleTabs()
    {
        var tabs = new List<string> { "overview", "activity" };
        if (canReadOrders) tabs.Add("orders");
        if (canReadQuotations) tabs.Add("quotations");
        if (canReadInvoices) tabs.Add("invoices");
        return tabs;
    }

    private static string NormalizeTab(string? value) =>
        KnownTabs.Contains(value?.Trim() ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            ? value!.Trim().ToLowerInvariant()
            : "overview";

    private bool IsTabAllowed(string value) => value switch
    {
        "overview" or "activity" => true,
        "orders" => canReadOrders,
        "quotations" => canReadQuotations,
        "invoices" => canReadInvoices,
        _ => false,
    };

    private void ResetHistoryState()
    {
        CancelHistoryLoads();
        activityPage = null;
        activityError = null;
        activityLoading = false;
        ordersPage = null;
        ordersPageIndex = 1;
        ordersError = null;
        ordersLoading = false;
        quotationsPage = null;
        quotationsPageIndex = 1;
        quotationsError = null;
        quotationsLoading = false;
        invoicesPage = null;
        invoicesPageIndex = 1;
        invoicesError = null;
        invoicesLoading = false;
    }

    private void CancelHistoryLoads()
    {
        foreach (var source in new[] { activityLoadCts, ordersLoadCts, quotationsLoadCts, invoicesLoadCts })
        {
            source?.Cancel();
            source?.Dispose();
        }
        activityLoadCts = ordersLoadCts = quotationsLoadCts = invoicesLoadCts = null;
    }

    private void CopyToEditModel(CustomerDetail value)
    {
        editModel.FirstName = value.FirstName;
        editModel.LastName = value.LastName;
        editModel.Email = value.Email;
        editModel.Telephone = value.Telephone;
        editModel.Mobile = value.Mobile;
        editModel.Fax = value.Fax;
        editModel.DateOfBirth = value.DateOfBirth;
    }

    private string Localize(string key) => Text[key];
    private string LocalizeFormat(string key, object?[] arguments) => Text[key, arguments.Select(value => value ?? string.Empty).ToArray()];
    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotAvailable"] : value;
    private string DisplayDate(DateTime? value) => LegacyPresentation.FormatCalendarDate(value, System.Globalization.CultureInfo.CurrentCulture, Text["NotAvailable"]);
    private string DisplayDateTime(DateTime? value) => LegacyPresentation.FormatUtcDateTime(value, System.Globalization.CultureInfo.CurrentCulture, Text["NotAvailable"]);
    private string FormatTimestamp(DateTime value) => LegacyPresentation.FormatUtcDateTime(value, System.Globalization.CultureInfo.CurrentCulture, Text["NotAvailable"]);
    private string FormatMoney(decimal amount, string currency) => string.Format(System.Globalization.CultureInfo.CurrentCulture, "{0:N2} {1}", amount, currency);
    private string FormatMoney(decimal? amount, string currency) => amount is null ? Text["NotAvailable"] : FormatMoney(amount.Value, currency);

    private string DisplayAddress(CustomerAddressDetail? address)
    {
        if (address is null) return Text["NotAvailable"];
        var value = string.Join(", ", new[] { address.Building, address.AddressLine1, address.AddressLine2, address.City, address.State, address.PostalCode }
            .Where(part => !string.IsNullOrWhiteSpace(part)));
        return string.IsNullOrWhiteSpace(value) ? Text["NotAvailable"] : value;
    }

    private static OrderListPage EmptyOrdersPage(int pageIndex) => new([], pageIndex, 0, 0, false, false);
    private static QuotationListPage EmptyQuotationsPage(int pageIndex) => new([], pageIndex, 0, 0, false, false);
    private static InvoiceListPage EmptyInvoicesPage(int pageIndex) => new([], pageIndex, 0, 0, false, false);

    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");

    public void Dispose()
    {
        customerLoadGate.Dispose();
        CancelHistoryLoads();
    }
}
