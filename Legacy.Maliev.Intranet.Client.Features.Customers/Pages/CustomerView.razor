    {
        CancelHistoryLoads();
        activityPage = null;
        activityError = null;
        activityLoading = false;
        ordersPage = null;
        ordersPageIndex = 1;
        ordersError = null;
        ordersLoading = false;
        quotationsPage = null;
        quotationsPageIndex = 1;
        quotationsError = null;
        quotationsLoading = false;
        invoicesPage = null;
        invoicesPageIndex = 1;
        invoicesError = null;
        invoicesLoading = false;
    }

    private void ResetInternalRemarkState()
    {
        internalRemarkLoadCts?.Cancel();
        internalRemarkLoadCts?.Dispose();
        internalRemarkLoadCts = null;
        internalRemark = null;
        internalRemarkEditModel.InternalRemark = null;
        internalRemarkEditContext = new EditContext(internalRemarkEditModel);
        internalRemarkError = null;
        internalRemarkEditing = false;
        internalRemarkLoading = false;
        internalRemarkSubmitting = false;
        internalRemarkSaved = false;
    }

    private void CancelHistoryLoads()
    {
        foreach (var source in new[] { activityLoadCts, ordersLoadCts, quotationsLoadCts, invoicesLoadCts })
        {
            source?.Cancel();
            source?.Dispose();
        }
        activityLoadCts = ordersLoadCts = quotationsLoadCts = invoicesLoadCts = null;
    }

