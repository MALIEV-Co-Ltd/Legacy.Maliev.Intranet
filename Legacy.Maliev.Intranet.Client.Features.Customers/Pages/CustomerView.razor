@page "/Customers/View"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<CustomerView> Text

<PageTitle>@(customer is null ? Text["PageTitle"] : Text["CustomerPageTitle", customer.FullName])</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-live="polite" aria-label="@Text["Loading"]" />
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="errorSeverity" Class="mb-4" aria-live="assertive">@error</MudAlert>
        <MudButton Href="/Customers/Index" Variant="Variant.Text">@Text["BackToCustomers"]</MudButton>
    }
    else if (customer is not null)
    {
        <header class="operations-page-header">
            <div><MudText Typo="Typo.h4" HtmlTag="h1">@customer.FullName</MudText><MudText Typo="Typo.body2">@Text["CustomerNumber", customer.Id]</MudText></div>
            @if (canEdit)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@submitting" OnClick="BeginEdit" aria-label="@Text["EditCustomer"]">
                    @Text["EditCustomer"]
                </MudButton>
            }
        </header>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <section>
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["Contact"]</MudText>
                    @if (editing)
                    {
                        <MudForm @ref="editForm" Model="@editModel" @bind-IsValid="editFormValid">
                            <MudTextField @bind-Value="editModel.FirstName" For="@(() => editModel.FirstName)" Label="@Text["FirstName"]" Required="true" />
                            <MudTextField @bind-Value="editModel.LastName" For="@(() => editModel.LastName)" Label="@Text["LastName"]" Required="true" />
                            <MudTextField @bind-Value="editModel.Email" For="@(() => editModel.Email)" Label="@Text["Email"]" InputType="InputType.Email" Required="true" />
                            <MudTextField @bind-Value="editModel.Telephone" For="@(() => editModel.Telephone)" Label="@Text["Telephone"]" InputType="InputType.Telephone" />
                            <MudTextField @bind-Value="editModel.Mobile" For="@(() => editModel.Mobile)" Label="@Text["Mobile"]" InputType="InputType.Telephone" />
                            <MudTextField @bind-Value="editModel.Fax" For="@(() => editModel.Fax)" Label="@Text["Fax"]" />
                            <MudDatePicker @bind-Date="editModel.DateOfBirth" For="@(() => editModel.DateOfBirth)" Label="@Text["DateOfBirth"]" />
                            <MudStack Row="true" Spacing="2" Class="mt-4">
                                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary" Disabled="@submitting" OnClick="SaveAsync">
                                    @(submitting ? Text["Saving"] : Text["SaveChanges"])
                                </MudButton>
                                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Text" Disabled="@submitting" OnClick="CancelEdit">
                                    @Text["Cancel"]
                                </MudButton>
                            </MudStack>
                        </MudForm>
                    }
                    else
                    {
                        <dl class="details">
                            <dt>@Text["Email"]</dt>
                            <dd><a href="mailto:@customer.Email">@customer.Email</a></dd>
                            <dt>@Text["Telephone"]</dt><dd>@Display(customer.Telephone)</dd>
                            <dt>@Text["Mobile"]</dt><dd>@Display(customer.Mobile)</dd>
                            <dt>@Text["Fax"]</dt><dd>@Display(customer.Fax)</dd>
                            <dt>@Text["DateOfBirth"]</dt><dd>@DisplayDate(customer.DateOfBirth)</dd>
                        </dl>
                    }
                </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12" md="6">
                <section>
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["Company"]</MudText>
                    @if (customer.Company is null)
                    {
                        <MudText>@Text["NotAvailable"]</MudText>
                    }
                    else
                    {
                        <dl class="details">
                            <dt>@Text["CompanyName"]</dt><dd>@customer.Company.Name</dd>
                            <dt>@Text["TaxNumber"]</dt><dd>@Display(customer.Company.TaxNumber)</dd>
                            <dt>@Text["Registrar"]</dt><dd>@Display(customer.Company.Registrar)</dd>
                        </dl>
                    }
                </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12" md="6">
                <section>
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["BillingAddress"]</MudText>
                    <address>@DisplayAddress(customer.BillingAddress)</address>
                </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12" md="6">
                <section>
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["ShippingAddress"]</MudText>
                    <address>@DisplayAddress(customer.ShippingAddress)</address>
                </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12">
                <section>
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-3">@Text["RecordInformation"]</MudText>
                    <dl class="details">
                        <dt>@Text["CreatedDate"]</dt><dd>@DisplayDateTime(customer.CreatedDate)</dd>
                        <dt>@Text["ModifiedDate"]</dt><dd>@DisplayDateTime(customer.ModifiedDate)</dd>
                    </dl>
                </MudPaper>
                </section>
            </MudItem>
        </MudGrid>

        <MudButton Href="/Customers/Index" Variant="Variant.Text" Class="mt-4">@Text["BackToCustomers"]</MudButton>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }

    private CustomerDetail? customer;
    private readonly CustomerUpdateRequest editModel = new();
    private MudForm? editForm;
    private bool editFormValid;
    private bool canEdit;
    private bool editing;
    private bool submitting;
    private string? error;
    private Severity errorSeverity = Severity.Error;
    private bool loading;

    protected override async Task OnParametersSetAsync()
    {
        customer = null;
        error = null;
        errorSeverity = Severity.Error;
        editing = false;
        submitting = false;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canEdit = authenticationState.User.Claims.Any(claim =>
            claim.Type == "permissions" &&
            claim.Value == "legacy-customer.customers.update");
        if (Id <= 0)
        {
            error = Text["NotFound"];
            errorSeverity = Severity.Warning;
            return;
        }

        loading = true;
        try
        {
            using var response = await Http.GetAsync($"/bff/customers/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                error = Text["NotFound"];
                errorSeverity = Severity.Warning;
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                error = Text["InvalidResponse"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            customer = await response.Content.ReadFromJsonAsync<CustomerDetail>();
            if (customer is null || customer.Id != Id)
            {
                customer = null;
                error = Text["InvalidResponse"];
            }
            else
            {
                CopyToEditModel(customer);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private void BeginEdit()
    {
        if (!canEdit || customer is null)
        {
            return;
        }

        CopyToEditModel(customer);
        error = null;
        editing = true;
    }

    private void CancelEdit()
    {
        editing = false;
        error = null;
    }

    private async Task SaveAsync()
    {
        if (!canEdit || !editing || submitting || editForm is null)
        {
            return;
        }

        await editForm.ValidateAsync();
        if (!editFormValid)
        {
            error = Text["ValidationFailed"];
            return;
        }

        submitting = true;
        error = null;
        try
        {
            using var sessionResponse = await Http.GetAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            sessionResponse.EnsureSuccessStatusCode();
            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                error = Text["SaveFailed"];
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/customers/{Id}")
            {
                Content = JsonContent.Create(editModel),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["ForbiddenUpdate"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                error = Text["ValidationFailed"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                error = Text["NotFound"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                error = Text["Conflict"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["SaveFailed"];
                return;
            }

            editing = false;
            await OnParametersSetAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private void CopyToEditModel(CustomerDetail value)
    {
        editModel.FirstName = value.FirstName;
        editModel.LastName = value.LastName;
        editModel.Email = value.Email;
        editModel.Telephone = value.Telephone;
        editModel.Mobile = value.Mobile;
        editModel.Fax = value.Fax;
        editModel.DateOfBirth = value.DateOfBirth;
    }

    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotAvailable"] : value;

    private string DisplayDate(DateTime? value) => value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
        ?? Text["NotAvailable"];

    private string DisplayDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
        ?? Text["NotAvailable"];

    private string DisplayAddress(CustomerAddressDetail? address)
    {
        if (address is null)
        {
            return Text["NotAvailable"];
        }

        return string.Join(", ", new[]
        {
            address.Building,
            address.AddressLine1,
            address.AddressLine2,
            address.City,
            address.State,
            address.PostalCode,
        }.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private void NavigateToLogin() => Navigation.NavigateTo(
        $"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
