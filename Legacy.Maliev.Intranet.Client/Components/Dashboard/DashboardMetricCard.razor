@using Legacy.Maliev.Intranet.Client.Shared.Components

<article class="dashboard-metric-card">
    <LegacyLink Href="@NavigateTo" Role="LegacyLinkRole.Navigation" AriaLabel="@($"{Label}: {Value}. {LinkText}")" Class="dashboard-metric-link">
        <span class="dashboard-metric-icon" aria-hidden="true"><ShadcnIcon Icon="@Icon" Size="18" /></span>
        <span class="dashboard-metric-copy">
            <span class="dashboard-metric-label">@Label</span>
            <strong class="dashboard-metric-value">@Value</strong>
        </span>
        <span class="dashboard-metric-arrow" aria-hidden="true">→</span>
    </LegacyLink>
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NavigateTo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string LinkText { get; set; } = string.Empty;
    [Parameter] public ShadcnIconData Icon { get; set; } = LucideIconCatalog.Instance.Get(LucideIconNames.LayoutDashboard);
}
