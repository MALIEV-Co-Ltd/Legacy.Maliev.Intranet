@using Legacy.Maliev.Intranet.Client.Layout
@inject NavigationManager Navigation
@inject IStringLocalizer<LegacyTopBar> Text
@inject IJSRuntime JS

<aside id="@(IsDrawer ? "legacy-navigation-rail-drawer" : "legacy-navigation-rail")"
       class="legacy-navigation-rail @(IsDrawer ? "drawer" : string.Empty)"
       role="@(IsDrawer ? "dialog" : null)"
       aria-modal="@(IsDrawer ? "true" : null)"
       aria-label="@Text["Primary navigation"]"
       @onkeydown="HandleKeyDown">
    @if (IsDrawer)
    {
        <span class="legacy-drawer-focus-sentinel" tabindex="0" @onfocus="FocusLastAsync"></span>
        <div class="legacy-rail-header">
            <a class="legacy-rail-logo legacy-logo-link" href="/Dashboard" aria-label="@Text["MALIEV dashboard"]">
                <img class="legacy-logo-image legacy-logo-image--light" src="images/MALIEV_BLACK.svg" alt="MALIEV" />
                <img class="legacy-logo-image legacy-logo-image--dark" src="images/MALIEV_WHITE.svg" alt="" aria-hidden="true" />
            </a>
            <ShadcnButton id="legacy-navigation-close" Class="legacy-rail-close"
                          Variant="ShadcnButtonVariant.Ghost" Size="ShadcnButtonSize.Icon"
                          aria-label="@Text["Close navigation"]" OnClick="CloseAsync">
                <ShadcnIcon Icon="CloseIcon" Size="20" />
            </ShadcnButton>
        </div>
    }

    <nav class="legacy-rail-groups">
        @foreach (var group in LegacyAppNavigation.Groups)
        {
            <section class="legacy-rail-group" aria-labelledby="@GroupId(group)">
                <h2 id="@GroupId(group)">@Text[group.Label]</h2>
                <ul class="legacy-rail-items">
                @foreach (var item in group.Items.Where(candidate => candidate.Kind == LegacyNavItemKind.Primary))
                {
                    var children = GetEnabledChildren(item);
                    @if (IsItemEnabled(item) || children.Count > 0)
                    {
                        <li class="legacy-rail-item">
                            @if (IsItemEnabled(item))
                            {
                                <a id="@ItemId(item)"
                                   href="@item.Href"
                                   @ref="_lastNavigationLink"
                                   class="legacy-rail-link @(IsItemActive(item) ? "active" : string.Empty)"
                                   aria-current="@(IsItemPageCurrent(item) ? "page" : null)"
                                   title="@Text[item.Description ?? item.Label]"
                                   @onclick="CloseAsync">
                                    <ShadcnIcon Icon="@item.Icon" Size="20" />
                                    <span>@Text[item.Label]</span>
                                </a>
                            }
                            @if (children.Count > 0)
                            {
                                <ul class="legacy-rail-children"
                                    aria-labelledby="@(IsItemEnabled(item) ? ItemId(item) : null)"
                                    aria-label="@(!IsItemEnabled(item) ? Text[item.Label].Value : null)">
                                @foreach (var child in children)
                                {
                                    <li>
                                        <a href="@child.Href"
                                           @ref="_lastNavigationLink"
                                           class="legacy-rail-link legacy-rail-link--child @(IsItemActive(child) ? "active" : string.Empty)"
                                           aria-current="@(IsItemPageCurrent(child) ? "page" : null)"
                                           title="@Text[child.Description ?? child.Label]"
                                           @onclick="CloseAsync">
                                            <ShadcnIcon Icon="@child.Icon" Size="20" />
                                            <span>@Text[child.Label]</span>
                                        </a>
                                    </li>
                                }
                                </ul>
                            }
                        </li>
                    }
                }
                </ul>
            </section>
        }
    </nav>
    @if (IsDrawer)
    {
        <span class="legacy-drawer-focus-sentinel" tabindex="0" @onfocus="FocusFirstAsync"></span>
    }
</aside>

@code {
    [Parameter] public EmployeeSessionSummary? Session { get; set; }
    [Parameter] public bool IsDrawer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly ShadcnIconData CloseIcon = LucideIconCatalog.Instance.Get(LucideIconNames.X);
    private ElementReference _lastNavigationLink;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsDrawer && firstRender)
        {
            await FocusCloseButtonAsync();
        }
    }

    private bool IsItemEnabled(LegacyNavItem item) => LegacyNavigationAuthorization.IsEnabled(
        Session?.IsAuthenticated == true,
        item.RequiredPermission,
        Session?.Permissions,
        Session?.Roles);

    private bool IsItemActive(LegacyNavItem item)
    {
        var current = CurrentRoute();
        var target = NormalizeRoute(item.Href);
        return item.Match == NavLinkMatch.All
            ? string.Equals(current, target, StringComparison.OrdinalIgnoreCase)
            : string.Equals(current, target, StringComparison.OrdinalIgnoreCase) ||
              current.StartsWith($"{target}/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsItemPageCurrent(LegacyNavItem item) => ReferenceEquals(FindCurrentItem(), item);

    private LegacyNavItem? FindCurrentItem() => LegacyAppNavigation.Groups
        .SelectMany(group => group.Items)
        .Where(IsItemEnabled)
        .Where(IsItemActive)
        .OrderByDescending(item => NormalizeRoute(item.Href).Length)
        .FirstOrDefault();

    private IReadOnlyList<LegacyNavItem> GetEnabledChildren(LegacyNavItem parent) => LegacyAppNavigation.Groups
        .SelectMany(group => group.Items)
        .Where(item => item.Kind == LegacyNavItemKind.ChildAction &&
                       string.Equals(item.ParentHref, parent.Href, StringComparison.OrdinalIgnoreCase) &&
                       IsItemEnabled(item))
        .ToArray();

    private string CurrentRoute() => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    private static string NormalizeRoute(string href) => href.Trim('/').Split('?', '#')[0];

    private static string ItemId(LegacyNavItem item) => $"legacy-rail-owner-{NormalizeRoute(item.Href).Replace('/', '-').ToLowerInvariant()}";

    private static string GroupId(LegacyNavGroup group) => $"legacy-rail-{group.Label.ToLowerInvariant().Replace(' ', '-')}";

    private Task CloseAsync() => IsDrawer ? OnClose.InvokeAsync() : Task.CompletedTask;

    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private async Task FocusFirstAsync(FocusEventArgs _)
    {
        await FocusCloseButtonAsync();
    }

    private async Task FocusLastAsync(FocusEventArgs _)
    {
        if (LegacyAppNavigation.Groups.SelectMany(group => group.Items).Any(IsItemEnabled))
        {
            await _lastNavigationLink.FocusAsync();
            return;
        }

        await FocusCloseButtonAsync();
    }

    private ValueTask FocusCloseButtonAsync() => JS.InvokeVoidAsync("malievFocus.byId", "legacy-navigation-close");
}
