@using System.Globalization
@using Legacy.Maliev.Intranet.Contracts
@using Legacy.Maliev.Intranet.Client.Layout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<LegacyTopBar> Text

<div class="legacy-language-selector">
    <ShadcnNativeSelect TValue="string" Class="legacy-language-select" Value="@SelectedCulture"
                        ValueChanged="ChangeCultureAsync" Size="ShadcnControlSize.Small"
                        aria-label="@Text["Language"]">
        <ShadcnNativeSelectOption TValue="string" Value="@EnglishCulture">English</ShadcnNativeSelectOption>
        <ShadcnNativeSelectOption TValue="string" Value="@ThaiCulture">ไทย</ShadcnNativeSelectOption>
    </ShadcnNativeSelect>
</div>

@code {
    private const string EnglishCulture = "en-TH";
    private const string ThaiCulture = "th-TH";

    private static string SelectedCulture =>
        CultureInfo.CurrentUICulture.Name.StartsWith("th", StringComparison.OrdinalIgnoreCase)
            ? "th-TH"
            : "en-TH";

    private async Task ChangeCultureAsync(string culture)
    {
        culture = string.Equals(culture, "th-TH", StringComparison.OrdinalIgnoreCase)
            ? "th-TH"
            : "en-TH";
        await JS.InvokeVoidAsync("malievCulture.set", culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
