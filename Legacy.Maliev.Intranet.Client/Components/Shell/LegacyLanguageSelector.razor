@using System.Globalization
@using Legacy.Maliev.Intranet.Contracts
@using Legacy.Maliev.Intranet.Client.Layout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<LegacyTopBar> Text

<label class="legacy-language-selector">
    <span class="visually-hidden">@Text["Language"]</span>
    <select aria-label="@Text["Language"]" value="@SelectedCulture" @onchange="ChangeCultureAsync">
        <option value="en-TH">English</option>
        <option value="th-TH">ไทย</option>
    </select>
</label>

@code {
    private static string SelectedCulture =>
        CultureInfo.CurrentUICulture.Name.StartsWith("th", StringComparison.OrdinalIgnoreCase)
            ? "th-TH"
            : "en-TH";

    private async Task ChangeCultureAsync(ChangeEventArgs args)
    {
        var culture = string.Equals(args.Value?.ToString(), "th-TH", StringComparison.OrdinalIgnoreCase)
            ? "th-TH"
            : "en-TH";
        await JS.InvokeVoidAsync("malievCulture.set", culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
