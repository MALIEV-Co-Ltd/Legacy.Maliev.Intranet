@using System.Globalization
@using Legacy.Maliev.Intranet.Contracts
@using Legacy.Maliev.Intranet.Client.Layout
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<LegacyTopBar> Text

<div class="legacy-language-selector">
    <MudSelect T="string" Class="legacy-language-select" Value="@SelectedCulture"
               ValueChanged="ChangeCultureAsync" Dense="true" Variant="Variant.Text"
               aria-label="@Text["Language"]">
        <MudSelectItem T="string" Value="@("en-TH")">English</MudSelectItem>
        <MudSelectItem T="string" Value="@("th-TH")">ไทย</MudSelectItem>
    </MudSelect>
</div>

@code {
    private static string SelectedCulture =>
        CultureInfo.CurrentUICulture.Name.StartsWith("th", StringComparison.OrdinalIgnoreCase)
            ? "th-TH"
            : "en-TH";

    private async Task ChangeCultureAsync(string culture)
    {
        culture = string.Equals(culture, "th-TH", StringComparison.OrdinalIgnoreCase)
            ? "th-TH"
            : "en-TH";
        await JS.InvokeVoidAsync("malievCulture.set", culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
