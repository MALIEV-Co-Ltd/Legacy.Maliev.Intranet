@using Legacy.Maliev.Intranet.Client.Layout
@inject IStringLocalizer<LegacyTopBar> Text

<nav class="legacy-quick-actions" aria-label="@Text["Quick actions"]">
    @foreach (var item in _actions.Where(IsItemEnabled))
    {
        <ShadcnButton Href="@item.Href"
                      Class="@QuickActionClass(item)"
                      Variant="@(item.Href == "/Orders/Create" ? ShadcnButtonVariant.Default : ShadcnButtonVariant.Outline)"
                      aria-label="@Text[item.Label]"
                      title="@Text[item.Label]">
            <ShadcnIcon Icon="AddIcon" Size="20" />
            <span>@Text[item.Label]</span>
        </ShadcnButton>
    }
</nav>

@code {
    [Parameter] public EmployeeSessionSummary? Session { get; set; }

    private static readonly ShadcnIconData AddIcon = LucideIconCatalog.Instance.Get(LucideIconNames.Plus);

    private static readonly LegacyNavItem[] _actions =
    [
        LegacyAppNavigation.FindByHref("/Quotations/Create"),
        LegacyAppNavigation.FindByHref("/Orders/Create"),
    ];

    private static string QuickActionClass(LegacyNavItem item) =>
        $"legacy-quick-action {(item.Href == "/Orders/Create" ? "primary" : string.Empty)}".Trim();

    private bool IsItemEnabled(LegacyNavItem item) => LegacyNavigationAuthorization.IsEnabled(
        Session?.IsAuthenticated == true,
        item.RequiredPermission,
        Session?.Permissions,
        Session?.Roles);
}
