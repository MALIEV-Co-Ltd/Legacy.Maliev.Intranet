@using Legacy.Maliev.Intranet.Client.Layout
@inject IStringLocalizer<LegacyTopBar> Text

<div class="legacy-quick-actions" aria-label="@Text["Quick actions"]">
    @foreach (var item in _actions.Where(IsItemEnabled))
    {
        <a href="@item.Href" class="legacy-quick-action @(item.Href == "/Orders/Create" ? "primary" : string.Empty)">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
            <span>@Text[item.Label]</span>
        </a>
    }
</div>

@code {
    [Parameter] public EmployeeSessionSummary? Session { get; set; }

    private static readonly LegacyNavItem[] _actions =
    [
        LegacyAppNavigation.FindByHref("/Quotations/Create"),
        LegacyAppNavigation.FindByHref("/Orders/Create"),
    ];

    private bool IsItemEnabled(LegacyNavItem item) => LegacyNavigationAuthorization.IsEnabled(
        Session?.IsAuthenticated == true,
        item.RequiredPermission,
        Session?.Permissions,
        Session?.Roles);
}
