@using Legacy.Maliev.Intranet.Client.Components.Shell
@inherits LayoutComponentBase
@inject EmployeeSessionClient SessionClient
@inject EmployeeAuthenticationClient AuthenticationClient
@inject LegacyThemeService ThemeService
@inject NavigationManager Navigation
@inject IStringLocalizer<MainLayout> Text
@implements IDisposable

<ShadcnThemeProvider IsDarkMode="@ThemeService.IsDarkMode" Direction="ShadcnDirection.LeftToRight" Class="legacy-provider-root">
<a class="legacy-skip-link" href="#main-content">@Text["Skip to content"]</a>

<ShadcnSidebarProvider @bind-Open="_sidebarOpen"
                       @bind-MobileOpen="_mobileNavigationOpen"
                       Width="16rem"
                       MobileWidth="18rem"
                       IconWidth="3.5rem"
                       ToggleLabel="@Text["Toggle navigation"]"
                       CloseLabel="@Text["Close navigation"]"
                       Class="legacy-layout">
    <LegacyNavigationRail Session="session" OnNavigate="CloseNavigationAsync" />

    <ShadcnSidebarInset Role="none" Class="legacy-workspace-frame">
        <LegacyTopBar Session="session" OnSignOut="SignOutAsync" />
        <div class="legacy-workspace-shell">
            <main id="main-content" class="legacy-main-content legacy-page-container" tabindex="-1">
                @Body
            </main>
        </div>
    </ShadcnSidebarInset>
</ShadcnSidebarProvider>
</ShadcnThemeProvider>

@code {
    private EmployeeSessionSummary? session;
    private bool _sidebarOpen = true;
    private bool _mobileNavigationOpen;

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync() => session = await SessionClient.GetAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task CloseNavigationAsync()
    {
        _mobileNavigationOpen = false;
        return Task.CompletedTask;
    }

    private async Task SignOutAsync()
    {
        await AuthenticationClient.SignOutAsync();
        Navigation.NavigateTo("/Login", forceLoad: true);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _mobileNavigationOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
