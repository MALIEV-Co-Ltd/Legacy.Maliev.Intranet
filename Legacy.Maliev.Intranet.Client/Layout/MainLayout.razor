@using Legacy.Maliev.Intranet.Client.Components.Shell
@inherits LayoutComponentBase
@inject EmployeeSessionClient SessionClient
@inject EmployeeAuthenticationClient AuthenticationClient
@inject LegacyThemeService ThemeService
@inject NavigationManager Navigation
@inject IStringLocalizer<MainLayout> Text
@implements IDisposable

<ShadcnThemeProvider IsDarkMode="@ThemeService.IsDarkMode" Direction="ShadcnDirection.LeftToRight" Class="legacy-provider-root">
<a class="legacy-skip-link" href="#main-content">@Text["Skip to content"]</a>

<MudLayout Class="legacy-layout">
    <LegacyNavigationRail Session="session" />

    @if (_navigationOpen)
    {
        <div class="legacy-navigation-backdrop" aria-hidden="true" @onclick="CloseNavigationAsync"></div>
        <LegacyNavigationRail Session="session" IsDrawer="true" OnClose="CloseNavigationAsync" />
    }

    <div class="legacy-workspace-frame" @attributes="WorkspaceAccessibilityAttributes">
        <LegacyTopBar Session="session"
                      NavigationOpen="_navigationOpen"
                      OnToggleNavigation="ToggleNavigationAsync"
                      OnCloseNavigation="CloseNavigationAsync"
                      OnSignOut="SignOutAsync" />
        <div class="legacy-workspace-shell">
            <MudMainContent Class="legacy-main-content">
                <main id="main-content" class="legacy-page-container" tabindex="-1">
                    @Body
                </main>
            </MudMainContent>
        </div>
    </div>
</MudLayout>
</ShadcnThemeProvider>

@code {
    private EmployeeSessionSummary? session;
    private bool _navigationOpen;

    private IReadOnlyDictionary<string, object> WorkspaceAccessibilityAttributes => _navigationOpen
        ? DrawerOpenWorkspaceAttributes
        : EmptyWorkspaceAttributes;

    private static readonly IReadOnlyDictionary<string, object> DrawerOpenWorkspaceAttributes =
        new Dictionary<string, object>
        {
            ["inert"] = string.Empty,
            ["aria-hidden"] = "true",
        };

    private static readonly IReadOnlyDictionary<string, object> EmptyWorkspaceAttributes =
        new Dictionary<string, object>();

    protected override void OnInitialized()
    {
        ThemeService.Changed += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync() => session = await SessionClient.GetAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ToggleNavigationAsync()
    {
        _navigationOpen = !_navigationOpen;
        return Task.CompletedTask;
    }

    private Task CloseNavigationAsync()
    {
        _navigationOpen = false;
        return Task.CompletedTask;
    }

    private async Task SignOutAsync()
    {
        await AuthenticationClient.SignOutAsync();
        Navigation.NavigateTo("/Login", forceLoad: true);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _navigationOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.Changed -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
