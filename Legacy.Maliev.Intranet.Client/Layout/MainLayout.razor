@inherits LayoutComponentBase
@inject EmployeeSessionClient SessionClient
@inject EmployeeAuthenticationClient AuthenticationClient
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="legacy-layout">
    <LegacyTopBar Session="@session" OnSignOut="SignOutAsync" />
    <MudMainContent Class="legacy-main-content">
        <div class="legacy-page-container">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2f6fed",
            AppbarBackground = "#f6f8fa",
            AppbarText = "#2f2f2f",
            Background = "#f4f5f7",
            DrawerBackground = "#ffffff",
            DrawerText = "#3d3d3d",
        },
    };

    private EmployeeSessionSummary? session;

    protected override async Task OnInitializedAsync()
    {
        session = await SessionClient.GetAsync();
    }

    private async Task SignOutAsync()
    {
        await AuthenticationClient.SignOutAsync();
        Navigation.NavigateTo("/Login", forceLoad: true);
    }

}
