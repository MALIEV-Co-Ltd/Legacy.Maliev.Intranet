@using Legacy.Maliev.Intranet.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject LegacyThemeService ThemeService
@implements IDisposable

<header class="legacy-topbar" @onkeydown="HandleKeyDown">
    <div class="legacy-topbar-brand">
        <button type="button"
                class="legacy-mobile-menu-button"
                aria-label="@(_mobileOpen ? "Close navigation" : "Open navigation")"
                aria-expanded="@_mobileOpen"
                aria-controls="legacy-mobile-nav"
                @onclick="ToggleMobileAsync">
            <MudIcon Icon="@(_mobileOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" Size="Size.Small" />
        </button>
        <a class="legacy-logo-link" href="/Dashboard" aria-label="MALIEV dashboard">
            <img src="images/MALIEV_BLACK.svg" alt="MALIEV" />
        </a>
    </div>

    <nav class="legacy-desktop-nav" aria-label="Primary navigation">
        @foreach (var group in LegacyAppNavigation.Groups)
        {
            <MudMenu Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="legacy-nav-menu">
                <ActivatorContent>
                    <button type="button"
                            class="legacy-nav-trigger @(IsGroupActive(group) ? "active" : string.Empty)"
                            aria-label="@($"{group.Label} navigation")"
                            @onclick="context.ToggleAsync">
                        <MudIcon Icon="@group.Icon" Size="Size.Small" />
                        <span>@group.Label</span>
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var item in group.Items)
                    {
                        <MudMenuItem Href="@item.Href"
                                     Icon="@item.Icon"
                                     Disabled="@(!IsItemEnabled(item))"
                                     Class="@(GetDesktopItemClass(item))">
                            @item.Label
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
    </nav>

    <div class="legacy-topbar-spacer"></div>

    <button type="button"
            class="legacy-theme-toggle"
            aria-label="@ThemeLabel"
            title="@ThemeLabel"
            @onclick="ToggleThemeAsync">
        <MudIcon Icon="@(ThemeService.IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Size="Size.Small" />
        <span>@(ThemeService.IsDarkMode ? "Light" : "Dark")</span>
    </button>

    <AuthorizeView>
        <Authorized Context="auth">
            <div class="legacy-profile-menu">
                <button type="button"
                        class="legacy-profile"
                        aria-haspopup="menu"
                        aria-expanded="@_profileMenuOpen"
                        aria-label="Employee menu"
                        @onclick="ToggleProfileMenuAsync">
                    <span class="legacy-session-avatar" aria-hidden="true">@GetInitials(auth.User.Identity?.Name)</span>
                    <span class="legacy-session-copy">
                        <strong>@(Session?.DisplayName ?? auth.User.Identity?.Name ?? "Employee")</strong>
                        <small>Employee workspace</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="legacy-profile-chevron" />
                </button>

                @if (_profileMenuOpen)
                {
                    <div class="legacy-profile-popover" role="menu">
                        <a class="legacy-profile-action" role="menuitem" href="/hr/profile" @onclick="CloseProfileMenuAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                            <span>My profile</span>
                        </a>
                        <div class="legacy-profile-menu-divider" />
                        <button type="button" class="legacy-profile-action" role="menuitem" @onclick="SignOutFromProfileAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                            <span>Sign out</span>
                        </button>
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <a class="legacy-signin-link" href="/Login">Sign in</a>
        </NotAuthorized>
    </AuthorizeView>
    @if (Session is null)
    {
        <span class="legacy-session-status" role="status">Session unavailable</span>
    }
</header>

@if (_mobileOpen)
{
    <div class="legacy-mobile-backdrop" aria-hidden="true" @onclick="CloseMobileAsync"></div>
    <aside id="legacy-mobile-nav" class="legacy-mobile-nav" role="dialog" aria-modal="true" aria-label="Mobile navigation">
        <div class="legacy-mobile-nav-header">
            <span>Workspace navigation</span>
            <button type="button" class="legacy-icon-button" aria-label="Close navigation" @onclick="CloseMobileAsync">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        </div>
        @foreach (var group in LegacyAppNavigation.Groups)
        {
            <section class="legacy-mobile-group" aria-label="@group.Label">
                <div class="legacy-mobile-group-title">
                    <MudIcon Icon="@group.Icon" Size="Size.Small" />
                    <span>@group.Label</span>
                </div>
                @foreach (var item in group.Items)
                {
                    @if (IsItemEnabled(item))
                    {
                        <a href="@item.Href"
                           class="legacy-mobile-link @(IsItemActive(item) ? "active" : string.Empty)"
                           aria-current="@GetAriaCurrent(item)"
                           @onclick="CloseMobileAsync">
                            <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            <span>@item.Label</span>
                        </a>
                    }
                    else
                    {
                        <span class="legacy-mobile-link disabled"
                              aria-disabled="true"
                              tabindex="-1">
                            <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            <span>@item.Label</span>
                        </span>
                    }
                }
            </section>
        }
    </aside>
}

@code {
    [Parameter] public EmployeeSessionSummary? Session { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    private bool _mobileOpen;
    private bool _profileMenuOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        ThemeService.Changed += OnThemeChanged;
    }

    private bool IsGroupActive(LegacyNavGroup group) => group.Items.Any(IsItemActive);

    private bool IsItemEnabled(LegacyNavItem item) => LegacyNavigationAuthorization.IsEnabled(
        Session?.IsAuthenticated == true,
        item.RequiredPermission,
        Session?.Permissions,
        Session?.Roles);

    private string GetDesktopItemClass(LegacyNavItem item)
    {
        var classes = IsItemActive(item) ? "legacy-nav-item active" : "legacy-nav-item";
        return IsItemEnabled(item) ? classes : $"{classes} disabled";
    }

    private bool IsItemActive(LegacyNavItem item)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        var target = item.Href.Trim('/').Split('?', '#')[0];
        return item.Match == NavLinkMatch.All
            ? string.Equals(current, target, StringComparison.OrdinalIgnoreCase)
            : string.Equals(current, target, StringComparison.OrdinalIgnoreCase) ||
              current.StartsWith($"{target}/", StringComparison.OrdinalIgnoreCase);
    }

    private Task ToggleMobileAsync()
    {
        _mobileOpen = !_mobileOpen;
        return Task.CompletedTask;
    }

    private Task CloseMobileAsync()
    {
        _mobileOpen = false;
        return Task.CompletedTask;
    }

    private Task ToggleProfileMenuAsync()
    {
        _profileMenuOpen = !_profileMenuOpen;
        return Task.CompletedTask;
    }

    private Task CloseProfileMenuAsync()
    {
        _profileMenuOpen = false;
        return Task.CompletedTask;
    }

    private async Task SignOutFromProfileAsync()
    {
        _profileMenuOpen = false;
        await SignOutAsync();
    }

    private string? GetAriaCurrent(LegacyNavItem item) => IsItemActive(item) ? "page" : null;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _mobileOpen = false;
        _profileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task SignOutAsync() => OnSignOut.InvokeAsync();

    private string ThemeLabel => ThemeService.IsDarkMode ? "Use light theme" : "Use dark theme";

    private Task ToggleThemeAsync() => ThemeService.ToggleAsync();

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _mobileOpen = false;
            _profileMenuOpen = false;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        ThemeService.Changed -= OnThemeChanged;
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "U";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1
            ? string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
}
