@using Legacy.Maliev.Intranet.Client.Components.Shell
@using Legacy.Maliev.Intranet.Contracts
@inject LegacyThemeService ThemeService
@inject IStringLocalizer<LegacyTopBar> Text
@implements IDisposable

<header class="legacy-topbar" @onkeydown="HandleKeyDown">
    <a class="legacy-topbar-logo" href="/Dashboard" aria-label="@Text["MALIEV dashboard"]">
        <img src="images/MALIEV_BLACK.svg" alt="MALIEV" />
    </a>

    <button type="button"
            class="legacy-mobile-menu-button"
            @ref="_navigationToggle"
            aria-label="@Text["Open navigation"]"
            aria-expanded="@NavigationOpen"
            aria-controls="legacy-navigation-rail-drawer"
            @onclick="OnToggleNavigation">
        <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Small" />
    </button>

    <LegacyGlobalSearch Session="Session" />
    <LegacyQuickActions Session="Session" />
    <LegacyLanguageSelector />

    <button type="button"
            class="legacy-theme-toggle"
            aria-label="@ThemeLabel"
            title="@ThemeLabel"
            @onclick="ToggleThemeAsync">
        <MudIcon Icon="@(ThemeService.IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" Size="Size.Small" />
    </button>

    <AuthorizeView>
        <Authorized Context="auth">
            <div class="legacy-profile-menu">
                <button type="button"
                        class="legacy-profile"
                        aria-haspopup="menu"
                        aria-expanded="@_profileMenuOpen"
                        aria-label="@Text["Employee menu"]"
                        @onclick="ToggleProfileMenuAsync">
                    <span class="legacy-session-avatar" aria-hidden="true">@GetInitials(auth.User.Identity?.Name)</span>
                    <span class="legacy-session-copy">
                        <strong>@(Session?.DisplayName ?? auth.User.Identity?.Name ?? Text["Employee"])</strong>
                        <small>@Text["Employee workspace"]</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="legacy-profile-chevron" />
                </button>

                @if (_profileMenuOpen)
                {
                    <div class="legacy-profile-popover" role="menu">
                        <a class="legacy-profile-action" role="menuitem" href="/hr/profile" @onclick="CloseProfileMenuAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                            <span>@Text["My profile"]</span>
                        </a>
                        <div class="legacy-profile-menu-divider"></div>
                        <button type="button" class="legacy-profile-action" role="menuitem" @onclick="SignOutFromProfileAsync">
                            <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                            <span>@Text["Sign out"]</span>
                        </button>
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <a class="legacy-signin-link" href="/Login">@Text["Sign in"]</a>
        </NotAuthorized>
    </AuthorizeView>

    @if (Session is null)
    {
        <span class="legacy-session-status" role="status">@Text["Session unavailable"]</span>
    }
</header>

@code {
    [Parameter] public EmployeeSessionSummary? Session { get; set; }
    [Parameter] public bool NavigationOpen { get; set; }
    [Parameter] public EventCallback OnToggleNavigation { get; set; }
    [Parameter] public EventCallback OnCloseNavigation { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    private bool _profileMenuOpen;
    private bool _wasNavigationOpen;
    private ElementReference _navigationToggle;

    protected override void OnInitialized() => ThemeService.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _wasNavigationOpen && !NavigationOpen)
        {
            await _navigationToggle.FocusAsync();
        }

        _wasNavigationOpen = NavigationOpen;
    }

    private Task ToggleProfileMenuAsync()
    {
        _profileMenuOpen = !_profileMenuOpen;
        return Task.CompletedTask;
    }

    private Task CloseProfileMenuAsync()
    {
        _profileMenuOpen = false;
        return Task.CompletedTask;
    }

    private async Task SignOutFromProfileAsync()
    {
        _profileMenuOpen = false;
        await OnSignOut.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _profileMenuOpen = false;
            await OnCloseNavigation.InvokeAsync();
        }
    }

    private string ThemeLabel => ThemeService.IsDarkMode ? Text["Use light theme"].Value : Text["Use dark theme"].Value;
    private Task ToggleThemeAsync() => ThemeService.ToggleAsync();
    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeService.Changed -= OnThemeChanged;

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "U";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1
            ? string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }
}
