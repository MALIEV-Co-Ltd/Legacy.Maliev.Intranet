@page "/not-found"
@attribute [AllowAnonymous]
@inject IStringLocalizer<NotFound> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="legacy-not-found" role="alert">
    <ShadcnTypography Variant="ShadcnTypographyVariant.H1">@Text["Heading"]</ShadcnTypography>
    <ShadcnTypography>@Text["Description"]</ShadcnTypography>
    <ShadcnButton Href="/Dashboard">@Text["Dashboard"]</ShadcnButton>
</div>
