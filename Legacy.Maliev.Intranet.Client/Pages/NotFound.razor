@page "/not-found"
@attribute [AllowAnonymous]

<PageTitle>Page Not Found - MALIEV Intranet</PageTitle>

<div class="legacy-not-found" role="alert">
    <MudText Typo="Typo.h4" HtmlTag="h1">Page not found</MudText>
    <MudText Typo="Typo.body1">The workspace page you requested does not exist.</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Dashboard">Go to dashboard</MudButton>
</div>
