@page "/not-found"
@attribute [AllowAnonymous]
@inject IStringLocalizer<NotFound> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="legacy-not-found" role="alert">
    <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Heading"]</MudText>
    <MudText Typo="Typo.body1">@Text["Description"]</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Dashboard">@Text["Dashboard"]</MudButton>
</div>
