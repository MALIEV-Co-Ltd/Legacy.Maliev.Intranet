@page "/Login"
@attribute [AllowAnonymous]
@layout Layout.EmptyLayout
@using Legacy.Maliev.Intranet.Client.Components.Shell
@inject EmployeeAuthenticationClient AuthenticationClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Login> Text
@inject IJSRuntime JSRuntime
@inject ILogger<Login> Logger
@inject LegacyThemeService ThemeService
@implements IAsyncDisposable

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="legacy-login-page @(ThemeService.IsDarkMode ? "dark-theme" : string.Empty)">
    <div class="legacy-login-shell">
        <aside class="legacy-login-brand-panel" aria-label="@Text["Employee gateway"]">
            <a class="legacy-login-brand" href="/" aria-label="@Text["HomeLabel"]">
                <img src="images/MALIEV_WHITE.svg" alt="MALIEV" class="legacy-login-brand-image" />
            </a>
            <div class="legacy-login-brand-copy">
                <h1>@Text["Secure access to your work"]</h1>
                <p>@Text["Sign in with your MALIEV work account to continue."]</p>
            </div>
        </aside>
        <section class="legacy-login-auth-panel">
            <header class="legacy-login-utilities">
                <LegacyLanguageSelector />
                <MudIconButton ButtonType="ButtonType.Button" Class="legacy-login-theme-toggle"
                               Icon="@(ThemeService.IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Size="Size.Small" OnClick="ToggleThemeAsync"
                               aria-label="@ThemeToggleLabel" title="@ThemeToggleLabel" />
            </header>

            <div class="legacy-login-main" id="legacy-login-content">
                @if (_isCheckingAuth)
                {
                    <section class="legacy-login-card legacy-login-loading" role="status" aria-live="polite" aria-busy="true">
                        <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                        <span>@Text["Checking your employee session..."]</span>
                    </section>
                }
                else
                {
                    <section class="legacy-login-card" aria-labelledby="legacy-login-title">
                        <div class="legacy-login-heading">
                            <h2 id="legacy-login-title" class="legacy-login-title">
                                <span>@Text["Sign in to"]</span>
                                <img src="images/MALIEV_BLACK.svg" alt="" aria-hidden="true" class="legacy-login-title-logo legacy-logo-image--light" />
                                <img src="images/MALIEV_WHITE.svg" alt="" aria-hidden="true" class="legacy-login-title-logo legacy-logo-image--dark" />
                            </h2>
                        </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="legacy-login-error"
                              role="alert" aria-live="assertive">@_errorMessage</MudAlert>
                }

                <div class="legacy-google-signin-section" data-google-signin-section data-google-signin-state="loading">
                    <div @ref="_googleIdentityHost"
                         class="legacy-google-signin-host"
                         data-google-signin-host
                         data-return-url="@LocalReturnUrlForGoogle"
                         data-status-loading="@Text["Loading Google sign-in..."]"
                         data-status-completing="@Text["Completing Google sign-in..."]"
                         data-status-completion-failed="@Text["Google sign-in could not be completed. Reloading..."]"
                         data-status-unavailable="@Text["Google sign-in is temporarily unavailable. You can still use your work email."]"
                         aria-label="@Text["Continue with Google"]"></div>
                    <p class="legacy-google-signin-status" data-google-signin-status role="status" aria-live="polite" hidden></p>
                </div>

                <div class="legacy-login-divider" role="separator" aria-label="@Text["or continue with email"]">
                    <span></span>
                    <strong>@Text["or continue with email"]</strong>
                    <span></span>
                </div>

                @if (IsEmailStep)
                {
                    <MudForm Class="legacy-login-form">
                        <MudTextField T="string" InputId="legacy-login-email" Class="legacy-login-input"
                                      Label="@Text["Email"]" Placeholder="@("name@maliev.com")"
                                      InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Value="@_emailInput" ValueChanged="@(value => _emailInput = value ?? string.Empty)"
                                      Immediate="true" Required="true" HelperText="@Text["Use your MALIEV work email."]"
                                      pattern="@EmailPattern" autocomplete="username" OnKeyDown="HandleEmailKeyDown" />
                        <MudButton ButtonType="ButtonType.Button" Class="legacy-login-primary" FullWidth="true"
                                   Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!EmailLooksValid)"
                                   OnClick="ContinueWithEmail">@Text["Continue with email"]</MudButton>
                    </MudForm>
                }
                else
                {
                    <MudForm Class="legacy-login-form">
                        <div class="legacy-login-email-summary">
                            <span>@_emailInput</span>
                            <MudButton ButtonType="ButtonType.Button" Class="legacy-login-change" Variant="Variant.Text"
                                       OnClick="BackToEmailStep">@Text["Change"]</MudButton>
                        </div>
                        <MudTextField T="string" InputId="legacy-login-password" Class="legacy-login-input"
                                      Label="@Text["Password"]" InputType="InputType.Password"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                      Value="@_password" ValueChanged="@(value => _password = value ?? string.Empty)"
                                      Immediate="true" autocomplete="current-password" OnKeyDown="HandlePasswordKeyDown" />
                        <MudCheckBox T="bool" Class="legacy-login-remember" @bind-Value="_rememberMe"
                                     Label="@Text["Remember me"]" />
                        <MudButton ButtonType="ButtonType.Button" Class="legacy-login-primary" FullWidth="true"
                                   Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(_isProcessing || !CredentialsReady)" OnClick="HandleLogin">
                            @if (_isProcessing)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Inherit" Indeterminate="true" />
                                <span>@Text["Signing in..."]</span>
                            }
                            else
                            {
                                <span>@Text["Sign in with email"]</span>
                            }
                        </MudButton>
                    </MudForm>
                }

                <div class="legacy-login-recovery">
                    <p>@Text["Need help accessing your employee account?"]</p>
                    <p>@Text["Contact your MALIEV administrator if you cannot access your employee account."]</p>
                </div>

                    </section>
                }
            </div>
            <footer class="legacy-login-footer">
                <span>MALIEV CO., LTD.</span>
                <a href="https://www.maliev.com" target="_blank" rel="noreferrer">www.maliev.com</a>
            </footer>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool _isCheckingAuth = true;
    private bool _isProcessing;
    private bool _rememberMe;
    private string _emailInput = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private LoginStep _step = LoginStep.Email;
    private ElementReference _googleIdentityHost;
    private bool _googleIdentityInitialized;

    private bool IsEmailStep => _step == LoginStep.Email;

    private bool EmailLooksValid => WorkspaceIdentityRules.IsAllowedEmployeeEmail(
        _emailInput.Trim(),
        allowLocalTestDomain: IsLocalAspireHost);

    private bool CredentialsReady => EmailLooksValid && !string.IsNullOrWhiteSpace(_password);

    private string LocalReturnUrlForGoogle => IsLocalPath(ReturnUrl) ? ReturnUrl! : "/Dashboard";

    private bool IsLocalAspireHost =>
        Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var baseUri) &&
        baseUri.Host is "localhost" or "127.0.0.1" or "::1";

    private string EmailPattern => IsLocalAspireHost
        ? "^[^@\\s]+@(maliev\\.com|maliev\\.test)$"
        : "^[^@\\s]+@maliev\\.com$";

    private string ThemeToggleLabel => ThemeService.IsDarkMode
        ? Text["Switch to light mode"].Value
        : Text["Switch to dark mode"].Value;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.Changed += OnThemeChanged;
        _errorMessage = string.IsNullOrWhiteSpace(Error) ? null : Error;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authenticationState.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(LocalReturnUrlForGoogle, replace: true);
                return;
            }
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Employee login could not read the existing authentication state.");
        }

        _isCheckingAuth = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            await InvokeAsync(StateHasChanged);
        }

        if (_isCheckingAuth || _googleIdentityInitialized)
        {
            return;
        }

        _googleIdentityInitialized = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("malievGoogleIdentity.initializeHost", _googleIdentityHost);
        }
        catch (Exception exception) when (exception is InvalidOperationException or JSException or JSDisconnectedException)
        {
            _googleIdentityInitialized = false;
            Logger.LogWarning(exception, "Google Identity Services could not initialize on the legacy login fallback.");
        }
    }

    private Task ToggleThemeAsync() => ThemeService.ToggleAsync();

    private void OnThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private void ContinueWithEmail()
    {
        _emailInput = _emailInput.Trim();
        if (!EmailLooksValid)
        {
            _errorMessage = Text["Use your MALIEV work email."].Value;
            return;
        }

        _errorMessage = null;
        _step = LoginStep.Credentials;
    }

    private void HandleEmailKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            ContinueWithEmail();
        }
    }

    private async Task HandlePasswordKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private void BackToEmailStep()
    {
        _step = LoginStep.Email;
        _password = string.Empty;
    }

    private async Task HandleLogin()
    {
        if (_isProcessing || !CredentialsReady)
        {
            return;
        }

        _isProcessing = true;
        _errorMessage = null;
        var password = _password;
        _password = string.Empty;

        try
        {
            var result = await AuthenticationClient.SignInAsync(
                _emailInput,
                password,
                ReturnUrl,
                _rememberMe);
            if (result.Succeeded && result.RedirectUrl is not null)
            {
                Navigation.NavigateTo(result.RedirectUrl, forceLoad: true);
                return;
            }

            _errorMessage = result.ErrorMessage ?? Text["Employee sign-in is temporarily unavailable."].Value;
        }
        finally
        {
            password = string.Empty;
            _isProcessing = false;
        }
    }

    private static bool IsLocalPath(string? path) =>
        !string.IsNullOrWhiteSpace(path) &&
        path.StartsWith("/", StringComparison.Ordinal) &&
        (path.Length == 1 || path[1] is not ('/' or '\\'));

    public ValueTask DisposeAsync()
    {
        ThemeService.Changed -= OnThemeChanged;
        _password = string.Empty;
        return ValueTask.CompletedTask;
    }

    private enum LoginStep
    {
        Email,
        Credentials,
    }
}
