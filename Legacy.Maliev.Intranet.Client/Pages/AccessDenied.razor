@page "/AccessDenied"
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Localization.IStringLocalizer<AccessDenied> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="legacy-content-container legacy-content-container--small py-8">
    <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert">
        <ShadcnAlertTitle><ShadcnTypography Variant="ShadcnTypographyVariant.H1" Class="mb-2">@Text["Heading"]</ShadcnTypography></ShadcnAlertTitle>
        <ShadcnAlertDescription><ShadcnTypography Class="mb-4">@Text["Description"]</ShadcnTypography></ShadcnAlertDescription>
        <ShadcnAlertAction><ShadcnButton Href="/Login">@Text["ReturnToSignIn"]</ShadcnButton></ShadcnAlertAction>
    </ShadcnAlert>
</div>
