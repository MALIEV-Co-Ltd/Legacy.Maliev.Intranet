@page "/Dashboard"
@attribute [Authorize]
@using Legacy.Maliev.Intranet.Client.Components.Dashboard
@using Legacy.Maliev.Intranet.Client.Shared.Components
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Dashboard> Text
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@Text["PageTitle"]</PageTitle>

<PageBreadcrumbs Items="@Breadcrumbs" />

<main class="dashboard-page" aria-labelledby="dashboard-heading">
    <header class="dashboard-heading">
        <div>
            <h1 id="dashboard-heading">@Text["Heading"]</h1>
            <p>@Text["Description"]</p>
        </div>
        <div class="dashboard-freshness" aria-live="polite">
            @if (_snapshot is not null)
            {
                <span class="dashboard-health @(_snapshot.DegradedSources.Count == 0 ? "is-healthy" : "is-degraded")">
                    <span aria-hidden="true"></span>
                    @(_snapshot.DegradedSources.Count == 0 ? Text["ConnectedSourcesOperational"] : Text["SourcesDegraded", _snapshot.DegradedSources.Count])
                </span>
                <time datetime="@_snapshot.GeneratedAt.ToString("O")">@Text["UpdatedAt", FormatTimestamp(_snapshot.GeneratedAt)]</time>
            }
            <ShadcnButton Variant="ShadcnButtonVariant.Outline" Size="ShadcnButtonSize.Small" Disabled="_loading" OnClick="RefreshAsync">
                <ShadcnIcon Icon="RefreshIcon" Size="18" />
                @Text["Refresh"]
            </ShadcnButton>
        </div>
    </header>

    @if (_loading)
    {
        <div class="dashboard-loading" aria-label="@Text["LoadingDashboard"]" aria-busy="true">
            <ShadcnProgress Label="@Text["LoadingDashboard"]" />
            <div class="dashboard-loading-grid">
                @for (var index = 0; index < 4; index++)
                {
                    <ShadcnSkeleton Style="height: 140px;" />
                }
            </div>
            <ShadcnSkeleton Style="height: 320px;" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert" Class="dashboard-alert">
            <ShadcnAlertDescription>@_error</ShadcnAlertDescription>
            <ShadcnAlertAction><ShadcnButton Variant="ShadcnButtonVariant.Ghost" OnClick="RefreshAsync" Class="ml-2">@Text["TryAgain"]</ShadcnButton></ShadcnAlertAction>
        </ShadcnAlert>
    }
    else if (_snapshot is { Cards.Count: 0 } && !HasOperationalContent)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status" Class="dashboard-alert"><ShadcnAlertDescription>@Text["NoWorkspaces"]</ShadcnAlertDescription></ShadcnAlert>
    }
    else if (_snapshot is not null)
    {
        @if (_snapshot.DegradedSources.Count > 0)
        {
            <ShadcnAlert AlertRole="ShadcnAlertRole.Status" Class="dashboard-alert dashboard-alert--warning">
                <ShadcnIcon Icon="WarningIcon" Size="20" aria-hidden="true" />
                <ShadcnAlertDescription>@Text["PartialDataWarning"]</ShadcnAlertDescription>
            </ShadcnAlert>
        }

        <div class="dashboard-primary-grid">
            @if (_snapshot.RecentOrders.Count > 0)
            {
                <DashboardPanel Title="@Text["ProductionPipeline"]"
                                Subtitle="@Text["ProductionPipelineSubtitle"]"
                                NavigateTo="/sales/orders"
                                LinkText="@Text["ViewAll"]"
                                Class="dashboard-wide-panel">
                    <div class="dashboard-table-scroll">
                        <ShadcnTable Class="dashboard-table" ExpectedColumnCount="7" data-projection="dashboard-orders">
                            <ShadcnTableCaption Class="sr-only">@Text["RecentProductionOrders"]</ShadcnTableCaption>
                            <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Order"]</ShadcnTableHead><ShadcnTableHead>@Text["Part"]</ShadcnTableHead><ShadcnTableHead>@Text["Quantity"]</ShadcnTableHead><ShadcnTableHead>@Text["Manufactured"]</ShadcnTableHead><ShadcnTableHead>@Text["Remaining"]</ShadcnTableHead><ShadcnTableHead>@Text["Promised"]</ShadcnTableHead><ShadcnTableHead>@Text["Progress"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                            <ShadcnTableBody>
                                @foreach (var order in _snapshot.RecentOrders)
                                {
                                    <ShadcnTableRow>
                                        <ShadcnTableCell data-label="@Text["Order"]" data-field="Id NavigateTo" class="mlv-mono"><LegacyLink Href="@order.NavigateTo" Role="LegacyLinkRole.Record" AriaLabel="@Text["OrderNumber", order.Id]">#@order.Id</LegacyLink></ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Part"]" data-field="Name" class="dashboard-table-primary">@(string.IsNullOrWhiteSpace(order.Name) ? Text["OrderNumber", order.Id] : order.Name)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Quantity"]" data-field="Quantity" class="mlv-mono">@order.Quantity.ToString("N0")</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Manufactured"]" data-field="Manufactured" class="mlv-mono">@order.Manufactured.ToString("N0")</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Remaining"]" data-field="Remaining" class="mlv-mono">@Remaining(order).ToString("N0")</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Promised"]" data-field="PromisedDate" class="mlv-mono">@FormatDate(order.PromisedDate)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Progress"]"><span class="dashboard-status @OrderStatusClass(order)">@OrderStatus(order)</span></ShadcnTableCell>
                                    </ShadcnTableRow>
                                }
                            </ShadcnTableBody>
                        </ShadcnTable>
                    </div>
                </DashboardPanel>
            }

            @if (_snapshot.RecentQuotations.Count > 0)
            {
                <DashboardPanel Title="@Text["RecentQuotations"]"
                                Subtitle="@Text["RecentQuotationsSubtitle"]"
                                NavigateTo="/Quotations/Index"
                                LinkText="@Text["ViewAll"]"
                                Class="dashboard-wide-panel">
                    <div class="dashboard-table-scroll">
                        <ShadcnTable Class="dashboard-table dashboard-table-compact" ExpectedColumnCount="6" data-projection="dashboard-quotations">
                            <ShadcnTableCaption Class="sr-only">@Text["RecentQuotations"]</ShadcnTableCaption>
                            <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Quote"]</ShadcnTableHead><ShadcnTableHead>@Text["Total"]</ShadcnTableHead><ShadcnTableHead>@Text["QuotedAmount"]</ShadcnTableHead><ShadcnTableHead>@Text["Expires"]</ShadcnTableHead><ShadcnTableHead>@Text["CreatedDate"]</ShadcnTableHead><ShadcnTableHead>@Text["Decision"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                            <ShadcnTableBody>
                                @foreach (var quotation in _snapshot.RecentQuotations)
                                {
                                    <ShadcnTableRow>
                                        <ShadcnTableCell data-label="@Text["Quote"]" data-field="Id NavigateTo" class="mlv-mono"><LegacyLink Href="@quotation.NavigateTo" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["Quote"]} #{quotation.Id}")">#@quotation.Id</LegacyLink></ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Total"]" data-field="Total CurrencyId" class="dashboard-money mlv-mono">@FormatMoney(quotation.Total, quotation.CurrencyId)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["QuotedAmount"]" data-field="QuotedAmount" class="dashboard-money mlv-mono">@(quotation.QuotedAmount is decimal quotedAmount ? FormatMoney(quotedAmount, quotation.CurrencyId) : "—")</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Expires"]" data-field="ExpirationDate" class="mlv-mono">@FormatDate(quotation.ExpirationDate)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["CreatedDate"]" data-field="CreatedDate" class="mlv-mono">@FormatDate(quotation.CreatedDate)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Decision"]" data-field="Accepted"><span class="dashboard-status mlv-mono @DecisionClass(quotation.Accepted)">@Decision(quotation.Accepted)</span></ShadcnTableCell>
                                    </ShadcnTableRow>
                                }
                            </ShadcnTableBody>
                        </ShadcnTable>
                    </div>
                </DashboardPanel>
            }
        </div>

        <div class="dashboard-primary-grid">
            @if (_snapshot.RecentPayments.Count > 0)
            {
                <DashboardPanel Title="@Text["RecentPayments"]"
                                Subtitle="@Text["RecentPaymentsSubtitle"]"
                                NavigateTo="/Finances/Index"
                                LinkText="@Text["ViewAll"]">
                    <div class="dashboard-table-scroll">
                        <ShadcnTable Class="dashboard-table dashboard-table-compact" ExpectedColumnCount="5" data-projection="dashboard-payments">
                            <ShadcnTableCaption Class="sr-only">@Text["RecentPayments"]</ShadcnTableCaption>
                            <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Payment"]</ShadcnTableHead><ShadcnTableHead>@Text["Recipient"]</ShadcnTableHead><ShadcnTableHead>@Text["Amount"]</ShadcnTableHead><ShadcnTableHead>@Text["PaymentDate"]</ShadcnTableHead><ShadcnTableHead>@Text["CreatedDate"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                            <ShadcnTableBody>
                                @foreach (var payment in _snapshot.RecentPayments)
                                {
                                    <ShadcnTableRow>
                                        <ShadcnTableCell data-label="@Text["Payment"]" data-field="Id NavigateTo" class="mlv-mono"><LegacyLink Href="@payment.NavigateTo" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["Payment"]} #{payment.Id}")">#@payment.Id</LegacyLink></ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Recipient"]" data-field="Recipient" class="dashboard-table-primary">@(string.IsNullOrWhiteSpace(payment.Recipient) ? "—" : payment.Recipient)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Amount"]" data-field="Amount CurrencyId" class="dashboard-money mlv-mono">@FormatMoney(payment.Amount, payment.CurrencyId)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["PaymentDate"]" data-field="PaymentDate" class="mlv-mono">@FormatDate(payment.PaymentDate)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["CreatedDate"]" data-field="CreatedDate" class="mlv-mono">@FormatDate(payment.CreatedDate)</ShadcnTableCell>
                                    </ShadcnTableRow>
                                }
                            </ShadcnTableBody>
                        </ShadcnTable>
                    </div>
                </DashboardPanel>
            }

            @if (_snapshot.RecentCustomers.Count > 0)
            {
                <DashboardPanel Title="@Text["RecentCustomers"]"
                                Subtitle="@Text["RecentCustomersSubtitle"]"
                                NavigateTo="/customers"
                                LinkText="@Text["ViewAll"]">
                    <div class="dashboard-table-scroll">
                        <ShadcnTable Class="dashboard-table dashboard-table-compact" ExpectedColumnCount="3" data-projection="dashboard-customers">
                            <ShadcnTableCaption Class="sr-only">@Text["RecentCustomers"]</ShadcnTableCaption>
                            <ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["Customer"]</ShadcnTableHead><ShadcnTableHead>@Text["Company"]</ShadcnTableHead><ShadcnTableHead>@Text["Email"]</ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader>
                            <ShadcnTableBody>
                                @foreach (var customer in _snapshot.RecentCustomers)
                                {
                                    <ShadcnTableRow>
                                        <ShadcnTableCell data-label="@Text["Customer"]" data-field="Id FullName NavigateTo"><LegacyLink Href="@customer.NavigateTo" Role="LegacyLinkRole.Record" AriaLabel="@customer.FullName">@customer.FullName</LegacyLink></ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Company"]" data-field="Company" class="dashboard-table-primary">@(string.IsNullOrWhiteSpace(customer.Company) ? "—" : customer.Company)</ShadcnTableCell>
                                        <ShadcnTableCell data-label="@Text["Email"]" data-field="Email">@customer.Email</ShadcnTableCell>
                                    </ShadcnTableRow>
                                }
                            </ShadcnTableBody>
                        </ShadcnTable>
                    </div>
                </DashboardPanel>
            }
        </div>

        <div class="dashboard-secondary-grid">
            @if (_snapshot.RecentActivity.Count > 0)
            {
                <DashboardPanel Title="@Text["RecentActivity"]" Subtitle="@Text["RecentActivitySubtitle"]">
                    <ol class="dashboard-activity-list">
                        @foreach (var activity in _snapshot.RecentActivity)
                        {
                            <li>
                                <span class="dashboard-activity-icon" aria-hidden="true"><ShadcnIcon Icon="@ActivityIcon(activity.Kind)" Size="20" /></span>
                                <div>
                                    <LegacyLink Href="@activity.NavigateTo" Role="LegacyLinkRole.Record" AriaLabel="@ActivityTitle(activity)">@ActivityTitle(activity)</LegacyLink>
                                    <span>@ActivityDetail(activity)</span>
                                </div>
                                <time datetime="@DateTimeAttribute(activity.OccurredAt)">@FormatRelativeDate(activity.OccurredAt)</time>
                            </li>
                        }
                    </ol>
                </DashboardPanel>
            }

            @if (_snapshot.MonthlyFinance.Count > 0)
            {
                <DashboardPanel Title="@Text["FinancialSnapshot"]" Subtitle="@Text["FinancialSnapshotSubtitle"]" NavigateTo="/Finances/Index" LinkText="@Text["ViewAll"]">
                    <div class="dashboard-finance-grid">
                        @foreach (var detail in _snapshot.MonthlyFinance)
                        {
                            <article>
                                <span>@CurrencyName(detail.CurrencyId)</span>
                                <strong>@FormatMoney(detail.CurrentAmount, detail.CurrencyId)</strong>
                                <small class="@(detail.DeltaAmount >= 0 ? "is-positive" : "is-negative")">
                                    @Text["ComparedWithPrevious", SignedPercent(detail.DeltaPercent)]
                                </small>
                            </article>
                        }
                    </div>
                </DashboardPanel>
            }

            @if (_snapshot.QuotationSummary is not null)
            {
                var quotationTotal = _snapshot.QuotationSummary.Accepted + _snapshot.QuotationSummary.Declined + _snapshot.QuotationSummary.Open;
                <DashboardPanel Title="@Text["QuotationDecisions"]" Subtitle="@Text["QuotationDecisionsSubtitle"]" NavigateTo="/Quotations/Index" LinkText="@Text["ViewAll"]">
                    @if (quotationTotal == 0)
                    {
                        <p class="dashboard-panel-empty">@Text["NoQuotationDecisions"]</p>
                    }
                    else
                    {
                        <div class="dashboard-decision-summary">
                            <ShadcnChart Id="quotation-decisions"
                                         Class="dashboard-decision-chart"
                                         Type="ShadcnChartType.Donut"
                                         Config="@QuotationDecisionChartConfig"
                                         Categories="@QuotationDecisionCategories"
                                         Series="@QuotationDecisionSeries"
                                         Title="@Text["QuotationDecisions"]"
                                         ShowAxis="false"
                                         ShowTicks="false"
                                         ShowGrid="false"
                                         ShowLegend="false"
                                         Animated="false"
                                         InitialWidth="104"
                                         InitialHeight="104" />
                            <div class="dashboard-decision-total" aria-hidden="true"><strong>@quotationTotal.ToString("N0")</strong><span>@Text["Total"]</span></div>
                            <ul class="dashboard-decision-legend" data-slot="chart-legend">
                                <li data-slot="chart-legend-item"><span class="shadcn-chart-legend-icon is-accepted"></span><span>@Text["Accepted"]</span><strong>@_snapshot.QuotationSummary.Accepted.ToString("N0")</strong><small>@Percent(_snapshot.QuotationSummary.Accepted, quotationTotal)</small></li>
                                <li data-slot="chart-legend-item"><span class="shadcn-chart-legend-icon is-declined"></span><span>@Text["Declined"]</span><strong>@_snapshot.QuotationSummary.Declined.ToString("N0")</strong><small>@Percent(_snapshot.QuotationSummary.Declined, quotationTotal)</small></li>
                                <li data-slot="chart-legend-item"><span class="shadcn-chart-legend-icon is-open"></span><span>@Text["Open"]</span><strong>@_snapshot.QuotationSummary.Open.ToString("N0")</strong><small>@Percent(_snapshot.QuotationSummary.Open, quotationTotal)</small></li>
                            </ul>
                        </div>
                    }
                </DashboardPanel>
            }

            @if (_snapshot.RecentOrders.Count > 0)
            {
                <DashboardPanel Title="@Text["RecentOrderProgress"]" Subtitle="@Text["RecentOrderProgressSubtitle"]" NavigateTo="/sales/orders" LinkText="@Text["ViewAll"]">
                    <div class="dashboard-progress-summary">
                        @foreach (var status in OrderProgress)
                        {
                            <div>
                                <span><i class="dashboard-dot @status.Class"></i>@status.Label</span>
                                <strong>@status.Count.ToString("N0")</strong>
                            </div>
                        }
                    </div>
                </DashboardPanel>
            }
        </div>
    }
</main>

@code {
    private static readonly TimeSpan BangkokOffset = TimeSpan.FromHours(7);
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(15);
    private static readonly ShadcnIconData RefreshIcon = LucideIconCatalog.Instance.Get(LucideIconNames.RefreshCw);
    private static readonly ShadcnIconData InvoiceIcon = LucideIconCatalog.Instance.Get(LucideIconNames.ReceiptText);
    private static readonly ShadcnIconData QuotationRequestIcon = LucideIconCatalog.Instance.Get(LucideIconNames.Mail);
    private static readonly ShadcnIconData NotificationIcon = LucideIconCatalog.Instance.Get(LucideIconNames.Badge);
    private static readonly ShadcnIconData WarningIcon = LucideIconCatalog.Instance.Get(LucideIconNames.TriangleAlert);
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs => [new(Text["Dashboard"])];
    private LegacyDashboardSnapshot? _snapshot;
    private string? _error;
    private bool _loading = true;
    private DotNetObjectReference<Dashboard>? _selfReference;
    private int? _refreshHandle;

    private ShadcnChartConfig QuotationDecisionChartConfig => new()
    {
        ["accepted"] = new(Text["Accepted"]) { Color = "var(--shadcn-chart-2)" },
        ["declined"] = new(Text["Declined"]) { Color = "var(--shadcn-destructive)" },
        ["open"] = new(Text["Open"]) { Color = "var(--shadcn-chart-4)" },
    };

    private static readonly string[] QuotationDecisionCategories = ["Total"];
    private IReadOnlyList<ShadcnChartSeries> QuotationDecisionSeries =>
    [
        new("accepted", [(double)(_snapshot?.QuotationSummary?.Accepted ?? 0)]),
        new("declined", [(double)(_snapshot?.QuotationSummary?.Declined ?? 0)]),
        new("open", [(double)(_snapshot?.QuotationSummary?.Open ?? 0)]),
    ];

    private bool HasOperationalContent => _snapshot is not null &&
        (_snapshot.RecentOrders.Count > 0 || _snapshot.RecentQuotations.Count > 0 ||
         _snapshot.RecentCustomers.Count > 0 || _snapshot.RecentPayments.Count > 0 ||
         _snapshot.RecentActivity.Count > 0 || _snapshot.MonthlyFinance.Count > 0 ||
         _snapshot.QuotationSummary is not null);

    private IReadOnlyList<(string Label, int Count, string Class)> OrderProgress
    {
        get
        {
            var orders = _snapshot?.RecentOrders ?? [];
            return
            [
                (Text["Completed"].Value, orders.Count(order => Remaining(order) <= 0), "is-complete"),
                (Text["InProgress"].Value, orders.Count(order => Remaining(order) > 0 && order.Manufactured > 0), "is-progress"),
                (Text["Queued"].Value, orders.Count(order => Remaining(order) > 0 && order.Manufactured <= 0), "is-queued"),
            ];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            _refreshHandle = await JS.InvokeAsync<int>(
                "malievDashboardRefresh.start",
                _selfReference,
                RefreshInterval.TotalMilliseconds);
        }
    }

    private Task RefreshAsync() => LoadAsync(showLoading: false);

    private async Task LoadAsync(bool showLoading = true)
    {
        if (showLoading)
        {
            _loading = true;
        }
        _error = null;
        try
        {
            using var response = await Http.GetForPresentationAsync("/bff/dashboard");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _error = Text["DashboardUnavailable"];
                return;
            }

            _snapshot = await response.Content.ReadFromJsonAsync<LegacyDashboardSnapshot>();
            _error = _snapshot is null ? Text["InvalidDashboardResponse"].Value : null;
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _error = Text["DashboardUnavailable"];
        }
        finally
        {
            if (showLoading)
            {
                _loading = false;
            }
        }
    }

    [JSInvokable]
    public async Task RefreshFromBrowserAsync()
    {
        await LoadAsync(showLoading: false);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshHandle is int refreshHandle)
        {
            await JS.InvokeVoidAsync("malievDashboardRefresh.stop", refreshHandle);
        }

        _selfReference?.Dispose();
    }

    private static ShadcnIconData ActivityIcon(string kind) => kind switch
    {
        "invoice" => InvoiceIcon,
        "quotation-request" => QuotationRequestIcon,
        _ => NotificationIcon,
    };

    private string ActivityTitle(LegacyDashboardActivity activity) => string.IsNullOrWhiteSpace(activity.Title)
        ? Text[activity.Kind == "invoice" ? "InvoiceNumber" : "RequestNumber", ActivityId(activity.NavigateTo)]
        : activity.Title;

    private string ActivityDetail(LegacyDashboardActivity activity) => Text[$"Activity_{activity.Kind}_{activity.State}"];

    private static string ActivityId(string navigateTo)
    {
        var marker = navigateTo.LastIndexOf('=');
        return marker >= 0 && marker < navigateTo.Length - 1 ? navigateTo[(marker + 1)..] : "—";
    }

    private static int Remaining(LegacyDashboardOrder order) => order.Remaining ?? Math.Max(0, order.Quantity - order.Manufactured);

    private string OrderStatus(LegacyDashboardOrder order) => Remaining(order) <= 0
        ? Text["Completed"]
        : order.Manufactured > 0 ? Text["InProgress"] : Text["Queued"];

    private static string OrderStatusClass(LegacyDashboardOrder order) => Remaining(order) <= 0
        ? "is-complete"
        : order.Manufactured > 0 ? "is-progress" : "is-queued";

    private string Decision(bool? accepted) => accepted switch { true => Text["Accepted"], false => Text["Declined"], null => Text["Open"] };
    private static string DecisionClass(bool? accepted) => accepted switch { true => "is-complete", false => "is-declined", null => "is-open" };

    private string FormatMoney(decimal value, int currencyId) => Text["MoneyFormat", value.ToString("N2", System.Globalization.CultureInfo.CurrentCulture), CurrencyName(currencyId)];
    private string FormatMoney(decimal value, int? currencyId) => currencyId is int valueId
        ? FormatMoney(value, valueId)
        : Text["MoneyFormat", value.ToString("N2", System.Globalization.CultureInfo.CurrentCulture), Text["CurrencyUnavailable"]];
    private string FormatMoney(decimal value, string currencyId) => Text["MoneyFormat", value.ToString("N2", System.Globalization.CultureInfo.CurrentCulture), CurrencyName(currencyId)];
    private string CurrencyName(int currencyId)
    {
        if (_snapshot is null ||
            !_snapshot.CurrencyCodes.TryGetValue(currencyId, out var currencyCode) ||
            string.IsNullOrWhiteSpace(currencyCode))
        {
            return Text["CurrencyUnavailable"];
        }

        return LocalizeCurrencyCode(currencyCode);
    }
    private string CurrencyName(string currencyId) => int.TryParse(currencyId, out var numericId)
        ? CurrencyName(numericId)
        : LocalizeCurrencyCode(currencyId);
    private static string LocalizeCurrencyCode(string currencyCode) =>
        currencyCode.Equals("THB", StringComparison.OrdinalIgnoreCase) &&
        System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th"
            ? "บาท"
            : currencyCode.ToUpperInvariant();
    private static string Percent(int value, int total) => $"{(total == 0 ? 0m : value * 100m / total).ToString("N1", System.Globalization.CultureInfo.CurrentCulture)}%";
    private static string SignedPercent(decimal value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("N1", System.Globalization.CultureInfo.CurrentCulture)}%";

    private static string FormatTimestamp(DateTimeOffset value) => value.ToOffset(BangkokOffset).ToString("dd MMM yyyy, HH:mm 'ICT'", System.Globalization.CultureInfo.CurrentCulture);
    private static string FormatDate(DateTime? value) => value is null ? "—" : Bangkok(value.Value).ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
    private static string FormatDate(DateTime value) => Bangkok(value).ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
    private static string DateTimeAttribute(DateTime? value) => value is null ? string.Empty : Bangkok(value.Value).ToString("O");

    private string FormatRelativeDate(DateTime? value)
    {
        if (value is null)
        {
            return Text["DateUnavailable"];
        }

        return Bangkok(value.Value).ToString("dd MMM, HH:mm", System.Globalization.CultureInfo.CurrentCulture);
    }

    private static DateTimeOffset Bangkok(DateTime value)
    {
        var utc = value.Kind == DateTimeKind.Utc ? value : DateTime.SpecifyKind(value, DateTimeKind.Utc);
        return new DateTimeOffset(utc).ToOffset(BangkokOffset);
    }
}
