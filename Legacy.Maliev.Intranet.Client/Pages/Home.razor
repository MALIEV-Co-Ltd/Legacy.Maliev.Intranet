@page "/"
@page "/Index"
@attribute [AllowAnonymous]
@inject Microsoft.Extensions.Localization.IStringLocalizer<Home> Text
@inject EmployeeSessionClient SessionClient
@inject NavigationManager Navigation

<PageTitle>@Text["PageTitle"]</PageTitle>

@if (_checkingSession)
{
    <div class="legacy-content-container py-8" aria-busy="true">
        <ShadcnProgress Label="@Text["CheckingSession"]" />
    </div>
}
else
{
    <div class="legacy-content-container py-8">
        <ShadcnCard Class="pa-8 text-center">
            <ShadcnCardContent>
                <ShadcnTypography Variant="ShadcnTypographyVariant.Small">@Text["Eyebrow"]</ShadcnTypography>
                <ShadcnTypography Variant="ShadcnTypographyVariant.H1" Class="mb-3">@Text["Heading"]</ShadcnTypography>
                <ShadcnTypography Class="mb-6">@Text["Description"]</ShadcnTypography>
                <ShadcnButton Href="/Login" Size="ShadcnButtonSize.Large">@Text["SignIn"]</ShadcnButton>
            </ShadcnCardContent>
        </ShadcnCard>
    </div>
}

@code {
    private bool _checkingSession = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var session = await SessionClient.GetAsync();
            if (session?.IsAuthenticated == true)
            {
                Navigation.NavigateTo("/Dashboard", replace: true);
                return;
            }
        }
        finally
        {
            _checkingSession = false;
        }
    }
}
