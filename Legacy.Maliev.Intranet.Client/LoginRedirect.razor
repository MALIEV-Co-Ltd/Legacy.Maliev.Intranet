@inject NavigationManager Navigation
@inject IStringLocalizer<LoginRedirect> Text

<div class="pa-6 d-flex flex-column align-center gap-2" role="status">
    <ShadcnSpinner Label="@Text["Redirecting"]" Size="1.5rem" />
    <ShadcnTypography Variant="ShadcnTypographyVariant.Muted">@Text["Redirecting"]</ShadcnTypography>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var returnPath = "/" + relativePath;
        Navigation.NavigateTo(
            $"/Login?returnUrl={Uri.EscapeDataString(returnPath)}",
            new NavigationOptions { ReplaceHistoryEntry = true });
    }
}
