@using Legacy.Maliev.Intranet.Client.Pages

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@lazyAssemblies" OnNavigateAsync="LoadFeatureAssemblyAsync">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        <LayoutView Layout="@typeof(Layout.MainLayout)">
                            <AccessDenied />
                        </LayoutView>
                    }
                    else
                    {
                        <LoginRedirect />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="#main-content" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private readonly List<System.Reflection.Assembly> lazyAssemblies = [];
    private readonly HashSet<string> loadedFeatureAssemblies = new(StringComparer.Ordinal);

    [Inject] private Microsoft.AspNetCore.Components.WebAssembly.Services.LazyAssemblyLoader AssemblyLoader { get; set; } = default!;

    private async Task LoadFeatureAssemblyAsync(Microsoft.AspNetCore.Components.Routing.NavigationContext context)
    {
        var path = context.Path.TrimStart('/');
        var assemblyName = path.StartsWith("Materials/", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("mfg/materials", StringComparison.OrdinalIgnoreCase)
            ? "Legacy.Maliev.Intranet.Client.Features.Catalog.wasm"
            : path.StartsWith("Server/", StringComparison.OrdinalIgnoreCase)
                ? "Legacy.Maliev.Intranet.Client.Features.Diagnostics.wasm"
                : path.StartsWith("Finances/", StringComparison.OrdinalIgnoreCase)
                    ? "Legacy.Maliev.Intranet.Client.Features.Accounting.wasm"
                    : path.StartsWith("Invoices/", StringComparison.OrdinalIgnoreCase) ||
                        path.Equals("accounting", StringComparison.OrdinalIgnoreCase) ||
                        path.StartsWith("accounting/", StringComparison.OrdinalIgnoreCase) ||
                        path.Equals("finance/invoices", StringComparison.OrdinalIgnoreCase)
                        ? "Legacy.Maliev.Intranet.Client.Features.Accounting.wasm"
                    : path.StartsWith("QuotationRequests/", StringComparison.OrdinalIgnoreCase)
                        ? "Legacy.Maliev.Intranet.Client.Features.Quotations.wasm"
                        : path.StartsWith("Quotations/", StringComparison.OrdinalIgnoreCase)
                            ? "Legacy.Maliev.Intranet.Client.Features.Quotations.wasm"
                    : path.StartsWith("Customers/", StringComparison.OrdinalIgnoreCase) ||
                        path.StartsWith("customers", StringComparison.OrdinalIgnoreCase) ||
                        path.StartsWith("sales/customers", StringComparison.OrdinalIgnoreCase)
                        ? "Legacy.Maliev.Intranet.Client.Features.Customers.wasm"
                : path.StartsWith("Employees/", StringComparison.OrdinalIgnoreCase) ||
                    path.StartsWith("employees", StringComparison.OrdinalIgnoreCase) ||
                    path.StartsWith("hr/directory", StringComparison.OrdinalIgnoreCase) ||
                    path.StartsWith("hr/profile", StringComparison.OrdinalIgnoreCase)
                    ? "Legacy.Maliev.Intranet.Client.Features.Employees.wasm"
                    : path.StartsWith("Orders/", StringComparison.OrdinalIgnoreCase) ||
                        path.StartsWith("sales/orders", StringComparison.OrdinalIgnoreCase)
                        ? "Legacy.Maliev.Intranet.Client.Features.Orders.wasm"
                        : path.StartsWith("Suppliers/", StringComparison.OrdinalIgnoreCase) ||
                            path.StartsWith("purchasing/suppliers", StringComparison.OrdinalIgnoreCase)
                            ? "Legacy.Maliev.Intranet.Client.Features.Procurement.wasm"
                            : path.StartsWith("PurchaseOrders/", StringComparison.OrdinalIgnoreCase) ||
                                path.StartsWith("purchasing", StringComparison.OrdinalIgnoreCase)
                                ? "Legacy.Maliev.Intranet.Client.Features.Procurement.wasm"
                                : null;
        if (assemblyName is not null && loadedFeatureAssemblies.Add(assemblyName))
        {
            context.CancellationToken.ThrowIfCancellationRequested();
            lazyAssemblies.AddRange(await AssemblyLoader.LoadAssembliesAsync(
                [assemblyName]));
            context.CancellationToken.ThrowIfCancellationRequested();
        }
    }
}
