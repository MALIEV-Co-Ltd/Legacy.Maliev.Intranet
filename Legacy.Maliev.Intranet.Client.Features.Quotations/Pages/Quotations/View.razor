@page "/Quotations/View"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<View> Text
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@Text["PageTitle", Id ?? 0]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    @if (loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" />
            <span class="sr-only">@Text["Loading"]</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <MudButton OnClick="LoadAsync" Variant="Variant.Filled" Color="Color.Primary">@Text["Retry"]</MudButton>
            <LegacyLink Href="/Quotations/Index" Role="LegacyLinkRole.Navigation" StartIcon="@Icons.Material.Filled.ArrowBack" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
        </div>
    }
    else if (page is not null)
    {
        <header class="operations-page-header">
            <div>
                <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Heading", page.Quotation.Id]</MudText>
                <MudText Typo="Typo.body1">@Text["Description"]</MudText>
            </div>
            <div class="d-flex flex-wrap gap-2" aria-label="@Text["Actions"]">
                @if (page.Files.LastOrDefault()?.Uri is Uri quotationUri)
                {
                    <MudButton Href="@quotationUri.ToString()" Target="_blank" Rel="noopener" Variant="Variant.Filled" Color="Color.Primary">@Text["ViewPdf"]</MudButton>
                }
                <LegacyLink Href="/Quotations/Index" Role="LegacyLinkRole.Navigation" StartIcon="@Icons.Material.Filled.ArrowBack" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink>
            </div>
        </header>

        @if (canDecide)
        {
            <MudPaper Class="pa-4 mb-4" aria-busy="@decisionBusy.ToString().ToLowerInvariant()">
                <MudText Typo="Typo.h6" HtmlTag="h2">@Text["DecisionActions"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@Text["DecisionHelp"]</MudText>
                @if (!string.IsNullOrWhiteSpace(decisionMessage))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3" aria-live="polite">@Text[decisionMessage]</MudAlert>
                }
                @if (!string.IsNullOrWhiteSpace(decisionError))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" aria-live="assertive">
                        @if (decisionError == "DecisionPartial" && decisionResult is not null)
                        {
                            @Text[decisionError, decisionResult.CompletedOrders, decisionResult.TotalOrders]
                        }
                        else if (decisionError == "DecisionRateLimited")
                        {
                            @Text[decisionError, retryAfterSeconds]
                        }
                        else
                        {
                            @Text[decisionError]
                        }
                    </MudAlert>
                }
                @if (pendingDecision is bool decision)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3" aria-live="polite">
                        <MudText Typo="Typo.subtitle2">@Text["ConfirmDecision"]</MudText>
                        <MudText Typo="Typo.body2">@Text[decision ? "ConfirmAccept" : "ConfirmDecline"]</MudText>
                    </MudAlert>
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton OnClick="SubmitDecisionAsync" Disabled="decisionBusy" Variant="Variant.Filled" Color="@(decision ? Color.Success : Color.Error)">@Text[string.IsNullOrWhiteSpace(decisionError) ? "ConfirmDecision" : "RetryDecision"]</MudButton>
                        <MudButton OnClick="CancelDecision" Disabled="decisionBusy" Variant="Variant.Outlined">@Text["Cancel"]</MudButton>
                        @if (!string.IsNullOrWhiteSpace(decisionError))
                        {
                            <MudButton OnClick="LoadAsync" Disabled="decisionBusy" Variant="Variant.Text">@Text["ReloadQuotation"]</MudButton>
                        }
                    </div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        <MudButton OnClick="@(() => BeginDecision(true))" Disabled="decisionBusy" Variant="Variant.Filled" Color="Color.Success">@Text["AcceptQuotation"]</MudButton>
                        <MudButton OnClick="@(() => BeginDecision(false))" Disabled="decisionBusy" Variant="Variant.Outlined" Color="Color.Error">@Text["DeclineQuotation"]</MudButton>
                    </div>
                }
            </MudPaper>
        }

        <MudGrid>
            <MudItem xs="12" md="7">
                <section aria-labelledby="quotation-information-heading" class="h-100">
                    <MudPaper Class="pa-4 h-100">
                        <MudText id="quotation-information-heading" Typo="Typo.h6" HtmlTag="h2">@Text["Quotation"]</MudText>
                        <dl class="quotation-detail-list">
                            <div><dt>@Text["CreatedLabel"]</dt><dd>@FormatTimestamp(page.Quotation.CreatedDate)</dd></div>
                            <div><dt>@Text["ModifiedLabel"]</dt><dd>@FormatTimestamp(page.Quotation.ModifiedDate)</dd></div>
                            <div><dt>@Text["EmployeeLabel"]</dt><dd>@(page.Employee?.FullName ?? "-")</dd></div>
                            <div><dt>@Text["PeriodLabel"]</dt><dd>@Text["PeriodValue", page.Quotation.Period]</dd></div>
                            <div><dt>@Text["ExpirationLabel"]</dt><dd>@FormatDate(page.Quotation.ExpirationDate)</dd></div>
                            <div><dt>@Text["DecisionLabel"]</dt><dd><span class="@DecisionClass(page.Quotation.Accepted)">@Decision(page.Quotation.Accepted)</span></dd></div>
                        </dl>
                        <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="mt-4">@Text["CommentLabel"]</MudText>
                        <MudText Typo="Typo.body2">@Value(page.Quotation.Comment)</MudText>
                    </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12" md="5">
                <section aria-labelledby="quotation-customer-heading" class="h-100">
                    <MudPaper Class="pa-4 h-100">
                        <MudText id="quotation-customer-heading" Typo="Typo.h6" HtmlTag="h2">@Text["Customer"]</MudText>
                        @if (page.Customer is null)
                        {
                            <MudText>@Text["NoCustomer"]</MudText>
                        }
                        else
                        {
                            <dl class="quotation-detail-list">
                                <div><dt>@Text["CustomerNameLabel"]</dt><dd><LegacyLink Href="@($"/Customers/View?id={page.Customer.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@(page.Customer.FullName)">@(page.Customer.FullName)</LegacyLink></dd></div>
                                <div><dt>@Text["EmailLabel"]</dt><dd>@Value(page.Customer.Email)</dd></div>
                                <div><dt>@Text["TelephoneLabel"]</dt><dd>@Value(page.Customer.Telephone)</dd></div>
                                <div><dt>@Text["MobileLabel"]</dt><dd>@Value(page.Customer.Mobile)</dd></div>
                                <div><dt>@Text["FaxLabel"]</dt><dd>@Value(page.Customer.Fax)</dd></div>
                            </dl>
                        }
                    </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12">
                <section aria-labelledby="quotation-pricing-heading">
                    <MudPaper Class="pa-4">
                        <MudText id="quotation-pricing-heading" Typo="Typo.h6" HtmlTag="h2">@Text["Pricing"]</MudText>
                        <dl class="quotation-price-grid">
                            <div><dt>@Text["Subtotal"]</dt><dd>@Money(page.Quotation.Subtotal)</dd></div>
                            <div><dt>@Text["Vat"]</dt><dd>@Money(page.Quotation.Vat)</dd></div>
                            <div><dt>@Text["Withholding"]</dt><dd>@Money(-(page.Quotation.WithholdingTax ?? 0m))</dd></div>
                            <div class="quotation-price-total"><dt>@Text["Total"]</dt><dd>@Money(page.Quotation.QuotedAmount ?? page.Quotation.Total)</dd></div>
                        </dl>
                        @if (page.Invoice is not null)
                        {
                            <MudText Class="mt-3">@Text["Invoice"] <LegacyLink Href="@($"/Invoices/View?id={page.Invoice.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["Invoice"]} {page.Invoice.Number}")">@(page.Invoice.Number)</LegacyLink></MudText>
                        }
                    </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12" md="6">
                <section aria-labelledby="quotation-orders-heading" class="h-100">
                    <MudPaper Class="pa-4 h-100">
                        <MudText id="quotation-orders-heading" Typo="Typo.h6" HtmlTag="h2">@Text["Orders"]</MudText>
                        @if (page.Orders.Count == 0)
                        {
                            <MudText>@Text["NoOrders"]</MudText>
                        }
                        else
                        {
                            <MudList T="QuotationOrderLink">
                                @foreach (var order in page.Orders)
                                {
                                    <MudListItem T="QuotationOrderLink" Value="order"><LegacyLink Href="@($"/Orders/View?id={order.OrderId}")" Role="LegacyLinkRole.Record" AriaLabel="@Text["Order", order.OrderId]">@Text["Order", order.OrderId]</LegacyLink></MudListItem>
                                }
                            </MudList>
                        }
                    </MudPaper>
                </section>
            </MudItem>

            <MudItem xs="12" md="6">
                <section aria-labelledby="quotation-files-heading" class="h-100">
                    <MudPaper Class="pa-4 h-100">
                        <MudText id="quotation-files-heading" Typo="Typo.h6" HtmlTag="h2">@Text["Files"]</MudText>
                        @if (page.Files.Count == 0)
                        {
                            <MudText>@Text["NoFiles"]</MudText>
                        }
                        else
                        {
                            <MudList T="QuotationFile">
                                @foreach (var file in page.Files)
                                {
                                    <MudListItem T="QuotationFile" Value="file">
                                        @if (file.Uri is null)
                                        {
                                            <MudText>@file.ObjectName</MudText>
                                        }
                                        else
                                        {
                                            <LegacyLink Href="@file.Uri.ToString()" Role="LegacyLinkRole.External" Target="_blank" Rel="noopener">@file.ObjectName</LegacyLink>
                                        }
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudPaper>
                </section>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }
    private QuotationDetailPage? page;
    private bool loading = true;
    private string? error;
    private bool canDecide;
    private bool? pendingDecision;
    private bool decisionBusy;
    private string? decisionMessage;
    private string? decisionError;
    private int retryAfterSeconds;
    private QuotationDecisionResult? decisionResult;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        pendingDecision = null;
        decisionMessage = null;
        decisionError = null;
        decisionResult = null;
        retryAfterSeconds = 0;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canDecide = authenticationState.User.Claims.Any(claim =>
            claim.Type == "permissions" && claim.Value == LegacyQuotationPermissions.Update);
        if (Id is not > 0)
        {
            error = Text["InvalidId"];
            loading = false;
            return;
        }
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/quotations/{Id.Value}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                error = Text["NotFound"];
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode == HttpStatusCode.Forbidden ? Text["Forbidden"] : Text["Unavailable"];
                return;
            }
            page = await response.Content.ReadFromJsonAsync<QuotationDetailPage>();
            if (page is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private void BeginDecision(bool accepted)
    {
        if (!canDecide || decisionBusy) return;
        pendingDecision = accepted;
        decisionMessage = null;
        decisionError = null;
        decisionResult = null;
        retryAfterSeconds = 0;
    }

    private void CancelDecision()
    {
        if (decisionBusy) return;
        pendingDecision = null;
        decisionError = null;
        decisionResult = null;
        retryAfterSeconds = 0;
    }

    private async Task SubmitDecisionAsync()
    {
        if (!canDecide || decisionBusy || pendingDecision is not bool accepted || Id is not > 0 || page is null) return;

        decisionBusy = true;
        decisionMessage = null;
        decisionError = null;
        decisionResult = null;
        retryAfterSeconds = 0;
        try
        {
            using var sessionResponse = await Http.GetForPresentationAsync("/bff/session");
            if (sessionResponse.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }
            if (!sessionResponse.IsSuccessStatusCode)
            {
                decisionError = "DecisionUnavailable";
                return;
            }

            var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>();
            if (session is null || !session.IsAuthenticated || string.IsNullOrWhiteSpace(session.CsrfToken))
            {
                decisionError = "DecisionInvalidResponse";
                return;
            }
            if (session.Permissions?.Contains(LegacyQuotationPermissions.Update, StringComparer.Ordinal) != true)
            {
                canDecide = false;
                decisionError = "DecisionForbidden";
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/quotations/{Id.Value}/decision")
            {
                Content = JsonContent.Create(new QuotationDecisionInput(accepted, page.Quotation.ModifiedDate)),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                canDecide = false;
                decisionError = "DecisionForbidden";
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                decisionError = "NotFound";
                return;
            }
            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                retryAfterSeconds = BoundedRetryAfter(response.Headers.RetryAfter);
                decisionError = "DecisionRateLimited";
                return;
            }
            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                decisionResult = await ReadDecisionResultAsync(response);
                decisionError = decisionResult?.Status == "DependencyConflict" ? "DecisionPartial" : "DecisionConflict";
                return;
            }
            if (response.StatusCode == HttpStatusCode.BadGateway)
            {
                decisionError = "DecisionInvalidResponse";
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                decisionError = "DecisionUnavailable";
                return;
            }

            decisionResult = await ReadDecisionResultAsync(response);
            if (decisionResult is null || decisionResult.Status != "Completed" ||
                decisionResult.CompletedOrders < 0 || decisionResult.TotalOrders < 0 ||
                decisionResult.CompletedOrders > decisionResult.TotalOrders)
            {
                decisionError = "DecisionInvalidResponse";
                return;
            }

            page = page with
            {
                Quotation = page.Quotation with
                {
                    Accepted = accepted,
                    ModifiedDate = decisionResult.ModifiedDate ?? page.Quotation.ModifiedDate,
                },
            };
            pendingDecision = null;
            decisionMessage = "DecisionSucceeded";
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            decisionError = "DecisionUnavailable";
        }
        finally
        {
            decisionBusy = false;
        }
    }

    private async Task<QuotationDecisionResult?> ReadDecisionResultAsync(HttpResponseMessage response)
    {
        try
        {
            return await response.Content.ReadFromJsonAsync<QuotationDecisionResult>();
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private void NavigateToLogin() =>
        Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");

    private static int BoundedRetryAfter(System.Net.Http.Headers.RetryConditionHeaderValue? retryAfter)
    {
        var seconds = retryAfter?.Delta is TimeSpan delta
            ? (int)Math.Ceiling(delta.TotalSeconds)
            : retryAfter?.Date is DateTimeOffset date
                ? (int)Math.Ceiling((date - DateTimeOffset.UtcNow).TotalSeconds)
                : 0;
        return Math.Clamp(seconds, 0, 3600);
    }

    private string Money(decimal value)
    {
        var currency = page?.Currency.ShortName ?? string.Empty;
        if (currency.Equals("THB", StringComparison.OrdinalIgnoreCase) && CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th") currency = "บาท";
        return $"{value:N2} {currency}";
    }
    private string Decision(bool? value) => value switch
    {
        true => Text["Accepted"],
        false => Text["Declined"],
        null => Text["Open"],
    };
    private static string DecisionClass(bool? value) => value switch
    {
        true => "quotation-status quotation-status--accepted",
        false => "quotation-status quotation-status--declined",
        null => "quotation-status quotation-status--open",
    };
    private static string FormatDate(DateTime? value) => LegacyPresentation.FormatCalendarDate(value, CultureInfo.CurrentCulture, "-");
    private static string FormatTimestamp(DateTime? value) => LegacyPresentation.FormatUtcDateTime(value, CultureInfo.CurrentCulture, "-");
    private static string Value(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
