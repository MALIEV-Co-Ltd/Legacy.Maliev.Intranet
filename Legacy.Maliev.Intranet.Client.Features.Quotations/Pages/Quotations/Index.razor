@page "/Quotations/Index"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Index> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="mlv-module-shell quotations-page">
    <div class="mlv-page-body">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header">
        <div>
            <h1>@Text["Quotations"]</h1>
            <p>@Text["Description"]</p>
        </div>
        <div class="quotation-actions" role="group" aria-label="@Text["Actions"]">
            <ShadcnButton Href="/Quotations/Create">@Text["Create"]</ShadcnButton>
            <ShadcnButton Href="/Quotations/Estimate" Variant="ShadcnButtonVariant.Outline">@Text["Estimate"]</ShadcnButton>
        </div>
    </header>

    @if (loading)
    {
        <div role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
    }
    else
    {
        @if (stats.Accepted + stats.Declined + stats.Open > 0)
        {
            <section class="quotation-decision-summary" aria-labelledby="quotation-decision-heading">
                    <h2 id="quotation-decision-heading">@Text["DecisionSummary"]</h2>
                    <div class="quotation-decision-layout">
                        <ShadcnChart Id="quotation-decisions" Type="ShadcnChartType.Donut" Title="@Text["DecisionSummary"]" CategoryLabel="@Text["Decision"]" Config="@decisionConfig" Categories="@decisionLabels" Series="@decisionSeries" ShowLegend="false" InitialWidth="420" InitialHeight="260" />
                        <dl class="quotation-decision-data" aria-label="@Text["DecisionData"]">
                            <div><dt><span class="quotation-status quotation-status--accepted">@Text["Accepted"]</span></dt><dd>@stats.Accepted</dd></div>
                            <div><dt><span class="quotation-status quotation-status--declined">@Text["Declined"]</span></dt><dd>@stats.Declined</dd></div>
                            <div><dt><span class="quotation-status quotation-status--open">@Text["Open"]</span></dt><dd>@stats.Open</dd></div>
                        </dl>
                    </div>
            </section>
        }

        <section class="quotation-table-section" aria-label="@Text["TableCaption"]">
            <OperationalDataTable TItem="QuotationListItem"
                                  Items="@(page.Items)"
                                  Columns="@Columns"
                                  RowKey="@(quotation => quotation.Id.ToString(CultureInfo.InvariantCulture))"
                                  State="@dataTableState"
                                  StateChanged="HandleDataTableStateChangedAsync"
                                  RequestChanged="HandleDataTableRequestAsync"
                                  TotalCount="@(page.TotalRecords)"
                                  FilterPlaceholder="@Text["Search"]"
                                  EmptyText="@Text["NoQuotations"]"
                                  LoadingText="@Text["Loading"]"
                                  ActionsLabel="@Text["Actions"]"
                                  PageSizeOptions="@StandardPageSizes"
                                  DetailHref="@(quotation => $"/Quotations/View?id={quotation.Id}")"
                                  DetailAriaLabel="@(quotation => Text["ViewQuotation", quotation.Id])"
                                  DetailsAriaLabel="@(quotation => Text["ExpandQuotation", quotation.Id])">
                    <QuickViewContent Context="quotation">
                        <dl class="quotation-quick-view">
                            <div><dt>@Text["Employee"]</dt><dd>@EmployeeName(quotation.EmployeeId)</dd></div>
                            <div><dt>@Text["Period"]</dt><dd class="quotation-period">@Text["Days", quotation.Period]</dd></div>
                            <div><dt>@Text["ExpirationDate"]</dt><dd class="quotation-date">@FormatDate(quotation.ExpirationDate)</dd></div>
                            <div><dt>@Text["Subtotal"]</dt><dd class="quotation-money mlv-mono">@FormatMoney(quotation.Subtotal, quotation.CurrencyId)</dd></div>
                            <div><dt>@Text["Vat"]</dt><dd class="quotation-money mlv-mono">@FormatMoney(quotation.Vat, quotation.CurrencyId)</dd></div>
                            <div><dt>@Text["WithholdingTax"]</dt><dd class="quotation-money mlv-mono">@FormatMoney(-(quotation.WithholdingTax ?? 0m), quotation.CurrencyId)</dd></div>
                            <div><dt>@Text["Fob"]</dt><dd>@ValueOrFallback(quotation.Fob)</dd></div>
                            <div><dt>@Text["ShippedVia"]</dt><dd>@ValueOrFallback(quotation.ShippedVia)</dd></div>
                            <div><dt>@Text["Terms"]</dt><dd>@ValueOrFallback(quotation.Terms)</dd></div>
                        </dl>
                    </QuickViewContent>
            </OperationalDataTable>
        </section>
    }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int PageIndex { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private static readonly QuotationListPage EmptyPage = new([], 1, 0, 0, false, false);
    private static readonly int[] StandardPageSizes = [10, 25, 50, 100, 250];
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 10 };
    private QuotationListPage page = EmptyPage;
    private QuotationStats stats = new(0, 0, 0);
    private IReadOnlyDictionary<int, string> employees = new Dictionary<int, string>();
    private IReadOnlyDictionary<int, string> currencies = new Dictionary<int, string>();
    private IReadOnlyList<ShadcnChartSeries> decisionSeries = [];
    private string[] decisionLabels = [];
    private ShadcnChartConfig decisionConfig => new()
    {
        ["decision"] = new(Text["DecisionSummary"]) { Color = "var(--shadcn-chart-1)" },
        ["decision-0"] = new(Text["Accepted"]) { Color = "var(--shadcn-chart-2)" },
        ["decision-1"] = new(Text["Declined"]) { Color = "var(--shadcn-chart-5)" },
        ["decision-2"] = new(Text["Open"]) { Color = "var(--shadcn-chart-4)" },
    };
    private QuotationListSort currentSort = QuotationListSort.QuotationCreatedDate_Descending;
    private bool loading;
    private string? error;
    private IReadOnlyList<ShadcnDataTableColumn<QuotationListItem>> Columns =>
    [
        new("id", Text["Id"], quotation => quotation.Id) { Sortable = true, Hideable = false },
        new("customer", Text["CustomerId"], quotation => quotation.CustomerId) { CellTemplate = quotation => CustomerLink(quotation.CustomerId) },
        new("total", Text["Total"], quotation => quotation.Total) { Alignment = ShadcnTableAlignment.End, CellTemplate = quotation => builder => builder.AddContent(0, FormatMoney(quotation.Total, quotation.CurrencyId)) },
        new("quoted", Text["QuotedAmount"], quotation => quotation.QuotedAmount ?? quotation.Total) { Alignment = ShadcnTableAlignment.End, CellTemplate = quotation => builder => builder.AddContent(0, FormatMoney(quotation.QuotedAmount ?? quotation.Total, quotation.CurrencyId)) },
        new("decision", Text["Decision"], quotation => Decision(quotation.Accepted)),
        new("employee", Text["Employee"], quotation => EmployeeName(quotation.EmployeeId)) { MinWidth = "12rem" },
        new("period", Text["Period"], quotation => quotation.Period) { CellTemplate = quotation => builder => builder.AddContent(0, Text["Days", quotation.Period]) },
        new("expiration", Text["ExpirationDate"], quotation => quotation.ExpirationDate) { CellTemplate = quotation => builder => builder.AddContent(0, FormatDate(quotation.ExpirationDate)) },
        new("subtotal", Text["Subtotal"], quotation => quotation.Subtotal) { Alignment = ShadcnTableAlignment.End, CellTemplate = quotation => builder => builder.AddContent(0, FormatMoney(quotation.Subtotal, quotation.CurrencyId)) },
        new("vat", Text["Vat"], quotation => quotation.Vat) { Alignment = ShadcnTableAlignment.End, CellTemplate = quotation => builder => builder.AddContent(0, FormatMoney(quotation.Vat, quotation.CurrencyId)) },
        new("withholding", Text["WithholdingTax"], quotation => quotation.WithholdingTax) { Alignment = ShadcnTableAlignment.End, CellTemplate = quotation => builder => builder.AddContent(0, FormatMoney(-(quotation.WithholdingTax ?? 0m), quotation.CurrencyId)) },
        new("fob", Text["Fob"], quotation => ValueOrFallback(quotation.Fob)),
        new("shipped", Text["ShippedVia"], quotation => ValueOrFallback(quotation.ShippedVia)),
        new("terms", Text["Terms"], quotation => ValueOrFallback(quotation.Terms)) { MinWidth = "12rem" },
        new("created", Text["CreatedDate"], quotation => quotation.CreatedDate) { Sortable = true },
        new("modified", Text["ModifiedDate"], quotation => quotation.ModifiedDate) { Sortable = true },
    ];
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Quotations"]),
    ];

    protected override async Task OnParametersSetAsync()
    {
        PageIndex = Math.Max(1, PageIndex);
        Size = Size is 10 or 25 or 100 or 250 ? Size : 10;
        currentSort = Enum.TryParse<QuotationListSort>(SortQuery, true, out var parsed)
            ? parsed
            : QuotationListSort.QuotationCreatedDate_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = requestGate.Begin();
        loading = true;
        error = null;
        HttpResponseMessage[]? responses = null;
        try
        {
            responses = await Task.WhenAll(
                Http.GetForPresentationAsync($"/bff/quotations?sort={currentSort}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={PageIndex}&size={Size}", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/quotations/stats", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/catalog/currencies", lease.CancellationToken),
                Http.GetForPresentationAsync("/bff/employees?sort=EmployeeId_Ascending&index=1&size=100", lease.CancellationToken));
            if (!lease.IsCurrent)
            {
                return;
            }
            if (HandleFailure(responses[0]) || HandleFailure(responses[1]))
            {
                return;
            }

            var loadedPage = await responses[0].Content.ReadFromJsonAsync<QuotationListPage>(lease.CancellationToken) ?? EmptyPage;
            var loadedStats = await responses[1].Content.ReadFromJsonAsync<QuotationStats>(lease.CancellationToken) ?? new(0, 0, 0);
            IReadOnlyDictionary<int, string> loadedCurrencies = currencies;
            IReadOnlyDictionary<int, string> loadedEmployees = employees;
            if (responses[2].IsSuccessStatusCode)
            {
                loadedCurrencies = (await responses[2].Content.ReadFromJsonAsync<List<CatalogCurrency>>(lease.CancellationToken) ?? [])
                    .ToDictionary(item => item.Id, item => item.ShortName);
            }
            if (responses[3].IsSuccessStatusCode)
            {
                loadedEmployees = (await responses[3].Content.ReadFromJsonAsync<EmployeeListPage>(lease.CancellationToken) ?? new([], 1, 0, 0, false, false))
                    .Items.ToDictionary(item => item.Id, item => item.FullName);
            }
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            stats = loadedStats;
            currencies = loadedCurrencies;
            employees = loadedEmployees;

            decisionLabels = [Text["Accepted"], Text["Declined"], Text["Open"]];
            decisionSeries = [new ShadcnChartSeries("decision", new double?[] { stats.Accepted, stats.Declined, stats.Open })];
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            if (responses is not null)
            {
                foreach (var response in responses)
                {
                    response.Dispose();
                }
            }
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private bool HandleFailure(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return false;
        }
        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
        }
        else
        {
            error = response.StatusCode switch
            {
                HttpStatusCode.Forbidden => Text["Forbidden"],
                HttpStatusCode.TooManyRequests => Text["RateLimited"],
                HttpStatusCode.BadGateway => Text["InvalidResponse"],
                _ => Text["Unavailable"],
            };
        }
        return true;
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, QuotationListSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/Quotations/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={size}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, PageIndex - 1),
        PageSize = Size,
        HiddenColumnKeys = new HashSet<string>(["created", "modified"], StringComparer.Ordinal),
        Sorts = currentSort switch
        {
            QuotationListSort.QuotationId_Ascending => [new("id", ShadcnSortDirection.Ascending)],
            QuotationListSort.QuotationId_Descending => [new("id", ShadcnSortDirection.Descending)],
            QuotationListSort.QuotationCreatedDate_Ascending => [new("created", ShadcnSortDirection.Ascending)],
            QuotationListSort.QuotationCreatedDate_Descending => [new("created", ShadcnSortDirection.Descending)],
            QuotationListSort.QuotationModifiedDate_Ascending => [new("modified", ShadcnSortDirection.Ascending)],
            QuotationListSort.QuotationModifiedDate_Descending => [new("modified", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private QuotationListSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => QuotationListSort.QuotationId_Ascending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => QuotationListSort.QuotationId_Descending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Ascending } => QuotationListSort.QuotationCreatedDate_Ascending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Descending } => QuotationListSort.QuotationCreatedDate_Descending,
        { ColumnKey: "modified", Direction: ShadcnSortDirection.Ascending } => QuotationListSort.QuotationModifiedDate_Ascending,
        { ColumnKey: "modified", Direction: ShadcnSortDirection.Descending } => QuotationListSort.QuotationModifiedDate_Descending,
        _ => currentSort,
    };

    private RenderFragment CustomerLink(int? customerId) => builder =>
    {
        if (customerId is not int id)
        {
            builder.AddContent(0, "-");
            return;
        }
        builder.OpenComponent<LegacyLink>(1);
        builder.AddAttribute(2, nameof(LegacyLink.Href), $"/Customers/View?id={id}");
        builder.AddAttribute(3, nameof(LegacyLink.Role), LegacyLinkRole.Record);
        builder.AddAttribute(4, nameof(LegacyLink.AriaLabel), $"{Text["CustomerId"]} {id}");
        builder.AddAttribute(5, nameof(LegacyLink.ChildContent), (RenderFragment)(content => content.AddContent(0, id)));
        builder.CloseComponent();
    };
    private string EmployeeName(int? id) => id is int value && employees.TryGetValue(value, out var name) ? name : id?.ToString(CultureInfo.InvariantCulture) ?? "-";
    private string FormatMoney(decimal value, int currencyId)
    {
        var currency = currencies.TryGetValue(currencyId, out var name) ? name : currencyId.ToString(CultureInfo.InvariantCulture);
        if (currency.Equals("THB", StringComparison.OrdinalIgnoreCase) && CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th") currency = "บาท";
        return $"{value:N2} {currency}";
    }
    private static string FormatDate(DateTime value) => LegacyPresentation.FormatCalendarDate(value, CultureInfo.CurrentCulture, "-");
    private string Decision(bool? value) => value switch { true => Text["Accepted"], false => Text["Declined"], null => Text["Open"] };
    private static string DecisionClass(bool? value) => value switch
    {
        true => "quotation-status quotation-status--accepted",
        false => "quotation-status quotation-status--declined",
        null => "quotation-status quotation-status--open",
    };
    private static string ValueOrFallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
