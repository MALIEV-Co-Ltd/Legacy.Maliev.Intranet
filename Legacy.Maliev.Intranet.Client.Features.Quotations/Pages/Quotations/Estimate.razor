@page "/Quotations/Estimate"
@attribute [Authorize]
@inject IStringLocalizer<Estimate> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="quotation-estimate">
    <PageBreadcrumbs Items="Breadcrumbs" />
    <header class="operations-page-header">
        <div>
            <h1>@Text["Heading"]</h1>
            <p>@Text["Description"]</p>
        </div>
    </header>

    <ShadcnTabs Value="cnc">
        <ShadcnTabsList><ShadcnTabsTrigger Value="printing">@Text["Printing"]</ShadcnTabsTrigger><ShadcnTabsTrigger Value="cnc">@Text["CncMachining"]</ShadcnTabsTrigger><ShadcnTabsTrigger Value="scanning">@Text["Scanning"]</ShadcnTabsTrigger><ShadcnTabsTrigger Value="designing">@Text["Designing"]</ShadcnTabsTrigger></ShadcnTabsList>
        <ShadcnTabsContent Value="printing"><ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["ComingSoon"]</ShadcnAlertDescription></ShadcnAlert></ShadcnTabsContent>
        <ShadcnTabsContent Value="cnc">
            <div class="quotation-estimate-layout"><div class="quotation-estimate-inputs">
                <section class="quotation-estimate-card"><h2>@Text["Machine"]</h2><div class="quotation-estimate-grid"><QuotationInputField TValue="decimal" Id="estimate-machine-cost" Label="@Text["MachineCost"]" Type="number" Min="0" @bind-Value="model.MachineCost" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-roi-years" Label="@Text["RoiYears"]" Type="number" Min="0" @bind-Value="model.ReturnOnInvestmentYears" @bind-Value:after="Recalculate" /><QuotationInputField TValue="int" Id="estimate-weekdays" Label="@Text["WeekdaysPerMonth"]" Type="number" Min="1" @bind-Value="model.WeekdaysPerMonth" @bind-Value:after="Recalculate" /><QuotationInputField TValue="int" Id="estimate-hours-day" Label="@Text["WorkingHoursPerDay"]" Type="number" Min="1" @bind-Value="model.WorkingHoursPerDay" @bind-Value:after="Recalculate" /><div class="quotation-estimate-wide"><QuotationInputField TValue="decimal" Id="estimate-machine-hour" Label="@Text["MachineCostPerHour"]" Type="number" Min="0" Value="@machineCostPerHour" ValueChanged="SetMachineCostPerHour" /></div></div><p class="quotation-estimate-help">@Text["RoiBreakdown", calculated.ReturnOnInvestmentMonths, calculated.ReturnOnInvestmentDays, calculated.ReturnOnInvestmentHours] · @Text["ManualOverride"]</p></section>
                <section class="quotation-estimate-card"><h2>@Text["Job"]</h2><div class="quotation-estimate-grid quotation-estimate-grid--three"><QuotationInputField TValue="int" Id="estimate-parts" Label="@Text["PartCount"]" Type="number" Min="1" @bind-Value="model.PartCount" @bind-Value:after="Recalculate" /><QuotationInputField TValue="int" Id="estimate-hours" Label="@Text["Hours"]" Type="number" Min="0" @bind-Value="model.TimePerPartHours" @bind-Value:after="Recalculate" /><QuotationInputField TValue="int" Id="estimate-minutes" Label="@Text["Minutes"]" Type="number" Min="0" @bind-Value="model.TimePerPartMinutes" @bind-Value:after="Recalculate" /><div class="quotation-estimate-wide"><QuotationInputField TValue="decimal" Id="estimate-machine-total" Label="@Text["MachineCostAllParts"]" Type="number" Min="0" Value="@machineCost" ValueChanged="SetMachineCost" /></div></div><p class="quotation-estimate-help">@Text["MachineHours", calculated.TimePerPartHours, calculated.TotalMachiningHours]</p></section>
                <section class="quotation-estimate-card"><h2>@Text["Material"]</h2><div class="quotation-estimate-grid quotation-estimate-grid--three"><QuotationInputField TValue="decimal" Id="estimate-stock-x" Label="@Text["StockX"]" Type="number" Min="0" @bind-Value="model.StockLengthMillimetres" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-stock-y" Label="@Text["StockY"]" Type="number" Min="0" @bind-Value="model.StockWidthMillimetres" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-stock-z" Label="@Text["StockZ"]" Type="number" Min="0" @bind-Value="model.StockHeightMillimetres" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-stock-kg" Label="@Text["StockCostPerKilogram"]" Type="number" Min="0" @bind-Value="model.StockCostPerKilogram" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-stock-weight" Label="@Text["StockWeight"]" Type="number" Min="0" @bind-Value="model.StockWeightKilograms" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-stock-markup" Label="@Text["StockMarkup"]" Type="number" Min="0" @bind-Value="model.StockMarkupPercent" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-material-part" Label="@Text["MaterialCostPerPart"]" Type="number" Min="0" Value="@materialCostPerPart" ValueChanged="SetMaterialCostPerPart" /><QuotationInputField TValue="decimal" Id="estimate-material-total" Label="@Text["MaterialCostAllParts"]" Type="number" Min="0" Value="@materialCost" ValueChanged="SetMaterialCost" /></div><p class="quotation-estimate-help">@Text["StockVolume", calculated.StockVolumeCubicMillimetres] · @Text["ManualOverride"]</p></section>
                <section class="quotation-estimate-card"><h2>@Text["Electricity"]</h2><div class="quotation-estimate-grid quotation-estimate-grid--three"><QuotationInputField TValue="decimal" Id="estimate-power" Label="@Text["MaximumPower"]" Type="number" Min="0" @bind-Value="model.MaximumPowerKilowatts" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-electric-base" Label="@Text["ElectricityBaseCost"]" Type="number" Min="0" @bind-Value="model.ElectricityBaseCost" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-kwh" Label="@Text["CostPerKwh"]" Type="number" Min="0" @bind-Value="model.ElectricityCostPerKilowattHour" @bind-Value:after="Recalculate" /><div class="quotation-estimate-wide"><QuotationInputField TValue="decimal" Id="estimate-electric-total" Label="@Text["ElectricityCost"]" Type="number" Min="0" Value="@electricityCost" ValueChanged="SetElectricityCost" /></div></div><p class="quotation-estimate-help">@Text["PowerConsumption", calculated.TotalPowerConsumptionKilowattHours]</p></section>
                <section class="quotation-estimate-card"><h2>@Text["Setup"]</h2><div class="quotation-estimate-grid"><QuotationInputField TValue="int" Id="estimate-setups" Label="@Text["NumberOfSetups"]" Type="number" Min="0" @bind-Value="model.NumberOfSetups" @bind-Value:after="Recalculate" /><QuotationInputField TValue="decimal" Id="estimate-setup-cost" Label="@Text["CostPerSetup"]" Type="number" Min="0" @bind-Value="model.CostPerSetup" @bind-Value:after="Recalculate" /><div class="quotation-estimate-wide"><QuotationInputField TValue="decimal" Id="estimate-setup-total" Label="@Text["SetupCostAllParts"]" Type="number" Min="0" Value="@setupCost" ValueChanged="SetSetupCost" /></div></div><p class="quotation-estimate-help">@Text["SetupCostPerPart", calculated.SetupCostPerPart]</p></section>
            </div>
            <aside class="quotation-estimate-summary" aria-labelledby="estimate-summary-heading"><div class="quotation-estimate-card" role="status" aria-live="polite" aria-atomic="true"><h2 id="estimate-summary-heading">@Text["Summary"]</h2><ShadcnTable ExpectedColumnCount="2"><caption class="sr-only">@Text["SummaryCaption"]</caption><ShadcnTableBody><ShadcnTableRow><ShadcnTableHead Scope="ShadcnTableHeadScope.Row">@Text["MachineCost"]</ShadcnTableHead><ShadcnTableCell>@FormatMoney(machineCost)</ShadcnTableCell></ShadcnTableRow><ShadcnTableRow><ShadcnTableHead Scope="ShadcnTableHeadScope.Row">@Text["MaterialCost"]</ShadcnTableHead><ShadcnTableCell>@FormatMoney(materialCost)</ShadcnTableCell></ShadcnTableRow><ShadcnTableRow><ShadcnTableHead Scope="ShadcnTableHeadScope.Row">@Text["ElectricityCost"]</ShadcnTableHead><ShadcnTableCell>@FormatMoney(electricityCost)</ShadcnTableCell></ShadcnTableRow><ShadcnTableRow><ShadcnTableHead Scope="ShadcnTableHeadScope.Row">@Text["SetupCost"]</ShadcnTableHead><ShadcnTableCell>@FormatMoney(setupCost)</ShadcnTableCell></ShadcnTableRow><ShadcnTableRow><ShadcnTableHead Scope="ShadcnTableHeadScope.Row"><strong>@Text["GrandTotal"]</strong></ShadcnTableHead><ShadcnTableCell><strong>@FormatMoney(GrandTotal)</strong></ShadcnTableCell></ShadcnTableRow></ShadcnTableBody></ShadcnTable><ShadcnButton Variant="ShadcnButtonVariant.Outline" OnClick="Reset">@Text["Reset"]</ShadcnButton></div></aside></div>
        </ShadcnTabsContent>
        <ShadcnTabsContent Value="scanning"><ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["ComingSoon"]</ShadcnAlertDescription></ShadcnAlert></ShadcnTabsContent>
        <ShadcnTabsContent Value="designing"><ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text["ComingSoon"]</ShadcnAlertDescription></ShadcnAlert></ShadcnTabsContent>
    </ShadcnTabs>
</main>

@code {
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Quotations"], "/Quotations/Index"),
        new(Text["Estimate"]),
    ];

    private EstimateFormModel model = EstimateFormModel.LegacyDefaults();
    private CncEstimateResult calculated = CncEstimateCalculator.Calculate(CncEstimateInput.LegacyDefaults);
    private decimal machineCostPerHour;
    private decimal machineCost;
    private decimal materialCostPerPart;
    private decimal materialCost;
    private decimal electricityCost;
    private decimal setupCost;

    private decimal GrandTotal => Math.Round(machineCost + materialCost + electricityCost + setupCost, 2, MidpointRounding.AwayFromZero);
    private static string FormatMoney(decimal value) => $"{value.ToString("N2", CultureInfo.CurrentCulture)} {(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th" ? "บาท" : "THB")}";

    protected override void OnInitialized() => ApplyCalculatedValues();

    private void Recalculate()
    {
        calculated = CncEstimateCalculator.Calculate(model.ToInput());
        ApplyCalculatedValues();
    }

    private void ApplyCalculatedValues()
    {
        machineCostPerHour = calculated.MachineCostPerHour;
        machineCost = calculated.MachineCost;
        materialCostPerPart = calculated.MaterialCostPerPart;
        materialCost = calculated.MaterialCost;
        electricityCost = calculated.ElectricityCost;
        setupCost = calculated.SetupCost;
    }

    private void SetMachineCostPerHour(decimal value)
    {
        machineCostPerHour = Math.Max(0m, value);
        machineCost = Round(machineCostPerHour * calculated.TotalMachiningHours);
    }

    private void SetMachineCost(decimal value) => machineCost = Math.Max(0m, value);

    private void SetMaterialCostPerPart(decimal value)
    {
        materialCostPerPart = Math.Max(0m, value);
        materialCost = Round(materialCostPerPart * Math.Max(0, model.PartCount));
    }

    private void SetMaterialCost(decimal value) => materialCost = Math.Max(0m, value);

    private void SetElectricityCost(decimal value) => electricityCost = Math.Max(0m, value);

    private void SetSetupCost(decimal value) => setupCost = Math.Max(0m, value);

    private void Reset()
    {
        model = EstimateFormModel.LegacyDefaults();
        Recalculate();
    }

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    private sealed class EstimateFormModel
    {
        public decimal MachineCost { get; set; }
        public decimal ReturnOnInvestmentYears { get; set; }
        public int WeekdaysPerMonth { get; set; }
        public int WorkingHoursPerDay { get; set; }
        public int PartCount { get; set; }
        public int TimePerPartHours { get; set; }
        public int TimePerPartMinutes { get; set; }
        public decimal StockLengthMillimetres { get; set; }
        public decimal StockWidthMillimetres { get; set; }
        public decimal StockHeightMillimetres { get; set; }
        public decimal StockCostPerKilogram { get; set; }
        public decimal StockWeightKilograms { get; set; }
        public decimal StockMarkupPercent { get; set; }
        public decimal MaximumPowerKilowatts { get; set; }
        public decimal ElectricityBaseCost { get; set; }
        public decimal ElectricityCostPerKilowattHour { get; set; }
        public int NumberOfSetups { get; set; }
        public decimal CostPerSetup { get; set; }

        public static EstimateFormModel LegacyDefaults()
        {
            var value = CncEstimateInput.LegacyDefaults;
            return new()
            {
                MachineCost = value.MachineCost,
                ReturnOnInvestmentYears = value.ReturnOnInvestmentYears,
                WeekdaysPerMonth = value.WeekdaysPerMonth,
                WorkingHoursPerDay = value.WorkingHoursPerDay,
                PartCount = value.PartCount,
                TimePerPartHours = value.TimePerPartHours,
                TimePerPartMinutes = value.TimePerPartMinutes,
                StockLengthMillimetres = value.StockLengthMillimetres,
                StockWidthMillimetres = value.StockWidthMillimetres,
                StockHeightMillimetres = value.StockHeightMillimetres,
                StockCostPerKilogram = value.StockCostPerKilogram,
                StockWeightKilograms = value.StockWeightKilograms,
                StockMarkupPercent = value.StockMarkupPercent,
                MaximumPowerKilowatts = value.MaximumPowerKilowatts,
                ElectricityBaseCost = value.ElectricityBaseCost,
                ElectricityCostPerKilowattHour = value.ElectricityCostPerKilowattHour,
                NumberOfSetups = value.NumberOfSetups,
                CostPerSetup = value.CostPerSetup,
            };
        }

        public CncEstimateInput ToInput() => new(
            MachineCost,
            ReturnOnInvestmentYears,
            WeekdaysPerMonth,
            WorkingHoursPerDay,
            PartCount,
            TimePerPartHours,
            TimePerPartMinutes,
            StockLengthMillimetres,
            StockWidthMillimetres,
            StockHeightMillimetres,
            StockCostPerKilogram,
            StockWeightKilograms,
            StockMarkupPercent,
            MaximumPowerKilowatts,
            ElectricityBaseCost,
            ElectricityCostPerKilowattHour,
            NumberOfSetups,
            CostPerSetup);
    }
}
