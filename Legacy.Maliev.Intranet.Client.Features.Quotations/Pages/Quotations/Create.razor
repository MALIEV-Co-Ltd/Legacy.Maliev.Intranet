@page "/Quotations/Create"
@using System.ComponentModel.DataAnnotations
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Create> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="quotation-create">
    <header class="operations-page-header"><h1>@Text["Heading"]</h1></header>
    @if (loading) { <div role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error)) { <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert> }
        @if (!string.IsNullOrWhiteSpace(warning)) { <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@warning</ShadcnAlertDescription></ShadcnAlert> }
        <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" class="quotation-create__form">
            <DataAnnotationsValidator />
            <section class="quotation-create__section" aria-labelledby="customer-heading">
                <h2 id="customer-heading">@Text["Customer"]</h2>
                <div class="quotation-create__customer"><QuotationInputField TValue="int" Id="quotation-customer" Label="@Text["CustomerId"]" Type="number" InputMode="numeric" Min="1" @bind-Value="model.CustomerId" Required="true" Disabled="@submitting" /><ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Outline" OnClick="LoadCustomerAsync" Disabled="@submitting">@Text["LoadCustomer"]</ShadcnButton></div>
                @if (page?.Customer is not null) { <p><strong>@(page.Customer.FullName)</strong> · @(page.Customer.Email)</p> }
            </section>

            <section class="quotation-create__section" aria-labelledby="terms-heading">
                <h2 id="terms-heading">@Text["TermsHeading"]</h2>
                <div class="quotation-create__grid quotation-create__grid--three">
                    <QuotationSelectField TValue="int" Id="quotation-employee" Label="@Text["Employee"]" @bind-Value="model.EmployeeId" Options="@EmployeeOptions" Placeholder="@Text["Employee"]" Required="true" Disabled="@submitting" />
                    <QuotationSelectField TValue="int" Id="quotation-currency" Label="@Text["Currency"]" @bind-Value="model.CurrencyId" Options="@CurrencyOptions" Placeholder="@Text["Currency"]" Required="true" Disabled="@submitting" />
                    <QuotationInputField TValue="int" Id="quotation-period" Label="@Text["Period"]" Type="number" InputMode="numeric" Min="1" @bind-Value="model.Period" Required="true" Disabled="@submitting" />
                    <QuotationInputField TValue="string" Id="quotation-shipped-via" Label="@Text["ShippedVia"]" @bind-Value="model.ShippedVia" Disabled="@submitting" />
                    <QuotationInputField TValue="string" Id="quotation-fob" Label="@Text["Fob"]" @bind-Value="model.Fob" Disabled="@submitting" />
                    <QuotationInputField TValue="string" Id="quotation-terms" Label="@Text["Terms"]" @bind-Value="model.Terms" Disabled="@submitting" />
                    <div class="quotation-create__wide"><ShadcnFormField Id="quotation-comment" Label="@Text["Comment"]"><Control><ShadcnTextarea TValue="string" id="quotation-comment" @bind-Value="model.Comment" rows="3" Disabled="@submitting" /></Control></ShadcnFormField></div>
                    <div class="quotation-create__wide"><QuotationCheckboxField Id="quotation-withholding" Label="@Text["Withholding"]" @bind-Value="model.WithholdingTaxEnabled" Disabled="@submitting" /></div>
                </div>
            </section>

            <section class="quotation-create__section" aria-labelledby="lines-heading">
                <div class="quotation-create__section-heading"><h2 id="lines-heading">@Text["Lines"]</h2><ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Outline" OnClick="AddLine" Disabled="@submitting">@Text["AddLine"]</ShadcnButton></div>
                @if (page?.Customer is not null)
                {
                    <section class="quotation-order-candidates" aria-labelledby="quotation-order-candidates-heading">
                        <div class="quotation-order-candidates-heading"><div><h3 id="quotation-order-candidates-heading">@Text["CustomerOrders"]</h3><p>@Text["CustomerOrdersSummary", page.Orders.Count]</p></div><div class="quotation-order-search"><QuotationInputField TValue="string" Id="quotation-order-search" Label="@Text["SearchOrders"]" @bind-Value="orderSearch" Disabled="@submitting" /><ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Outline" OnClick="SearchOrdersAsync" Disabled="@submitting">@Text["Search"]</ShadcnButton></div></div>
                        @if (VisibleOrders.Count == 0) { <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@Text[page.Orders.Count == 0 ? "NoCustomerOrders" : "NoMatchingOrders"]</ShadcnAlertDescription></ShadcnAlert> }
                        else
                        {
                            <div class="quotation-order-table-scroll"><ShadcnTable ExpectedColumnCount="6" Class="quotation-order-table"><ShadcnTableHeader><ShadcnTableRow><ShadcnTableHead>@Text["OrderId"]</ShadcnTableHead><ShadcnTableHead>@Text["OrderName"]</ShadcnTableHead><ShadcnTableHead>@Text["Quantity"]</ShadcnTableHead><ShadcnTableHead>@Text["UnitPrice"]</ShadcnTableHead><ShadcnTableHead>@Text["Discount"]</ShadcnTableHead><ShadcnTableHead><span class="visually-hidden">@Text["Actions"]</span></ShadcnTableHead></ShadcnTableRow></ShadcnTableHeader><ShadcnTableBody>@foreach (var order in VisibleOrders) { <ShadcnTableRow><ShadcnTableCell data-label="@Text["OrderId"]">#@order.Id</ShadcnTableCell><ShadcnTableCell data-label="@Text["OrderName"]">@(string.IsNullOrWhiteSpace(order.Name) ? Text["UnnamedOrder"] : order.Name)</ShadcnTableCell><ShadcnTableCell data-label="@Text["Quantity"]">@order.Quantity.ToString("N0")</ShadcnTableCell><ShadcnTableCell data-label="@Text["UnitPrice"]">@FormatOrderMoney(order.UnitPrice)</ShadcnTableCell><ShadcnTableCell data-label="@Text["Discount"]">@FormatDiscount(order.DiscountPercent)</ShadcnTableCell><ShadcnTableCell data-label="@Text["Actions"]"><ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Outline" Size="ShadcnButtonSize.Small" Disabled="@(submitting || IsOrderSelected(order.Id))" OnClick="@(() => AddOrder(order))">@Text[IsOrderSelected(order.Id) ? "OrderAdded" : "AddOrder"]</ShadcnButton></ShadcnTableCell></ShadcnTableRow> }</ShadcnTableBody></ShadcnTable></div>
                        }
                    </section>
                }
                @foreach (var line in model.Lines)
                {
                    <div class="quotation-line-editor" data-testid="quotation-line-editor" @key="line">
                        <QuotationSelectField TValue="int?" Id="@($"quotation-line-order-{LineIndex(line)}")" Label="@Text["Order"]" Value="@line.OrderId" ValueChanged="@((int? value) => SelectOrder(line, value))" Options="@OrderOptions" Placeholder="@Text["Order"]" Clearable="true" Disabled="@submitting" />
                        <QuotationInputField TValue="string" Id="@($"quotation-line-description-{LineIndex(line)}")" Label="@Text["Description"]" @bind-Value="line.Description" Required="true" Disabled="@submitting" />
                        <div class="quotation-line-numbers"><QuotationInputField TValue="int" Id="@($"quotation-line-quantity-{LineIndex(line)}")" Label="@Text["Quantity"]" Type="number" InputMode="numeric" Min="1" @bind-Value="line.Quantity" Required="true" Disabled="@submitting" /><QuotationInputField TValue="decimal" Id="@($"quotation-line-price-{LineIndex(line)}")" Label="@Text["UnitPrice"]" Type="number" InputMode="decimal" Min="0" @bind-Value="line.UnitPrice" Required="true" Disabled="@submitting" /><QuotationInputField TValue="decimal" Id="@($"quotation-line-discount-{LineIndex(line)}")" Label="@Text["Discount"]" Type="number" InputMode="decimal" Min="0" @bind-Value="line.DiscountPercent" Disabled="@submitting" /></div>
                        <div class="quotation-line-actions"><ShadcnButton ButtonType="ShadcnButtonType.Button" Variant="ShadcnButtonVariant.Destructive" Size="ShadcnButtonSize.Small" Disabled="@(submitting || model.Lines.Count == 1)" OnClick="@(() => RemoveLine(line))" aria-label="@Text["RemoveLine"]">@Text["RemoveLine"]</ShadcnButton></div>
                    </div>
                }
                <div class="quotation-create__estimate"><strong>@Text["EstimatedSubtotal", EstimatedSubtotal.ToString("N2", CultureInfo.CurrentCulture), CurrencyLabel]</strong><span>@Text["ServerAuthoritative"]</span></div>
            </section>
            <div class="quotation-create__actions"><ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@(submitting ? Text["Submitting"] : Text["Create"])</ShadcnButton><LegacyLink Href="/Quotations/Index" Role="LegacyLinkRole.Navigation" Disabled="submitting" AriaLabel="@Text["Cancel"]">@Text["Cancel"]</LegacyLink></div>
        </EditForm>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "customerId")] public int? CustomerId { get; set; }
    private readonly FormModel model = new();
    private readonly string attemptId = Guid.NewGuid().ToString("D");
    private QuotationCreatePage? page;
    private EditContext editContext = null!;
    private bool loading = true;
    private bool submitting;
    private string? error;
    private string? warning;
    private string orderSearch = string.Empty;
    private IReadOnlyList<ShadcnSelectOption<int>> EmployeeOptions => page?.Employees.Select(value => new ShadcnSelectOption<int>(value.Id, value.FullName)).ToArray() ?? [];
    private IReadOnlyList<ShadcnSelectOption<int>> CurrencyOptions => page?.Currencies.Select(value => new ShadcnSelectOption<int>(value.Id, value.ShortName)).ToArray() ?? [];
    private IReadOnlyList<ShadcnSelectOption<int?>> OrderOptions => page?.Orders.Select(value => new ShadcnSelectOption<int?>(value.Id, $"#{value.Id} {value.Name}")).ToArray() ?? [];
    protected override void OnInitialized() => editContext = new EditContext(model);
    protected override async Task OnParametersSetAsync() { model.CustomerId = CustomerId is > 0 ? CustomerId.Value : model.CustomerId; await LoadPageAsync(model.CustomerId > 0 ? model.CustomerId : null); }
    private async Task LoadCustomerAsync() => await LoadPageAsync(model.CustomerId > 0 ? model.CustomerId : null);
    private async Task SearchOrdersAsync()
    {
        if (page is null || string.IsNullOrWhiteSpace(orderSearch)) return;
        try { using var response = await Http.GetForPresentationAsync($"/bff/quotations/create/orders?search={Uri.EscapeDataString(orderSearch)}&customerId={model.CustomerId}"); if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; } if (!response.IsSuccessStatusCode) { error = Text["Unavailable"]; return; } var orders = await response.Content.ReadFromJsonAsync<IReadOnlyList<QuotationOrderCandidate>>(); page = page with { Orders = orders ?? [] }; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
    }
    private async Task LoadPageAsync(int? customerId)
    {
        loading = true; error = null;
        try { var uri = customerId is > 0 ? $"/bff/quotations/create?customerId={customerId}" : "/bff/quotations/create"; using var response = await Http.GetForPresentationAsync(uri); if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; } if (response.StatusCode == HttpStatusCode.NotFound) { error = Text["CustomerNotFound"]; return; } if (!response.IsSuccessStatusCode) { error = response.StatusCode == HttpStatusCode.Forbidden ? Text["Forbidden"] : Text["Unavailable"]; return; } page = await response.Content.ReadFromJsonAsync<QuotationCreatePage>(); if (page is null) { error = Text["InvalidResponse"]; return; } model.Lines.RemoveAll(line => line.OrderId is int orderId && page.Orders.All(order => order.Id != orderId)); if (model.Lines.Count == 0) model.Lines.Add(new()); if (model.EmployeeId <= 0) model.EmployeeId = page.CurrentEmployeeId ?? page.Employees.FirstOrDefault()?.Id ?? 0; if (model.CurrencyId <= 0) model.CurrencyId = page.Currencies.FirstOrDefault(value => value.ShortName == "THB")?.Id ?? page.Currencies.FirstOrDefault()?.Id ?? 0; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["Unavailable"]; }
        finally { loading = false; }
    }
    private void AddLine() => model.Lines.Add(new());
    private void RemoveLine(LineModel line) { if (model.Lines.Count > 1) model.Lines.Remove(line); }
    private int LineIndex(LineModel line) => model.Lines.IndexOf(line);
    private void AddOrder(QuotationOrderCandidate order) { if (IsOrderSelected(order.Id)) return; var line = model.Lines.FirstOrDefault(value => value.OrderId is null && string.IsNullOrWhiteSpace(value.Description) && value.UnitPrice == 0m) ?? new LineModel(); if (!model.Lines.Contains(line)) model.Lines.Add(line); PopulateLine(line, order); }
    private void SelectOrder(LineModel line, int? orderId) { line.OrderId = orderId; if (orderId is int value && page?.Orders.FirstOrDefault(order => order.Id == value) is { } order) PopulateLine(line, order); }
    private static void PopulateLine(LineModel line, QuotationOrderCandidate order) { line.OrderId = order.Id; line.Description = string.IsNullOrWhiteSpace(order.Description) ? order.Name ?? $"Order #{order.Id}" : order.Description; line.Quantity = Math.Max(1, order.Quantity); line.UnitPrice = order.UnitPrice ?? (order.Subtotal is decimal subtotal ? subtotal / Math.Max(1, order.Quantity) : 0m); line.DiscountPercent = order.DiscountPercent ?? 0m; }
    private bool IsOrderSelected(int orderId) => model.Lines.Any(line => line.OrderId == orderId);
    private async Task SubmitAsync()
    {
        if (submitting || page?.Customer?.Id != model.CustomerId || model.Lines.Any(line => string.IsNullOrWhiteSpace(line.Description) || line.Quantity < 1 || line.UnitPrice < 0 || line.DiscountPercent is < 0 or > 100)) { error = Text["ValidationFailed"]; return; }
        submitting = true; error = null; warning = null;
        try { using var sessionResponse = await Http.GetForPresentationAsync("/bff/session"); sessionResponse.EnsureSuccessStatusCode(); var session = await sessionResponse.Content.ReadFromJsonAsync<EmployeeSessionSummary>(); if (string.IsNullOrWhiteSpace(session?.CsrfToken)) { error = Text["CreateFailed"]; return; } var input = new QuotationCreateRequest(model.CustomerId, model.EmployeeId, model.CurrencyId, model.Period, model.ShippedVia, model.Fob, model.Terms, model.Comment, model.WithholdingTaxEnabled, model.Lines.Select(line => new QuotationCreateLine(line.OrderId, line.Description, line.Quantity, line.UnitPrice, line.DiscountPercent)).ToArray()); using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/quotations") { Content = JsonContent.Create(input) }; request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken); request.Headers.Add("Idempotency-Key", attemptId); using var response = await Http.SendAsync(request); if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; } if (response.StatusCode == HttpStatusCode.Forbidden) { error = Text["Forbidden"]; return; } if (response.StatusCode == HttpStatusCode.BadRequest) { error = Text["ValidationFailed"]; return; } if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; } if (!response.IsSuccessStatusCode) { error = Text["CreateFailed"]; return; } var created = await response.Content.ReadFromJsonAsync<QuotationCreatedResult>(); if (created is null || created.Id <= 0) { error = Text["InvalidResponse"]; return; } warning = created.Warning; Navigation.NavigateTo($"/Quotations/View?id={created.Id}"); }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { error = Text["CreateFailed"]; }
        finally { submitting = false; }
    }
    private decimal EstimatedSubtotal => model.Lines.Sum(line => Math.Round((line.UnitPrice * (1m - line.DiscountPercent / 100m)) * line.Quantity, 2, MidpointRounding.AwayFromZero));
    private IReadOnlyList<QuotationOrderCandidate> VisibleOrders => page?.Orders.Where(order => string.IsNullOrWhiteSpace(orderSearch) || order.Id.ToString(CultureInfo.InvariantCulture).Contains(orderSearch.Trim(), StringComparison.OrdinalIgnoreCase) || (order.Name?.Contains(orderSearch.Trim(), StringComparison.CurrentCultureIgnoreCase) ?? false)).ToArray() ?? [];
    private string CurrencyLabel { get { var currency = page?.Currencies.FirstOrDefault(value => value.Id == model.CurrencyId)?.ShortName ?? string.Empty; return currency.Equals("THB", StringComparison.OrdinalIgnoreCase) && CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "th" ? "บาท" : currency; } }
    private string FormatOrderMoney(decimal? value) => value is null ? "—" : $"{value.Value.ToString("N2", CultureInfo.CurrentCulture)} {CurrencyLabel}";
    private static string FormatDiscount(decimal? value) => $"{(value ?? 0m).ToString("N2", CultureInfo.CurrentCulture)}%";
    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
    private sealed class FormModel { [Range(1,int.MaxValue)] public int CustomerId { get; set; } [Range(1,int.MaxValue)] public int EmployeeId { get; set; } [Range(1,int.MaxValue)] public int CurrencyId { get; set; } [Range(1,365)] public int Period { get; set; } = 30; public string? ShippedVia { get; set; } public string? Fob { get; set; } public string? Terms { get; set; } public string? Comment { get; set; } public bool WithholdingTaxEnabled { get; set; } public List<LineModel> Lines { get; } = [new()]; }
    private sealed class LineModel { public int? OrderId { get; set; } public string Description { get; set; } = string.Empty; public int Quantity { get; set; } = 1; public decimal UnitPrice { get; set; } public decimal DiscountPercent { get; set; } }
}
