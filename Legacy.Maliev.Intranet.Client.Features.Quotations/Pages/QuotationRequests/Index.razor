@page "/QuotationRequests/Index"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Index> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="mlv-module-shell quotation-requests-page">
    <div class="mlv-page-body">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header">
        <div>
            <h1>@Text["Heading"]</h1>
            <p>@Text["Description"]</p>
        </div>
    </header>

    <section class="quotation-request-table-region" aria-label="@Text["TableCaption"]">
        <OperationalDataTable TItem="QuotationRequestItem"
                              Items="@(page?.Items ?? [])"
                              Columns="@Columns"
                              RowKey="@(request => request.Id.ToString(CultureInfo.InvariantCulture))"
                              State="@dataTableState"
                              StateChanged="HandleDataTableStateChangedAsync"
                              RequestChanged="HandleDataTableRequestAsync"
                              TotalCount="@(page?.TotalRecords ?? 0)"
                              Loading="@loading"
                              Error="@error"
                              FilterPlaceholder="@Text["Search"]"
                              EmptyText="@Text["Empty"]"
                              LoadingText="@Text["Loading"]"
                              ActionsLabel="@Text["Actions"]"
                              PageSizeOptions="@StandardPageSizes"
                              DetailHref="@(request => $"/QuotationRequests/View?id={request.Id}")"
                              DetailAriaLabel="@(request => Text["ViewQuotationRequest", request.Id])"
                              DetailsAriaLabel="@(request => Text["ExpandQuotationRequest", request.Id])">
            <QuickViewContent Context="context">
                <dl class="quotation-request-quick-view">
                    <div><dt>@Text["Customer"]</dt><dd>@Name(context)</dd></div>
                    <div><dt>@Text["Company"]</dt><dd>@Fallback(context.CompanyName)</dd></div>
                </dl>
            </QuickViewContent>
        </OperationalDataTable>
    </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int PageIndex { get; set; } = 1;
    [SupplyParameterFromQuery] public int Size { get; set; } = 25;

    private QuotationRequestPage? page;
    private static readonly int[] StandardPageSizes = [10, 25, 50, 100, 250];
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 25 };
    private bool loading = true;
    private string? error;
    private QuotationRequestSort sortInput;
    private IReadOnlyList<ShadcnDataTableColumn<QuotationRequestItem>> Columns =>
    [
        new("id", Text["Id"], request => request.Id) { Sortable = true, Hideable = false },
        new("customer", Text["Customer"], request => Name(request)) { MinWidth = "12rem" },
        new("status", Text["Status"], request => request.Done == true ? Text["Done"].Value : Text["Open"].Value),
        new("created", Text["Created"], request => request.CreatedDate) { Sortable = true, MinWidth = "10rem", CellTemplate = request => builder => builder.AddContent(0, Format(request.CreatedDate)) },
        new("company", Text["Company"], request => Fallback(request.CompanyName)) { MinWidth = "14rem" },
    ];
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Heading"]),
    ];

    protected override async Task OnParametersSetAsync()
    {
        PageIndex = PaginationQueryDefaults.NormalizeIndex(PageIndex);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        sortInput = Enum.TryParse<QuotationRequestSort>(Sort, true, out var parsed)
            ? parsed
            : QuotationRequestSort.RequestCreatedDate_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = requestGate.Begin();
        loading = true;
        error = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/quotation-requests?sort={sortInput}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={PageIndex}&size={Size}", lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                error = Error(response.StatusCode);
                return;
            }
            var loadedPage = await response.Content.ReadFromJsonAsync<QuotationRequestPage>(lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (loadedPage is null)
            {
                error = Text["Invalid"];
                return;
            }

            page = loadedPage;
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, QuotationRequestSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/QuotationRequests/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, PageIndex - 1),
        PageSize = Size,
        Sorts = sortInput switch
        {
            QuotationRequestSort.RequestId_Ascending => [new("id", ShadcnSortDirection.Ascending)],
            QuotationRequestSort.RequestId_Descending => [new("id", ShadcnSortDirection.Descending)],
            QuotationRequestSort.RequestCreatedDate_Ascending => [new("created", ShadcnSortDirection.Ascending)],
            QuotationRequestSort.RequestCreatedDate_Descending => [new("created", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private QuotationRequestSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => QuotationRequestSort.RequestId_Ascending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => QuotationRequestSort.RequestId_Descending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Ascending } => QuotationRequestSort.RequestCreatedDate_Ascending,
        { ColumnKey: "created", Direction: ShadcnSortDirection.Descending } => QuotationRequestSort.RequestCreatedDate_Descending,
        _ => sortInput,
    };

    private string Error(HttpStatusCode value) => value switch
    {
        HttpStatusCode.Forbidden => Text["Forbidden"],
        HttpStatusCode.TooManyRequests => Text["RateLimited"],
        HttpStatusCode.BadGateway => Text["Invalid"],
        _ => Text["Unavailable"],
    };

    private static string Name(QuotationRequestItem value) =>
        Fallback(string.Join(' ', new[] { value.FirstName, value.LastName }.Where(part => !string.IsNullOrWhiteSpace(part))));
    private static string Fallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Format(DateTime? value) => LegacyPresentation.FormatUtcDate(value, CultureInfo.CurrentCulture, "-");
    private static string StatusClass(bool? done) => done == true
        ? "quotation-request-status quotation-request-status--done"
        : "quotation-request-status quotation-request-status--open";
}
