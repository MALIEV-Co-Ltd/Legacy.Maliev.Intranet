@page "/QuotationRequests/Index"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Index> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <header class="operations-page-header">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Heading"]</MudText>
            <MudText Typo="Typo.body1">@Text["Description"]</MudText>
        </div>
    </header>

    <ListToolbar TSort="QuotationRequestSort"
                 Value="@ToolbarValue"
                 Defaults="@ToolbarDefaults"
                 SortOptions="@ToolbarSortOptions"
                 PageSizeOptions="@StandardPageSizes"
                 SearchLabel="@Text["Search"]"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" aria-label="@Text["Loading"]" />
            <span class="sr-only">@Text["Loading"]</span>
        </div>
    }
    else if (error is not null)
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info" aria-live="polite">@Text["Empty"]</MudAlert>
    }
    else
    {
        <MudText id="quotation-request-table-summary" Typo="Typo.caption" Class="mb-3">
            @Text["RecordsSummary", page.TotalRecords]
        </MudText>
        <MudTable Items="page.Items" Hover="true" Breakpoint="Breakpoint.Sm" aria-label="@Text["TableCaption"]" aria-describedby="quotation-request-table-summary">
            <HeaderContent>
                <MudTh>@Text["Id"]</MudTh>
                <MudTh>@Text["Customer"]</MudTh>
                <MudTh>@Text["Company"]</MudTh>
                <MudTh>@Text["Status"]</MudTh>
                <MudTh>@Text["Created"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Text["Id"]"><LegacyLink Href="@($"/QuotationRequests/View?id={context.Id}")" Role="LegacyLinkRole.Record" AriaLabel="@($"{Text["Id"]} {context.Id}")">@context.Id</LegacyLink></MudTd>
                <MudTd DataLabel="@Text["Customer"]">@Name(context)</MudTd>
                <MudTd DataLabel="@Text["Company"]">@Fallback(context.CompanyName)</MudTd>
                <MudTd DataLabel="@Text["Status"]"><span class="@StatusClass(context.Done)">@(context.Done == true ? Text["Done"] : Text["Open"])</span></MudTd>
                <MudTd DataLabel="@Text["Created"]">@Format(context.CreatedDate)</MudTd>
            </RowTemplate>
        </MudTable>
        <nav class="d-flex justify-space-between align-center mt-4" aria-label="@Text["PaginationLabel"]">
            <MudButton Disabled="@(!page.HasPreviousPage)" OnClick="PreviousAsync">@Text["Previous"]</MudButton>
            <MudText aria-live="polite" aria-atomic="true">@Text["Page", page.PageIndex, page.TotalPages, page.TotalRecords]</MudText>
            <MudButton Disabled="@(!page.HasNextPage)" OnClick="NextAsync">@Text["Next"]</MudButton>
        </nav>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int PageIndex { get; set; } = 1;
    [SupplyParameterFromQuery] public int Size { get; set; } = 25;

    private QuotationRequestPage? page;
    private static readonly int[] StandardPageSizes = [10, 25, 50, 100, 250];
    private readonly LatestRequestGate requestGate = new();
    private bool loading = true;
    private string? error;
    private QuotationRequestSort sortInput;
    private ListToolbarState<QuotationRequestSort> ToolbarValue => new(Search, sortInput, Size);
    private static ListToolbarState<QuotationRequestSort> ToolbarDefaults =>
        new(null, QuotationRequestSort.RequestCreatedDate_Descending, 25);
    private IReadOnlyList<ListToolbarOption<QuotationRequestSort>> ToolbarSortOptions =>
        Enum.GetValues<QuotationRequestSort>().Select(option => new ListToolbarOption<QuotationRequestSort>(option, Text[option.ToString()])).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        PageIndex = PaginationQueryDefaults.NormalizeIndex(PageIndex);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 25, maximum: 250);
        sortInput = Enum.TryParse<QuotationRequestSort>(Sort, true, out var parsed)
            ? parsed
            : QuotationRequestSort.RequestCreatedDate_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var lease = requestGate.Begin();
        loading = true;
        error = null;
        try
        {
            using var response = await Http.GetForPresentationAsync($"/bff/quotation-requests?sort={sortInput}&search={Uri.EscapeDataString(Search ?? string.Empty)}&index={PageIndex}&size={Size}", lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                error = Error(response.StatusCode);
                return;
            }
            var loadedPage = await response.Content.ReadFromJsonAsync<QuotationRequestPage>(lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }
            if (loadedPage is null)
            {
                error = Text["Invalid"];
                return;
            }

            page = loadedPage;
        }
        catch (OperationCanceledException) when (!lease.IsCurrent)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task PreviousAsync() => NavigateAsync(Math.Max(1, PageIndex - 1), Search, sortInput, Size);
    private Task NextAsync() => NavigateAsync(PageIndex + 1, Search, sortInput, Size);

    private Task HandleToolbarRequestAsync(ListToolbarRequest<QuotationRequestSort> request) =>
        request.Reason == ListToolbarChangeReason.Refreshed && request.State.Normalize() == ToolbarValue.Normalize()
            ? LoadAsync()
            : NavigateAsync(1, request.State.Search, request.State.Sort, request.State.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, QuotationRequestSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/QuotationRequests/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private string Error(HttpStatusCode value) => value switch
    {
        HttpStatusCode.Forbidden => Text["Forbidden"],
        HttpStatusCode.TooManyRequests => Text["RateLimited"],
        HttpStatusCode.BadGateway => Text["Invalid"],
        _ => Text["Unavailable"],
    };

    private static string Name(QuotationRequestItem value) =>
        Fallback(string.Join(' ', new[] { value.FirstName, value.LastName }.Where(part => !string.IsNullOrWhiteSpace(part))));
    private static string Fallback(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string Format(DateTime? value) => LegacyPresentation.FormatUtcDate(value, CultureInfo.CurrentCulture, "-");
    private static string StatusClass(bool? done) => done == true
        ? "quotation-request-status quotation-request-status--done"
        : "quotation-request-status quotation-request-status--open";
}
