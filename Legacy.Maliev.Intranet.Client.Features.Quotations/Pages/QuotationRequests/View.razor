@page "/QuotationRequests/View"
@attribute [Authorize]
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<View> Text

<PageTitle>@Text["PageTitle", Id ?? 0]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    @if (loading)
    {
        <div role="status" aria-live="polite">
            <MudProgressLinear Indeterminate="true" aria-label="@Text["Loading"]" />
            <span class="sr-only">@Text["Loading"]</span>
        </div>
    }
    else if (error is not null)
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (detail is not null)
    {
        <header class="operations-page-header">
            <div>
                <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Heading", detail.Request.Id]</MudText>
                <MudText Typo="Typo.body1">@Text["Description"]</MudText>
            </div>
            <MudButton Href="/QuotationRequests/Index" Variant="Variant.Outlined">@Text["Back"]</MudButton>
        </header>

        @if (notice is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" aria-live="polite">@notice</MudAlert>
        }

        <MudForm @ref="form" Model="edit" aria-busy="@submitting.ToString().ToLowerInvariant()">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudPaper Class="pa-4 h-100">
                        <MudText Typo="Typo.h6" HtmlTag="h2">@Text["CustomerDetails"]</MudText>
                        <MudGrid>
                            <MudItem xs="12" md="6"><MudTextField Label="@Text["FirstName"]" @bind-Value="edit.FirstName" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="@Text["LastName"]" @bind-Value="edit.LastName" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="@Text["Email"]" @bind-Value="edit.Email" InputType="InputType.Email" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="@Text["Telephone"]" @bind-Value="edit.TelephoneNumber" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="@Text["Company"]" @bind-Value="edit.CompanyName" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="@Text["Country"]" @bind-Value="edit.Country" /></MudItem>
                            <MudItem xs="12"><MudTextField Label="@Text["Tax"]" @bind-Value="edit.TaxIdentification" /></MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4 h-100">
                        <MudText Typo="Typo.h6" HtmlTag="h2">@Text["Workflow"]</MudText>
                        <p class="quotation-request-status-summary">
                            <span>@Text["StatusSummary"]</span>
                            <span class="@StatusClass(edit.Done)">@(edit.Done == true ? Text["Done"] : Text["Open"])</span>
                        </p>
                        <MudSelect T="bool?" Label="@Text["Status"]" @bind-Value="edit.Done" Required="true">
                            <MudSelectItem T="bool?" Value="@((bool?)false)">@Text["Open"]</MudSelectItem>
                            <MudSelectItem T="bool?" Value="@((bool?)true)">@Text["Done"]</MudSelectItem>
                        </MudSelect>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudPaper Class="pa-4">
                        <MudText Typo="Typo.h6" HtmlTag="h2">@Text["RequestDetails"]</MudText>
                        <MudTextField Label="@Text["Message"]" @bind-Value="edit.Message" Lines="5" />
                        <MudTextField Class="mt-3" Label="@Text["Internal"]" @bind-Value="edit.InternalComment" Lines="4" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="12">
                    <MudButton OnClick="SaveAsync" Disabled="submitting" Variant="Variant.Filled" Color="Color.Primary">
                        @(submitting ? Text["Saving"] : Text["Save"])
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudForm>

        <section aria-labelledby="quotation-request-files-heading">
            <MudPaper Class="pa-4 mt-4">
                <MudText id="quotation-request-files-heading" Typo="Typo.h5" HtmlTag="h2">@Text["Files"]</MudText>
                @if (detail.Files.Count == 0)
                {
                    <MudText>@Text["NoFiles"]</MudText>
                }
                else
                {
                    <MudList T="QuotationRequestFileItem">
                        @foreach (var file in detail.Files)
                        {
                            <MudListItem T="QuotationRequestFileItem" Value="file">
                                @if (file.Uri is null)
                                {
                                    <MudText>@file.ObjectName</MudText>
                                }
                                else
                                {
                                    <MudLink Href="@file.Uri.ToString()" Target="_blank" rel="noopener">@file.ObjectName</MudLink>
                                }
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </section>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int? Id { get; set; }

    private MudForm? form;
    private QuotationRequestDetail? detail;
    private Edit edit = new();
    private EmployeeSessionSummary? session;
    private bool loading = true;
    private bool submitting;
    private string? error;
    private string? notice;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        if (Id is not > 0)
        {
            error = Text["InvalidId"];
            loading = false;
            return;
        }

        try
        {
            session = await Http.GetFromJsonAsync<EmployeeSessionSummary>("/bff/session");
            using var response = await Http.GetAsync($"/bff/quotation-requests/{Id}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                error = Text["NotFound"];
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                error = ErrorFor(response.StatusCode);
                return;
            }
            detail = await response.Content.ReadFromJsonAsync<QuotationRequestDetail>();
            if (detail is null)
            {
                error = Text["Invalid"];
                return;
            }
            edit = Edit.From(detail.Request);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (detail is null || form is null || session?.CsrfToken is null)
        {
            return;
        }
        await form.ValidateAsync();
        if (!form.IsValid)
        {
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/quotation-requests/{detail.Request.Id}")
        {
            Content = JsonContent.Create(edit.ToRequest()),
        };
        request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
        submitting = true;
        try
        {
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                error = Text["Conflict"];
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                error = ErrorFor(response.StatusCode);
                return;
            }
            notice = Text["Saved"];
            await LoadAsync();
        }
        catch (HttpRequestException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            submitting = false;
        }
    }

    private string ErrorFor(HttpStatusCode status) => status switch
    {
        HttpStatusCode.Forbidden => Text["Forbidden"],
        HttpStatusCode.TooManyRequests => Text["RateLimited"],
        HttpStatusCode.BadGateway => Text["Invalid"],
        _ => Text["Unavailable"],
    };

    private static string StatusClass(bool? done) => done == true
        ? "quotation-request-status quotation-request-status--done"
        : "quotation-request-status quotation-request-status--open";

    private sealed class Edit
    {
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
        public string? TelephoneNumber { get; set; }
        public string? Country { get; set; }
        public string? CompanyName { get; set; }
        public string? TaxIdentification { get; set; }
        public string? Message { get; set; }
        public string? InternalComment { get; set; }
        public bool? Done { get; set; }
        public DateTime? ModifiedDate { get; set; }

        public static Edit From(QuotationRequestItem value) => new()
        {
            FirstName = value.FirstName,
            LastName = value.LastName,
            Email = value.Email,
            TelephoneNumber = value.TelephoneNumber,
            Country = value.Country,
            CompanyName = value.CompanyName,
            TaxIdentification = value.TaxIdentification,
            Message = value.Message,
            InternalComment = value.InternalComment,
            Done = value.Done,
            ModifiedDate = value.ModifiedDate,
        };

        public QuotationRequestUpdate ToRequest() => new(
            FirstName,
            LastName,
            Email,
            TelephoneNumber,
            Country,
            CompanyName,
            TaxIdentification,
            Message,
            InternalComment,
            Done,
            ModifiedDate);
    }
}
