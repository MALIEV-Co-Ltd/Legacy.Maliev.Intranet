@page "/Materials/View"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<MaterialDetail> Text
@inject IStringLocalizer<MaterialCreate> Fields

<PageTitle>@Text["PageTitle", Id]</PageTitle>

<main class="material-detail">
    <header class="operations-page-header"><div><h1>@Text["Material", Id]</h1><p>@Text["Catalog"]</p></div></header>

    @if (loading)
    {
        <div class="material-detail__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else if (notFound)
    {
        <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        <LegacyLink Href="/Materials/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]" Class="material-detail__back">@Text["Back"]</LegacyLink>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        <div class="material-detail__actions"><ShadcnButton OnClick="LoadAsync">@Text["Retry"]</ShadcnButton><LegacyLink Href="/Materials/Index" Role="LegacyLinkRole.Navigation" AriaLabel="@Text["Back"]">@Text["Back"]</LegacyLink></div>
    }
    else if (material is not null)
    {
        @if (!string.IsNullOrWhiteSpace(notification))
        {
            <ShadcnAlert AlertRole="ShadcnAlertRole.Status"><ShadcnAlertDescription>@notification</ShadcnAlertDescription></ShadcnAlert>
        }

        <section class="material-detail__summary" aria-label="@Text["Material", Id]">
            <dl>
                <div><dt>@Text["Id"]</dt><dd>@material.Id</dd></div>
                <div><dt>@Text["Group"]</dt><dd>@ValueOrUnavailable(material.MaterialGroup?.Name)</dd></div>
                <div><dt>@Text["Name"]</dt><dd>@material.Name</dd></div>
                <div><dt>@Text["Number"]</dt><dd>@ValueOrUnavailable(material.MaterialNumber)</dd></div>
                <div><dt>@Text["Density"]</dt><dd>@DensityOrUnavailable()</dd></div>
                <div><dt>@Text["Machinable"]</dt><dd>@Text[material.Machinable ? "Yes" : "No"]</dd></div>
                <div><dt>@Text["Printable"]</dt><dd>@Text[material.Printable ? "Yes" : "No"]</dd></div>
            </dl>
        </section>

        <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="@(_ => error = Text["ValidationFailed"])" class="material-detail__form">
            <DataAnnotationsValidator />
            <section class="material-detail__section">
                <h2>@Fields["BasicInformation"]</h2>
                <div class="material-detail__grid">
                    <CatalogInputField TValue="string" Id="material-detail-name" Label="@Fields["Name"]" Required="true" MaxLength="50" @bind-Value="model.Name" />
                    <CatalogSelectField TValue="int" Id="material-detail-group" Label="@Fields["MaterialGroup"]" @bind-Value="model.MaterialGroupId" Options="@MaterialGroupOptions" Placeholder="@Fields["MaterialGroup"]" Required="true" />
                    <CatalogInputField TValue="string" Id="material-detail-number" Label="@Fields["MaterialNumber"]" @bind-Value="model.MaterialNumber" />
                    <CatalogInputField TValue="string" Id="material-detail-manufacturer" Label="@Fields["ManufacturerReference"]" @bind-Value="model.ManufacturerReference" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-price" Label="@Fields["PricePerKilogram"]" Type="number" InputMode="decimal" @bind-Value="model.PricePerKilogram" />
                    <CatalogSelectField TValue="int?" Id="material-detail-currency" Label="@Fields["Currency"]" @bind-Value="model.CurrencyId" Options="@CurrencyOptions" Placeholder="@Fields["Currency"]" Clearable="true" />
                    <CatalogInputField TValue="string" Id="material-detail-url" Label="@Fields["DatasheetUrl"]" Type="url" @bind-Value="model.Url" />
                    <ShadcnFormField Id="material-detail-comment" Label="@Fields["Comment"]" Class="material-detail__wide"><Control><ShadcnTextarea TValue="string" id="material-detail-comment" @bind-Value="model.Comment" /></Control></ShadcnFormField>
                </div>
            </section>

            <section class="material-detail__section">
                <h2>@Fields["MechanicalProperties"]</h2>
                <div class="material-detail__grid">
                    <CatalogInputField TValue="decimal?" Id="material-detail-density" Label="@Fields["Density"]" Type="number" InputMode="decimal" @bind-Value="model.DensityKilogramPerCubicMeter" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-thermal" Label="@Fields["ThermalConductivity"]" Type="number" InputMode="decimal" @bind-Value="model.ThermalConductivityWattPerMeterKelvin" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-ultimate" Label="@Fields["UltimateTensileStrength"]" Type="number" InputMode="decimal" @bind-Value="model.TensileStrengthUltimateGigaPascal" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-yield" Label="@Fields["YieldTensileStrength"]" Type="number" InputMode="decimal" @bind-Value="model.TensileStrengthYieldMegaPascal" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-shear" Label="@Fields["ShearModulus"]" Type="number" InputMode="decimal" @bind-Value="model.ShearModulusGigaPascal" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-machinability" Label="@Fields["MachinabilityPercent"]" Type="number" InputMode="decimal" @bind-Value="model.MachinabilityPercent" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-brinell" Label="@Fields["HardnessBrinell"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessBrinell" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-knoop" Label="@Fields["HardnessKnoop"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessKnoop" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-rockwell-a" Label="@Fields["HardnessRockwellA"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessRockwellA" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-rockwell-b" Label="@Fields["HardnessRockwellB"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessRockwellB" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-rockwell-c" Label="@Fields["HardnessRockwellC"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessRockwellC" />
                    <CatalogInputField TValue="decimal?" Id="material-detail-vickers" Label="@Fields["HardnessVickers"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessVickers" />
                </div>
            </section>

            <section class="material-detail__section">
                <h2>@Fields["MaterialIdentification"]</h2>
                <div class="material-detail__grid material-detail__grid--three">
                    <CatalogInputField TValue="string" Id="material-detail-aisi" Label="@Fields["Aisi"]" @bind-Value="model.Aisi" />
                    <CatalogInputField TValue="string" Id="material-detail-din" Label="@Fields["Din"]" @bind-Value="model.Din" />
                    <CatalogInputField TValue="string" Id="material-detail-bts" Label="@Fields["Bts"]" @bind-Value="model.Bts" />
                    <CatalogInputField TValue="string" Id="material-detail-jis" Label="@Fields["Jis"]" @bind-Value="model.Jis" />
                    <CatalogInputField TValue="string" Id="material-detail-uns" Label="@Fields["Uns"]" @bind-Value="model.Uns" />
                    <CatalogInputField TValue="string" Id="material-detail-en" Label="@Fields["En"]" @bind-Value="model.En" />
                    <CatalogInputField TValue="string" Id="material-detail-afnor" Label="@Fields["Afnor"]" @bind-Value="model.Afnor" />
                    <CatalogInputField TValue="string" Id="material-detail-uni" Label="@Fields["Uni"]" @bind-Value="model.Uni" />
                    <CatalogInputField TValue="string" Id="material-detail-sis" Label="@Fields["Sis"]" @bind-Value="model.Sis" />
                    <CatalogInputField TValue="string" Id="material-detail-sae" Label="@Fields["Sae"]" @bind-Value="model.Sae" />
                    <CatalogInputField TValue="string" Id="material-detail-astm" Label="@Fields["Astm"]" @bind-Value="model.Astm" />
                    <CatalogInputField TValue="string" Id="material-detail-ams" Label="@Fields["Ams"]" @bind-Value="model.Ams" />
                </div>
            </section>

            <section class="material-detail__section">
                <h2>@Fields["ProcessCompatibility"]</h2>
                <div class="material-detail__checks">
                    <CatalogCheckboxField Id="material-detail-machinable" Label="@Fields["Machinable"]" @bind-Value="model.Machinable" Disabled="@submitting" />
                    <CatalogCheckboxField Id="material-detail-printable" Label="@Fields["Printable"]" @bind-Value="model.Printable" Disabled="@submitting" />
                </div>
            </section>

            <section class="material-detail__section">
                <h2>@Fields["AvailableColors"]</h2>
                @if (loadingAssociations) { <p class="material-detail__muted">@Text["Loading"]</p> }
                else if (colors.Count == 0) { <p class="material-detail__muted">@Text["NotAvailable"]</p> }
                else
                {
                    <div class="material-detail__association-grid">
                        @foreach (var color in colors)
                        {
                            <CatalogCheckboxField Id="@($"material-color-{color.Id}")" Label="@color.Name" Value="@selectedColorIds.Contains(color.Id)" ValueChanged="@(value => SetColorSelection(color.Id, value))" Disabled="@submitting" />
                        }
                    </div>
                }
            </section>

            <section class="material-detail__section">
                <h2>@Fields["AvailableSurfaceFinishes"]</h2>
                @if (loadingAssociations) { <p class="material-detail__muted">@Text["Loading"]</p> }
                else if (surfaceFinishes.Count == 0) { <p class="material-detail__muted">@Text["NotAvailable"]</p> }
                else
                {
                    <div class="material-detail__association-grid">
                        @foreach (var finish in surfaceFinishes)
                        {
                            <CatalogCheckboxField Id="@($"material-finish-{finish.Id}")" Label="@finish.Name" Value="@selectedSurfaceFinishIds.Contains(finish.Id)" ValueChanged="@(value => SetSurfaceFinishSelection(finish.Id, value))" Disabled="@submitting" />
                        }
                    </div>
                }
            </section>

            <div class="material-detail__actions">
                <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@(submitting ? Text["Saving"] : Text["SaveMaterial"])</ShadcnButton>
                <LegacyLink Href="/Materials/Index" Role="LegacyLinkRole.Navigation" Disabled="@submitting" AriaLabel="@Text["BackToMaterials"]">@Text["BackToMaterials"]</LegacyLink>
            </div>
        </EditForm>
    }
</main>

@code {
    [SupplyParameterFromQuery(Name = "id")] public int Id { get; set; }

    private readonly CatalogMaterialUpsertRequest model = new();
    private CatalogMaterialDetail? material;
    private IReadOnlyList<CatalogMaterialGroup> materialGroups = [];
    private IReadOnlyList<CatalogCurrency> currencies = [];
    private EditContext editContext = null!;
    private string? error;
    private string? notification;
    private bool loading;
    private bool loadingAssociations;
    private bool notFound;
    private bool submitting;
    private IReadOnlyList<CatalogMaterialColor> colors = [];
    private IReadOnlyList<CatalogMaterialSurfaceFinish> surfaceFinishes = [];
    private HashSet<int> selectedColorIds = [];
    private HashSet<int> persistedColorIds = [];
    private HashSet<int> selectedSurfaceFinishIds = [];
    private HashSet<int> persistedSurfaceFinishIds = [];

    private IReadOnlyList<ShadcnSelectOption<int>> MaterialGroupOptions => materialGroups.Select(group => new ShadcnSelectOption<int>(group.Id, group.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> CurrencyOptions => currencies.Select(currency => new ShadcnSelectOption<int?>(currency.Id, currency.ShortName)).ToArray();

    protected override void OnInitialized() => editContext = new EditContext(model);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        material = null;
        error = null;
        notification = null;
        notFound = false;

        if (Id <= 0)
        {
            notFound = true;
            error = Text["MaterialNotFound"];
            return;
        }

        loading = true;
        loadingAssociations = true;
        try
        {
            var detailTask = LoadMaterialAsync();
            var groupsTask = LoadLookupAsync<CatalogMaterialGroup>("/bff/catalog/material-groups");
            var currenciesTask = LoadLookupAsync<CatalogCurrency>("/bff/catalog/currencies");
            var colorsTask = LoadLookupAsync<CatalogMaterialColor>("/bff/catalog/colors");
            var surfaceFinishesTask = LoadLookupAsync<CatalogMaterialSurfaceFinish>("/bff/catalog/surface-finishes");
            var selectedColorsTask = LoadAssociationLookupAsync<CatalogMaterialColor>($"/bff/catalog/materials/{Id}/colors");
            var selectedSurfaceFinishesTask = LoadAssociationLookupAsync<CatalogMaterialSurfaceFinish>($"/bff/catalog/materials/{Id}/surface-finishes");
            await Task.WhenAll(detailTask, groupsTask, currenciesTask, colorsTask, surfaceFinishesTask, selectedColorsTask, selectedSurfaceFinishesTask);
            material = await detailTask;
            materialGroups = await groupsTask;
            currencies = await currenciesTask;
            colors = await colorsTask;
            surfaceFinishes = await surfaceFinishesTask;
            persistedColorIds = (await selectedColorsTask).Select(color => color.Id).ToHashSet();
            selectedColorIds = persistedColorIds.ToHashSet();
            persistedSurfaceFinishIds = (await selectedSurfaceFinishesTask).Select(finish => finish.Id).ToHashSet();
            selectedSurfaceFinishIds = persistedSurfaceFinishIds.ToHashSet();
            if (material is not null)
            {
                CopyToModel(material);
            }
        }
        catch (UnauthorizedAccessException)
        {
            NavigateToLogin();
        }
        catch (MaterialNotFoundException)
        {
            notFound = true;
            error = Text["MaterialNotFound"];
        }
        catch (CatalogForbiddenException)
        {
            error = Text["Forbidden"];
        }
        catch (CatalogRateLimitedException)
        {
            error = Text["RateLimited"];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["Unavailable"];
        }
        finally
        {
            loading = false;
            loadingAssociations = false;
        }
    }

    private async Task<CatalogMaterialDetail> LoadMaterialAsync()
    {
        using var response = await Http.GetForPresentationAsync($"/bff/catalog/materials/{Id}");
        if (response.StatusCode == HttpStatusCode.Unauthorized) throw new UnauthorizedAccessException();
        if (response.StatusCode == HttpStatusCode.Forbidden) throw new CatalogForbiddenException();
        if (response.StatusCode == HttpStatusCode.NotFound) throw new MaterialNotFoundException();
        if (response.StatusCode == HttpStatusCode.TooManyRequests) throw new CatalogRateLimitedException();
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<CatalogMaterialDetail>()
            ?? throw new System.Text.Json.JsonException("The Catalog detail response was empty.");
    }

    private async Task<IReadOnlyList<T>> LoadLookupAsync<T>(string path)
    {
        using var response = await Http.GetForPresentationAsync(path);
        if (response.StatusCode == HttpStatusCode.Unauthorized) throw new UnauthorizedAccessException();
        if (response.StatusCode == HttpStatusCode.Forbidden) throw new CatalogForbiddenException();
        if (response.StatusCode == HttpStatusCode.TooManyRequests) throw new CatalogRateLimitedException();
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<IReadOnlyList<T>>() ?? [];
    }

    private async Task<IReadOnlyList<T>> LoadAssociationLookupAsync<T>(string path)
    {
        using var response = await Http.GetForPresentationAsync(path);
        if (response.StatusCode == HttpStatusCode.Unauthorized) throw new UnauthorizedAccessException();
        if (response.StatusCode == HttpStatusCode.Forbidden) throw new CatalogForbiddenException();
        if (response.StatusCode == HttpStatusCode.TooManyRequests) throw new CatalogRateLimitedException();
        if (response.StatusCode == HttpStatusCode.NotFound) return [];
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<IReadOnlyList<T>>() ?? [];
    }

    private async Task SubmitAsync()
    {
        if (submitting) return;
        if (!editContext.Validate())
        {
            error = Text["ValidationFailed"];
            return;
        }

        submitting = true;
        error = null;
        notification = null;
        try
        {
            var session = await Http.GetFromJsonForPresentationAsync<EmployeeSessionSummary>("/bff/session");
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                error = Text["SaveFailed"];
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Put, $"/bff/catalog/materials/{Id}")
            {
                Content = JsonContent.Create(model),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Unauthorized) { NavigateToLogin(); return; }
            if (response.StatusCode == HttpStatusCode.Forbidden) { error = Text["Forbidden"]; return; }
            if (response.StatusCode == HttpStatusCode.NotFound) { notFound = true; error = Text["MaterialNotFound"]; return; }
            if (response.StatusCode == HttpStatusCode.BadRequest) { error = Text["ValidationFailed"]; return; }
            if (response.StatusCode == HttpStatusCode.Conflict) { error = Text["Conflict"]; return; }
            if (response.StatusCode == HttpStatusCode.TooManyRequests) { error = Text["RateLimited"]; return; }
            if (!response.IsSuccessStatusCode) { error = Text["SaveFailed"]; return; }

            await SyncAssociationSetAsync(
                persistedColorIds,
                selectedColorIds,
                "colors");
            await SyncAssociationSetAsync(
                persistedSurfaceFinishIds,
                selectedSurfaceFinishIds,
                "surface-finishes");
            persistedColorIds = selectedColorIds.ToHashSet();
            persistedSurfaceFinishIds = selectedSurfaceFinishIds.ToHashSet();
            notification = Text["MaterialSaved"];
            CopyToSummary();
        }
        catch (UnauthorizedAccessException)
        {
            NavigateToLogin();
        }
        catch (CatalogForbiddenException)
        {
            error = Text["Forbidden"];
        }
        catch (AssociationSaveException)
        {
            error = Text["AssociationSaveFailed"];
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["SaveFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private void CopyToModel(CatalogMaterialDetail value)
    {
        model.MaterialGroupId = value.MaterialGroupId; model.Machinable = value.Machinable; model.Printable = value.Printable; model.Name = value.Name;
        model.Aisi = value.Aisi; model.Din = value.Din; model.Bts = value.Bts; model.Jis = value.Jis; model.Uns = value.Uns; model.En = value.En;
        model.Afnor = value.Afnor; model.Uni = value.Uni; model.Sis = value.Sis; model.Sae = value.Sae; model.Astm = value.Astm; model.Ams = value.Ams;
        model.MaterialNumber = value.MaterialNumber; model.ManufacturerReference = value.ManufacturerReference; model.HardnessBrinell = value.HardnessBrinell;
        model.HardnessKnoop = value.HardnessKnoop; model.HardnessRockwellA = value.HardnessRockwellA; model.HardnessRockwellB = value.HardnessRockwellB;
        model.HardnessRockwellC = value.HardnessRockwellC; model.HardnessVickers = value.HardnessVickers; model.DensityKilogramPerCubicMeter = value.DensityKilogramPerCubicMeter;
        model.TensileStrengthUltimateGigaPascal = value.TensileStrengthUltimateGigaPascal; model.TensileStrengthYieldMegaPascal = value.TensileStrengthYieldMegaPascal;
        model.MachinabilityPercent = value.MachinabilityPercent; model.ShearModulusGigaPascal = value.ShearModulusGigaPascal;
        model.ThermalConductivityWattPerMeterKelvin = value.ThermalConductivityWattPerMeterKelvin; model.Url = value.Url;
        model.PricePerKilogram = value.PricePerKilogram; model.CurrencyId = value.CurrencyId; model.Comment = value.Comment;
        editContext = new EditContext(model);
    }

    private async Task SyncAssociationSetAsync(
        IEnumerable<int> persisted,
        IEnumerable<int> selected,
        string segment)
    {
        var session = await Http.GetFromJsonForPresentationAsync<EmployeeSessionSummary>("/bff/session");
        if (string.IsNullOrWhiteSpace(session?.CsrfToken))
        {
            throw new AssociationSaveException();
        }

        var current = persisted.ToHashSet();
        var next = selected.ToHashSet();
        foreach (var id in next.Except(current))
        {
            await SendAssociationAsync(
                HttpMethod.Post,
                $"/bff/catalog/materials/{Id}/{segment}/{id}",
                session.CsrfToken,
                ignoreNotFound: false);
        }

        foreach (var id in current.Except(next))
        {
            await SendAssociationAsync(
                HttpMethod.Delete,
                $"/bff/catalog/materials/{Id}/{segment}/{id}",
                session.CsrfToken,
                ignoreNotFound: true);
        }
    }

    private async Task SendAssociationAsync(
        HttpMethod method,
        string path,
        string csrfToken,
        bool ignoreNotFound)
    {
        using var request = new HttpRequestMessage(method, path);
        request.Headers.Add("X-CSRF-TOKEN", csrfToken);
        using var response = await Http.SendAsync(request);
        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            throw new UnauthorizedAccessException();
        }

        if (response.StatusCode == HttpStatusCode.Forbidden)
        {
            throw new CatalogForbiddenException();
        }

        if (ignoreNotFound && response.StatusCode == HttpStatusCode.NotFound)
        {
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            throw new AssociationSaveException();
        }
    }

    private void SetColorSelection(int id, bool selected) => SetSelection(selectedColorIds, id, selected);

    private void SetSurfaceFinishSelection(int id, bool selected) => SetSelection(selectedSurfaceFinishIds, id, selected);

    private static void SetSelection(HashSet<int> selection, int id, bool selected)
    {
        if (selected)
        {
            selection.Add(id);
        }
        else
        {
            selection.Remove(id);
        }
    }

    private void CopyToSummary() => material = material! with
    {
        MaterialGroupId = model.MaterialGroupId,
        MaterialGroup = materialGroups.FirstOrDefault(group => group.Id == model.MaterialGroupId),
        Machinable = model.Machinable,
        Printable = model.Printable,
        Name = model.Name,
        MaterialNumber = model.MaterialNumber,
        DensityKilogramPerCubicMeter = model.DensityKilogramPerCubicMeter,
    };

    private void NavigateToLogin() => Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
    private string ValueOrUnavailable(string? value) => string.IsNullOrWhiteSpace(value) ? Text["NotAvailable"] : value;
    private string DensityOrUnavailable() => material?.DensityKilogramPerCubicMeter is decimal density ? density.ToString(System.Globalization.CultureInfo.CurrentCulture) : Text["NotAvailable"];
    private sealed class MaterialNotFoundException : Exception;
    private sealed class CatalogForbiddenException : Exception;
    private sealed class CatalogRateLimitedException : Exception;
    private sealed class AssociationSaveException : Exception;
}
