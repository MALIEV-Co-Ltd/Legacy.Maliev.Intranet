@page "/Materials/Create"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<MaterialCreate> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="material-editor">
    <header class="operations-page-header"><div><h1>@Text["CreateMaterial"]</h1><p>@Text["Catalog"]</p></div></header>

    @if (loading)
    {
        <div class="material-editor__loading" role="status" aria-live="polite"><ShadcnSpinner Label="@Text["Loading"]" Size="1.25rem" /><span>@Text["Loading"]</span></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <ShadcnAlert Variant="ShadcnAlertVariant.Destructive" AlertRole="ShadcnAlertRole.Alert"><ShadcnAlertDescription>@error</ShadcnAlertDescription></ShadcnAlert>
        }

        <EditForm EditContext="@editContext" OnValidSubmit="SubmitAsync" OnInvalidSubmit="@(_ => error = Text["ValidationFailed"])" class="material-editor__form">
            <DataAnnotationsValidator />
            <section class="material-editor__section">
                <h2>@Text["BasicInformation"]</h2>
                <div class="material-editor__grid">
                    <CatalogInputField TValue="string" Id="material-name" Label="@Text["Name"]" @bind-Value="model.Name" Required="true" MaxLength="50" />
                    <CatalogSelectField TValue="int" Id="material-group" Label="@Text["MaterialGroup"]" @bind-Value="model.MaterialGroupId" Options="@MaterialGroupOptions" Placeholder="@Text["MaterialGroup"]" Required="true" />
                    <CatalogInputField TValue="string" Id="material-number" Label="@Text["MaterialNumber"]" @bind-Value="model.MaterialNumber" />
                    <CatalogInputField TValue="string" Id="material-manufacturer-reference" Label="@Text["ManufacturerReference"]" @bind-Value="model.ManufacturerReference" />
                    <CatalogInputField TValue="decimal?" Id="material-price-per-kilogram" Label="@Text["PricePerKilogram"]" Type="number" InputMode="decimal" @bind-Value="model.PricePerKilogram" />
                    <CatalogSelectField TValue="int?" Id="material-currency" Label="@Text["Currency"]" @bind-Value="model.CurrencyId" Options="@CurrencyOptions" Placeholder="@Text["Currency"]" Clearable="true" />
                    <CatalogInputField TValue="string" Id="material-url" Label="@Text["DatasheetUrl"]" Type="url" @bind-Value="model.Url" />
                    <ShadcnFormField Id="material-comment" Label="@Text["Comment"]" Class="material-editor__wide"><Control><ShadcnTextarea TValue="string" id="material-comment" @bind-Value="model.Comment" /></Control></ShadcnFormField>
                </div>
            </section>

            <section class="material-editor__section">
                <h2>@Text["MechanicalProperties"]</h2>
                <div class="material-editor__grid">
                    <CatalogInputField TValue="decimal?" Id="material-density" Label="@Text["Density"]" Type="number" InputMode="decimal" @bind-Value="model.DensityKilogramPerCubicMeter" />
                    <CatalogInputField TValue="decimal?" Id="material-thermal-conductivity" Label="@Text["ThermalConductivity"]" Type="number" InputMode="decimal" @bind-Value="model.ThermalConductivityWattPerMeterKelvin" />
                    <CatalogInputField TValue="decimal?" Id="material-ultimate-tensile-strength" Label="@Text["UltimateTensileStrength"]" Type="number" InputMode="decimal" @bind-Value="model.TensileStrengthUltimateGigaPascal" />
                    <CatalogInputField TValue="decimal?" Id="material-yield-tensile-strength" Label="@Text["YieldTensileStrength"]" Type="number" InputMode="decimal" @bind-Value="model.TensileStrengthYieldMegaPascal" />
                    <CatalogInputField TValue="decimal?" Id="material-shear-modulus" Label="@Text["ShearModulus"]" Type="number" InputMode="decimal" @bind-Value="model.ShearModulusGigaPascal" />
                    <CatalogInputField TValue="decimal?" Id="material-machinability" Label="@Text["MachinabilityPercent"]" Type="number" InputMode="decimal" @bind-Value="model.MachinabilityPercent" />
                    <CatalogInputField TValue="decimal?" Id="material-hardness-brinell" Label="@Text["HardnessBrinell"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessBrinell" />
                    <CatalogInputField TValue="decimal?" Id="material-hardness-knoop" Label="@Text["HardnessKnoop"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessKnoop" />
                    <CatalogInputField TValue="decimal?" Id="material-hardness-rockwell-a" Label="@Text["HardnessRockwellA"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessRockwellA" />
                    <CatalogInputField TValue="decimal?" Id="material-hardness-rockwell-b" Label="@Text["HardnessRockwellB"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessRockwellB" />
                    <CatalogInputField TValue="decimal?" Id="material-hardness-rockwell-c" Label="@Text["HardnessRockwellC"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessRockwellC" />
                    <CatalogInputField TValue="decimal?" Id="material-hardness-vickers" Label="@Text["HardnessVickers"]" Type="number" InputMode="decimal" @bind-Value="model.HardnessVickers" />
                </div>
            </section>

            <section class="material-editor__section">
                <h2>@Text["MaterialIdentification"]</h2>
                <div class="material-editor__grid material-editor__grid--three">
                    <CatalogInputField TValue="string" Id="material-aisi" Label="@Text["Aisi"]" @bind-Value="model.Aisi" />
                    <CatalogInputField TValue="string" Id="material-din" Label="@Text["Din"]" @bind-Value="model.Din" />
                    <CatalogInputField TValue="string" Id="material-bts" Label="@Text["Bts"]" @bind-Value="model.Bts" />
                    <CatalogInputField TValue="string" Id="material-jis" Label="@Text["Jis"]" @bind-Value="model.Jis" />
                    <CatalogInputField TValue="string" Id="material-uns" Label="@Text["Uns"]" @bind-Value="model.Uns" />
                    <CatalogInputField TValue="string" Id="material-en" Label="@Text["En"]" @bind-Value="model.En" />
                    <CatalogInputField TValue="string" Id="material-afnor" Label="@Text["Afnor"]" @bind-Value="model.Afnor" />
                    <CatalogInputField TValue="string" Id="material-uni" Label="@Text["Uni"]" @bind-Value="model.Uni" />
                    <CatalogInputField TValue="string" Id="material-sis" Label="@Text["Sis"]" @bind-Value="model.Sis" />
                    <CatalogInputField TValue="string" Id="material-sae" Label="@Text["Sae"]" @bind-Value="model.Sae" />
                    <CatalogInputField TValue="string" Id="material-astm" Label="@Text["Astm"]" @bind-Value="model.Astm" />
                    <CatalogInputField TValue="string" Id="material-ams" Label="@Text["Ams"]" @bind-Value="model.Ams" />
                </div>
            </section>

            <section class="material-editor__section">
                <h2>@Text["ProcessCompatibility"]</h2>
                <div class="material-editor__checks">
                    <CatalogCheckboxField Id="material-machinable" Label="@Text["Machinable"]" @bind-Value="model.Machinable" />
                    <CatalogCheckboxField Id="material-printable" Label="@Text["Printable"]" @bind-Value="model.Printable" />
                </div>
            </section>

            <div class="material-editor__actions">
                <ShadcnButton ButtonType="ShadcnButtonType.Submit" OperationFeedback="false" Disabled="@submitting">@(submitting ? Text["Submitting"] : Text["CreateMaterial"])</ShadcnButton>
                <LegacyLink Href="/Materials/Index" Role="LegacyLinkRole.Navigation" Disabled="@submitting" AriaLabel="@Text["Cancel"]">@Text["Cancel"]</LegacyLink>
            </div>
        </EditForm>
    }
</main>

@code {
    private readonly CatalogMaterialUpsertRequest model = new();
    private IReadOnlyList<CatalogMaterialGroup> materialGroups = [];
    private IReadOnlyList<CatalogCurrency> currencies = [];
    private EditContext editContext = null!;
    private bool loading = true;
    private bool submitting;
    private string? error;

    private IReadOnlyList<ShadcnSelectOption<int>> MaterialGroupOptions => materialGroups.Select(group => new ShadcnSelectOption<int>(group.Id, group.Name)).ToArray();
    private IReadOnlyList<ShadcnSelectOption<int?>> CurrencyOptions => currencies.Select(currency => new ShadcnSelectOption<int?>(currency.Id, currency.ShortName)).ToArray();

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(model);
        try
        {
            materialGroups = await LoadLookupAsync<CatalogMaterialGroup>("/bff/catalog/material-groups");
            currencies = await LoadLookupAsync<CatalogCurrency>("/bff/catalog/currencies");
        }
        catch (UnauthorizedAccessException)
        {
            NavigateToLogin();
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["LookupsUnavailable"];
        }
        finally
        {
            loading = false;
        }
    }

    private async Task<IReadOnlyList<T>> LoadLookupAsync<T>(string path)
    {
        using var response = await Http.GetForPresentationAsync(path);
        if (response.StatusCode == HttpStatusCode.Unauthorized)
        {
            throw new UnauthorizedAccessException();
        }

        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<IReadOnlyList<T>>() ?? [];
    }

    private async Task SubmitAsync()
    {
        if (submitting)
        {
            return;
        }

        if (!editContext.Validate())
        {
            error = Text["ValidationFailed"];
            return;
        }

        submitting = true;
        error = null;
        try
        {
            var session = await Http.GetFromJsonForPresentationAsync<EmployeeSessionSummary>("/bff/session");
            if (string.IsNullOrWhiteSpace(session?.CsrfToken))
            {
                error = Text["CreateFailed"];
                return;
            }

            using var request = new HttpRequestMessage(HttpMethod.Post, "/bff/catalog/materials")
            {
                Content = JsonContent.Create(model),
            };
            request.Headers.Add("X-CSRF-TOKEN", session.CsrfToken);
            using var response = await Http.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                NavigateToLogin();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                error = Text["ValidationFailed"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["CreateFailed"];
                return;
            }

            var created = await response.Content.ReadFromJsonAsync<CatalogCreatedMaterial>();
            if (created is null || created.Id <= 0)
            {
                error = Text["InvalidResponse"];
                return;
            }

            Navigation.NavigateTo($"/Materials/View?id={created.Id}");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = Text["CreateFailed"];
        }
        finally
        {
            submitting = false;
        }
    }

    private void NavigateToLogin() => Navigation.NavigateTo(
        $"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
}
