@page "/Materials/Index"
@page "/mfg/materials"
@using System.Globalization
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Materials> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<main class="materials-page">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header">
        <div>
            <h1>@Text["Materials"]</h1>
            <p>@Text["Catalog"]</p>
        </div>
        <ShadcnButton Href="/Materials/Create">
            @Text["CreateMaterial"]
        </ShadcnButton>
    </header>

    <section aria-label="@Text["MaterialsTable"]">
    <OperationalDataTable TItem="CatalogMaterialListItem"
                          Items="@(page?.Items ?? [])"
                          Columns="@Columns"
                          RowKey="@(material => material.Id.ToString(CultureInfo.InvariantCulture))"
                          State="@dataTableState"
                          StateChanged="HandleDataTableStateChangedAsync"
                          RequestChanged="HandleDataTableRequestAsync"
                          TotalCount="@(page?.TotalRecords ?? 0)"
                          Loading="@loading"
                          Error="@error"
                          FilterPlaceholder="@Text["Search"]"
                          EmptyText="@Text["Empty"]"
                          LoadingText="@Text["Loading"]"
                          ActionsLabel="@Text["Actions"]"
                          PageSizeOptions="@PageSizeOptions"
                          DetailHref="@(material => $"/Materials/View?id={material.Id}")"
                          DetailAriaLabel="@(material => Text["ViewMaterial", material.Id])"
                          DetailsAriaLabel="@(material => Text["ExpandMaterial", material.Id])">
            <QuickViewContent Context="material"><dl class="operational-quick-view">
                <div><dt>@Text["Density"]</dt><dd class="mlv-mono">@material.DensityKilogramPerCubicMeter</dd></div>
                <div><dt>@Text["Machinable"]</dt><dd>@Text[material.Machinable ? "Yes" : "No"]</dd></div>
                <div><dt>@Text["Printable"]</dt><dd>@Text[material.Printable ? "Yes" : "No"]</dd></div>
            </dl></QuickViewContent>
    </OperationalDataTable>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private CatalogMaterialPage? page;
    private string? error;
    private bool loading;
    private CatalogMaterialSort currentSort = CatalogMaterialSort.MaterialId_Descending;
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 10 };
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Materials"]),
    ];
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 250];
    private IReadOnlyList<ShadcnDataTableColumn<CatalogMaterialListItem>> Columns =>
    [
        new("id", Text["Id"], material => material.Id) { Sortable = true, Hideable = false },
        new("number", Text["Number"], material => material.MaterialNumber) { Sortable = true },
        new("name", Text["Name"], material => material.Name) { Sortable = true, MinWidth = "12rem" },
        new("group", Text["Group"], material => material.MaterialGroup?.Name ?? "-") { Sortable = true },
        new("density", Text["Density"], material => material.DensityKilogramPerCubicMeter) { Sortable = true },
        new("machinable", Text["Machinable"], material => Text[material.Machinable ? "Yes" : "No"].Value) { Sortable = true },
        new("printable", Text["Printable"], material => Text[material.Printable ? "Yes" : "No"].Value),
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 10, maximum: 250);
        currentSort = Enum.TryParse<CatalogMaterialSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : CatalogMaterialSort.MaterialId_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<CatalogMaterialSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? new ListToolbarState<CatalogMaterialSort>(Search, currentSort, Size)).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/catalog/materials?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<CatalogMaterialPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, CatalogMaterialSort sort, int size, bool replace = false)
    {
        var uri = $"/Materials/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}";
        Navigation.NavigateTo(uri, replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, Index - 1),
        PageSize = Size,
        Sorts = currentSort switch
        {
            CatalogMaterialSort.MaterialId_Ascending => [new("id", ShadcnSortDirection.Ascending)],
            CatalogMaterialSort.MaterialId_Descending => [new("id", ShadcnSortDirection.Descending)],
            CatalogMaterialSort.MaterialNumber_Ascending => [new("number", ShadcnSortDirection.Ascending)],
            CatalogMaterialSort.MaterialNumber_Descending => [new("number", ShadcnSortDirection.Descending)],
            CatalogMaterialSort.MaterialName_Ascending => [new("name", ShadcnSortDirection.Ascending)],
            CatalogMaterialSort.MaterialName_Descending => [new("name", ShadcnSortDirection.Descending)],
            CatalogMaterialSort.MaterialGroup_Ascending => [new("group", ShadcnSortDirection.Ascending)],
            CatalogMaterialSort.MaterialGroup_Descending => [new("group", ShadcnSortDirection.Descending)],
            CatalogMaterialSort.MaterialDensity_Ascending => [new("density", ShadcnSortDirection.Ascending)],
            CatalogMaterialSort.MaterialDensity_Descending => [new("density", ShadcnSortDirection.Descending)],
            CatalogMaterialSort.MaterialMachinability_Ascending => [new("machinable", ShadcnSortDirection.Ascending)],
            CatalogMaterialSort.MaterialMachinability_Descending => [new("machinable", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private CatalogMaterialSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "id", Direction: ShadcnSortDirection.Ascending } => CatalogMaterialSort.MaterialId_Ascending,
        { ColumnKey: "id", Direction: ShadcnSortDirection.Descending } => CatalogMaterialSort.MaterialId_Descending,
        { ColumnKey: "number", Direction: ShadcnSortDirection.Ascending } => CatalogMaterialSort.MaterialNumber_Ascending,
        { ColumnKey: "number", Direction: ShadcnSortDirection.Descending } => CatalogMaterialSort.MaterialNumber_Descending,
        { ColumnKey: "name", Direction: ShadcnSortDirection.Ascending } => CatalogMaterialSort.MaterialName_Ascending,
        { ColumnKey: "name", Direction: ShadcnSortDirection.Descending } => CatalogMaterialSort.MaterialName_Descending,
        { ColumnKey: "group", Direction: ShadcnSortDirection.Ascending } => CatalogMaterialSort.MaterialGroup_Ascending,
        { ColumnKey: "group", Direction: ShadcnSortDirection.Descending } => CatalogMaterialSort.MaterialGroup_Descending,
        { ColumnKey: "density", Direction: ShadcnSortDirection.Ascending } => CatalogMaterialSort.MaterialDensity_Ascending,
        { ColumnKey: "density", Direction: ShadcnSortDirection.Descending } => CatalogMaterialSort.MaterialDensity_Descending,
        { ColumnKey: "machinable", Direction: ShadcnSortDirection.Ascending } => CatalogMaterialSort.MaterialMachinability_Ascending,
        { ColumnKey: "machinable", Direction: ShadcnSortDirection.Descending } => CatalogMaterialSort.MaterialMachinability_Descending,
        _ => currentSort,
    };
}
