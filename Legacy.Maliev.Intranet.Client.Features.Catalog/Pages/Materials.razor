@page "/Materials/Index"
@page "/mfg/materials"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<Materials> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <header class="operations-page-header">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">@Text["Materials"]</MudText>
            <MudText Typo="Typo.body2">@Text["Catalog"]</MudText>
        </div>
        <MudButton Href="/Materials/Create" Variant="Variant.Filled" Color="Color.Primary">
            @Text["CreateMaterial"]
        </MudButton>
    </header>

    <ListToolbar TSort="CatalogMaterialSort"
                 Value="@ToolbarState"
                 Defaults="@DefaultToolbarState"
                 SortOptions="@SortOptions"
                 PageSizeOptions="@PageSizeOptions"
                 SearchLabel="@Text["Search"]"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite"><MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" /><span class="visually-hidden">@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@Text["Empty"]</MudAlert>
    }
    else
    {
        <MudTable Items="page.Items" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" aria-label="@Text["MaterialsTable"]">
            <HeaderContent>
                <MudTh>@Text["Id"]</MudTh><MudTh>@Text["Group"]</MudTh><MudTh>@Text["Name"]</MudTh>
                <MudTh>@Text["Number"]</MudTh><MudTh>@Text["Density"]</MudTh>
                <MudTh>@Text["Machinable"]</MudTh><MudTh>@Text["Printable"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Text["Id"]"><MudLink Href="@($"/Materials/View?id={context.Id}")">@context.Id</MudLink></MudTd>
                <MudTd DataLabel="@Text["Group"]">@context.MaterialGroup?.Name</MudTd>
                <MudTd DataLabel="@Text["Name"]">@context.Name</MudTd>
                <MudTd DataLabel="@Text["Number"]">@context.MaterialNumber</MudTd>
                <MudTd DataLabel="@Text["Density"]">@context.DensityKilogramPerCubicMeter</MudTd>
                <MudTd DataLabel="@Text["Machinable"]">@Text[context.Machinable ? "Yes" : "No"]</MudTd>
                <MudTd DataLabel="@Text["Printable"]">@Text[context.Printable ? "Yes" : "No"]</MudTd>
            </RowTemplate>
        </MudTable>
        <nav class="d-flex flex-wrap align-center justify-space-between gap-3 mt-4" aria-label="@Text["MaterialPages"]">
            <MudButton Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</MudButton>
            <MudText aria-live="polite">@Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords]</MudText>
            <MudButton Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</MudButton>
        </nav>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private CatalogMaterialPage? page;
    private string? error;
    private bool loading;
    private CatalogMaterialSort currentSort = CatalogMaterialSort.MaterialId_Descending;
    private readonly LatestRequestGate requestGate = new();
    private static readonly ListToolbarState<CatalogMaterialSort> DefaultToolbarState =
        new(null, CatalogMaterialSort.MaterialId_Descending, 10);
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100, 250];
    private ListToolbarState<CatalogMaterialSort> ToolbarState => new(Search, currentSort, Size);
    private IReadOnlyList<ListToolbarOption<CatalogMaterialSort>> SortOptions =>
        Enum.GetValues<CatalogMaterialSort>()
            .Select(option => new ListToolbarOption<CatalogMaterialSort>(option, Text[option.ToString()]))
            .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 10, maximum: 250);
        currentSort = Enum.TryParse<CatalogMaterialSort>(SortQuery, ignoreCase: true, out var parsedSort)
            ? parsedSort
            : CatalogMaterialSort.MaterialId_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<CatalogMaterialSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? ToolbarState).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/catalog/materials?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = Text["Forbidden"];
                return;
            }

            if (response.StatusCode == HttpStatusCode.TooManyRequests)
            {
                error = Text["RateLimited"];
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<CatalogMaterialPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["InvalidResponse"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private Task HandleToolbarRequestAsync(ListToolbarRequest<CatalogMaterialSort> request)
    {
        var state = request.State.Normalize();
        if (request.Reason == ListToolbarChangeReason.Refreshed && state == ToolbarState.Normalize())
        {
            return LoadAsync();
        }

        return NavigateAsync(1, state.Search, state.Sort, state.PageSize, replace: true);
    }

    private Task NavigateAsync(int index, string? search, CatalogMaterialSort sort, int size, bool replace = false)
    {
        var uri = $"/Materials/Index?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 250)}";
        Navigation.NavigateTo(uri, replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();
}
