@page "/Server/ErrorReport"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<ErrorReport> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<div class="legacy-content-container legacy-content-container--wide">
    <PageBreadcrumbs Items="@Breadcrumbs" />
    <header class="operations-page-header"><div><ShadcnTypography Variant="ShadcnTypographyVariant.H1">@Text["Title"]</ShadcnTypography><ShadcnTypography Variant="ShadcnTypographyVariant.Muted">@Text["Operations"]</ShadcnTypography></div></header>
    <ShadcnAlert AlertRole="ShadcnAlertRole.Status" Class="mb-4"><ShadcnAlertDescription>@Text["PrivacyNote"]</ShadcnAlertDescription></ShadcnAlert>

    <section aria-label="@Text["DiagnosticsTable"]">
    <OperationalDataTable TItem="DiagnosticEventItem"
                          Items="@(page?.Items ?? [])"
                          Columns="@Columns"
                          RowKey="@(diagnostic => diagnostic.Id.ToString(CultureInfo.InvariantCulture))"
                          State="@dataTableState"
                          StateChanged="HandleDataTableStateChangedAsync"
                          RequestChanged="HandleDataTableRequestAsync"
                          TotalCount="@(page?.TotalRecords ?? 0)"
                          Loading="@loading"
                          Error="@error"
                          FilterPlaceholder="@Text["Search"]"
                          EmptyText="@Text["Empty"]"
                          LoadingText="@Text["Loading"]"
                          ActionsLabel="@Text["Actions"]"
                          PageSizeOptions="@PageSizeOptions"
                          DetailHref="@(_ => null)"
                          DetailAriaLabel="@(diagnostic => Text["ViewDiagnostic", diagnostic.Id])"
                          DetailsAriaLabel="@(diagnostic => Text["ExpandDiagnostic", diagnostic.Id])">
            <QuickViewContent Context="diagnostic"><dl class="operational-quick-view">
                <div><dt>@Text["Path"]</dt><dd class="mlv-mono">@diagnostic.Path</dd></div>
                <div><dt>@Text["CorrelationId"]</dt><dd class="mlv-mono">@diagnostic.CorrelationId</dd></div>
                <div><dt>@Text["Code"]</dt><dd class="mlv-mono">@diagnostic.Code</dd></div>
            </dl></QuickViewContent>
    </OperationalDataTable>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private DiagnosticEventPage? page;
    private string? error;
    private bool loading;
    private DiagnosticEventSort currentSort = DiagnosticEventSort.LogTimestamp_Descending;
    private readonly LatestRequestGate requestGate = new();
    private ShadcnDataTableState dataTableState = new() { PageSize = 10 };
    private IReadOnlyList<PageBreadcrumbItem> Breadcrumbs =>
    [
        new(Text["Operations"], "/Dashboard"),
        new(Text["Title"]),
    ];
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private IReadOnlyList<ShadcnDataTableColumn<DiagnosticEventItem>> Columns =>
    [
        new("timestamp", Text["Timestamp"], diagnostic => diagnostic.Timestamp) { Sortable = true, Hideable = false, MinWidth = "12rem", CellTemplate = diagnostic => builder => builder.AddContent(0, LegacyPresentation.FormatUtcDateTime(diagnostic.Timestamp, CultureInfo.CurrentCulture)) },
        new("level", Text["Level"], diagnostic => diagnostic.Level) { Sortable = true, Filterable = true },
        new("code", Text["Code"], diagnostic => diagnostic.Code) { Filterable = true },
        new("category", Text["Category"], diagnostic => diagnostic.Category) { Filterable = true },
        new("path", Text["Path"], diagnostic => diagnostic.Path) { Filterable = true, MinWidth = "14rem" },
        new("correlation", Text["CorrelationId"], diagnostic => diagnostic.CorrelationId) { Filterable = true, MinWidth = "12rem" },
    ];

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 10, maximum: 100);
        currentSort = Enum.TryParse<DiagnosticEventSort>(SortQuery, true, out var parsed)
            ? parsed
            : DiagnosticEventSort.LogTimestamp_Descending;
        dataTableState = BuildDataTableState();
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<DiagnosticEventSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? new ListToolbarState<DiagnosticEventSort>(Search, currentSort, Size)).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/diagnostics/events?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode == HttpStatusCode.Forbidden ? Text["Forbidden"] : Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<DiagnosticEventPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["Unavailable"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task HandleDataTableStateChangedAsync(ShadcnDataTableState state)
    {
        dataTableState = state;
        return Task.CompletedTask;
    }

    private Task HandleDataTableRequestAsync(ShadcnDataTableRequest request) =>
        NavigateAsync(request.PageIndex + 1, request.Query, MapSort(request.Sorts), request.PageSize, replace: true);

    private Task NavigateAsync(int index, string? search, DiagnosticEventSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/Server/ErrorReport?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 100)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();

    private ShadcnDataTableState BuildDataTableState() => new()
    {
        Query = Search ?? string.Empty,
        PageIndex = Math.Max(0, Index - 1),
        PageSize = Size,
        Sorts = currentSort switch
        {
            DiagnosticEventSort.LogTimestamp_Ascending => [new("timestamp", ShadcnSortDirection.Ascending)],
            DiagnosticEventSort.LogTimestamp_Descending => [new("timestamp", ShadcnSortDirection.Descending)],
            DiagnosticEventSort.LogLevel_Ascending => [new("level", ShadcnSortDirection.Ascending)],
            DiagnosticEventSort.LogLevel_Descending => [new("level", ShadcnSortDirection.Descending)],
            _ => [],
        },
    };

    private DiagnosticEventSort MapSort(IReadOnlyList<ShadcnDataTableSort> sorts) => sorts.FirstOrDefault() switch
    {
        { ColumnKey: "timestamp", Direction: ShadcnSortDirection.Ascending } => DiagnosticEventSort.LogTimestamp_Ascending,
        { ColumnKey: "timestamp", Direction: ShadcnSortDirection.Descending } => DiagnosticEventSort.LogTimestamp_Descending,
        { ColumnKey: "level", Direction: ShadcnSortDirection.Ascending } => DiagnosticEventSort.LogLevel_Ascending,
        { ColumnKey: "level", Direction: ShadcnSortDirection.Descending } => DiagnosticEventSort.LogLevel_Descending,
        _ => currentSort,
    };
}
