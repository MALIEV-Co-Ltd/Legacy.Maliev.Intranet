@page "/Server/ErrorReport"
@attribute [Authorize]
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IStringLocalizer<ErrorReport> Text

<PageTitle>@Text["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge">
    <header class="operations-page-header"><div><MudText Typo="Typo.h4" HtmlTag="h1">@Text["Title"]</MudText><MudText Typo="Typo.body2">@Text["Operations"]</MudText></div></header>
    <MudAlert Severity="Severity.Info" Class="mb-4">@Text["PrivacyNote"]</MudAlert>

    <ListToolbar TSort="DiagnosticEventSort"
                 Value="@ToolbarState"
                 Defaults="@DefaultToolbarState"
                 SortOptions="@SortOptions"
                 PageSizeOptions="@PageSizeOptions"
                 SearchLabel="@Text["Search"]"
                 IsBusy="@loading"
                 OnRequest="HandleToolbarRequestAsync" />

    @if (loading)
    {
        <div role="status" aria-live="polite"><MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Text["Loading"]" /><span class="visually-hidden">@Text["Loading"]</span></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudAlert Severity="Severity.Error" aria-live="assertive">@error</MudAlert>
    }
    else if (page is null || page.Items.Count == 0)
    {
        <MudAlert Severity="Severity.Success">@Text["Empty"]</MudAlert>
    }
    else
    {
        <MudTable Items="page.Items" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="1" aria-label="@Text["DiagnosticsTable"]">
            <HeaderContent>
                <MudTh>@Text["Timestamp"]</MudTh>
                <MudTh>@Text["Level"]</MudTh>
                <MudTh>@Text["Code"]</MudTh>
                <MudTh>@Text["Category"]</MudTh>
                <MudTh>@Text["Path"]</MudTh>
                <MudTh>@Text["CorrelationId"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Text["Timestamp"]">@LegacyPresentation.FormatUtcDateTime(context.Timestamp, CultureInfo.CurrentCulture)</MudTd>
                <MudTd DataLabel="@Text["Level"]">@context.Level</MudTd>
                <MudTd DataLabel="@Text["Code"]"><code>@context.Code</code></MudTd>
                <MudTd DataLabel="@Text["Category"]">@context.Category</MudTd>
                <MudTd DataLabel="@Text["Path"]"><code>@context.Path</code></MudTd>
                <MudTd DataLabel="@Text["CorrelationId"]"><code>@context.CorrelationId</code></MudTd>
            </RowTemplate>
        </MudTable>
        <nav class="d-flex flex-wrap align-center justify-space-between gap-3 mt-4" aria-label="@Text["Pages"]">
            <MudButton Disabled="@(!page.HasPreviousPage)" OnClick="PreviousPageAsync">@Text["Previous"]</MudButton>
            <MudText aria-live="polite">@Text["PageSummary", page.PageIndex, page.TotalPages, page.TotalRecords]</MudText>
            <MudButton Disabled="@(!page.HasNextPage)" OnClick="NextPageAsync">@Text["Next"]</MudButton>
        </nav>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "search")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? SortQuery { get; set; }
    [SupplyParameterFromQuery(Name = "index")] public int Index { get; set; } = 1;
    [SupplyParameterFromQuery(Name = "size")] public int Size { get; set; } = 10;

    private DiagnosticEventPage? page;
    private string? error;
    private bool loading;
    private DiagnosticEventSort currentSort = DiagnosticEventSort.LogTimestamp_Descending;
    private readonly LatestRequestGate requestGate = new();
    private static readonly ListToolbarState<DiagnosticEventSort> DefaultToolbarState =
        new(null, DiagnosticEventSort.LogTimestamp_Descending, 10);
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private ListToolbarState<DiagnosticEventSort> ToolbarState => new(Search, currentSort, Size);
    private IReadOnlyList<ListToolbarOption<DiagnosticEventSort>> SortOptions =>
        Enum.GetValues<DiagnosticEventSort>()
            .Select(option => new ListToolbarOption<DiagnosticEventSort>(option, Text[option.ToString()]))
            .ToArray();

    protected override async Task OnParametersSetAsync()
    {
        Index = PaginationQueryDefaults.NormalizeIndex(Index);
        Size = PaginationQueryDefaults.NormalizeSize(Size, fallback: 10, maximum: 100);
        currentSort = Enum.TryParse<DiagnosticEventSort>(SortQuery, true, out var parsed)
            ? parsed
            : DiagnosticEventSort.LogTimestamp_Descending;
        await LoadAsync();
    }

    private async Task LoadAsync(
        ListToolbarState<DiagnosticEventSort>? requestedState = null,
        CancellationToken cancellationToken = default)
    {
        using var lease = requestGate.Begin(cancellationToken);
        var state = (requestedState ?? ToolbarState).Normalize();
        loading = true;
        error = null;
        try
        {
            var uri = $"/bff/diagnostics/events?sort={state.Sort}&search={Uri.EscapeDataString(state.Search ?? string.Empty)}&index={Index}&size={state.PageSize}";
            using var response = await Http.GetForPresentationAsync(uri, lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/Login?returnUrl={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode == HttpStatusCode.Forbidden ? Text["Forbidden"] : Text["Unavailable"];
                return;
            }

            var loadedPage = await response.Content.ReadFromJsonAsync<DiagnosticEventPage>(cancellationToken: lease.CancellationToken);
            if (!lease.IsCurrent)
            {
                return;
            }

            page = loadedPage;
            if (loadedPage is null)
            {
                error = Text["Unavailable"];
            }
        }
        catch (OperationCanceledException) when (!lease.IsCurrent || lease.CancellationToken.IsCancellationRequested)
        {
            // A newer toolbar request owns the visible state.
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            if (lease.IsCurrent)
            {
                error = Text["Unavailable"];
            }
        }
        finally
        {
            if (lease.IsCurrent)
            {
                loading = false;
            }
        }
    }

    private Task PreviousPageAsync() => NavigateAsync(Math.Max(1, Index - 1), Search, currentSort, Size);
    private Task NextPageAsync() => NavigateAsync(Index + 1, Search, currentSort, Size);

    private Task HandleToolbarRequestAsync(ListToolbarRequest<DiagnosticEventSort> request)
    {
        var state = request.State.Normalize();
        if (request.Reason == ListToolbarChangeReason.Refreshed && state == ToolbarState.Normalize())
        {
            return LoadAsync();
        }

        return NavigateAsync(1, state.Search, state.Sort, state.PageSize, replace: true);
    }

    private Task NavigateAsync(int index, string? search, DiagnosticEventSort sort, int size, bool replace = false)
    {
        Navigation.NavigateTo($"/Server/ErrorReport?search={Uri.EscapeDataString(search ?? string.Empty)}&sort={sort}&index={index}&size={Math.Clamp(size, 1, 100)}", replace: replace);
        return Task.CompletedTask;
    }

    public void Dispose() => requestGate.Dispose();
}
